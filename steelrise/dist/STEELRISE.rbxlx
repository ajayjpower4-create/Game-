---------------------------------------------------------------------------
-- Layout generation
---------------------------------------------------------------------------

local SEAT = G.SeatOffset * S

local function gussetCf(colBase, gridPos, dir, high, L)
	local y = high and (colBase + L - G.GussetHighFromTop * S) or (colBase + G.GussetLow * S)
	local pos = V(gridPos.X, y, gridPos.Z) + dir * SEAT
	return Factory.lookAlong(pos, dir)
end

-- Expands a grid into blueprint entries:
-- { key, item, cf, phase, level, i, j, dir, side, group }
function Sites.layout(grid)
	local entries = {}
	local O = grid.originM * S
	local bx, bz = grid.bayX * S, grid.bayZ * S
	local L = grid.floorH * S
	local y0 = G.FootingTop * S
	local colId = Registry.find("column", grid.column, grid.floorH)
	local beamX = Registry.find("beam", grid.beam, grid.bayX)
	local beamZ = Registry.find("beam", grid.beam, grid.bayZ)
	local beamDef = Registry.get(beamX)
	local d = beamDef.profile.d * S
	local footing = Registry.find("footing", grid.bayX >= 9 and 2.0 or 1.5)

	local function gp(i, j)
		return V(O.X + i * bx, 0, O.Z + j * bz)
	end
	local function push(e)
		e.key = e.phase .. ":" .. e.level .. ":" .. e.i .. ":" .. e.j .. ":" .. (e.dir or "") .. ":" .. (e.side or "")
		table.insert(entries, e)
	end

	for i = 0, grid.nx do
		for j = 0, grid.nz do
			push({ phase = "footing", level = 0, i = i, j = j, item = footing, cf = CFrame.new(gp(i, j)) })
		end
	end

	for k = 1, grid.floors do
		local base = y0 + (k - 1) * L
		local top = base + L
		for i = 0, grid.nx do
			for j = 0, grid.nz do
				local p = gp(i, j)
				push({ phase = "column", level = k, i = i, j = j, item = colId, cf = CFrame.new(p.X, base + L / 2, p.Z) })
			end
		end
		-- beams along X
		for i = 0, grid.nx - 1 do
			for j = 0, grid.nz do
				local a, b = gp(i, j), gp(i + 1, j)
				local c = (a + b) / 2
				push({ phase = "beam", level = k, i = i, j = j, dir = "x", item = beamX, cf = CFrame.new(c.X, top - d / 2, c.Z) })
			end
		end
		-- beams along Z
		for i = 0, grid.nx do
			for j = 0, grid.nz - 1 do
				local a, b = gp(i, j), gp(i, j + 1)
				local c = (a + b) / 2
				push({ phase = "beam", level = k, i = i, j = j, dir = "z", item = beamZ, cf = CFrame.new(c.X, top - d / 2, c.Z) * CFrame.Angles(0, math.pi / 2, 0) })
			end
		end
		-- braced bays: { "x", i, j } = bay along X starting at column (i, j)
		for _, br in ipairs(grid.braces or {}) do
			local dirName, bi, bj = br[1], br[2], br[3]
			local a = gp(bi, bj)
			local b = dirName == "x" and gp(bi + 1, bj) or gp(bi, bj + 1)
			local valid = (dirName == "x" and bi < grid.nx and bj <= grid.nz) or (dirName == "z" and bj < grid.nz and bi <= grid.nx)
			if valid then
				local dir = (b - a).Unit
				local gA = gussetCf(base, a, dir, false, L)
				local gB = gussetCf(base, b, -dir, true, L)
				push({ phase = "gusset", level = k, i = bi, j = bj, dir = dirName, side = "A", item = "CON-GUSSET-350", cf = gA })
				push({ phase = "gusset", level = k, i = bi, j = bj, dir = dirName, side = "B", item = "CON-GUSSET-350", cf = gB })
				local braceId = Registry.find("brace", dirName == "x" and grid.bayX or grid.bayZ, grid.floorH)
				local braceDef = Registry.get(braceId)
				if braceDef then
					local seatA = (gA * CFrame.new(0, 0, -G.GussetTip * S)).Position
					local seatB = (gB * CFrame.new(0, 0, -G.GussetTip * S)).Position
					local pA, pB = braceDef.plugs[1].cfS.Position, braceDef.plugs[2].cfS.Position
					push({ phase = "brace", level = k, i = bi, j = bj, dir = dirName, item = braceId, cf = BuildRules.spanCf(pA, pB, seatA, seatB) })
				end
			end
		end
		-- deck sheets spanning X in every bay
		if grid.deck then
			local deckId = Registry.find("deck", grid.bayX)
			local W = G.DeckWidth * S
			local n = math.floor(bz / W + 0.5)
			for i = 0, grid.nx - 1 do
				for j = 0, grid.nz - 1 do
					local a = gp(i, j)
					for t = 0, n - 1 do
						local pos = V(a.X + bx / 2, top, a.Z + (t + 0.5) * W)
						local e = { phase = "deck", level = k, i = i, j = j, dir = tostring(t), item = deckId, cf = CFrame.new(pos), group = "deck:" .. k .. ":" .. i .. ":" .. j }
						push(e)
					end
				end
			end
		end
		-- facade on the four perimeter faces
		if grid.facade then
			local function facadeItem(bayLen, idx)
				local kind = grid.facade
				if kind == "mixed" then
					kind = (idx % 2 == 0) and "curtain" or "wall"
				end
				return Registry.find(kind, bayLen, grid.floorH)
			end
			local rc = G.CladOffset * S
			local faces = {
				{ side = "-Z", n = V(0, 0, -1), along = "x", fixed = 0 },
				{ side = "+Z", n = V(0, 0, 1), along = "x", fixed = grid.nz },
				{ side = "-X", n = V(-1, 0, 0), along = "z", fixed = 0 },
				{ side = "+X", n = V(1, 0, 0), along = "z", fixed = grid.nx },
			}
			for _, f in ipairs(faces) do
				local count = f.along == "x" and grid.nx or grid.nz
				for t = 0, count - 1 do
					local a, b
					if f.along == "x" then
						a, b = gp(t, f.fixed), gp(t + 1, f.fixed)
					else
						a, b = gp(f.fixed, t), gp(f.fixed, t + 1)
					end
					local sa = V(a.X, base, a.Z) + f.n * rc
					local sb = V(b.X, base, b.Z) + f.n * rc
					if (sb - sa):Cross(Vector3.yAxis):Dot(f.n) < 0 then
						sa, sb = sb, sa
					end
					local bayLen = f.along == "x" and grid.bayX or grid.bayZ
					local id = facadeItem(bayLen, t + k)
					local def = Registry.get(id)
					if def then
						local pA, pB = def.plugs[1].cfS.Position, def.plugs[2].cfS.Position
						local ii, jj = t, f.fixed
						if f.along == "z" then
							ii, jj = f.fixed, t
						end
						push({ phase = "facade", level = k, i = ii, j = jj, side = f.side, item = id, cf = BuildRules.spanCf(pA, pB, sa, sb) })
					end
				end
			end
		end
	end
	return entries
end

-- Build order used for the task panel and "next work package" deliveries.
Sites.PhaseOrder = { footing = 1, column = 2, beam = 3, gusset = 4, brace = 5, deck = 6, facade = 7 }

function Sites.sortEntries(entries)
	table.sort(entries, function(a, b)
		if a.level ~= b.level then
			if a.phase == "footing" or b.phase == "footing" then
				return a.phase == "footing" and b.phase ~= "footing"
			end
			return a.level < b.level
		end
		local pa, pb = Sites.PhaseOrder[a.phase], Sites.PhaseOrder[b.phase]
		if pa ~= pb then
			return pa < pb
		end
		return a.key < b.key
	end)
	return entries
end

function Sites.get(id)
	return Sites.Defs[id]
end

-- Main grid of a site, or a blueprint grid for free-build sites.
function Sites.blueprintGrid(site, blueprintId)
	if site.grid and (not blueprintId or blueprintId == "Site") then
		return site.grid
	end
	for _, bp in ipairs(site.blueprints or {}) do
		if bp.id == blueprintId then
			return bp.grid
		end
	end
	return site.grid
end

function Sites.stageEntries(site)
	if not site.grid or not site.stage then
		return {}
	end
	local out = {}
	for _, e in ipairs(Sites.layout(site.grid)) do
		if site.stage(e) then
			table.insert(out, e)
		end
	end
	return out
end

function Sites.boundsStuds(site)
	local half = site.lotM * S / 2
	return V(-half.X, -50, -half.Z), V(half.X, 2000, half.Z)
end

---------------------------------------------------------------------------
-- Preview models (menu ViewportFrames). One proxy per component, decks merged
-- per bay so even the tower previews stay light.
---------------------------------------------------------------------------

local STYLE_GROUND = {
	Rural = Color3.fromRGB(118, 104, 84),
	Suburban = Color3.fromRGB(104, 112, 86),
	Downtown = Color3.fromRGB(96, 96, 98),
	Waterfront = Color3.fromRGB(110, 106, 100),
	Industrial = Color3.fromRGB(102, 98, 92),
	CityCenter = Color3.fromRGB(92, 94, 98),
	Residential = Color3.fromRGB(108, 110, 92),
	HighRise = Color3.fromRGB(96, 98, 100),
}

local function previewPart(model, size, cf, color, transparency, material)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.Transparency = transparency or 0
	p.Parent = model
	return p
end

function Sites.buildPreview(siteId)
	local site = Sites.get(siteId)
	local model = Instance.new("Model")
	model.Name = "Preview_" .. siteId
	local lot = site.lotM * S
	previewPart(model, V(lot.X, 1, lot.Z), CFrame.new(0, -0.5, 0), STYLE_GROUND[site.style] or Color3.fromRGB(110, 104, 92), 0, Enum.Material.Ground)
	previewPart(model, V(lot.X + 60, 0.6, 40), CFrame.new(0, -0.6, -lot.Z / 2 - 20), Color3.fromRGB(52, 54, 58))
	-- fence line
	for _, sgn in ipairs({ -1, 1 }) do
		previewPart(model, V(lot.X, 6, 0.3), CFrame.new(0, 3, sgn * lot.Z / 2), Color3.fromRGB(60, 80, 64), 0.3)
		previewPart(model, V(0.3, 6, lot.Z), CFrame.new(sgn * lot.X / 2, 3, 0), Color3.fromRGB(60, 80, 64), 0.3)
	end
	-- installed starting stage
	local groups = {}
	for _, e in ipairs(Sites.stageEntries(site)) do
		local def = Registry.get(e.item)
		if def then
			if e.group then
				groups[e.group] = groups[e.group] or { cfs = {}, def = def }
				table.insert(groups[e.group].cfs, e.cf)
			else
				local p = Factory.proxy(def, e.cf)
				p.Parent = model
			end
		end
	end
	for _, g in pairs(groups) do
		local n = #g.cfs
		local first, last = g.cfs[1], g.cfs[n]
		local mid = (first.Position + last.Position) / 2
		local width = (last.Position - first.Position).Magnitude + Config.Geo.DeckWidth * S
		previewPart(model, V(g.def.size.X, 0.4, width), CFrame.new(mid + V(0, 0.2, 0)), Config.Colors.Galvanized)
	end
	-- the unbuilt remainder as a faint outline of the finished building
	if site.grid then
		local grid = site.grid
		local O = grid.originM * S
		local w, dpt = grid.nx * grid.bayX * S, grid.nz * grid.bayZ * S
		local h = grid.floors * grid.floorH * S
		local outline = previewPart(model, V(w, h, dpt), CFrame.new(O.X + w / 2, G.FootingTop * S + h / 2, O.Z + dpt / 2), Config.Colors.Info, 0.88)
		outline.Name = "Outline"
	end
	-- crane silhouette
	local c = site.crane
	local base = c.posM * S
	local H = c.heightM * S
	local yellow = Config.Colors.CraneYellow
	previewPart(model, V(6, H, 6), CFrame.new(base.X, H / 2, base.Z), yellow, 0, Enum.Material.Metal)
	local slew = CFrame.new(base.X, H + 3, base.Z) * CFrame.Angles(0, math.rad(c.slewDeg or 0), 0)
	previewPart(model, V(c.jibM * S, 4, 4), slew * CFrame.new(c.jibM * S / 2, 0, 0), yellow, 0, Enum.Material.Metal)
	previewPart(model, V(c.counterM * S, 4, 5), slew * CFrame.new(-c.counterM * S / 2, 0, 0), yellow, 0, Enum.Material.Metal)
	previewPart(model, V(6, 6, 8), slew * CFrame.new(-c.counterM * S + 3, -2, 0), Color3.fromRGB(150, 150, 146), 0, Enum.Material.Concrete)
	-- trailer bays
	for _, b in ipairs(site.bays) do
		previewPart(model, V(Config.Delivery.BedLength * S, 4, 8), b * CFrame.new(0, 2.5, 0), Color3.fromRGB(70, 74, 80))
	end
	-- neighbours by style
	local rng = Random.new(Util.hashString(siteId))
	local neighbourH = {
		Rural = { 0, 0 },
		Suburban = { 20, 45 },
		Downtown = { 90, 220 },
		Waterfront = { 30, 80 },
		Industrial = { 30, 50 },
		CityCenter = { 150, 330 },
		Residential = { 25, 60 },
		HighRise = { 120, 300 },
	}
	local range = neighbourH[site.style] or { 0, 0 }
	if range[2] > 0 then
		for k = 1, 10 do
			local ang = (k / 10) * math.pi * 2
			local r = math.max(lot.X, lot.Z) / 2 + 60 + rng:NextNumber(0, 60)
			local bh = rng:NextNumber(range[1], range[2])
			local pos = V(math.cos(ang) * r, bh / 2, math.sin(ang) * r)
			if pos.Z > -lot.Z / 2 - 30 or site.style ~= "Waterfront" then
				previewPart(model, V(rng:NextNumber(40, 80), bh, rng:NextNumber(40, 80)), CFrame.new(pos), Color3.fromRGB(120, 124, 130), 0.1)
			end
		end
	end
	if site.style == "Waterfront" then
		previewPart(model, V(lot.X + 400, 0.5, 300), CFrame.new(0, -1, lot.Z / 2 + 150), Color3.fromRGB(40, 70, 88), 0.1, Enum.Material.Glass)
	end
	model.PrimaryPart = model:FindFirstChildWhichIsA("BasePart")
	return model
end

return Sites
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000B">
<Properties>
<string name="Name">Util</string>
<ProtectedString name="Source"><![CDATA[-- Small shared helpers.

local Util = {}

function Util.round(x, step)
	step = step or 1
	return math.floor(x / step + 0.5) * step
end

function Util.clamp(x, a, b)
	if x < a then
		return a
	elseif x > b then
		return b
	end
	return x
end

-- Move `current` toward `target` by at most `maxDelta`.
function Util.approach(current, target, maxDelta)
	if current < target then
		return math.min(current + maxDelta, target)
	end
	return math.max(current - maxDelta, target)
end

-- Rate-limited velocity change: accelerate with `accel`, slow down with `brake`.
function Util.rampVelocity(v, target, accel, brake, dt)
	local slowing = (math.abs(target) < math.abs(v)) or (target * v < 0)
	local rate = slowing and brake or accel
	return Util.approach(v, target, rate * dt)
end

function Util.yawOf(cf)
	local look = cf.LookVector
	return math.atan2(-look.X, -look.Z)
end

-- Smallest angle between two rotations (radians).
function Util.angleBetween(a, b)
	local rel = a.Rotation:Inverse() * b.Rotation
	local _, angle = rel:ToAxisAngle()
	return math.abs(angle)
end

function Util.fmtKg(kg)
	if kg >= 1000 then
		return string.format("%.1f t", kg / 1000)
	end
	return string.format("%d kg", math.floor(kg + 0.5))
end

function Util.fmtM(meters)
	return string.format("%.2f m", meters)
end

-- Serialise a CFrame to a plain array for DataStores.
function Util.cfToArray(cf)
	local c = { cf:GetComponents() }
	for i = 1, #c do
		c[i] = math.floor(c[i] * 10000 + 0.5) / 10000
	end
	return c
end

function Util.arrayToCf(a)
	if type(a) ~= "table" or #a ~= 12 then
		return nil
	end
	return CFrame.new(table.unpack(a))
end

function Util.shallowCopy(t)
	local n = {}
	for k, v in pairs(t) do
		n[k] = v
	end
	return n
end

function Util.deepCopy(t)
	if type(t) ~= "table" then
		return t
	end
	local n = {}
	for k, v in pairs(t) do
		n[k] = Util.deepCopy(v)
	end
	return n
end

-- Fill missing keys in `t` from `defaults` (recursively for tables).
function Util.withDefaults(t, defaults)
	local out = type(t) == "table" and Util.deepCopy(t) or {}
	for k, v in pairs(defaults) do
		if out[k] == nil then
			out[k] = Util.deepCopy(v)
		elseif type(v) == "table" and type(out[k]) == "table" then
			out[k] = Util.withDefaults(out[k], v)
		end
	end
	return out
end

-- Deterministic pseudo-random in [0,1) from integers, used for wear/variation
-- so the same component always looks the same on every client.
function Util.hash01(a, b, c)
	local n = ((a or 0) * 73856093 + (b or 0) * 19349663 + (c or 0) * 83492791) % 4294967296
	n = bit32.bxor(n, bit32.rshift(n, 13))
	n = (n * 1274126177) % 4294967296
	n = bit32.bxor(n, bit32.rshift(n, 16))
	return (n % 100000) / 100000
end

function Util.hashString(s)
	local h = 5381
	for i = 1, #s do
		h = (h * 33 + string.byte(s, i)) % 2147483647
	end
	return h
end

return Util
]]></ProtectedString>
</Properties>
</Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX00000017">
<Properties>
<string name="Name">ServerScriptService</string>
</Properties>
<Item class="Folder" referent="RBX00000016">
<Properties>
<string name="Name">Steelrise</string>
</Properties>
<Item class="ModuleScript" referent="RBX0000000E">
<Properties>
<string name="Name">ComponentService</string>
<ProtectedString name="Source"><![CDATA[-- Owns every physical material/component instance on the site and its
-- state machine:
--
--   Restrained -> Loose -> Carried | Rigged -> Placed -> Installed
--                   ^________________________________________|  (dismantle)
--
-- The delivered model IS the installed model: the same Model instance moves
-- through every state, so nothing is duplicated or swapped.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local Factory = require(Shared.ModelFactory)
local BuildRules = require(Shared.BuildRules)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local ComponentService = {}
local Services

local byId = {} -- id -> model
local carrying = {} -- player -> model
local equipped = {} -- player -> toolId
local lastFasten = {} -- player -> time
local changed = Instance.new("BindableEvent")
ComponentService.Changed = changed.Event

local function notify(player, text, kind)
	Remotes.get("Notify"):FireClient(player, text, kind or "info")
end

local function fx(kind, pos, extra)
	Remotes.get("FX"):FireAllClients(kind, pos, extra)
end

function ComponentService.init(services)
	Services = services
	Players.PlayerRemoving:Connect(function(player)
		ComponentService.dropCarried(player, true)
		equipped[player] = nil
		lastFasten[player] = nil
	end)
end

function ComponentService.folder()
	local site = Services.Site.current
	return site and site.folder:FindFirstChild("Components")
end

function ComponentService.world()
	return Services.Site.current and Services.Site.current.world
end

function ComponentService.get(id)
	local m = byId[id]
	if m and m.Parent then
		return m
	end
	byId[id] = nil
	return nil
end

function ComponentService.def(model)
	return Registry.get(model:GetAttribute("ItemId"))
end

function ComponentService.all()
	local out = {}
	for id, m in pairs(byId) do
		if m.Parent then
			table.insert(out, m)
		else
			byId[id] = nil
		end
	end
	return out
end

function ComponentService.clearAll()
	for _, m in pairs(byId) do
		m:Destroy()
	end
	byId = {}
	for player in pairs(carrying) do
		carrying[player] = nil
	end
end

local function markWorldDirty()
	local w = ComponentService.world()
	if w then
		w:markDirty()
	end
end

local function fire(kind, model, player)
	changed:Fire(kind, model, player)
	Remotes.get("Progress"):FireAllClients(kind, {
		id = model and model:GetAttribute("ComponentId"),
		item = model and model:GetAttribute("ItemId"),
		state = model and model:GetAttribute("State"),
		by = player and player.UserId or 0,
	})
end

function ComponentService.setState(model, state)
	model:SetAttribute("State", state)
	markWorldDirty()
end

-- Creates a component model. opts: { id, fastened (mask), supportedBy, restraint, trailer, on }
function ComponentService.spawn(itemId, cf, state, opts)
	opts = opts or {}
	local def = Registry.get(itemId)
	if not def then
		warn("[STEELRISE] unknown item", itemId)
		return nil
	end
	local id = opts.id or HttpService:GenerateGUID(false)
	local tint = (Util.hash01(Util.hashString(id), 3, 7) - 0.5) * 0.09
	local model = Factory.build(def, cf, { tint = tint, installed = state == "Installed" })
	model.Name = def.id
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model:SetAttribute("ComponentId", id)
	model:SetAttribute("ItemId", def.id)
	model:SetAttribute("State", state)
	model:SetAttribute("Holder", "")
	model:SetAttribute("RestraintId", opts.restraint or "")
	model:SetAttribute("TrailerId", opts.trailer or "")
	model:SetAttribute("SupportedBy", opts.supportedBy or "")
	local n = #def.fasteners
	local mask = opts.fastened or string.rep(state == "Installed" and "1" or "0", n)
	model:SetAttribute("Fastened", mask)
	if state == "Placed" or state == "Installed" then
		Factory.addFasteners(model, def, mask)
	end
	if def.functional then
		model:SetAttribute("On", opts.on and true or false)
		ComponentService.applyFunctional(model)
	end
	model.Parent = ComponentService.folder()
	byId[id] = model
	markWorldDirty()
	return model
end

function ComponentService.destroy(model)
	local id = model:GetAttribute("ComponentId")
	byId[id] = nil
	model:Destroy()
	markWorldDirty()
end

function ComponentService.fastenedCount(model)
	local mask = model:GetAttribute("Fastened") or ""
	local _, n = string.gsub(mask, "1", "")
	return n
end

---------------------------------------------------------------------------
-- Tools
---------------------------------------------------------------------------

local function handOf(character)
	return character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
end

function ComponentService.equipped(player)
	return equipped[player] or "TL-HANDS"
end

function ComponentService.equip(player, toolId)
	local def = Registry.get(toolId or "")
	if not def or def.kind ~= "Tool" then
		return false, "Unknown tool."
	end
	equipped[player] = toolId
	local character = player.Character
	if character then
		local old = character:FindFirstChild("SR_Tool")
		if old then
			old:Destroy()
		end
		local hand = handOf(character)
		if hand and toolId ~= "TL-HANDS" then
			local model = Factory.build(def, nil, { preview = true })
			model.Name = "SR_Tool"
			local rootPart = model.PrimaryPart
			local grip = hand.CFrame * CFrame.new(0, -hand.Size.Y / 2 - 0.25, -0.2)
			model:PivotTo(grip)
			for _, p in ipairs(model:GetDescendants()) do
				if p:IsA("BasePart") then
					p.Anchored = false
					p.CanCollide = false
					p.CanQuery = false
					p.CanTouch = false
					p.Massless = true
					if p ~= rootPart then
						local w = Instance.new("WeldConstraint")
						w.Part0 = rootPart
						w.Part1 = p
						w.Parent = p
					end
				end
			end
			local w = Instance.new("WeldConstraint")
			w.Part0 = hand
			w.Part1 = rootPart
			w.Parent = rootPart
			model.Parent = character
		end
	end
	return true
end

---------------------------------------------------------------------------
-- Hand carrying
---------------------------------------------------------------------------

local function setCarryPhysics(model, carried)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			if carried then
				p:SetAttribute("_cc", p.CanCollide)
				p:SetAttribute("_cq", p.CanQuery)
				p.CanCollide = false
				p.CanQuery = false
				p.Massless = true
				p.Anchored = false
			else
				p.Anchored = true
				p.Massless = false
				local cc, cq = p:GetAttribute("_cc"), p:GetAttribute("_cq")
				if cc ~= nil then
					p.CanCollide = cc
				end
				if cq ~= nil then
					p.CanQuery = cq
				end
				p:SetAttribute("_cc", nil)
				p:SetAttribute("_cq", nil)
			end
		end
	end
	local welds = model:FindFirstChild("CarryWelds")
	if welds then
		welds:Destroy()
	end
end

-- Distance from a point to a component's bounding box.
function ComponentService.distanceTo(model, point)
	local def = ComponentService.def(model)
	local cf = model:GetPivot() * CFrame.new(def.boundsOffset)
	local lp = cf:PointToObjectSpace(point)
	local h = def.size / 2
	local clamped = Vector3.new(Util.clamp(lp.X, -h.X, h.X), Util.clamp(lp.Y, -h.Y, h.Y), Util.clamp(lp.Z, -h.Z, h.Z))
	return (lp - clamped).Magnitude
end

local function hrpOf(player)
	local c = player.Character
	return c and c:FindFirstChild("HumanoidRootPart"), c and c:FindFirstChildOfClass("Humanoid")
end

function ComponentService.carried(player)
	local m = carrying[player]
	if m and m.Parent then
		return m
	end
	carrying[player] = nil
	return nil
end

local function trailerBusy(model)
	local tid = model:GetAttribute("TrailerId")
	if tid and tid ~= "" and Services.Delivery.isArriving(tid) then
		return true
	end
	return false
end

function ComponentService.pickUp(player, id)
	local model = ComponentService.get(id)
	if not model then
		return false, "That item no longer exists."
	end
	local def = ComponentService.def(model)
	local hrp, hum = hrpOf(player)
	if not hrp then
		return false, "No character."
	end
	if ComponentService.carried(player) then
		return false, "You're already carrying something — place or drop it first (G)."
	end
	if Services.Crane.isOperating(player) then
		return false, "Leave the crane controls first."
	end
	local state = model:GetAttribute("State")
	if state == "Restrained" then
		return false, "Secured by cargo straps — release the strap first."
	end
	if state ~= "Loose" then
		return false, "Only loose materials can be picked up."
	end
	if trailerBusy(model) then
		return false, "The truck is still pulling in."
	end
	local wc = Config.WeightClasses[def.weightClass]
	if not wc.carry then
		return false, string.format("Too heavy to carry (%s) — use the crane.", Util.fmtKg(def.weightKg))
	end
	if ComponentService.distanceTo(model, hrp.Position) > Config.Reach.Interact then
		return false, "Out of reach — move closer."
	end
	-- nothing stacked on top
	local blocker = ComponentService.stackedOnTop(model)
	if blocker then
		return false, "Take the " .. blocker .. " off the top of the stack first."
	end
	setCarryPhysics(model, true)
	local longest = math.max(def.size.X, def.size.Y, def.size.Z)
	local hold
	if longest > 5 then
		-- shoulder carry, longest axis along the walking direction
		local axis = CFrame.new()
		if longest == def.size.X then
			axis = CFrame.Angles(0, math.pi / 2, 0)
		elseif longest == def.size.Y then
			axis = CFrame.Angles(-math.pi / 2, 0, 0)
		end
		hold = hrp.CFrame * CFrame.new(1.1, 1.6, 0) * axis * CFrame.new(-def.boundsOffset)
	else
		local depth = math.max(def.size.X, def.size.Z) / 2
		hold = hrp.CFrame * CFrame.new(0, 0.2, -(depth + 1.4)) * CFrame.new(-def.boundsOffset)
	end
	model:PivotTo(hold)
	local welds = Instance.new("Folder")
	welds.Name = "CarryWelds"
	welds.Parent = model
	local root = model.PrimaryPart
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and p ~= root then
			local w = Instance.new("WeldConstraint")
			w.Part0 = root
			w.Part1 = p
			w.Parent = welds
		end
	end
	local w = Instance.new("WeldConstraint")
	w.Part0 = hrp
	w.Part1 = root
	w.Parent = welds
	model:SetAttribute("State", "Carried")
	model:SetAttribute("Holder", tostring(player.UserId))
	Services.Delivery.onRemovedFromTrailer(model)
	model:SetAttribute("TrailerId", "")
	carrying[player] = model
	if hum then
		hum.WalkSpeed = wc.walkSpeed
	end
	markWorldDirty()
	fx("Pickup", root.Position, def.id)
	fire("PickedUp", model, player)
	return true
end

-- Returns the name of a loose item resting on top of `model`, if any.
function ComponentService.stackedOnTop(model)
	local def = ComponentService.def(model)
	local cf = model:GetPivot() * CFrame.new(def.boundsOffset)
	-- which local axis points up, and how tall the box is in world space
	local up = cf:VectorToObjectSpace(Vector3.yAxis)
	local halfY = math.abs(up.X) * def.size.X / 2 + math.abs(up.Y) * def.size.Y / 2 + math.abs(up.Z) * def.size.Z / 2
	local ax, ay, az = math.abs(up.X), math.abs(up.Y), math.abs(up.Z)
	local probe = Vector3.new(
		ax >= ay and ax >= az and 0.5 or def.size.X * 0.8,
		ay > ax and ay >= az and 0.5 or def.size.Y * 0.8,
		az > ax and az > ay and 0.5 or def.size.Z * 0.8
	)
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { ComponentService.folder() }
	local box = cf.Rotation + (cf.Position + Vector3.new(0, halfY + 0.35, 0))
	local parts = workspace:GetPartBoundsInBox(box, probe, params)
	for _, p in ipairs(parts) do
		if not p:IsDescendantOf(model) then
			local other = p
			while other and other.Parent ~= ComponentService.folder() do
				other = other.Parent
			end
			if other and other ~= model then
				local st = other:GetAttribute("State")
				if st == "Loose" or st == "Restrained" then
					return Registry.get(other:GetAttribute("ItemId")).name
				end
			end
		end
	end
	return nil
end

-- Lay an item down in its transport pose on whatever is below `point`.
function ComponentService.restingPose(model, point, yaw, excludeModels)
	local def = ComponentService.def(model)
	local w = ComponentService.world()
	local hit = w:raycast(point + Vector3.new(0, 4, 0), Vector3.new(0, -60, 0), excludeModels)
	local groundY = hit and hit.Position.Y or 0
	local R = CFrame.Angles(0, yaw, 0) * def.transport
	local box, offset = Services.Packing.transportBox(def)
	local rotOffset = CFrame.Angles(0, yaw, 0):VectorToWorldSpace(offset)
	local centre = Vector3.new(point.X, groundY + box.Y / 2 + 0.02, point.Z)
	return CFrame.new(centre - rotOffset) * R
end

function ComponentService.dropCarried(player, silent)
	local model = ComponentService.carried(player)
	if not model then
		return false, "Not carrying anything."
	end
	local def = ComponentService.def(model)
	local hrp, hum = hrpOf(player)
	local pos = model:GetPivot().Position
	local yaw = hrp and Util.yawOf(hrp.CFrame) or 0
	setCarryPhysics(model, false)
	local excl = { model }
	if player.Character then
		table.insert(excl, player.Character)
	end
	local base = hrp and (hrp.CFrame * CFrame.new(0, 0, -(math.min(def.size.X, def.size.Z) / 2 + 2))).Position or pos
	model:PivotTo(ComponentService.restingPose(model, base, yaw, excl))
	model:SetAttribute("State", "Loose")
	model:SetAttribute("Holder", "")
	carrying[player] = nil
	if hum then
		hum.WalkSpeed = Config.WalkSpeed
	end
	markWorldDirty()
	if not silent then
		fx("Drop", model.PrimaryPart.Position, def.id)
	end
	fire("Dropped", model, player)
	return true
end

-- Commits a component to a validated pose. `holderInfo` decides the new state.
function ComponentService.commitPlacement(model, cf, info)
	local def = ComponentService.def(model)
	model:PivotTo(cf)
	local ids = {}
	for _, id in ipairs(info.mates or {}) do
		table.insert(ids, id)
	end
	for _, id in ipairs(info.supports or {}) do
		table.insert(ids, id)
	end
	model:SetAttribute("SupportedBy", table.concat(ids, ","))
	local needs = #def.fasteners > 0
	model:SetAttribute("Fastened", string.rep("0", #def.fasteners))
	model:SetAttribute("State", needs and "Placed" or "Installed")
	model:SetAttribute("RestraintId", "")
	model:SetAttribute("TrailerId", "")
	Factory.addFasteners(model, def, model:GetAttribute("Fastened"))
	markWorldDirty()
	if not needs then
		ComponentService.onInstalled(model)
	end
end

function ComponentService.place(player, id, cf, free)
	local model = ComponentService.carried(player)
	if not model or model:GetAttribute("ComponentId") ~= id then
		return false, "You're not carrying that."
	end
	if typeof(cf) ~= "CFrame" then
		return false, "Bad placement."
	end
	local def = ComponentService.def(model)
	if free and not def.allowFree then
		return false, "Free placement isn't available for structural members."
	end
	local hrp, hum = hrpOf(player)
	local excl = { model }
	if player.Character then
		table.insert(excl, player.Character)
	end
	local ok, why, info = BuildRules.validate(ComponentService.world(), def, cf, {
		exclude = { id },
		excludeModels = excl,
		actorPos = hrp and hrp.Position,
		reach = Config.Reach.Place,
	})
	if not ok then
		return false, why
	end
	setCarryPhysics(model, false)
	carrying[player] = nil
	if hum then
		hum.WalkSpeed = Config.WalkSpeed
	end
	model:SetAttribute("Holder", "")
	ComponentService.commitPlacement(model, cf, info)
	fx("Set", cf.Position, def.id)
	fire("Placed", model, player)
	return true
end

---------------------------------------------------------------------------
-- Fastening, installing, dismantling
---------------------------------------------------------------------------

function ComponentService.onInstalled(model)
	local def = ComponentService.def(model)
	model:SetAttribute("State", "Installed")
	-- cut off the column lifting lug once it is bolted down
	local lug = model:FindFirstChild("LiftLug")
	if lug then
		lug:Destroy()
	end
	markWorldDirty()
	fire("Installed", model, nil)
	if Services.Site then
		Services.Site.onComponentInstalled(model, def)
	end
end

function ComponentService.fasten(player, id, index)
	local model = ComponentService.get(id)
	if not model then
		return false, "That component no longer exists."
	end
	local def = ComponentService.def(model)
	if model:GetAttribute("State") ~= "Placed" then
		return false, "Only placed components need fastening."
	end
	local f = def.fasteners[index]
	if not f then
		return false, "No fastener there."
	end
	local mask = model:GetAttribute("Fastened") or ""
	if string.sub(mask, index, index) == "1" then
		return false, "Already tight."
	end
	local tool = Registry.get(ComponentService.equipped(player))
	if not tool or tool.fastens ~= f.type then
		local need = ({ Bolt = "the impact wrench (2)", Wedge = "the scaffold hammer (3)", Weld = "the welder (4)" })[f.type]
		return false, "Wrong tool — this needs " .. (need or f.type) .. "."
	end
	local hrp = hrpOf(player)
	local wp = model:GetPivot() * (f.pos * Config.S)
	if not hrp or (hrp.Position - wp).Magnitude > Config.Reach.Fasten then
		return false, "Out of reach — get closer to the connection (scaffold or deck)."
	end
	local now = os.clock()
	if lastFasten[player] and now - lastFasten[player] < 0.3 then
		return false, nil
	end
	lastFasten[player] = now
	mask = string.sub(mask, 1, index - 1) .. "1" .. string.sub(mask, index + 1)
	model:SetAttribute("Fastened", mask)
	Factory.setFastenerVisible(model, index, true)
	fx(f.type, wp, def.id)
	if not string.find(mask, "0", 1, true) then
		ComponentService.onInstalled(model)
		Services.Crane.onComponentInstalled(model)
	end
	fire("Fastened", model, player)
	return true
end

function ComponentService.dismantle(player, id)
	local model = ComponentService.get(id)
	if not model then
		return false, "That component no longer exists."
	end
	local def = ComponentService.def(model)
	local state = model:GetAttribute("State")
	if state ~= "Installed" and state ~= "Placed" then
		return false, "Nothing to dismantle."
	end
	if Services.Crane.holds(model) then
		return false, "The crane is still holding it — unhook first."
	end
	local hrp = hrpOf(player)
	if not hrp or ComponentService.distanceTo(model, hrp.Position) > Config.Reach.Interact then
		return false, "Out of reach."
	end
	if #def.fasteners > 0 then
		local tool = Registry.get(ComponentService.equipped(player))
		if not tool or tool.fastens ~= def.fasteners[1].type then
			local need = ({ Bolt = "impact wrench (2)", Wedge = "scaffold hammer (3)", Weld = "welder (4)" })[def.fasteners[1].type]
			return false, "Equip the " .. (need or "right tool") .. " to undo its connections."
		end
	end
	local deps = BuildRules.dependents(ComponentService.world(), model:GetAttribute("ComponentId"))
	if #deps > 0 then
		return false, "Remove what it supports first: " .. Registry.get(deps[1]:GetAttribute("ItemId")).name .. "."
	end
	model:SetAttribute("State", "Loose")
	model:SetAttribute("SupportedBy", "")
	model:SetAttribute("Fastened", string.rep("0", #def.fasteners))
	local folder = model:FindFirstChild("Fasteners")
	if folder then
		folder:Destroy()
	end
	markWorldDirty()
	fx("Dismantle", model:GetPivot().Position, def.id)
	fire("Dismantled", model, player)
	Services.Site.onComponentRemoved(model)
	return true
end

---------------------------------------------------------------------------
-- Functional equipment (lights, engines)
---------------------------------------------------------------------------

function ComponentService.applyFunctional(model)
	local on = model:GetAttribute("On") == true
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("Light") then
			d.Enabled = on
		elseif d:IsA("BasePart") and d:GetAttribute("Lens") then
			d.Material = on and Enum.Material.Neon or Enum.Material.Glass
		end
	end
end

function ComponentService.toggle(player, id)
	local model = ComponentService.get(id)
	if not model then
		return false, "Gone."
	end
	local def = ComponentService.def(model)
	if not def.functional then
		return false, "Nothing to switch on."
	end
	local st = model:GetAttribute("State")
	if st ~= "Installed" and st ~= "Loose" then
		return false, "Set it down first."
	end
	local hrp = hrpOf(player)
	if not hrp or ComponentService.distanceTo(model, hrp.Position) > Config.Reach.Interact then
		return false, "Out of reach."
	end
	model:SetAttribute("On", not model:GetAttribute("On"))
	ComponentService.applyFunctional(model)
	fx("Toggle", model:GetPivot().Position, model:GetAttribute("On"))
	return true
end

---------------------------------------------------------------------------
-- Remote handlers
---------------------------------------------------------------------------

function ComponentService.handle(player, action, a, b, c)
	if not Services.Site.current then
		return false, "No site loaded."
	end
	if action == "PickUp" then
		return ComponentService.pickUp(player, a)
	elseif action == "Drop" then
		return ComponentService.dropCarried(player)
	elseif action == "Place" then
		return ComponentService.place(player, a, b, c == true)
	elseif action == "Release" then
		return Services.Delivery.releaseStrap(player, a)
	elseif action == "Toggle" then
		return ComponentService.toggle(player, a)
	end
	return false, "Unknown action."
end

function ComponentService.build(player, action, a, b)
	if action == "Equip" then
		return ComponentService.equip(player, a)
	end
	if not Services.Site.current then
		return false, "No site loaded."
	end
	if action == "Fasten" then
		return ComponentService.fasten(player, a, tonumber(b) or 0)
	elseif action == "Dismantle" then
		return ComponentService.dismantle(player, a)
	end
	return false, "Unknown action."
end

return ComponentService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000F">
<Properties>
<string name="Name">CraneService</string>
<ProtectedString name="Source"><![CDATA[-- Server authority for tower cranes.
--
-- The operator's client simulates the crane at frame rate (smooth controls,
-- sway, collision stops) and streams its state ~15 Hz. The server clamps every
-- update to the crane's speed limits, travel limits and load chart, publishes
-- it as attributes for everyone else, and validates every attach, landing and
-- release against its own copy of the state.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local CraneMath = require(Shared.CraneMath)
local BuildRules = require(Shared.BuildRules)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local CraneService = {}
local Services
local cranes = {} -- id -> rec

local K = Config.Crane

local function notify(player, text, kind)
	Remotes.get("Notify"):FireClient(player, text, kind or "info")
end

local function fx(kind, pos, extra)
	Remotes.get("FX"):FireAllClients(kind, pos, extra)
end

local function now()
	return workspace:GetServerTimeNow()
end

function CraneService.register(id, model, cfg)
	local rec = {
		id = id,
		model = model,
		cfg = cfg,
		st = CraneMath.defaultState(cfg.def),
		operator = nil,
		mode = nil,
		lastStream = os.clock(),
	}
	cranes[id] = rec
	CraneMath.writeAttributes(model, rec.st)
	model:SetAttribute("Locked", false)
	return rec
end

function CraneService.clearAll()
	for _, rec in pairs(cranes) do
		if rec.operator then
			CraneService.exit(rec.operator)
		end
	end
	cranes = {}
end

function CraneService.get(id)
	return cranes[id]
end

function CraneService.first()
	for _, rec in pairs(cranes) do
		return rec
	end
	return nil
end

local function recOf(player)
	for _, rec in pairs(cranes) do
		if rec.operator == player then
			return rec
		end
	end
	return nil
end

function CraneService.isOperating(player)
	return recOf(player) ~= nil
end

function CraneService.holds(model)
	local id = model:GetAttribute("ComponentId")
	for _, rec in pairs(cranes) do
		if rec.loadId == id then
			return true
		end
	end
	return false
end

local function loadModel(rec)
	return rec.loadId and Services.Components.get(rec.loadId)
end

local function loadKg(rec)
	local m = loadModel(rec)
	if not m then
		return 0
	end
	return Services.Components.def(m).weightKg + K.RiggingKg
end

local function publish(rec)
	CraneMath.writeAttributes(rec.model, rec.st)
end

local function setOperator(rec, player, mode)
	rec.operator = player
	rec.mode = mode
	rec.model:SetAttribute("Operator", player and player.UserId or 0)
	rec.model:SetAttribute("Mode", mode or "")
	rec.lastStream = os.clock()
end

---------------------------------------------------------------------------
-- Operator entry / exit
---------------------------------------------------------------------------

local function nearAccess(rec, hrp)
	local static = rec.model:FindFirstChild("Static")
	if not static then
		return false
	end
	for _, name in ipairs({ "CraneAccess", "CraneAccessTop" }) do
		local p = static:FindFirstChild(name)
		if p and (p.Position - hrp.Position).Magnitude <= Config.Reach.CraneCab + p.Size.Magnitude / 2 then
			return true
		end
	end
	return false
end

function CraneService.enter(player, id, mode)
	local rec = cranes[id] or CraneService.first()
	if not rec then
		return false, "No crane on this site."
	end
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false, "No character."
	end
	if Services.Components.carried(player) then
		return false, "Put down what you're carrying first."
	end
	if rec.operator and rec.operator ~= player and rec.operator.Parent then
		return false, rec.operator.DisplayName .. " is operating this crane."
	end
	if mode == "Remote" then
		if Services.Components.equipped(player) ~= "TL-REMOTE" then
			return false, "Equip the crane radio remote (5)."
		end
		local d = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(rec.cfg.base.X, 0, rec.cfg.base.Z)).Magnitude
		if d > K.RemoteRange then
			return false, "Out of radio range."
		end
	else
		if not nearAccess(rec, hrp) and rec.operator ~= player then
			return false, "Go to the crane access gate at the mast base (or climb to the top)."
		end
		hrp.Anchored = true
	end
	setOperator(rec, player, mode)
	Remotes.get("Progress"):FireAllClients("CraneEntered", { by = player.UserId, mode = mode })
	return true, nil, { craneId = rec.id, mode = mode }
end

function CraneService.exit(player)
	local rec = recOf(player)
	if not rec then
		return false, "Not operating a crane."
	end
	local mode = rec.mode
	setOperator(rec, nil, nil)
	if mode == "Cab" then
		local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if hrp then
			local base = rec.cfg.base
			hrp.CFrame = CFrame.new(base + Vector3.new(0, 3.5, -(CraneMath.MastWidth / 2 + 5)))
			hrp.Anchored = false
		end
	end
	return true
end

---------------------------------------------------------------------------
-- State stream
---------------------------------------------------------------------------

local function limit(old, new, rate, dt)
	local m = rate * dt * 1.6 + 0.05
	return old + Util.clamp(new - old, -m, m)
end

function CraneService.onStream(player, id, data)
	local rec = cranes[id]
	if not rec or rec.operator ~= player or type(data) ~= "table" then
		return
	end
	for _, k in ipairs(CraneMath.Keys) do
		if type(data[k]) ~= "number" or data[k] ~= data[k] then
			return
		end
	end
	if (data.seq or 0) < (rec.model:GetAttribute("ResetSeq") or 0) then
		return -- stale stream from before a recovery reset
	end
	local t = os.clock()
	local dt = Util.clamp(t - rec.lastStream, 0.01, 0.5)
	rec.lastStream = t
	local old = rec.st
	local st = {}
	if rec.locked then
		st.slew, st.trolley, st.loadYaw = old.slew, old.trolley, old.loadYaw
		-- allow only slacking off the hoist a little while the crane holds a set piece
		st.hoist = Util.clamp(data.hoist, old.hoist - 0.05, old.hoist + 1.0)
		st.swingX, st.swingZ = 0, 0
	else
		local dSlew = ((data.slew - old.slew + math.pi) % (2 * math.pi)) - math.pi
		st.slew = old.slew + Util.clamp(dSlew, -(K.SlewMaxSpeed * dt * 1.6 + 0.01), K.SlewMaxSpeed * dt * 1.6 + 0.01)
		st.trolley = limit(old.trolley, data.trolley, K.TrolleyMaxSpeed, dt)
		st.hoist = limit(old.hoist, data.hoist, K.HoistMaxSpeed, dt)
		st.loadYaw = limit(old.loadYaw, data.loadYaw, K.LoadRotateSpeed, dt)
		st.swingX, st.swingZ = data.swingX, data.swingZ
		local kg = loadKg(rec)
		if kg > 0 then
			local maxR = CraneMath.maxRadiusFor(rec.cfg, kg)
			if st.trolley > maxR and st.trolley > old.trolley then
				st.trolley = math.max(old.trolley, maxR)
			end
		end
	end
	rec.st = CraneMath.sanitize(rec.cfg, st)
	publish(rec)
end

---------------------------------------------------------------------------
-- Rigging
---------------------------------------------------------------------------

local function unrig(rec)
	local m = loadModel(rec)
	if m then
		m.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
		m:SetAttribute("Holder", "")
	end
	rec.loadId = nil
	rec.rigOffset = nil
	rec.locked = false
	rec.model:SetAttribute("LoadId", "")
	rec.model:SetAttribute("Locked", false)
end

function CraneService.attach(player, componentId)
	local rec = recOf(player)
	if not rec then
		return false, "You're not at the crane controls."
	end
	if rec.loadId then
		return false, "Something is already on the hook."
	end
	local model = Services.Components.get(componentId)
	if not model then
		return false, "Nothing to hook."
	end
	local def = Services.Components.def(model)
	local state = model:GetAttribute("State")
	if state == "Restrained" then
		return false, "Release the cargo straps on that stack first."
	end
	if state ~= "Loose" then
		return false, "Only loose materials can be rigged."
	end
	local tid = model:GetAttribute("TrailerId")
	if tid ~= "" and Services.Delivery.isArriving(tid) then
		return false, "Wait for the truck to stop."
	end
	local hook = CraneMath.hookPos(rec.cfg, rec.st)
	local liftWorld = model:GetPivot() * CraneMath.liftCentre(def)
	local target = liftWorld + Vector3.new(0, K.SlingDrop, 0)
	local spread = 0
	for _, p in ipairs(def.liftPointsS) do
		spread = math.max(spread, (p - CraneMath.liftCentre(def)).Magnitude)
	end
	if (hook - target).Magnitude > K.AttachRange + 1.5 + spread * 0.25 then
		return false, "Bring the hook over the rigging points first."
	end
	local kg = def.weightKg + K.RiggingKg
	local cap = CraneMath.capacityKg(rec.cfg, rec.st.trolley)
	if kg > cap then
		return false, string.format("Over the load chart: %s at this radius, capacity %s. Trolley in closer.", Util.fmtKg(kg), Util.fmtKg(cap))
	end
	local blocker = Services.Components.stackedOnTop(model)
	if blocker then
		return false, "Take the " .. blocker .. " off the top of the stack first."
	end
	local hookCf = CraneMath.hookCf(rec.cfg, rec.st)
	rec.rigOffset = CraneMath.rigOffset(def, model:GetPivot(), hookCf)
	rec.st.loadYaw = 0
	rec.loadId = componentId
	rec.rigTime = now()
	rec.locked = false
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	model:SetAttribute("RestraintId", "")
	Services.Delivery.onRemovedFromTrailer(model)
	Services.Components.setState(model, "Rigged")
	model:SetAttribute("Holder", "crane:" .. rec.id)
	rec.model:SetAttribute("RigOffset", rec.rigOffset)
	rec.model:SetAttribute("RigStart", model:GetPivot())
	rec.model:SetAttribute("RigTime", rec.rigTime)
	rec.model:SetAttribute("Locked", false)
	rec.model:SetAttribute("LoadId", componentId)
	publish(rec)
	fx("Rig", liftWorld, nil)
	Remotes.get("Progress"):FireAllClients("Rigged", { id = componentId, item = def.id, by = player.UserId })
	return true
end

function CraneService.currentLoadCf(rec)
	if not rec.loadId or not rec.rigOffset then
		return nil
	end
	return CraneMath.loadCf(rec.cfg, rec.st, rec.rigOffset)
end

function CraneService.land(player, target)
	local rec = recOf(player)
	if not rec then
		return false, "You're not at the crane controls."
	end
	if typeof(target) ~= "CFrame" then
		return false, "Bad target."
	end
	local model = loadModel(rec)
	if not model or rec.locked then
		return false, "No hanging load to land."
	end
	if now() - (rec.rigTime or 0) < 1.4 then
		return false, "Let the load settle on the slings first."
	end
	local def = Services.Components.def(model)
	local loadCf = CraneService.currentLoadCf(rec)
	local dPos = (target.Position - loadCf.Position).Magnitude
	local ang = BuildRules.angleDiff(def, target, loadCf)
	if dPos > K.LandPosTolerance then
		return false, string.format("Still %.1f m from the connection — bring it closer.", Config.toMeters(dPos))
	end
	if ang > K.LandAngleTolerance then
		return false, string.format("Rotate the load to line up (%d° off).", math.floor(math.deg(ang) + 0.5))
	end
	local ok, why, info = BuildRules.validate(Services.Components.world(), def, target, {
		exclude = { rec.loadId },
		excludeModels = { model },
	})
	if not ok then
		return false, why
	end
	Services.Components.commitPlacement(model, target, info)
	rec.locked = true
	rec.st.swingX, rec.st.swingZ = 0, 0
	rec.model:SetAttribute("Locked", true)
	publish(rec)
	fx("Set", target.Position, def.id)
	Remotes.get("Progress"):FireAllClients("Landed", { id = rec.loadId, item = def.id, by = player.UserId })
	local need = def.minFastenRelease
	if need > 0 then
		notify(player, string.format("Landed. Fasten at least %d connection%s, then unhook (G).", need, need > 1 and "s" or ""), "info")
	end
	return true
end

-- Lowest point of a load box in world space.
local function bottomY(def, cf)
	local box = cf * CFrame.new(def.boundsOffset)
	local h = def.size / 2
	local low = math.huge
	for _, sx in ipairs({ -1, 1 }) do
		for _, sy in ipairs({ -1, 1 }) do
			for _, sz in ipairs({ -1, 1 }) do
				low = math.min(low, (box * Vector3.new(sx * h.X, sy * h.Y, sz * h.Z)).Y)
			end
		end
	end
	return low
end

function CraneService.release(player)
	local rec = recOf(player)
	if not rec then
		return false, "You're not at the crane controls."
	end
	local model = loadModel(rec)
	if not model then
		unrig(rec)
		return false, "Nothing on the hook."
	end
	local def = Services.Components.def(model)
	if rec.locked then
		local state = model:GetAttribute("State")
		local done = Services.Components.fastenedCount(model)
		if state == "Placed" and done < def.minFastenRelease then
			return false, string.format("Fasten at least %d connection%s before unhooking (%d done).", def.minFastenRelease, def.minFastenRelease > 1 and "s" or "", done)
		end
		unrig(rec)
		fx("Unhook", model:GetPivot().Position, nil)
		Remotes.get("Progress"):FireAllClients("Unhooked", { id = model:GetAttribute("ComponentId"), item = def.id, by = player.UserId })
		return true, "Rigging released."
	end
	local loadCf = CraneService.currentLoadCf(rec)
	local w = Services.Components.world()
	local hit = w:raycast(loadCf.Position + Vector3.new(0, 2, 0), Vector3.new(0, -200, 0), { model })
	local groundY = hit and hit.Position.Y or 0
	if bottomY(def, loadCf) - groundY > 1.6 then
		return false, "Lower it until it sits on the ground or a deck before unhooking."
	end
	local pose = Services.Components.restingPose(model, loadCf.Position, Util.yawOf(CFrame.Angles(0, rec.st.slew + rec.st.loadYaw, 0)), { model })
	model:PivotTo(pose)
	Services.Components.setState(model, "Loose")
	unrig(rec)
	fx("Drop", pose.Position, def.id)
	Remotes.get("Progress"):FireAllClients("Unhooked", { id = model:GetAttribute("ComponentId"), item = def.id, by = player.UserId })
	return true, "Load set down."
end

-- Finds a free resting pose for `model` in the laydown yard.
function CraneService.recoveryPose(model)
	local site = Services.Site.current
	local def = Services.Components.def(model)
	local ld = site.def.laydownM
	local c = ld.center * Config.S
	local size = ld.size * Config.S
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { site.folder.Components, site.folder.Environment }
	params.RespectCanCollide = true
	local step = 3
	for gz = -size.Z / 2 + 2, size.Z / 2 - 2, step do
		for gx = -size.X / 2 + 2, size.X / 2 - 2, step do
			local p = c + Vector3.new(gx, 0, gz)
			local pose = Services.Components.restingPose(model, p, 0, { model })
			local box, offset = Services.Packing.transportBox(def)
			local parts = workspace:GetPartBoundsInBox(CFrame.new(pose.Position + offset), box - Vector3.new(0.2, 0.2, 0.2), params)
			local clear = true
			for _, part in ipairs(parts) do
				if not part:IsDescendantOf(model) and part.Name ~= "Dunnage" then
					clear = false
					break
				end
			end
			if clear then
				return pose
			end
		end
	end
	return Services.Components.restingPose(model, c, 0, { model })
end

function CraneService.recover(player)
	local rec = recOf(player) or CraneService.first()
	if not rec then
		return false, "No crane."
	end
	local isHost = Services.Site.current and Services.Site.current.host == player
	if rec.operator and rec.operator ~= player and not isHost then
		return false, "Only the operator or the site host can recover the load."
	end
	local model = loadModel(rec)
	local msg = "Hook recovered."
	if model then
		local state = model:GetAttribute("State")
		if state ~= "Installed" then
			local def = Services.Components.def(model)
			model:PivotTo(CraneService.recoveryPose(model))
			model:SetAttribute("Fastened", string.rep("0", #def.fasteners))
			model:SetAttribute("SupportedBy", "")
			local f = model:FindFirstChild("Fasteners")
			if f then
				f:Destroy()
			end
			Services.Components.setState(model, "Loose")
			msg = def.name .. " returned to the laydown yard."
		end
		unrig(rec)
	end
	rec.st.hoist = math.min(rec.st.hoist, 24)
	rec.st.swingX, rec.st.swingZ, rec.st.loadYaw = 0, 0, 0
	rec.model:SetAttribute("ResetSeq", (rec.model:GetAttribute("ResetSeq") or 0) + 1)
	publish(rec)
	return true, msg
end

function CraneService.onComponentInstalled(model)
	for _, rec in pairs(cranes) do
		if rec.loadId == model:GetAttribute("ComponentId") and rec.operator then
			notify(rec.operator, "All connections made — unhook with G.", "success")
		end
	end
end

---------------------------------------------------------------------------
-- Remote handler and housekeeping
---------------------------------------------------------------------------

function CraneService.handle(player, action, a)
	if not Services.Site.current then
		return false, "No site loaded."
	end
	if action == "Enter" then
		return CraneService.enter(player, a, "Cab")
	elseif action == "Remote" then
		return CraneService.enter(player, a, "Remote")
	elseif action == "Exit" then
		return CraneService.exit(player)
	elseif action == "Attach" then
		return CraneService.attach(player, a)
	elseif action == "Release" then
		return CraneService.release(player)
	elseif action == "Land" then
		return CraneService.land(player, a)
	elseif action == "Recover" then
		return CraneService.recover(player)
	end
	return false, "Unknown action."
end

function CraneService.serialize()
	local out = {}
	for id, rec in pairs(cranes) do
		out[id] = { slew = rec.st.slew, trolley = rec.st.trolley, hoist = rec.st.hoist }
	end
	return out
end

function CraneService.restore(data)
	for id, s in pairs(data or {}) do
		local rec = cranes[id]
		if rec and type(s) == "table" then
			rec.st.slew = tonumber(s.slew) or rec.st.slew
			rec.st.trolley = tonumber(s.trolley) or rec.st.trolley
			rec.st.hoist = tonumber(s.hoist) or rec.st.hoist
			CraneMath.sanitize(rec.cfg, rec.st)
			publish(rec)
		end
	end
end

function CraneService.init(services)
	Services = services
	Remotes.get("CraneStream").OnServerEvent:Connect(CraneService.onStream)
	local function release(player)
		local rec = recOf(player)
		if rec then
			setOperator(rec, nil, nil)
		end
	end
	Players.PlayerRemoving:Connect(release)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterRemoving:Connect(function()
			release(player)
		end)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		player.CharacterRemoving:Connect(function()
			release(player)
		end)
	end
	-- keep cab operators seated in the slewing cab
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.2 then
			return
		end
		acc = 0
		for _, rec in pairs(cranes) do
			if rec.operator and rec.mode == "Cab" then
				local hrp = rec.operator.Character and rec.operator.Character:FindFirstChild("HumanoidRootPart")
				if hrp then
					local cab = CraneMath.slewCf(rec.cfg, rec.st.slew) * CFrame.new(CraneMath.CabOffset) * CFrame.new(0.2, -0.6, 0) * CFrame.Angles(0, -math.pi / 2, 0)
					hrp.Anchored = true
					hrp.CFrame = cab
				end
			end
		end
	end)
end

return CraneService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000010">
<Properties>
<string name="Name">DeliveryService</string>
<ProtectedString name="Source"><![CDATA[-- Flatbed deliveries: trucks pull into unloading bays with every ordered
-- piece physically on the deck, stacked on dunnage and held by ratchet
-- straps. Pieces leave visible gaps as they are unloaded; an empty truck can
-- be dismissed to free the bay.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local WorldFactory = require(script.Parent.WorldFactory)
local Packing = require(script.Parent.Packing)

local S = Config.S
local D = Config.Delivery

local DeliveryService = {}
local Services
local trailers = {} -- id -> record

local function now()
	return workspace:GetServerTimeNow()
end

local function fx(kind, pos, extra)
	Remotes.get("FX"):FireAllClients(kind, pos, extra)
end

function DeliveryService.init(services)
	Services = services
	task.spawn(function()
		while true do
			task.wait(5)
			for id, t in pairs(trailers) do
				if t.model and t.model.Parent and t.emptySince and not t.departing and now() - t.emptySince > 120 then
					DeliveryService.depart(id)
				end
			end
		end
	end)
end

function DeliveryService.folder()
	return Services.Site.current and Services.Site.current.folder:FindFirstChild("Trailers")
end

function DeliveryService.clearAll()
	for _, t in pairs(trailers) do
		if t.model then
			t.model:Destroy()
		end
	end
	trailers = {}
end

local function bedFrame(t)
	return t.bayCf * CFrame.new(0, t.bedTop, 0)
end

function DeliveryService.isArriving(id)
	local t = trailers[id]
	if not t then
		return false
	end
	return now() < (t.model:GetAttribute("ArriveAt") or 0) + D.ArriveSeconds
end

local function cargoOf(id)
	local out = {}
	for _, m in ipairs(Services.Components.all()) do
		if m:GetAttribute("TrailerId") == id then
			table.insert(out, m)
		end
	end
	return out
end

local function updateManifest(t)
	local counts, order = {}, {}
	for _, m in ipairs(cargoOf(t.id)) do
		local item = m:GetAttribute("ItemId")
		if not counts[item] then
			counts[item] = 0
			table.insert(order, item)
		end
		counts[item] += 1
	end
	local list = {}
	for _, item in ipairs(order) do
		local def = Registry.get(item)
		table.insert(list, { id = item, name = def and def.name or item, qty = counts[item] })
	end
	t.model:SetAttribute("Manifest", HttpService:JSONEncode(list))
	t.model:SetAttribute("Remaining", #cargoOf(t.id))
	if #list == 0 then
		t.model:SetAttribute("Empty", true)
		t.emptySince = t.emptySince or now()
	else
		t.model:SetAttribute("Empty", false)
		t.emptySince = nil
	end
end

local function buildStrap(t, s, strapId)
	local bed = bedFrame(t)
	local model = Instance.new("Model")
	model.Name = "Strap"
	model:SetAttribute("StrapId", strapId)
	model:SetAttribute("Group", s.group)
	model:SetAttribute("TrailerId", t.id)
	local W = math.max(s.width, D.BedWidth * S * 0.5)
	local function part(name, size, cf)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = bed * cf
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CastShadow = false
		p.Color = Config.Colors.StrapOrange
		p.Material = Enum.Material.Fabric
		p.Parent = model
		return p
	end
	local bedHalf = D.BedWidth * S / 2
	part("Band", Vector3.new(0.16, 0.06, W + 0.12), CFrame.new(s.x, s.top + 0.04, 0))
	for _, sz in ipairs({ -1, 1 }) do
		local zEdge = sz * (W / 2 + 0.05)
		local a = Vector3.new(s.x, s.top + 0.04, zEdge)
		local b = Vector3.new(s.x, -0.35, sz * (bedHalf + 0.06))
		local len = (b - a).Magnitude
		part("Leg", Vector3.new(0.16, len, 0.06), CFrame.new((a + b) / 2) * CFrame.Angles(math.atan2(a.Z - b.Z, a.Y - b.Y), 0, 0))
	end
	local ratchet = part("Ratchet", Vector3.new(0.3, 0.45, 0.2), CFrame.new(s.x, s.top * 0.45, bedHalf + 0.12))
	ratchet.Color = Color3.fromRGB(150, 152, 156)
	ratchet.Material = Enum.Material.Metal
	local hit = part("StrapHit", Vector3.new(1.2, s.top + 0.6, W + 0.8), CFrame.new(s.x, s.top / 2, 0))
	hit.Transparency = 1
	hit:SetAttribute("StrapHit", true)
	model.PrimaryPart = hit
	model.Parent = t.model:FindFirstChild("Straps")
	return model
end

local function buildLoadExtras(t, extras)
	local bed = bedFrame(t)
	local load = Instance.new("Folder")
	load.Name = "Dunnage"
	load.Parent = t.model
	t.dunnage = extras.dunnage
	for _, d in ipairs(extras.dunnage) do
		local p = Instance.new("Part")
		p.Name = "Dunnage"
		p.Size = d.size
		p.CFrame = bed * d.cf
		p.Anchored = true
		p.CanTouch = false
		p.Color = Config.Colors.Timber
		p.Material = Enum.Material.Wood
		p.Parent = load
	end
	local straps = Instance.new("Folder")
	straps.Name = "Straps"
	straps.Parent = t.model
	t.straps = {}
	for i, s in ipairs(extras.straps) do
		local strapId = s.id or (t.id .. ":S" .. i)
		if not s.released then
			buildStrap(t, s, strapId)
		end
		table.insert(t.straps, { id = strapId, x = s.x, top = s.top, width = s.width, group = s.group, released = s.released or false })
	end
end

function DeliveryService.freeBay()
	local site = Services.Site.current
	if not site then
		return nil
	end
	local used = {}
	for _, t in pairs(trailers) do
		used[t.bay] = true
	end
	for i = 1, math.min(#site.def.bays, D.MaxTrailers) do
		if not used[i] then
			return i
		end
	end
	return nil
end

-- Creates a trailer in bay `bayIndex`. `placed` from Packing (bed-local
-- CFrames) spawns new restrained cargo; pass nil when restoring a save
-- (cargo is restored separately with its saved state).
function DeliveryService.spawnTrailer(bayIndex, placed, extras, opts)
	opts = opts or {}
	local site = Services.Site.current
	local id = opts.id or ("T" .. string.sub(HttpService:GenerateGUID(false), 1, 8))
	local bayCf = site.def.bays[bayIndex]
	local seed = opts.seed or math.random(1, 1e6)
	local model, bedTop = WorldFactory.buildTrailer(bayCf, seed)
	model.Name = "Trailer_" .. id
	model.ModelStreamingMode = Enum.ModelStreamingMode.Atomic
	model:SetAttribute("TrailerId", id)
	model:SetAttribute("Bay", bayIndex)
	model:SetAttribute("ArriveAt", opts.instant and 0 or now())
	model:SetAttribute("DepartAt", 0)
	local t = { id = id, bay = bayIndex, bayCf = bayCf, bedTop = bedTop, model = model, seed = seed }
	trailers[id] = t
	buildLoadExtras(t, extras)
	model.Parent = DeliveryService.folder()
	if placed then
		local bed = bedFrame(t)
		for _, p in ipairs(placed) do
			Services.Components.spawn(p.id, bed * p.cf, "Restrained", { restraint = id .. ":" .. p.group, trailer = id })
		end
	end
	-- straps: group ids need the trailer prefix
	for _, s in ipairs(t.straps) do
		if not string.find(s.group, ":", 1, true) then
			s.group = id .. ":" .. s.group
		end
	end
	for _, strap in ipairs(model.Straps:GetChildren()) do
		local g = strap:GetAttribute("Group")
		if g and not string.find(g, ":", 1, true) then
			strap:SetAttribute("Group", id .. ":" .. g)
		end
	end
	updateManifest(t)
	return t
end

function DeliveryService.request(player, itemId, qty)
	local site = Services.Site.current
	if not site then
		return false, "No site loaded."
	end
	local def = Registry.get(itemId or "")
	if not def or not def.deliverable then
		return false, "That item can't be delivered."
	end
	local maxQty = def.weightClass == "Light" and 40 or (def.weightClass == "Medium" and 16 or 10)
	qty = math.clamp(math.floor(tonumber(qty) or 1), 1, maxQty)
	local loose = 0
	for _, m in ipairs(Services.Components.all()) do
		local st = m:GetAttribute("State")
		if st == "Loose" or st == "Restrained" then
			loose += 1
		end
	end
	if loose + qty > D.MaxLooseComponents then
		return false, string.format("Too much loose material on site (%d). Install or stack what you have first.", loose)
	end
	local remaining = { { id = itemId, qty = qty } }
	local delivered = 0
	local trucks = 0
	while #remaining > 0 do
		local bay = DeliveryService.freeBay()
		if not bay then
			break
		end
		local placed, extras, leftovers = Packing.pack(remaining, D.BedLength * S, D.BedWidth * S, D.MaxStackHeight * S, { maxKg = D.TrailerMaxKg })
		if #placed == 0 then
			if delivered == 0 then
				return false, "That load won't fit on a flatbed."
			end
			break
		end
		DeliveryService.spawnTrailer(bay, placed, extras, {})
		delivered += #placed
		trucks += 1
		remaining = leftovers
	end
	if delivered == 0 then
		return false, "All unloading bays are occupied — unload and dismiss a truck first."
	end
	local msg = string.format("%d × %s on %d truck%s — arriving now.", delivered, def.name, trucks, trucks > 1 and "s" or "")
	if delivered < qty then
		msg ..= string.format(" %d didn't fit: free a bay and order again.", qty - delivered)
	end
	fx("TruckArrive", site.def.bays[1].Position, nil)
	return true, msg
end

-- Starter loads for a fresh site (instant, no drive-in).
function DeliveryService.spawnLoaded(bayIndex, requests)
	local placed, extras = Packing.pack(requests, D.BedLength * S, D.BedWidth * S, D.MaxStackHeight * S, { maxKg = D.TrailerMaxKg })
	return DeliveryService.spawnTrailer(bayIndex, placed, extras, { instant = true })
end

local function findStrap(strapId)
	for _, t in pairs(trailers) do
		local folder = t.model:FindFirstChild("Straps")
		if folder then
			for _, s in ipairs(folder:GetChildren()) do
				if s:GetAttribute("StrapId") == strapId then
					return t, s
				end
			end
		end
	end
	return nil
end

function DeliveryService.releaseStrap(player, strapId)
	local t, strap = findStrap(strapId)
	if not t then
		return false, "Strap already released."
	end
	if DeliveryService.isArriving(t.id) then
		return false, "Wait for the truck to stop."
	end
	local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local hit = strap.PrimaryPart
	if not hrp or not hit then
		return false, "No character."
	end
	local lp = hit.CFrame:PointToObjectSpace(hrp.Position)
	local h = hit.Size / 2
	local d = (lp - Vector3.new(math.clamp(lp.X, -h.X, h.X), math.clamp(lp.Y, -h.Y, h.Y), math.clamp(lp.Z, -h.Z, h.Z))).Magnitude
	if d > Config.Reach.Interact then
		return false, "Out of reach — walk up to the trailer."
	end
	local group = strap:GetAttribute("Group")
	for _, s in ipairs(t.straps) do
		if s.id == strapId then
			s.released = true
		end
	end
	local pos = hit.Position
	strap:Destroy()
	fx("Strap", pos, nil)
	-- group free once all of its straps are off
	local held = false
	for _, s in ipairs(t.straps) do
		if s.group == group and not s.released then
			held = true
		end
	end
	if not held then
		for _, m in ipairs(cargoOf(t.id)) do
			if m:GetAttribute("RestraintId") == group then
				m:SetAttribute("RestraintId", "")
				if m:GetAttribute("State") == "Restrained" then
					Services.Components.setState(m, "Loose")
				end
			end
		end
	end
	Remotes.get("Progress"):FireAllClients("StrapReleased", { by = player.UserId })
	return true
end

function DeliveryService.onRemovedFromTrailer(model)
	local tid = model:GetAttribute("TrailerId")
	if tid and tid ~= "" and trailers[tid] then
		model:SetAttribute("TrailerId", "")
		updateManifest(trailers[tid])
	end
end

function DeliveryService.depart(id)
	local t = trailers[id]
	if not t or t.departing then
		return
	end
	t.departing = true
	t.model:SetAttribute("DepartAt", now())
	fx("TruckDepart", t.model:GetPivot().Position, nil)
	task.delay(D.DepartSeconds + 0.5, function()
		if trailers[id] == t then
			trailers[id] = nil
			t.model:Destroy()
		end
	end)
end

function DeliveryService.dismiss(player, id)
	local t = trailers[id]
	if not t then
		return false, "No such truck."
	end
	local left = #cargoOf(id)
	if left > 0 then
		return false, string.format("Unload all materials first (%d left on the deck).", left)
	end
	DeliveryService.depart(id)
	return true, "Truck released."
end

function DeliveryService.handle(player, action, a, b)
	if action == "Request" then
		return DeliveryService.request(player, a, b)
	elseif action == "Dismiss" then
		return DeliveryService.dismiss(player, a)
	end
	return false, "Unknown action."
end

function DeliveryService.serialize()
	local out = {}
	for _, t in pairs(trailers) do
		if not t.departing then
			local dun = {}
			for _, d in ipairs(t.dunnage or {}) do
				table.insert(dun, { cf = Util.cfToArray(d.cf), size = { d.size.X, d.size.Y, d.size.Z } })
			end
			local straps = {}
			for _, s in ipairs(t.straps) do
				table.insert(straps, { id = s.id, x = s.x, top = s.top, width = s.width, group = s.group, released = s.released })
			end
			table.insert(out, { id = t.id, bay = t.bay, seed = t.seed, dunnage = dun, straps = straps })
		end
	end
	return out
end

function DeliveryService.restore(list)
	for _, data in ipairs(list or {}) do
		local dun = {}
		for _, d in ipairs(data.dunnage or {}) do
			local cf = Util.arrayToCf(d.cf)
			if cf then
				table.insert(dun, { cf = cf, size = Vector3.new(d.size[1], d.size[2], d.size[3]) })
			end
		end
		local site = Services.Site.current
		if data.bay and site.def.bays[data.bay] then
			DeliveryService.spawnTrailer(data.bay, nil, { dunnage = dun, straps = data.straps or {} }, { instant = true, id = data.id, seed = data.seed })
		end
	end
end

function DeliveryService.refreshAll()
	for _, t in pairs(trailers) do
		updateManifest(t)
	end
end

return DeliveryService
]]></ProtectedString>
</Properties>
</Item>
<Item class="Script" referent="RBX00000011">
<Properties>
<string name="Name">Main</string>
<ProtectedString name="Source"><![CDATA[-- STEELRISE server bootstrap: creates remotes, wires services together and
-- loads the Empty Land site as the menu backdrop.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Remotes = require(Shared.Remotes)
Remotes.init()

Players.CharacterAutoLoads = false

local services = {
	Packing = require(script.Parent.Packing),
	Components = require(script.Parent.ComponentService),
	Delivery = require(script.Parent.DeliveryService),
	Crane = require(script.Parent.CraneService),
	Save = require(script.Parent.SaveService),
	Site = require(script.Parent.SiteService),
}

for _, name in ipairs({ "Components", "Delivery", "Crane", "Save", "Site" }) do
	services[name].init(services)
end

-- Per-player request budget so a misbehaving client can't flood the server.
local budget = {}
local function allow(player)
	local t = os.clock()
	local b = budget[player]
	if not b or t - b.t > 1 then
		budget[player] = { t = t, n = 1 }
		return true
	end
	b.n += 1
	return b.n <= 25
end
Players.PlayerRemoving:Connect(function(p)
	budget[p] = nil
end)

local function bind(name, handler)
	Remotes.get(name).OnServerInvoke = function(player, ...)
		if not allow(player) then
			return false, "Slow down."
		end
		local results = table.pack(pcall(handler, player, ...))
		if not results[1] then
			warn("[STEELRISE] " .. name .. " error:", results[2])
			return false, "Server error — see output."
		end
		return table.unpack(results, 2, results.n)
	end
end

bind("Menu", function(player, action)
	if action == "Info" then
		return true, nil, services.Site.menuInfo(player)
	end
	return false, "Unknown action."
end)
bind("Site", services.Site.handle)
bind("Delivery", services.Delivery.handle)
bind("Handle", services.Components.handle)
bind("Build", services.Components.build)
bind("Crane", services.Crane.handle)
bind("Save", services.Save.handle)

Players.PlayerAdded:Connect(function(player)
	player.ReplicationFocus = services.Site.focusPart()
end)

-- Menu backdrop / default site
local ok, err = pcall(services.Site.load, "EmptyLand", nil, nil)
if not ok then
	warn("[STEELRISE] failed to build default site:", err)
end
for _, player in ipairs(Players:GetPlayers()) do
	player.ReplicationFocus = services.Site.focusPart()
end

print("[STEELRISE] server ready")
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000012">
<Properties>
<string name="Name">Packing</string>
<ProtectedString name="Source"><![CDATA[-- Lays out a list of items on a rectangular bed (trailer deck or laydown yard)
-- as stacked blocks on dunnage, the way steel is actually shipped: one block
-- per item type, layers separated by timbers, straps over each block.
--
-- Coordinates are in the bed's local frame: X along the bed, Z across it,
-- Y = 0 at the bed surface. Everything in studs.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)

local S = Config.S

local Packing = {}

local DUNNAGE = 0.1 * S
local GAP = 0.08 * S

-- Rotated bounding size and centre offset for an item in its transport pose.
function Packing.transportBox(def)
	local R = def.transport
	local sx, sy, sz = def.size.X / 2, def.size.Y / 2, def.size.Z / 2
	local rx, ry, rz = R.RightVector, R.UpVector, -R.LookVector
	local hx = math.abs(rx.X) * sx + math.abs(ry.X) * sy + math.abs(rz.X) * sz
	local hy = math.abs(rx.Y) * sx + math.abs(ry.Y) * sy + math.abs(rz.Y) * sz
	local hz = math.abs(rx.Z) * sx + math.abs(ry.Z) * sy + math.abs(rz.Z) * sz
	local offset = R:VectorToWorldSpace(def.boundsOffset)
	return Vector3.new(hx * 2, hy * 2, hz * 2), offset
end

-- requests: array of { id = itemId, qty = n }
-- returns placed = { {id, cf(local)} }, extras = { dunnage = {{cf,size}}, straps = {{cf,size,group}} },
--         leftovers = { {id, qty} }, kg
function Packing.pack(requests, bedLength, bedWidth, maxHeight, opts)
	opts = opts or {}
	local placed, dunnage, straps, leftovers = {}, {}, {}, {}
	local cursor = -bedLength / 2 + 0.3 * S
	local totalKg = 0
	local maxKg = opts.maxKg or math.huge
	local groupN = 0
	-- longest items first so long steel sits at the front of the bed
	local sorted = {}
	for _, r in ipairs(requests) do
		local def = Registry.get(r.id)
		if def and r.qty > 0 then
			table.insert(sorted, { def = def, qty = r.qty })
		end
	end
	table.sort(sorted, function(a, b)
		return a.def.size.Magnitude > b.def.size.Magnitude
	end)
	for _, req in ipairs(sorted) do
		local def = req.def
		local box, offset = Packing.transportBox(def)
		local rot = def.transport
		local x, h, z = box.X, box.Y, box.Z
		if z > bedWidth and x <= bedWidth and z <= bedLength then
			rot = CFrame.Angles(0, math.pi / 2, 0) * rot
			box, offset = Vector3.new(z, h, x), CFrame.Angles(0, math.pi / 2, 0):VectorToWorldSpace(offset)
			x, z = box.X, box.Z
		end
		local across = math.max(1, math.floor((bedWidth + GAP) / (z + GAP)))
		local layers = 1
		if h <= maxHeight / 2 then
			layers = math.max(1, math.floor((maxHeight + 0.001) / (h + DUNNAGE)))
		end
		local remaining = req.qty
		while remaining > 0 do
			if cursor + x > bedLength / 2 + 0.01 then
				break
			end
			groupN += 1
			local group = (opts.prefix or "G") .. groupN
			local inBlock = 0
			local topY = 0
			local xc = cursor + x / 2
			for l = 0, layers - 1 do
				if remaining <= 0 then
					break
				end
				local yBottom = DUNNAGE + l * (h + DUNNAGE)
				-- dunnage under this layer
				for _, fx in ipairs({ -0.3, 0.3 }) do
					table.insert(dunnage, {
						cf = CFrame.new(xc + fx * x, yBottom - DUNNAGE / 2, 0),
						size = Vector3.new(0.12 * S, DUNNAGE, math.min(bedWidth, across * (z + GAP))),
					})
				end
				for a = 0, across - 1 do
					if remaining <= 0 then
						break
					end
					if totalKg + def.weightKg > maxKg then
						break
					end
					local zc = -((across - 1) / 2) * (z + GAP) + a * (z + GAP)
					local centre = Vector3.new(xc, yBottom + h / 2, zc)
					local cf = CFrame.new(centre - offset) * rot
					table.insert(placed, { id = def.id, cf = cf, group = group })
					totalKg += def.weightKg
					remaining -= 1
					inBlock += 1
					topY = yBottom + h
				end
				if totalKg + def.weightKg > maxKg then
					break
				end
			end
			if inBlock == 0 then
				break
			end
			-- straps over the block
			local strapXs = x > 3.5 * S and { xc - x / 4, xc + x / 4 } or { xc }
			for _, sx in ipairs(strapXs) do
				table.insert(straps, { x = sx, top = topY, width = math.min(bedWidth, across * (z + GAP)), group = group })
			end
			cursor += x + GAP * 2
			if totalKg + def.weightKg > maxKg then
				break
			end
		end
		if remaining > 0 then
			table.insert(leftovers, { id = def.id, qty = remaining })
		end
	end
	return placed, { dunnage = dunnage, straps = straps }, leftovers, totalKg
end

return Packing
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000013">
<Properties>
<string name="Name">SaveService</string>
<ProtectedString name="Source"><![CDATA[-- Saves and settings.
--
-- Keys per player:  u<UserId>:meta            settings, favourites, slot summaries
--                   u<UserId>:slot<n>         site snapshot (0 = autosave, 1..3 manual)
--
-- If DataStores are unavailable (Studio without "Enable Studio Access to API
-- Services", or an outage) everything falls back to an in-memory store for the
-- session and the player is told that saves will not persist.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local SaveService = {}
local Services

local store = nil
local persistent = false
local memory = {}
local metaCache = {}
local lastSave = {}

local function notify(player, text, kind)
	Remotes.get("Notify"):FireClient(player, text, kind or "info")
end

local function key(player, suffix)
	return "u" .. player.UserId .. ":" .. suffix
end

local function rawGet(k)
	if persistent then
		local ok, value = pcall(function()
			return store:GetAsync(k)
		end)
		if ok then
			return value, true
		end
		warn("[STEELRISE] DataStore read failed:", value)
		return memory[k], false
	end
	return memory[k], true
end

local function rawSet(k, value)
	memory[k] = value
	if persistent then
		local ok, err = pcall(function()
			store:UpdateAsync(k, function()
				return value
			end)
		end)
		if not ok then
			warn("[STEELRISE] DataStore write failed:", err)
			return false, "Cloud save failed — kept for this session only. (" .. tostring(err) .. ")"
		end
	end
	return true
end

function SaveService.init(services)
	Services = services
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Save.StoreName)
	end)
	if ok and result then
		store = result
		-- probe once so Studio without API access falls back cleanly
		local probeOk = pcall(function()
			store:GetAsync("probe")
		end)
		persistent = probeOk
	end
	if not persistent then
		warn("[STEELRISE] DataStores unavailable — saves are session-only. In Studio enable Game Settings > Security > Enable Studio Access to API Services.")
	end
	Players.PlayerRemoving:Connect(function(player)
		local site = Services.Site.current
		if site and site.host == player then
			SaveService.saveSlot(player, Config.Save.AutosaveSlot, true)
		end
		metaCache[player] = nil
		lastSave[player] = nil
	end)
	game:BindToClose(function()
		local site = Services.Site.current
		if site and site.host and site.host.Parent then
			SaveService.saveSlot(site.host, Config.Save.AutosaveSlot, true)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(Config.Save.AutosaveInterval)
			local site = Services.Site.current
			if site and site.host and site.host.Parent and site.dirty then
				Remotes.get("Notify"):FireClient(site.host, "Autosaving…", "save")
				local okSave, msg = SaveService.saveSlot(site.host, Config.Save.AutosaveSlot, true)
				Remotes.get("Notify"):FireClient(site.host, okSave and "Autosaved" or msg, okSave and "save" or "warn")
			end
		end
	end)
end

function SaveService.isPersistent()
	return persistent
end

function SaveService.meta(player)
	if metaCache[player] then
		return metaCache[player]
	end
	local data = rawGet(key(player, "meta"))
	local meta = Util.withDefaults(data, { settings = Config.DefaultSettings, favorites = {}, slots = {}, lastSlot = -1 })
	meta.settings = Util.withDefaults(meta.settings, Config.DefaultSettings)
	metaCache[player] = meta
	return meta
end

local function writeMeta(player)
	return rawSet(key(player, "meta"), metaCache[player])
end

---------------------------------------------------------------------------
-- Snapshot
---------------------------------------------------------------------------

function SaveService.snapshot()
	local site = Services.Site.current
	local comps = {}
	for _, m in ipairs(Services.Components.all()) do
		local state = m:GetAttribute("State")
		local cf = m:GetPivot()
		local entry = {
			i = m:GetAttribute("ComponentId"),
			t = m:GetAttribute("ItemId"),
			s = state,
			f = m:GetAttribute("Fastened"),
			sb = m:GetAttribute("SupportedBy"),
			r = m:GetAttribute("RestraintId"),
			tr = m:GetAttribute("TrailerId"),
			on = m:GetAttribute("On") or nil,
		}
		if state == "Rigged" then
			-- an interrupted lift is restored safely in the laydown yard
			cf = Services.Crane.recoveryPose(m)
			entry.s = "Loose"
			entry.r, entry.tr = "", ""
		elseif state == "Carried" then
			local holder = tonumber(m:GetAttribute("Holder"))
			local p = holder and Players:GetPlayerByUserId(holder)
			local hrp = p and p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			local base = hrp and hrp.Position or cf.Position
			cf = Services.Components.restingPose(m, base, 0, { m, p and p.Character })
			entry.s = "Loose"
		end
		entry.c = Util.cfToArray(cf)
		table.insert(comps, entry)
	end
	return {
		v = 1,
		site = site.id,
		blueprint = site.blueprint,
		savedAt = os.time(),
		progress = { installed = site.folder:GetAttribute("BPInstalled") or 0, total = site.folder:GetAttribute("BPTotal") or 0 },
		components = comps,
		trailers = Services.Delivery.serialize(),
		cranes = Services.Crane.serialize(),
	}
end

function SaveService.saveSlot(player, slot, silent)
	local site = Services.Site.current
	if not site then
		return false, "No site to save."
	end
	if site.host ~= player then
		return false, "Only the site host's progress is saved."
	end
	slot = math.clamp(math.floor(tonumber(slot) or 0), 0, Config.Save.ManualSlots)
	local t = os.clock()
	if not silent and lastSave[player] and t - lastSave[player] < Config.Save.MinSaveGap then
		return false, "Saved a moment ago — wait a few seconds."
	end
	lastSave[player] = t
	local snap = SaveService.snapshot()
	local ok, err = rawSet(key(player, "slot" .. slot), snap)
	local meta = SaveService.meta(player)
	meta.slots[tostring(slot)] = {
		site = snap.site,
		savedAt = snap.savedAt,
		installed = snap.progress.installed,
		total = snap.progress.total,
		count = #snap.components,
	}
	meta.lastSlot = slot
	writeMeta(player)
	site.dirty = false
	if not ok then
		return false, err
	end
	local where = slot == 0 and "autosave" or ("slot " .. slot)
	return true, persistent and ("Saved to " .. where .. ".") or ("Saved to " .. where .. " (this session only — DataStores unavailable).")
end

function SaveService.loadSlot(player, slot)
	local meta = SaveService.meta(player)
	if slot == nil or slot == "latest" then
		slot = meta.lastSlot
	end
	slot = tonumber(slot)
	if not slot or slot < 0 then
		return nil, "No saved construction found."
	end
	local data = rawGet(key(player, "slot" .. slot))
	if type(data) ~= "table" or not data.site then
		return nil, "That save slot is empty."
	end
	return data
end

function SaveService.handle(player, action, a, b)
	if action == "Save" then
		return SaveService.saveSlot(player, a, false)
	elseif action == "Settings" then
		if type(a) ~= "table" then
			return false, "Bad settings."
		end
		local meta = SaveService.meta(player)
		meta.settings = Util.withDefaults(a, Config.DefaultSettings)
		task.spawn(writeMeta, player)
		return true
	elseif action == "Favorite" then
		local meta = SaveService.meta(player)
		if type(a) == "string" and #a < 64 then
			meta.favorites[a] = b and true or nil
			task.spawn(writeMeta, player)
		end
		return true
	end
	return false, "Unknown action."
end

return SaveService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000014">
<Properties>
<string name="Name">SiteService</string>
<ProtectedString name="Source"><![CDATA[-- Loads a site: terrain, lighting, environment, crane, the starting stage of
-- the building (or a save), starter deliveries and the scaffold kit. Also
-- tracks blueprint progress for the task panel.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local Sites = require(Shared.Sites)
local BuildRules = require(Shared.BuildRules)
local CraneMath = require(Shared.CraneMath)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local WorldFactory = require(script.Parent.WorldFactory)
local Packing = require(script.Parent.Packing)

local S = Config.S

local SiteService = {}
local Services
SiteService.current = nil

local function notifyAll(text, kind)
	Remotes.get("Notify"):FireAllClients(text, kind or "info")
end

function SiteService.init(services)
	Services = services
end

local function newFolder(parent, name)
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

---------------------------------------------------------------------------
-- Blueprint progress
---------------------------------------------------------------------------

local function posKey(itemId, p)
	return itemId .. "@" .. math.floor(p.X * 2 + 0.5) .. "," .. math.floor(p.Y * 2 + 0.5) .. "," .. math.floor(p.Z * 2 + 0.5)
end

local PHASE_VERB = {
	footing = "Set footing",
	column = "Erect column",
	beam = "Hang beam",
	gusset = "Bolt gusset plate",
	brace = "Install brace",
	deck = "Lay deck sheet",
	facade = "Hang facade unit",
}

function SiteService.recountProgress()
	local site = SiteService.current
	if not site then
		return
	end
	local entries = site.blueprintEntries
	if not entries or #entries == 0 then
		site.folder:SetAttribute("BPInstalled", 0)
		site.folder:SetAttribute("BPTotal", 0)
		site.folder:SetAttribute("NextTask", "Free build — order materials from the catalog (Tab) and build anywhere on the lot.")
		return
	end
	local installed = {}
	for _, m in ipairs(Services.Components.all()) do
		if m:GetAttribute("State") == "Installed" then
			installed[posKey(m:GetAttribute("ItemId"), m:GetPivot().Position)] = true
		end
	end
	local done = 0
	local nextE = nil
	for _, e in ipairs(entries) do
		if installed[posKey(e.item, e.cf.Position)] then
			done += 1
		elseif not nextE then
			nextE = e
		end
	end
	site.folder:SetAttribute("BPInstalled", done)
	site.folder:SetAttribute("BPTotal", #entries)
	if nextE then
		local def = Registry.get(nextE.item)
		local where = nextE.phase == "footing" and string.format("grid %s%d", string.char(65 + nextE.i), nextE.j + 1)
			or string.format("level %d, grid %s%d", nextE.level, string.char(65 + nextE.i), nextE.j + 1)
		site.folder:SetAttribute("NextTask", string.format("%s — %s (%s)", PHASE_VERB[nextE.phase] or "Install", def and def.name or nextE.item, where))
	else
		site.folder:SetAttribute("NextTask", "Blueprint complete. Outstanding work!")
	end
end

function SiteService.onComponentInstalled()
	if SiteService.current then
		SiteService.current.dirty = true
		SiteService.recountProgress()
	end
end

function SiteService.onComponentRemoved()
	if SiteService.current then
		SiteService.current.dirty = true
		SiteService.recountProgress()
	end
end

function SiteService.setBlueprint(blueprintId)
	local site = SiteService.current
	if not site then
		return false, "No site."
	end
	local grid = Sites.blueprintGrid(site.def, blueprintId)
	site.blueprint = grid and (blueprintId or "Site") or nil
	site.blueprintEntries = grid and Sites.sortEntries(Sites.layout(grid)) or nil
	site.folder:SetAttribute("Blueprint", site.blueprint or "")
	SiteService.recountProgress()
	return true
end

---------------------------------------------------------------------------
-- Loading
---------------------------------------------------------------------------

local function unload()
	Services.Crane.clearAll()
	Services.Delivery.clearAll()
	Services.Components.clearAll()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then
			local hrp = p.Character:FindFirstChild("HumanoidRootPart")
			if hrp then
				hrp.Anchored = false
			end
			if Services.Components.carried(p) then
				Services.Components.dropCarried(p, true)
			end
		end
	end
	local old = workspace:FindFirstChild("SteelriseSite")
	if old then
		old:Destroy()
	end
	SiteService.current = nil
end

local function spawnLaydown(site, requests)
	if not requests or #requests == 0 then
		return
	end
	local list = {}
	for _, r in ipairs(requests) do
		table.insert(list, { id = r[1], qty = r[2] })
	end
	local ld = site.def.laydownM
	local frame = CFrame.new(ld.center.X * S, 0, ld.center.Z * S)
	local placed, extras = Packing.pack(list, ld.size.X * S, ld.size.Z * S, 1.2 * S, {})
	for _, d in ipairs(extras.dunnage) do
		local p = Instance.new("Part")
		p.Name = "Dunnage"
		p.Size = d.size
		p.CFrame = frame * d.cf
		p.Anchored = true
		p.Color = Config.Colors.Timber
		p.Material = Enum.Material.Wood
		p.Parent = site.folder.Environment
	end
	for _, pl in ipairs(placed) do
		Services.Components.spawn(pl.id, frame * pl.cf, "Loose", {})
	end
end

function SiteService.load(siteId, saveData, host)
	local def = Sites.get(siteId)
	if not def then
		return false, "Unknown site."
	end
	unload()
	local folder = Instance.new("Folder")
	folder.Name = "SteelriseSite"
	folder:SetAttribute("SiteId", siteId)
	folder:SetAttribute("Ready", false)
	local mn, mx = Sites.boundsStuds(def)
	folder:SetAttribute("BoundsMin", mn)
	folder:SetAttribute("BoundsMax", mx)
	local env = newFolder(folder, "Environment")
	newFolder(folder, "Components")
	newFolder(folder, "Trailers")
	newFolder(folder, "Cranes")
	folder.Parent = workspace

	local site = {
		id = siteId,
		def = def,
		folder = folder,
		host = host,
		dirty = false,
	}
	site.world = BuildRules.newWorld(folder)
	SiteService.current = site

	WorldFactory.applyLighting(def)
	WorldFactory.buildTerrain(def)
	WorldFactory.buildFencing(def, env)
	WorldFactory.buildSiteDressing(def, env)
	local surroundings = newFolder(folder, "Surroundings")
	WorldFactory.buildSurroundings(def, surroundings)

	-- crane
	local craneModel, cfg = WorldFactory.buildCrane(def.crane, "1")
	craneModel.Parent = folder.Cranes
	Services.Crane.register("1", craneModel, cfg)

	if saveData then
		for _, c in ipairs(saveData.components or {}) do
			local cf = Util.arrayToCf(c.c)
			if cf and Registry.get(c.t) then
				Services.Components.spawn(c.t, cf, c.s or "Loose", {
					id = c.i,
					fastened = c.f,
					supportedBy = c.sb,
					restraint = c.r,
					trailer = c.tr,
					on = c.on,
				})
			end
		end
		Services.Delivery.restore(saveData.trailers)
		Services.Crane.restore(saveData.cranes)
		Services.Delivery.refreshAll()
	else
		-- starting stage of the building
		local stageModels = {}
		for _, e in ipairs(Sites.stageEntries(def)) do
			local m = Services.Components.spawn(e.item, e.cf, "Installed", {})
			if m then
				table.insert(stageModels, m)
			end
		end
		site.world:markDirty()
		for _, m in ipairs(stageModels) do
			local ids = BuildRules.supportsOf(site.world, Registry.get(m:GetAttribute("ItemId")), m:GetPivot(), m:GetAttribute("ComponentId"))
			m:SetAttribute("SupportedBy", table.concat(ids, ","))
		end
		-- first work package on a truck, scaffold kit in the yard
		if def.starter then
			if def.starter.trailer then
				local reqs = {}
				for _, r in ipairs(def.starter.trailer) do
					table.insert(reqs, { id = r[1], qty = r[2] })
				end
				Services.Delivery.spawnLoaded(1, reqs)
			end
			spawnLaydown(site, def.starter.laydown)
		else
			-- next work package from the blueprint
			local pending = {}
			local entries = Sites.sortEntries(Sites.layout(def.grid))
			local stage = {}
			for _, e in ipairs(Sites.stageEntries(def)) do
				stage[e.key] = true
			end
			local counts, order = {}, {}
			local n = 0
			for _, e in ipairs(entries) do
				if not stage[e.key] and e.phase ~= "deck" and e.phase ~= "gusset" then
					if not counts[e.item] then
						counts[e.item] = 0
						table.insert(order, e.item)
					end
					counts[e.item] += 1
					n += 1
					if n >= 10 then
						break
					end
				end
			end
			for _, id in ipairs(order) do
				table.insert(pending, { id = id, qty = counts[id] })
			end
			if #pending > 0 then
				Services.Delivery.spawnLoaded(1, pending)
			end
			spawnLaydown(site, {
				{ "CON-GUSSET-350", 4 },
				{ "SC-BASEJACK", 4 },
				{ "SC-STD-2000", 8 },
				{ "SC-LEDGER-2570", 6 },
				{ "SC-LEDGER-1090", 6 },
				{ "SC-DECK-2570", 2 },
				{ "SC-LADDER-27", 1 },
			})
		end
	end

	local bp = saveData and saveData.blueprint or (def.grid and "Site" or nil)
	SiteService.setBlueprint(bp)
	folder:SetAttribute("Ready", true)
	folder:SetAttribute("Host", host and host.UserId or 0)
	-- keep player streaming focused on the site while in menus
	for _, p in ipairs(Players:GetPlayers()) do
		if not p.Character then
			p.ReplicationFocus = SiteService.focusPart()
		end
	end
	return true
end

-- Invisible part at the site centre used as the replication focus for menus.
function SiteService.focusPart()
	local site = SiteService.current
	if not site then
		return nil
	end
	local f = site.folder:FindFirstChild("Focus")
	if not f then
		f = Instance.new("Part")
		f.Name = "Focus"
		f.Anchored = true
		f.CanCollide = false
		f.CanQuery = false
		f.Transparency = 1
		f.Size = Vector3.new(1, 1, 1)
		f.CFrame = CFrame.new(site.def.crane.posM * S + Vector3.new(0, 20, 0))
		f.Parent = site.folder
	end
	return f
end

function SiteService.spawnCharacter(player)
	local site = SiteService.current
	if not site then
		return
	end
	player:LoadCharacter()
	local character = player.Character or player.CharacterAdded:Wait()
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	if hrp then
		local p = site.def.spawnM * S
		hrp.CFrame = CFrame.new(p + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.rad(180), 0)
	end
	player.ReplicationFocus = nil
	Services.Components.equip(player, "TL-HANDS")
	local hum = character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.Died:Connect(function()
			task.delay(4, function()
				-- respawn on site unless the player went back to the menu meanwhile
				if player.Parent and SiteService.current and player.Character == character then
					SiteService.spawnCharacter(player)
				end
			end)
		end)
	end
end

---------------------------------------------------------------------------
-- Remote handlers
---------------------------------------------------------------------------

function SiteService.handle(player, action, a, b, c)
	if action == "Start" then
		local siteId, mode, slot = a, b, c
		local site = SiteService.current
		local hostPresent = site and site.host and site.host.Parent and site.host ~= player
		if hostPresent and mode ~= "join" then
			return false, site.host.DisplayName .. " is hosting this server's site — use Join."
		end
		if mode == "continue" then
			local data, why = Services.Save.loadSlot(player, slot)
			if not data then
				return false, why
			end
			if site and site.host == player then
				Services.Save.saveSlot(player, Config.Save.AutosaveSlot, true)
			end
			local ok, err = SiteService.load(data.site, data, player)
			if not ok then
				return false, err
			end
		elseif mode == "join" then
			if not site then
				return false, "No site is running yet."
			end
		else
			if not Sites.get(siteId) then
				return false, "Unknown site."
			end
			if site and site.host == player then
				Services.Save.saveSlot(player, Config.Save.AutosaveSlot, true)
			end
			local ok, err = SiteService.load(siteId, nil, player)
			if not ok then
				return false, err
			end
		end
		-- (re)spawn everyone who is already on site so nobody stands in the old world
		for _, p in ipairs(Players:GetPlayers()) do
			if p.Character and p ~= player then
				task.spawn(SiteService.spawnCharacter, p)
			end
		end
		SiteService.spawnCharacter(player)
		local cur = SiteService.current
		cur.dirty = true
		return true, nil, { siteId = cur.id, host = cur.host and cur.host.UserId or 0 }
	elseif action == "Blueprint" then
		local site = SiteService.current
		if not site or site.host ~= player then
			return false, "Only the host can change the blueprint."
		end
		return SiteService.setBlueprint(a ~= "" and a or nil)
	elseif action == "Menu" then
		if Services.Crane.isOperating(player) then
			Services.Crane.exit(player)
		end
		if Services.Components.carried(player) then
			Services.Components.dropCarried(player, true)
		end
		if player.Character then
			player.Character:Destroy()
			player.Character = nil
		end
		player.ReplicationFocus = SiteService.focusPart()
		return true
	end
	return false, "Unknown action."
end

function SiteService.menuInfo(player)
	local site = SiteService.current
	local meta = Services.Save.meta(player)
	local counts = Registry.count()
	return {
		currentSite = site and site.id or nil,
		host = site and site.host and site.host.UserId or 0,
		hostName = site and site.host and site.host.DisplayName or nil,
		slots = meta.slots,
		lastSlot = meta.lastSlot,
		settings = meta.settings,
		favorites = meta.favorites,
		persistent = Services.Save.isPersistent(),
		itemCount = counts.total,
		itemTarget = Registry.TargetCount,
	}
end

return SiteService
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000015">
<Properties>
<string name="Name">WorldFactory</string>
<ProtectedString name="Source"><![CDATA[-- Server-side builders for site environments, the tower crane and the
-- delivery truck. Everything is made from engine parts and built-in
-- materials so the place runs without any uploaded assets; see
-- docs/ASSETS.md for the meshes/textures that would raise fidelity further.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local CraneMath = require(Shared.CraneMath)
local Util = require(Shared.Util)

local S = Config.S
local C = Config.Colors
local M = Enum.Material
local V = Vector3.new
local CF = CFrame.new

local WorldFactory = {}

local function m(x)
	return x * S
end

-- Part helper in STUDS.
local function P(parent, name, size, cf, color, material, flags)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color or C.Steel
	p.Material = material or M.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	if flags then
		if flags.nc then
			p.CanCollide = false
		end
		if flags.ns then
			p.CastShadow = false
		end
		if flags.nq then
			p.CanQuery = false
		end
		if flags.tr then
			p.Transparency = flags.tr
		end
		if flags.refl then
			p.Reflectance = flags.refl
		end
		if flags.shape then
			p.Shape = flags.shape
		end
	end
	p.Parent = parent
	return p
end
WorldFactory.P = P

local function cyl(parent, name, length, dia, cf, color, material, flags)
	local f = flags and Util.shallowCopy(flags) or {}
	f.shape = Enum.PartType.Cylinder
	return P(parent, name, V(length, dia, dia), cf, color, material, f)
end

local function lookAlong(pos, dir)
	local up = Vector3.yAxis
	if math.abs(dir.Unit.Y) > 0.98 then
		up = Vector3.xAxis
	end
	return CFrame.lookAt(pos, pos + dir, up)
end

-- Bar between two points (studs).
local function bar(parent, name, a, b, w, color, material, flags)
	local len = (b - a).Magnitude
	return P(parent, name, V(w, w, len), lookAlong((a + b) / 2, b - a), color, material, flags)
end

local function surfaceText(part, face, text, bg, fg, font)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 20
	gui.LightInfluence = 1
	gui.Parent = part
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundColor3 = bg or C.Charcoal
	t.BackgroundTransparency = bg and 0 or 1
	t.TextColor3 = fg or C.OffWhite
	t.Font = font or Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = text
	t.Parent = gui
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.04, 0)
	pad.PaddingRight = UDim.new(0.04, 0)
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingBottom = UDim.new(0.08, 0)
	pad.Parent = t
	return gui
end

---------------------------------------------------------------------------
-- Lighting
---------------------------------------------------------------------------

function WorldFactory.applyLighting(site)
	local L = site.lighting or {}
	Lighting.ClockTime = L.clock or 12
	Lighting.GeographicLatitude = L.latitude or 40
	Lighting.Brightness = 2.4
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1
	Lighting.ExposureCompensation = 0.05
	Lighting.ShadowSoftness = 0.15
	Lighting.GlobalShadows = true
	Lighting.Ambient = Color3.fromRGB(34, 36, 40)
	Lighting.OutdoorAmbient = Color3.fromRGB(126, 128, 134)
	Lighting.ColorShift_Top = L.tint or Color3.fromRGB(255, 248, 240)

	for _, child in ipairs(Lighting:GetChildren()) do
		if child:GetAttribute("Steelrise") then
			child:Destroy()
		end
	end
	local function tag(inst)
		inst:SetAttribute("Steelrise", true)
		inst.Parent = Lighting
		return inst
	end
	local atm = Instance.new("Atmosphere")
	atm.Density = L.density or 0.32
	atm.Offset = 0.22
	atm.Color = Color3.fromRGB(198, 205, 214)
	atm.Decay = Color3.fromRGB(104, 112, 124)
	atm.Glare = 0.18
	atm.Haze = L.haze or 1.2
	tag(atm)
	local sky = Instance.new("Sky")
	sky.CelestialBodiesShown = true
	sky.SunAngularSize = 14
	sky.StarCount = 1500
	tag(sky)
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "SR_Bloom"
	bloom.Intensity = 0.5
	bloom.Size = 22
	bloom.Threshold = 1.7
	tag(bloom)
	local rays = Instance.new("SunRaysEffect")
	rays.Name = "SR_SunRays"
	rays.Intensity = 0.045
	rays.Spread = 0.55
	tag(rays)
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "SR_Grade"
	cc.Brightness = 0.01
	cc.Contrast = 0.07
	cc.Saturation = -0.06
	cc.TintColor = L.tint or Color3.fromRGB(255, 250, 244)
	tag(cc)
	local dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "SR_DOF"
	dof.FarIntensity = 0.12
	dof.FocusDistance = 260
	dof.InFocusRadius = 220
	dof.NearIntensity = 0
	dof.Enabled = true
	tag(dof)

	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.42
	clouds.Density = 0.55
	clouds.Color = Color3.fromRGB(240, 240, 238)
	clouds.Parent = workspace.Terrain
end

---------------------------------------------------------------------------
-- Terrain
---------------------------------------------------------------------------

function WorldFactory.buildTerrain(site)
	local T = workspace.Terrain
	T:Clear()
	local lot = site.lotM * S
	local extent = V(lot.X + 900, 0, lot.Z + 900)
	-- base grade: top surface exactly at y = 0
	local baseMat = (site.style == "Rural" or site.style == "Suburban" or site.style == "Residential") and M.Grass or M.Pavement
	T:FillBlock(CF(0, -8, 0), V(extent.X, 16, extent.Z), baseMat)
	-- the lot itself: compacted dirt with mud patches and gravel bands
	T:FillBlock(CF(0, -8, 0), V(lot.X, 16, lot.Z), M.Ground)
	local rng = Random.new(Util.hashString(site.id))
	for _ = 1, 10 do
		local px = rng:NextNumber(-lot.X / 2 + 20, lot.X / 2 - 20)
		local pz = rng:NextNumber(-lot.Z / 2 + 20, lot.Z / 2 - 20)
		local sz = rng:NextNumber(18, 40)
		T:FillBlock(CF(px, -4, pz), V(sz, 8, sz * rng:NextNumber(0.6, 1.4)), M.Mud)
	end
	-- haul road from the gate to the trailer bays
	for _, b in ipairs(site.bays) do
		local p = b.Position
		if math.abs(p.X) < lot.X / 2 and math.abs(p.Z) < lot.Z / 2 then
			T:FillBlock(b * CF(0, -4, 0), V(m(24), 8, m(5)), M.Slate)
		end
	end
	-- crane pad and laydown
	local cb = site.crane.posM * S
	T:FillBlock(CF(cb.X, -4, cb.Z), V(m(9), 8, m(9)), M.Concrete)
	local ld = site.laydownM
	T:FillBlock(CF(ld.center.X * S, -4, ld.center.Z * S), V(ld.size.X * S, 8, ld.size.Z * S), M.Slate)
	-- street along the south edge (and east edge for corner lots)
	local roadZ = -lot.Z / 2 - m(9)
	T:FillBlock(CF(0, -4, roadZ), V(extent.X, 8, m(14)), M.Asphalt)
	T:FillBlock(CF(0, -4, -lot.Z / 2 - m(1.2)), V(extent.X, 8, m(2.4)), M.Concrete)
	if site.style == "Downtown" or site.style == "CityCenter" or site.style == "HighRise" then
		local roadX = lot.X / 2 + m(9)
		T:FillBlock(CF(roadX, -4, 0), V(m(14), 8, extent.Z), M.Asphalt)
		T:FillBlock(CF(lot.X / 2 + m(1.2), -4, 0), V(m(2.4), 8, extent.Z), M.Concrete)
	end
	if site.style == "Waterfront" then
		local waterZ = lot.Z / 2 + m(14) + 300
		T:FillBlock(CF(0, -8, waterZ), V(extent.X, 16, 600), M.Air)
		T:FillBlock(CF(0, -12, waterZ), V(extent.X, 8, 600), M.Mud)
		T:FillBlock(CF(0, -5, waterZ), V(extent.X, 6, 600), M.Water)
		T:FillBlock(CF(0, -4, lot.Z / 2 + m(6)), V(extent.X, 8, m(12)), M.Pavement)
	end
	if site.rail then
		T:FillBlock(CF(0, -4, lot.Z / 2 + m(8)), V(extent.X, 8, m(8)), M.Slate)
	end
end

---------------------------------------------------------------------------
-- Fencing, gate and site dressing
---------------------------------------------------------------------------

local function fenceRun(folder, a, b, screen, gateFrom, gateTo)
	local dir = (b - a)
	local len = dir.Magnitude
	local unit = dir.Unit
	local panel = m(3.5)
	local n = math.max(1, math.floor(len / panel + 0.5))
	local step = len / n
	local h = m(2.0)
	local runStart = nil
	local function closeRun(endT)
		if runStart and endT > runStart + 0.5 then
			local pA = a + unit * runStart
			local pB = a + unit * endT
			local mid = (pA + pB) / 2
			local seg = (pB - pA).Magnitude
			local cfm = lookAlong(mid + V(0, h / 2 + 0.3, 0), unit) * CFrame.Angles(0, math.pi / 2, 0)
			P(folder, "FenceMesh", V(seg, h, 0.08), cfm, C.Galvanized, M.DiamondPlate, { tr = 0.6, ns = true })
			P(folder, "FenceRail", V(seg, 0.12, 0.12), cfm * CF(0, h / 2, 0), C.Galvanized, M.Metal, { nc = true })
			if screen then
				local scr = P(folder, "Windscreen", V(seg, h * 0.82, 0.05), cfm * CF(0, -h * 0.05, -0.1), Color3.fromRGB(32, 64, 46), M.Fabric, { tr = 0.08 })
				scr.CastShadow = true
			end
		end
		runStart = nil
	end
	for k = 0, n do
		local t = k * step
		local inGate = gateFrom and t > gateFrom and t < gateTo
		if not inGate then
			local p = a + unit * t
			cyl(folder, "FencePost", h + 0.4, 0.16, CF(p + V(0, h / 2 + 0.3, 0)) * CFrame.Angles(0, 0, math.pi / 2), C.Galvanized, M.Metal)
			P(folder, "FenceFoot", V(m(0.6), 0.45, m(0.2)), lookAlong(p + V(0, 0.22, 0), unit) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(40, 42, 44), M.SmoothPlastic, { ns = true })
			if not runStart then
				runStart = t
			end
		else
			closeRun(t - step)
		end
	end
	closeRun(len)
end

function WorldFactory.buildFencing(site, folder)
	local lot = site.lotM * S
	local hx, hz = lot.X / 2, lot.Z / 2
	local screened = site.style ~= "Rural"
	-- gate on the south side, covering the bay x-range of internal bays
	local gateCentre = 0
	local count = 0
	for _, b in ipairs(site.bays) do
		if math.abs(b.Position.Z) < hz then
			gateCentre += b.Position.X
			count += 1
		end
	end
	gateCentre = count > 0 and gateCentre / count or 0
	local gateW = m(14)
	local southA, southB = V(-hx, 0, -hz), V(hx, 0, -hz)
	local gFrom = (gateCentre - gateW / 2) - (-hx)
	local gTo = gFrom + gateW
	if count == 0 then
		-- street-side deliveries: a narrow personnel gate only
		gFrom, gTo = hx - m(10), hx - m(6)
	end
	fenceRun(folder, southA, southB, screened, gFrom, gTo)
	fenceRun(folder, V(hx, 0, -hz), V(hx, 0, hz), screened)
	fenceRun(folder, V(hx, 0, hz), V(-hx, 0, hz), screened and site.style ~= "Waterfront")
	fenceRun(folder, V(-hx, 0, hz), V(-hx, 0, -hz), screened)

	-- gate signage
	local gx = -hx + (gFrom + gTo) / 2
	local signPost = P(folder, "GateSignPost", V(0.4, m(3.2), 0.4), CF(gx + gateW / 2 + 2, m(1.6), -hz - 1.5), C.SteelDark, M.Metal)
	signPost.CastShadow = true
	local board = P(folder, "GateSign", V(m(2.8), m(1.6), 0.15), CF(gx + gateW / 2 + 2, m(2.6), -hz - 1.6), C.OffWhite, M.SmoothPlastic)
	surfaceText(board, Enum.NormalId.Front, "STEELRISE\nCONSTRUCTION SITE\nPPE REQUIRED · DELIVERIES REPORT TO GATE", C.Charcoal, C.Safety)
	for k = 0, 3 do
		local banner = P(folder, "Banner", V(m(6), m(1.4), 0.06), CF(-hx + m(12) + k * m(26), m(1.3), -hz - 0.25), C.Charcoal, M.Fabric, { nc = true })
		if -hx + m(12) + k * m(26) < gx - gateW or -hx + m(12) + k * m(26) > gx + gateW then
			surfaceText(banner, Enum.NormalId.Front, "STEELRISE  ·  HARD HAT AREA", C.Charcoal, C.Safety)
		else
			banner:Destroy()
		end
	end
end

local function tree(folder, pos, rng, scale)
	scale = scale or 1
	local h = rng:NextNumber(5, 9) * scale
	cyl(folder, "Trunk", m(h * 0.45), m(0.3), CF(pos + V(0, m(h * 0.22), 0)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(86, 66, 48), M.Wood)
	local leaf = Color3.fromRGB(62 + rng:NextInteger(-8, 8), 92 + rng:NextInteger(-10, 10), 52)
	P(folder, "Canopy", V(m(h * 0.55), m(h * 0.6), m(h * 0.55)), CF(pos + V(0, m(h * 0.68), 0)), leaf, M.LeafyGrass, { shape = Enum.PartType.Ball, nc = true })
end

local function car(folder, cf, rng)
	local colours = { Color3.fromRGB(180, 180, 184), Color3.fromRGB(30, 32, 36), Color3.fromRGB(150, 24, 28), Color3.fromRGB(40, 70, 130), Color3.fromRGB(230, 230, 228) }
	local col = colours[rng:NextInteger(1, #colours)]
	P(folder, "CarBody", V(m(4.6), m(0.8), m(1.8)), cf * CF(0, m(0.6), 0), col, M.Metal, { refl = 0.05 })
	P(folder, "CarCabin", V(m(2.4), m(0.6), m(1.6)), cf * CF(-m(0.2), m(1.3), 0), Color3.fromRGB(40, 48, 56), M.Glass, { refl = 0.1 })
	for _, sx in ipairs({ -1.5, 1.4 }) do
		for _, sz in ipairs({ -0.85, 0.85 }) do
			cyl(folder, "Wheel", m(0.25), m(0.66), cf * CF(m(sx), m(0.33), m(sz)) * CFrame.Angles(0, math.pi / 2, 0), C.Rubber, M.SmoothPlastic, { ns = true })
		end
	end
end

-- Generic building massing with window bands.
local function building(folder, pos, w, d, h, kind, rng)
	local body, band
	if kind == "glass" then
		body = Color3.fromRGB(70, 92, 108)
		band = Color3.fromRGB(150, 170, 182)
	elseif kind == "brick" then
		body = Color3.fromRGB(140, 86, 66)
		band = Color3.fromRGB(46, 54, 62)
	elseif kind == "warehouse" then
		body = Color3.fromRGB(176, 180, 182)
		band = Color3.fromRGB(120, 124, 128)
	else
		body = Color3.fromRGB(196, 190, 178)
		band = Color3.fromRGB(56, 66, 76)
	end
	local mat = kind == "glass" and M.Glass or (kind == "brick" and M.Brick or (kind == "warehouse" and M.Metal or M.Concrete))
	local main = P(folder, "Building", V(w, h, d), CF(pos + V(0, h / 2, 0)), body, mat, { refl = kind == "glass" and 0.12 or 0 })
	main.CastShadow = true
	if kind == "warehouse" then
		local ribs = math.floor(w / m(2))
		for k = 0, ribs do
			P(folder, "Rib", V(0.3, h - 1, d + 0.3), CF(pos + V(-w / 2 + k * w / ribs, h / 2, 0)), band, M.Metal, { nc = true, ns = true })
		end
		P(folder, "Roof", V(w + 1, 1, d + 1), CF(pos + V(0, h + 0.5, 0)), Color3.fromRGB(120, 112, 100), M.CorrodedMetal)
		P(folder, "Door", V(m(5), m(5), 0.4), CF(pos + V(0, m(2.5), -d / 2 - 0.2)), Color3.fromRGB(70, 90, 120), M.Metal, { nc = true })
		return main
	end
	local floorH = m(3.6)
	local floors = math.floor(h / floorH)
	local stride = math.max(1, math.ceil(floors / 28))
	for f = 1, floors - 1, stride do
		local y = f * floorH - floorH * 0.45
		P(folder, "Band", V(w + 0.2, floorH * 0.5 * stride, d + 0.2), CF(pos + V(0, y + floorH * 0.25 * (stride - 1), 0)), band, M.Glass, { nc = true, ns = true, refl = 0.15 })
	end
	P(folder, "Parapet", V(w + 0.6, 1.2, d + 0.6), CF(pos + V(0, h + 0.6, 0)), body, mat, { nc = true })
	if h > m(12) then
		P(folder, "Plant", V(w * 0.4, m(2.5), d * 0.4), CF(pos + V(rng:NextNumber(-w * 0.2, w * 0.2), h + m(1.25), 0)), Color3.fromRGB(150, 150, 146), M.Metal)
	end
	return main
end

local function house(folder, pos, yaw, rng)
	local w, d, h = m(rng:NextNumber(9, 12)), m(rng:NextNumber(8, 10)), m(rng:NextNumber(5.5, 7))
	local cf = CF(pos) * CFrame.Angles(0, yaw, 0)
	local wall = ({ Color3.fromRGB(214, 206, 190), Color3.fromRGB(176, 120, 92), Color3.fromRGB(200, 204, 206) })[rng:NextInteger(1, 3)]
	P(folder, "House", V(w, h, d), cf * CF(0, h / 2, 0), wall, M.Brick)
	local roof = Color3.fromRGB(70, 66, 64)
	local wa = Instance.new("WedgePart")
	wa.Anchored = true
	wa.Size = V(w + 1, m(2.2), d / 2 + 0.5)
	wa.CFrame = cf * CF(0, h + m(1.1), -d / 4 - 0.25) * CFrame.Angles(0, math.pi, 0)
	wa.Color = roof
	wa.Material = M.Slate
	wa.Parent = folder
	local wb = wa:Clone()
	wb.CFrame = cf * CF(0, h + m(1.1), d / 4 + 0.25)
	wb.Parent = folder
	for k = -1, 1 do
		P(folder, "Window", V(m(1.2), m(1.3), 0.2), cf * CF(k * w / 3, h * 0.6, -d / 2 - 0.05), C.Glass, M.Glass, { nc = true, refl = 0.2 })
	end
end

function WorldFactory.buildSurroundings(site, folder)
	local lot = site.lotM * S
	local hx, hz = lot.X / 2, lot.Z / 2
	local rng = Random.new(Util.hashString(site.id) + 7)
	local style = site.style

	-- street furniture along the south street
	local roadZ = -hz - m(9)
	local lineCount = math.floor((lot.X + 400) / m(9))
	for k = 0, lineCount do
		local x = -lot.X / 2 - 200 + k * m(9)
		P(folder, "LaneMark", V(m(3), 0.06, m(0.15)), CF(x, 0.03, roadZ), Color3.fromRGB(232, 226, 210), M.SmoothPlastic, { nc = true, ns = true, nq = true })
	end
	for k = -3, 3 do
		local x = k * m(30)
		local pole = cyl(folder, "LampPost", m(8), m(0.2), CF(x, m(4), roadZ - m(7.5)) * CFrame.Angles(0, 0, math.pi / 2), C.SteelDark, M.Metal)
		local head = P(folder, "LampHead", V(m(0.6), m(0.2), m(1.4)), CF(x, m(8), roadZ - m(6.9)), C.SteelDark, M.Metal, { nc = true })
		if (site.lighting.clock or 12) > 17 or (site.lighting.clock or 12) < 7 then
			local l = Instance.new("SpotLight")
			l.Face = Enum.NormalId.Bottom
			l.Range = 40
			l.Angle = 110
			l.Brightness = 2
			l.Color = Color3.fromRGB(255, 214, 160)
			l.Parent = head
		end
		pole.CastShadow = true
	end

	-- Points on a rectangle grown `r` beyond the lot, so nothing lands inside it.
	local function ring(count, inner, outer, fn)
		for k = 1, count do
			local ang = (k / count) * math.pi * 2 + rng:NextNumber(-0.1, 0.1)
			local r = rng:NextNumber(inner, outer)
			local dx, dz = math.cos(ang), math.sin(ang)
			local t = math.min((hx + r) / math.max(math.abs(dx), 1e-3), (hz + r) / math.max(math.abs(dz), 1e-3))
			local p = V(dx * t, 0, dz * t)
			-- keep the south street and its far sidewalk clear
			if p.Z < -hz + m(2) and p.Z > roadZ - m(32) then
				p = V(p.X, 0, roadZ - m(32) - rng:NextNumber(0, m(10)))
			end
			fn(p, ang)
		end
	end

	if style == "Rural" then
		for _ = 1, 26 do
			local p = V(rng:NextNumber(-hx - 300, hx + 300), 0, rng:NextNumber(hz + 20, hz + 300))
			tree(folder, p, rng)
		end
		for _ = 1, 10 do
			tree(folder, V(rng:NextNumber(-hx - 200, -hx - 20), 0, rng:NextNumber(-hz, hz)), rng)
		end
	elseif style == "Suburban" then
		ring(7, m(30), m(55), function(p)
			building(folder, p, m(rng:NextNumber(28, 44)), m(rng:NextNumber(18, 26)), m(rng:NextNumber(8, 14)), "concrete", rng)
		end)
		for k = 1, 18 do
			car(folder, CF(-hx + m(10) + k * m(3.2), 0, roadZ - m(18)) * CFrame.Angles(0, math.pi / 2, 0), rng)
		end
		for _ = 1, 30 do
			tree(folder, V(rng:NextNumber(-hx - 150, hx + 150), 0, rng:NextNumber(hz + 10, hz + 160)), rng, 1.1)
		end
	elseif style == "Downtown" or style == "CityCenter" or style == "HighRise" then
		local lo, hi = 30, 90
		if style == "CityCenter" then
			lo, hi = 60, 160
		elseif style == "HighRise" then
			lo, hi = 50, 140
		end
		-- tight neighbours on the north and west sides of the lot
		building(folder, V(0, 0, hz + m(10)), lot.X, m(18), m(rng:NextNumber(lo * 0.5, lo)), "brick", rng)
		building(folder, V(-hx - m(10), 0, 0), m(18), lot.Z, m(rng:NextNumber(lo * 0.6, lo * 1.2)), "concrete", rng)
		ring(16, m(42), m(100), function(p)
			local kind = rng:NextNumber() < 0.5 and "glass" or "concrete"
			building(folder, p, m(rng:NextNumber(24, 40)), m(rng:NextNumber(24, 40)), m(rng:NextNumber(lo, hi)), kind, rng)
		end)
		for k = 1, 10 do
			car(folder, CF(-hx + k * m(6), 0, roadZ - m(3.2)) * CFrame.Angles(0, math.pi / 2, 0), rng)
		end
	elseif style == "Waterfront" then
		P(folder, "QuayWall", V(lot.X + 900, m(3), m(1)), CF(0, -m(1.5), hz + m(12.5)), Color3.fromRGB(150, 146, 138), M.Concrete)
		for k = -6, 6 do
			cyl(folder, "Bollard", m(0.7), m(0.4), CF(k * m(14), m(0.35), hz + m(11)) * CFrame.Angles(0, 0, math.pi / 2), C.SteelDark, M.Metal)
		end
		building(folder, V(hx + m(30), 0, 0), m(30), m(40), m(26), "glass", rng)
		building(folder, V(-hx - m(30), 0, -m(5)), m(34), m(30), m(22), "concrete", rng)
		building(folder, V(-hx - m(70), 0, m(10)), m(28), m(28), m(34), "glass", rng)
		for k = 1, 2 do
			local hull = P(folder, "Boat", V(m(16), m(2.5), m(5)), CF(k * m(40) - m(60), m(0.3), hz + m(30) + k * m(10)), C.OffWhite, M.SmoothPlastic)
			hull.CastShadow = true
			P(folder, "Wheelhouse", V(m(5), m(2.2), m(3.6)), hull.CFrame * CF(m(2), m(2.3), 0), Color3.fromRGB(46, 56, 70), M.Glass, { nc = true })
		end
	elseif style == "Industrial" then
		building(folder, V(-hx - m(36), 0, m(10)), m(60), m(46), m(12), "warehouse", rng)
		building(folder, V(hx + m(40), 0, -m(4)), m(64), m(52), m(14), "warehouse", rng)
		building(folder, V(m(30), 0, hz + m(45)), m(90), m(40), m(11), "warehouse", rng)
		-- rail siding (freight train arrives in phase 2)
		local railZ = hz + m(8)
		for _, dz in ipairs({ -0.72, 0.72 }) do
			P(folder, "Rail", V(lot.X + 600, m(0.15), m(0.07)), CF(0, m(0.32), railZ + m(dz)), Color3.fromRGB(110, 100, 92), M.Metal)
		end
		for k = 0, math.floor((lot.X + 600) / m(2.4)) do
			P(folder, "Sleeper", V(m(0.25), m(0.15), m(2.6)), CF(-(lot.X + 600) / 2 + k * m(2.4), m(0.18), railZ), Color3.fromRGB(70, 60, 50), M.Wood, { ns = true })
		end
		for k = 0, 5 do
			local c = ({ Color3.fromRGB(160, 50, 40), Color3.fromRGB(40, 90, 140), Color3.fromRGB(200, 140, 40) })[k % 3 + 1]
			P(folder, "Container", V(m(12.2), m(2.6), m(2.45)), CF(-hx - m(20) + (k % 3) * m(13), m(1.3) + math.floor(k / 3) * m(2.6), -hz - m(30)), c, M.Metal)
		end
	elseif style == "Residential" then
		for k = 0, 9 do
			house(folder, V(-hx + m(8) + k * m(14), 0, hz + m(14)), 0, rng)
			house(folder, V(-hx + m(8) + k * m(14), 0, roadZ - m(16)), math.pi, rng)
		end
		for _ = 1, 24 do
			tree(folder, V(rng:NextNumber(-hx - 100, hx + 100), 0, rng:NextNumber(hz + 26, hz + 120)), rng)
		end
	end
end

-- Welfare area, laydown dunnage and crane exclusion zone.
function WorldFactory.buildSiteDressing(site, folder)
	local lot = site.lotM * S
	local hx, hz = lot.X / 2, lot.Z / 2
	local ld = site.laydownM
	local lc = ld.center * S
	for k = 0, 5 do
		P(folder, "Dunnage", V(ld.size.X * S * 0.8, m(0.1), m(0.12)), CF(lc.X, m(0.05), lc.Z - ld.size.Z * S * 0.35 + k * ld.size.Z * S * 0.14), C.Timber, M.Wood, { ns = true })
	end
	-- crane exclusion barriers
	local cb = site.crane.posM * S
	for _, off in ipairs({ V(1, 0, 1), V(-1, 0, 1), V(1, 0, -1), V(-1, 0, -1) }) do
		local p = cb + off * m(5.2)
		P(folder, "CraneBarrier", V(m(2), m(1), m(0.5)), CF(p + V(0, m(0.5), 0)) * CFrame.Angles(0, math.rad(45 * off.X * off.Z), 0), Color3.fromRGB(240, 92, 24), M.SmoothPlastic)
	end
	-- crane signage
	local sign = P(folder, "CraneSign", V(m(1.6), m(1.1), 0.12), CF(cb + V(m(5.2), m(1.6), 0)) * CFrame.Angles(0, math.pi / 2, 0), C.Safety, M.SmoothPlastic)
	surfaceText(sign, Enum.NormalId.Front, "DANGER\nOVERHEAD LOADS", C.Safety, C.Charcoal)
	P(folder, "CraneSignPost", V(0.3, m(1.2), 0.3), CF(cb + V(m(5.25), m(0.6), 0)), C.SteelDark, M.Metal)
	-- welfare corner (avoids bays, laydown and the building grid)
	local corner = V(-hx + m(8), 0, -hz + m(6))
	if site.style == "Downtown" or site.style == "CityCenter" then
		corner = V(-hx + m(4), 0, hz - m(4))
	end
	local office = P(folder, "SiteOffice", V(m(6.06), m(2.6), m(2.44)), CF(corner + V(0, m(1.3), 0)), Color3.fromRGB(226, 226, 220), M.Metal)
	office.CastShadow = true
	P(folder, "OfficeWindow", V(m(1.2), m(0.9), 0.1), CF(corner + V(-m(1), m(1.6), m(1.23))), C.Glass, M.Glass, { nc = true, refl = 0.2 })
	P(folder, "OfficeDoor", V(m(0.9), m(2), 0.1), CF(corner + V(m(2.2), m(1.1), m(1.23))), Color3.fromRGB(70, 74, 80), M.Metal, { nc = true })
	local plate = P(folder, "OfficeSign", V(m(2.4), m(0.5), 0.08), CF(corner + V(0, m(2.3), m(1.25))), C.Charcoal, M.SmoothPlastic, { nc = true })
	surfaceText(plate, Enum.NormalId.Back, "SITE OFFICE", C.Charcoal, C.Safety)
	for k = 0, 1 do
		local tp = corner + V(m(4.6) + k * m(1.3), 0, 0)
		P(folder, "Toilet", V(m(1.1), m(2.3), m(1.2)), CF(tp + V(0, m(1.15), 0)), Color3.fromRGB(28, 98, 168), M.SmoothPlastic)
	end
	local skip = corner + V(m(10), 0, 0)
	P(folder, "Skip", V(m(5.4), m(1.5), m(2.3)), CF(skip + V(0, m(0.75), 0)), Color3.fromRGB(46, 92, 58), M.Metal)
end

---------------------------------------------------------------------------
-- Tower crane
---------------------------------------------------------------------------

function WorldFactory.buildCrane(craneDef, id)
	local cfg = CraneMath.config(craneDef)
	local model = Instance.new("Model")
	model.Name = "TowerCrane_" .. id
	model:SetAttribute("CraneId", id)
	model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent

	local Y = C.CraneYellow
	local base = cfg.base
	local Wm = CraneMath.MastWidth
	local half = Wm / 2 - 0.25

	-- Static: foundation + mast lattice + climbing ladder
	local static = Instance.new("Model")
	static.Name = "Static"
	static.Parent = model
	P(static, "Foundation", V(m(7), m(0.6), m(7)), CF(base + V(0, m(0.3), 0)), Color3.fromRGB(150, 148, 142), M.Concrete)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			P(static, "FixingAngle", V(1.2, m(1), 1.2), CF(base + V(sx * half, m(0.6) + m(0.5), sz * half)), Y, M.Metal)
		end
	end
	local mastBottom = base.Y + m(1.1)
	local mastTop = cfg.pivot.Y - 1.0
	local mastH = mastTop - mastBottom
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			P(static, "Chord", V(0.5, mastH, 0.5), CF(base.X + sx * half, mastBottom + mastH / 2, base.Z + sz * half), Y, M.Metal)
		end
	end
	local section = m(3)
	local nSec = math.floor(mastH / section)
	for k = 0, nSec - 1 do
		local y0 = mastBottom + k * section
		local y1 = y0 + section
		local corners = {
			V(-half, 0, -half),
			V(half, 0, -half),
			V(half, 0, half),
			V(-half, 0, half),
		}
		for f = 1, 4 do
			local a = corners[f]
			local b = corners[f % 4 + 1]
			local skipEntry = (k == 0 and f == 1)
			if not skipEntry then
				local flip = (k % 2 == 0)
				local p0 = base + (flip and a or b) + V(0, y0 - base.Y, 0)
				local p1 = base + (flip and b or a) + V(0, y1 - base.Y, 0)
				bar(static, "Diagonal", p0, p1, 0.22, Y, M.Metal, { ns = true })
			end
			bar(static, "Horizontal", base + a + V(0, y0 - base.Y, 0), base + b + V(0, y0 - base.Y, 0), 0.2, Y, M.Metal, { ns = true, nc = skipEntry })
		end
	end
	local truss = Instance.new("TrussPart")
	truss.Name = "MastLadder"
	truss.Size = V(2, 2 * math.floor(mastH / 2), 2)
	truss.CFrame = CF(base.X, mastBottom + truss.Size.Y / 2, base.Z)
	truss.Color = C.Galvanized
	truss.Material = M.Metal
	truss.Anchored = true
	truss.Style = Enum.Style.AlternateSupports
	truss.Parent = static
	-- top rest platform (where the ladder arrives) and the slewing ring
	-- landing ring around the ladder opening
	local ringW = (Wm + 2.4 - 2.6) / 2
	for _, sx in ipairs({ -1, 1 }) do
		P(static, "TopPlatform", V(ringW, 0.3, Wm + 2.4), CF(base.X + sx * (1.3 + ringW / 2), mastTop - 0.2, base.Z), C.SteelDark, M.DiamondPlate)
		P(static, "TopPlatform", V(2.6, 0.3, ringW), CF(base.X, mastTop - 0.2, base.Z + sx * (1.3 + ringW / 2)), C.SteelDark, M.DiamondPlate)
	end
	local topAccess = P(static, "CraneAccessTop", V(Wm + 2, 5, Wm + 2), CF(base.X, mastTop + 2.4, base.Z), Y, M.Metal, { tr = 1, nc = true })
	topAccess:SetAttribute("CraneInteract", "Access")
	for _, sz in ipairs({ -1, 1 }) do
		P(static, "TopRail", V(Wm + 2.4, 0.15, 0.15), CF(base.X, mastTop + 3.2, base.Z + sz * (Wm / 2 + 1.1)), Y, M.Metal, { nc = true })
	end
	cyl(static, "SlewRing", 0.8, Wm + 1.0, CF(cfg.pivot - V(0, 0.6, 0)) * CFrame.Angles(0, 0, math.pi / 2), C.SteelDark, M.Metal, { nc = true })
	local access = P(static, "CraneAccess", V(Wm + 1, m(2.4), 1), CF(base + V(0, m(0.6) + m(1.2), -(Wm / 2 + 1))), Y, M.Metal, { tr = 0.85, nc = true })
	access:SetAttribute("CraneInteract", "Access")
	local gateSign = P(static, "AccessSign", V(2.4, 1.4, 0.1), CF(base + V(0, m(1.8), -(Wm / 2 + 1.6))), C.Safety, M.SmoothPlastic, { nc = true })
	surfaceText(gateSign, Enum.NormalId.Front, "CRANE ACCESS\nAUTHORISED OPERATORS", C.Safety, C.Charcoal)

	-- Slewing assembly (moved as one model by the renderer)
	local slew = Instance.new("Model")
	slew.Name = "Slew"
	slew.Parent = model
	local root = P(slew, "Root", V(0.4, 0.4, 0.4), CF(cfg.pivot), Y, M.Metal, { tr = 1, nc = true, nq = true, ns = true })
	slew.PrimaryPart = root
	local frame = CF(cfg.pivot)
	local function sp(name, size, localCf, color, material, flags)
		return P(slew, name, size, frame * localCf, color, material, flags)
	end
	cyl(slew, "Turntable", 1.0, Wm + 0.6, frame * CF(0, 0.3, 0) * CFrame.Angles(0, 0, math.pi / 2), Y, M.Metal, { nc = true })
	sp("SlewUnit", V(Wm + 1, 1.6, Wm), CF(0, 1.4, 0), Y, M.Metal, { nc = true })
	-- jib (triangular lattice)
	local jy, jh, jw = CraneMath.JibBottomY, CraneMath.JibHeight, CraneMath.JibWidth
	local jibStart, jibEnd = 2.4, cfg.jib
	local jl = jibEnd - jibStart
	for _, sz in ipairs({ -1, 1 }) do
		sp("JibChord", V(jl, 0.5, 0.5), CF(jibStart + jl / 2, jy, sz * jw / 2), Y, M.Metal, { nc = true })
	end
	sp("JibTopChord", V(jl, 0.45, 0.45), CF(jibStart + jl / 2, jy + jh, 0), Y, M.Metal, { nc = true })
	local bayLen = 9
	local nb = math.floor(jl / bayLen)
	for k = 0, nb - 1 do
		local x0 = jibStart + k * bayLen
		local xm = x0 + bayLen / 2
		local x1 = x0 + bayLen
		for _, sz in ipairs({ -1, 1 }) do
			local bot0 = frame * V(x0, jy, sz * jw / 2)
			local top = frame * V(xm, jy + jh, 0)
			local bot1 = frame * V(x1, jy, sz * jw / 2)
			bar(slew, "JibLace", bot0, top, 0.2, Y, M.Metal, { nc = true, ns = true })
			bar(slew, "JibLace", top, bot1, 0.2, Y, M.Metal, { nc = true, ns = true })
		end
		sp("JibTie", V(0.18, 0.18, jw), CF(x0, jy, 0), Y, M.Metal, { nc = true, ns = true })
	end
	sp("JibTip", V(0.6, jh, jw + 0.4), CF(jibEnd, jy + jh / 2, 0), Y, M.Metal, { nc = true })
	local beacon = sp("AviationLight", V(0.5, 0.5, 0.5), CF(jibEnd, jy + jh + 0.4, 0), Color3.fromRGB(255, 40, 30), M.Neon, { nc = true, ns = true })
	beacon.Shape = Enum.PartType.Ball
	-- counter-jib with walkway, winch, counterweights
	local cl = cfg.counter
	for _, sz in ipairs({ -1, 1 }) do
		sp("CounterGirder", V(cl, 1.2, 0.8), CF(-cl / 2 - 1.5, jy + 0.6, sz * 1.8), Y, M.Metal, { nc = true })
		sp("Handrail", V(cl, 0.15, 0.15), CF(-cl / 2 - 1.5, jy + 3.4, sz * 2.4), Y, M.Metal, { nc = true, ns = true })
		local posts = math.floor(cl / 6)
		for k = 0, posts do
			sp("RailPost", V(0.15, 2.2, 0.15), CF(-2 - k * (cl - 2) / posts, jy + 2.3, sz * 2.4), Y, M.Metal, { nc = true, ns = true })
		end
	end
	sp("Walkway", V(cl, 0.2, 3.2), CF(-cl / 2 - 1.5, jy + 1.2, 0), C.SteelDark, M.DiamondPlate, { nc = true })
	sp("WinchHousing", V(3.2, 2.4, 2.6), CF(-6, jy + 2.4, 0), Color3.fromRGB(70, 74, 80), M.Metal, { nc = true })
	local drum = cyl(slew, "WinchDrum", 2.4, 1.6, frame * CF(-9.2, jy + 2.1, 0) * CFrame.Angles(0, math.pi / 2, 0), C.SteelDark, M.Metal, { nc = true })
	drum:SetAttribute("Sound", "Hoist")
	sp("Cabinet", V(1.6, 2.2, 1.2), CF(-12, jy + 2.3, 1.2), Color3.fromRGB(210, 210, 206), M.Metal, { nc = true })
	for k = 0, 3 do
		sp("Counterweight", V(1.0, m(2.2), 4.4), CF(-cl - 0.5 + k * 1.05, jy - m(0.4), 0), Color3.fromRGB(150, 150, 146), M.Concrete, { nc = true })
	end
	local brand = sp("Brand", V(cl * 0.7, 3.2, 0.2), CF(-cl / 2 - 1.5, jy + 1.6, 2.35), C.Charcoal, M.Metal, { nc = true })
	surfaceText(brand, Enum.NormalId.Back, "STEELRISE", C.Charcoal, C.Safety)
	local brandB = sp("BrandB", V(cl * 0.7, 3.2, 0.2), CF(-cl / 2 - 1.5, jy + 1.6, -2.35), C.Charcoal, M.Metal, { nc = true })
	surfaceText(brandB, Enum.NormalId.Front, "STEELRISE", C.Charcoal, C.Safety)
	-- operator cab
	local co = CraneMath.CabOffset
	local cabCf = frame * CF(co)
	local function cp(name, size, localCf, color, material, flags)
		return P(slew, name, size, cabCf * localCf, color, material, flags)
	end
	cp("CabFloor", V(3.6, 0.2, 3.0), CF(0, -2.2, 0), C.SteelDark, M.DiamondPlate, { nc = true })
	cp("CabRoof", V(3.8, 0.25, 3.2), CF(0, 2.2, 0), C.OffWhite, M.Metal, { nc = true })
	cp("CabBack", V(0.2, 4.4, 3.0), CF(-1.8, 0, 0), C.OffWhite, M.Metal, { nc = true })
	cp("CabSideIn", V(3.6, 4.4, 0.2), CF(0, 0, -1.5), C.OffWhite, M.Metal, { nc = true })
	cp("CabSideOutLow", V(3.6, 1.4, 0.2), CF(0, -1.5, 1.5), C.OffWhite, M.Metal, { nc = true })
	local glass = cp("CabSideGlass", V(3.2, 2.8, 0.06), CF(0, 0.7, 1.5), C.Glass, M.Glass, { nc = true, tr = 0.55, refl = 0.12, ns = true })
	glass.CanQuery = false
	local front = cp("CabFrontGlass", V(0.06, 4.0, 2.8), CF(1.8, 0, 0), C.Glass, M.Glass, { nc = true, tr = 0.6, refl = 0.1, ns = true })
	front.CanQuery = false
	cp("CabFloorGlass", V(1.2, 0.06, 2.6), CF(1.2, -2.1, 0), C.Glass, M.Glass, { nc = true, tr = 0.6, ns = true, nq = true })
	cp("Seat", V(1.0, 0.3, 1.0), CF(0.1, -1.3, 0), C.Charcoal, M.Fabric, { nc = true })
	cp("SeatBack", V(0.25, 1.4, 1.0), CF(-0.45, -0.6, 0), C.Charcoal, M.Fabric, { nc = true })
	cp("ConsoleL", V(0.9, 0.7, 0.35), CF(0.5, -1.0, -0.8), C.Charcoal, M.SmoothPlastic, { nc = true })
	cp("ConsoleR", V(0.9, 0.7, 0.35), CF(0.5, -1.0, 0.8), C.Charcoal, M.SmoothPlastic, { nc = true })
	local screen = cp("Display", V(0.06, 0.5, 0.8), CF(1.5, -0.2, -0.9), Color3.fromRGB(20, 60, 80), M.Neon, { nc = true, ns = true })
	screen.Transparency = 0.2
	local door = cp("CabDoor", V(3.6, 4.0, 0.3), CF(0, 0, -1.65), Y, M.Metal, { tr = 0.9, nc = true })
	door:SetAttribute("CraneInteract", "Cab")
	sp("CabWalk", V(3.2, 0.2, 2.8), CF(0, -1.0 - 2.2 + 1.4, 2.2), C.SteelDark, M.DiamondPlate, { nc = true })

	-- Trolley
	local trolley = Instance.new("Model")
	trolley.Name = "Trolley"
	trolley.Parent = model
	local st = CraneMath.defaultState(craneDef)
	local tcf = CraneMath.trolleyCf(cfg, st)
	local troot = P(trolley, "Root", V(0.3, 0.3, 0.3), tcf, Y, M.Metal, { tr = 1, nc = true, nq = true, ns = true })
	trolley.PrimaryPart = troot
	P(trolley, "Frame", V(3.2, 0.6, jw + 0.6), tcf * CF(0, 1.0, 0), Y, M.Metal, { nc = true })
	for _, sx in ipairs({ -1.2, 1.2 }) do
		for _, sz in ipairs({ -1, 1 }) do
			cyl(trolley, "Wheel", 0.3, 0.6, tcf * CF(sx, 1.75, sz * jw / 2) * CFrame.Angles(0, math.pi / 2, 0), C.SteelDark, M.Metal, { nc = true, ns = true })
		end
	end
	for _, sx in ipairs({ -0.5, 0.5 }) do
		cyl(trolley, "Sheave", 0.25, 0.9, tcf * CF(sx, 0.2, 0) * CFrame.Angles(0, math.pi / 2, 0), C.SteelDark, M.Metal, { nc = true, ns = true })
	end

	-- Hook block
	local hook = Instance.new("Model")
	hook.Name = "Hook"
	hook.Parent = model
	local hcf = CraneMath.hookCf(cfg, st)
	local hroot = P(hook, "Root", V(0.3, 0.3, 0.3), hcf, Y, M.Metal, { tr = 1, nc = true, nq = true, ns = true })
	hook.PrimaryPart = hroot
	P(hook, "Block", V(1.3, 2.0, 1.9), hcf * CF(0, 1.9, 0), Y, M.Metal, { nc = true })
	for k = 0, 3 do
		for _, sz in ipairs({ -1, 1 }) do
			P(hook, "Stripe", V(0.32, 1.9, 0.04), hcf * CF(-0.48 + k * 0.32, 1.9, sz * 0.97) * CFrame.Angles(0, 0, math.rad(30)), k % 2 == 0 and C.Charcoal or Y, M.SmoothPlastic, { nc = true, ns = true })
		end
	end
	cyl(hook, "BlockSheave", 1.4, 1.1, hcf * CF(0, 2.9, 0) * CFrame.Angles(0, math.pi / 2, 0), C.SteelDark, M.Metal, { nc = true, ns = true })
	cyl(hook, "Shank", 0.7, 0.35, hcf * CF(0, 0.6, 0) * CFrame.Angles(0, 0, math.pi / 2), C.SteelDark, M.Metal, { nc = true })
	P(hook, "HookBack", V(0.3, 0.8, 0.3), hcf * CF(-0.32, 0.05, 0), Y, M.Metal, { nc = true })
	P(hook, "HookBowl", V(0.9, 0.3, 0.3), hcf * CF(0, -0.32, 0), Y, M.Metal, { nc = true })
	P(hook, "HookTip", V(0.3, 0.45, 0.3), hcf * CF(0.32, -0.1, 0), Y, M.Metal, { nc = true })
	P(hook, "Latch", V(0.06, 0.6, 0.08), hcf * CF(0.0, 0.15, 0) * CFrame.Angles(0, 0, math.rad(-35)), C.SteelDark, M.Metal, { nc = true, ns = true })

	-- Hoist falls (two parts falls, reshaped by the renderer)
	local cables = Instance.new("Folder")
	cables.Name = "Cables"
	cables.Parent = model
	for k = 1, 2 do
		local c = cyl(cables, "Fall" .. k, 1, 0.09, CF(), Color3.fromRGB(40, 40, 42), M.Metal, { nc = true, ns = true, nq = true })
		c.CanQuery = false
	end

	CraneMath.writeAttributes(model, st)
	model:SetAttribute("Operator", 0)
	model:SetAttribute("LoadId", "")
	model:SetAttribute("ResetSeq", 0)
	model.PrimaryPart = root
	return model, cfg
end

---------------------------------------------------------------------------
-- Truck + flatbed trailer
---------------------------------------------------------------------------

-- Local frame: origin at road level under the middle of the bed, bed along +X,
-- tractor toward -X. Returns the model and the bed-top height in studs.
function WorldFactory.buildTrailer(bayCf, rngSeed)
	local rng = Random.new(rngSeed or 1)
	local model = Instance.new("Model")
	model.Name = "Trailer"
	local root = P(model, "Root", V(0.4, 0.4, 0.4), CF(), C.Steel, M.Metal, { tr = 1, nc = true, nq = true, ns = true })
	model.PrimaryPart = root
	local D = Config.Delivery
	local L, W, H = m(D.BedLength), m(D.BedWidth), m(D.BedHeight)
	-- deck and frame
	P(model, "Deck", V(L, m(0.06), W), CF(0, H - m(0.03), 0), Color3.fromRGB(122, 96, 70), M.WoodPlanks)
	for _, sz in ipairs({ -1, 1 }) do
		P(model, "SideRail", V(L, m(0.25), m(0.08)), CF(0, H - m(0.14), sz * (W / 2 - m(0.04))), C.SteelDark, M.Metal)
		P(model, "MainBeam", V(L - m(1), m(0.45), m(0.14)), CF(m(0.5), H - m(0.45), sz * m(0.45)), C.SteelDark, M.Metal)
		for k = 0, 7 do
			P(model, "StakePocket", V(m(0.12), m(0.14), m(0.06)), CF(-L / 2 + m(1) + k * m(2), H - m(0.28), sz * (W / 2 + m(0.02))), C.SteelDark, M.Metal, { nc = true, ns = true })
		end
		P(model, "Mudflap", V(m(0.02), m(0.6), m(0.6)), CF(L / 2 - m(0.4), m(0.45), sz * m(0.9)), C.Rubber, M.SmoothPlastic, { nc = true })
		local tl = P(model, "TailLight", V(m(0.05), m(0.12), m(0.25)), CF(L / 2 + m(0.02), H - m(0.3), sz * m(1.0)), Color3.fromRGB(200, 20, 20), M.Neon, { nc = true, ns = true })
		tl.Transparency = 0.1
	end
	P(model, "RearBumper", V(m(0.15), m(0.15), W - m(0.2)), CF(L / 2 - m(0.1), m(0.75), 0), C.SteelDark, M.Metal, { nc = true })
	P(model, "LandingGear", V(m(0.15), H - m(0.6), m(1.8)), CF(-L / 2 + m(3.2), (H - m(0.6)) / 2 + m(0.1), 0), C.SteelDark, M.Metal, { nc = true })
	local tireDia, tireW = m(1.0), m(0.28)
	local function wheelSet(x, dual)
		for _, sz in ipairs({ -1, 1 }) do
			local offs = dual and { 0.78, 1.08 } or { 1.0 }
			for _, o in ipairs(offs) do
				cyl(model, "Tire", tireW, tireDia, CF(x, tireDia / 2, sz * m(o)) * CFrame.Angles(0, math.pi / 2, 0), C.Rubber, M.SmoothPlastic, { ns = false })
			end
			cyl(model, "Hub", m(0.05), m(0.5), CF(x, tireDia / 2, sz * m(dual and 1.23 or 1.15)) * CFrame.Angles(0, math.pi / 2, 0), Color3.fromRGB(190, 192, 196), M.Metal, { nc = true, ns = true })
		end
	end
	for _, ax in ipairs({ 4.9, 6.2, 7.4 }) do
		wheelSet(m(ax), true)
	end
	-- tractor (conventional long-hood)
	local paint = ({ Color3.fromRGB(120, 18, 22), Color3.fromRGB(236, 236, 232), Color3.fromRGB(22, 44, 92), Color3.fromRGB(26, 26, 28) })[rng:NextInteger(1, 4)]
	local tx = -L / 2
	P(model, "TractorFrame", V(m(7.4), m(0.35), m(1.0)), CF(tx - m(3.2), m(0.95), 0), C.SteelDark, M.Metal)
	P(model, "FifthWheel", V(m(1.2), m(0.15), m(1.4)), CF(tx + m(0.4), m(1.25), 0), C.Rubber, M.Metal, { nc = true })
	wheelSet(tx - m(0.6), true)
	wheelSet(tx - m(1.9), true)
	wheelSet(tx - m(7.3), false)
	local sleeper = P(model, "Sleeper", V(m(1.6), m(2.4), m(2.4)), CF(tx - m(3.6), m(2.35), 0), paint, M.Metal, { refl = 0.05 })
	sleeper.CastShadow = true
	P(model, "Cab", V(m(1.6), m(2.0), m(2.4)), CF(tx - m(5.2), m(2.15), 0), paint, M.Metal, { refl = 0.05 })
	P(model, "Windshield", V(m(0.05), m(0.85), m(2.1)), CF(tx - m(6.0), m(2.65), 0) * CFrame.Angles(0, 0, math.rad(-12)), Color3.fromRGB(40, 52, 60), M.Glass, { nc = true, refl = 0.25 })
	for _, sz in ipairs({ -1, 1 }) do
		P(model, "SideWindow", V(m(0.9), m(0.7), m(0.03)), CF(tx - m(5.3), m(2.65), sz * m(1.21)), Color3.fromRGB(40, 52, 60), M.Glass, { nc = true, refl = 0.25 })
		P(model, "Mirror", V(m(0.08), m(0.4), m(0.18)), CF(tx - m(6.1), m(2.6), sz * m(1.45)), C.SteelDark, M.Metal, { nc = true, ns = true })
		cyl(model, "Exhaust", m(2.6), m(0.16), CF(tx - m(4.35), m(2.8), sz * m(1.05)) * CFrame.Angles(0, 0, math.pi / 2), Color3.fromRGB(200, 202, 206), M.Metal, { nc = true, refl = 0.2 })
		cyl(model, "FuelTank", m(1.3), m(0.6), CF(tx - m(4.6), m(0.95), sz * m(0.95)), Color3.fromRGB(196, 198, 202), M.Metal, { nc = true, refl = 0.15 })
		P(model, "Headlight", V(m(0.05), m(0.2), m(0.35)), CF(tx - m(8.2), m(1.35), sz * m(0.8)), Color3.fromRGB(240, 240, 230), M.Neon, { nc = true, ns = true })
	end
	P(model, "Hood", V(m(2.2), m(1.3), m(2.0)), CF(tx - m(7.1), m(1.55), 0), paint, M.Metal, { refl = 0.05 })
	P(model, "Grille", V(m(0.08), m(1.2), m(1.2)), CF(tx - m(8.2), m(1.55), 0), Color3.fromRGB(200, 202, 206), M.DiamondPlate, { nc = true, refl = 0.2 })
	P(model, "Bumper", V(m(0.3), m(0.35), m(2.4)), CF(tx - m(8.35), m(0.75), 0), Color3.fromRGB(200, 202, 206), M.Metal, { refl = 0.2 })
	for k = -2, 2 do
		P(model, "Marker", V(m(0.08), m(0.06), m(0.12)), CF(tx - m(5.95), m(3.2), k * m(0.35)), Color3.fromRGB(255, 160, 30), M.Neon, { nc = true, ns = true })
	end
	local engine = P(model, "Engine", V(m(1), m(0.6), m(1)), CF(tx - m(7.1), m(1.2), 0), C.SteelDark, M.Metal, { nc = true, tr = 1, nq = true, ns = true })
	engine:SetAttribute("Sound", "TruckIdle")
	local cabInteract = P(model, "TruckInteract", V(m(2), m(3), m(2.6)), CF(tx - m(5), m(1.8), 0), C.Steel, M.SmoothPlastic, { tr = 1, nc = true, ns = true })
	cabInteract:SetAttribute("TrailerInteract", "Cab")
	model:PivotTo(bayCf)
	return model, H
end

return WorldFactory
]]></ProtectedString>
</Properties>
</Item>
</Item>
