<Item class="ModuleScript" referent="RBX00000022">
<Properties>
<string name="Name">Net</string>
<ProtectedString name="Source"><![CDATA[-- Safe wrappers around the STEELRISE remotes.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Remotes = require(Shared.Remotes)
local State = require(script.Parent.State)

local Net = {}

-- Invokes a RemoteFunction; returns ok, message, data. Failures with a
-- message are shown as a warning toast unless `quiet`.
function Net.call(name, quiet, ...)
	local remote = Remotes.get(name)
	if not remote then
		return false, "Not connected."
	end
	local results = table.pack(pcall(remote.InvokeServer, remote, ...))
	if not results[1] then
		warn("[STEELRISE] remote", name, "failed:", results[2])
		if not quiet and State.notify then
			State.notify("Connection problem — try again.", "error")
		end
		return false, "Connection problem."
	end
	local ok, msg, data = results[2], results[3], results[4]
	if not ok and msg and not quiet and State.notify then
		State.notify(msg, "warn")
	elseif ok and msg and not quiet and State.notify then
		State.notify(msg, "success")
	end
	return ok, msg, data
end

function Net.event(name)
	return Remotes.get(name)
end

return Net
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000023">
<Properties>
<string name="Name">Placement</string>
<ProtectedString name="Source"><![CDATA[-- Hand placement of carried components: a transparent ghost snaps to grid or
-- connection points, turns green/red and explains exactly why a placement is
-- invalid. R/Z/C rotate, T toggles free placement for suitable items, arrow
-- keys nudge, LMB sets the piece, G drops it.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local Factory = require(Shared.ModelFactory)
local BuildRules = require(Shared.BuildRules)

local State = require(script.Parent.State)
local HUD = require(script.Parent.HUD)
local Net = require(script.Parent.Net)
local View = require(script.Parent.View)

local Placement = {}
local player = Players.LocalPlayer
local S = Config.S

local ghost, ghostDef, highlight
local rot = 0
local free = false
local nudge = Vector3.zero
local lastCf, lastValid, lastReason = nil, false, nil
local placing = false
local solveAcc = 0

local function clearGhost()
	if ghost then
		ghost:Destroy()
	end
	ghost, ghostDef, highlight = nil, nil, nil
	HUD.setPlacement(nil)
end

local function makeGhost(def)
	clearGhost()
	ghostDef = def
	ghost = Factory.build(def, CFrame.new(0, -500, 0), { ghost = true, preview = true })
	ghost.Name = "SR_Ghost"
	highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0.1
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Parent = ghost
	ghost.Parent = workspace.CurrentCamera
	rot, free, nudge = 0, false, Vector3.zero
end

local function findCarried()
	local site = State.site
	local comps = site and site:FindFirstChild("Components")
	if not comps then
		return nil
	end
	local me = tostring(player.UserId)
	for _, m in ipairs(comps:GetChildren()) do
		if m:GetAttribute("State") == "Carried" and m:GetAttribute("Holder") == me then
			return m
		end
	end
	return nil
end

local function hints(def)
	local h = "LMB place · R rotate · Z/C fine"
	if def.allowFree then
		h ..= " · T free" .. (free and " (ON)" or "")
		if free then
			h ..= " · arrows nudge"
		end
	end
	return h .. " · G drop"
end

local function update(dt)
	local carried = State.carrying
	if not carried or not carried.Parent or State.mode ~= "Play" or State.crane.operating then
		if ghost then
			clearGhost()
		end
		return
	end
	local def = Registry.get(carried:GetAttribute("ItemId"))
	if not def then
		return
	end
	if ghostDef ~= def then
		makeGhost(def)
	end
	if State.uiBlocking then
		ghost:PivotTo(CFrame.new(0, -500, 0))
		HUD.setPlacement(nil)
		return
	end
	solveAcc += dt
	if solveAcc < 1 / 30 then
		return
	end
	solveAcc = 0
	local world = State.world
	local exclude = { carried, ghost }
	local hit = View.cast(Config.Reach.Place + 14, exclude)
	local cf, reason
	if hit then
		local aim = { point = hit.Position, hit = hit.Instance, normal = hit.Normal }
		cf, reason = BuildRules.solve(world, def, aim, { rot = rot, free = free, nudge = nudge * S, excludeModels = { carried, player.Character } })
	else
		reason = "Aim at the ground or a connection."
	end
	local valid = false
	if cf then
		local ok, why = BuildRules.validate(world, def, cf, {
			exclude = { carried:GetAttribute("ComponentId") },
			excludeModels = { carried, player.Character },
			actorPos = View.rootPosition(),
			reach = Config.Reach.Place,
		})
		valid, reason = ok, why
		ghost:PivotTo(cf)
	elseif hit then
		ghost:PivotTo(CFrame.new(hit.Position + Vector3.new(0, def.originBottom and 0 or def.size.Y / 2, 0)) * CFrame.Angles(0, math.rad(90 * rot), 0))
	else
		ghost:PivotTo(CFrame.new(0, -500, 0))
	end
	lastCf, lastValid, lastReason = cf, valid, reason
	highlight.FillColor = valid and Config.Colors.Valid or Config.Colors.Invalid
	highlight.OutlineColor = valid and Config.Colors.Valid or Config.Colors.Invalid
	HUD.setPlacement({
		title = def.name .. (free and "  ·  FREE PLACEMENT" or ""),
		valid = valid,
		reason = reason,
		hints = hints(def),
	})
end

local function place()
	if placing or not State.carrying or not lastCf then
		if lastReason then
			State.notify(lastReason, "warn")
		end
		return
	end
	if not lastValid then
		State.notify(lastReason or "Can't place here.", "warn")
		return
	end
	placing = true
	local id = State.carrying:GetAttribute("ComponentId")
	local cf = lastCf
	task.spawn(function()
		local ok = Net.call("Handle", false, "Place", id, cf, free)
		placing = false
		if ok then
			State.carrying = nil
			clearGhost()
			State.fire("CarryChanged", nil)
		end
	end)
end

function Placement.init()
	UserInputService.InputBegan:Connect(function(input, gp)
		if gp or State.mode ~= "Play" or State.uiBlocking or State.crane.operating or not State.carrying then
			return
		end
		local def = ghostDef
		local k = input.KeyCode
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			place()
		elseif k == Enum.KeyCode.R then
			-- always a quarter turn; Z/C step 15° in free placement
			rot += free and (90 / Config.Grid.FreeRotateStep) or 1
		elseif k == Enum.KeyCode.Z then
			rot -= 1
		elseif k == Enum.KeyCode.C then
			rot += 1
		elseif k == Enum.KeyCode.T then
			if def and def.allowFree then
				free = not free
				nudge = Vector3.zero
			else
				State.notify("Free placement is only for props and equipment — structure snaps to its connections.", "info")
			end
		elseif k == Enum.KeyCode.G then
			task.spawn(function()
				local ok = Net.call("Handle", false, "Drop")
				if ok then
					State.carrying = nil
					clearGhost()
					State.fire("CarryChanged", nil)
				end
			end)
		elseif free and (k == Enum.KeyCode.Up or k == Enum.KeyCode.Down or k == Enum.KeyCode.Left or k == Enum.KeyCode.Right) then
			local step = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 0.5 or Config.Grid.Fine
			local look = workspace.CurrentCamera.CFrame.LookVector
			local fwd = Vector3.new(look.X, 0, look.Z)
			fwd = fwd.Magnitude > 0 and fwd.Unit or Vector3.zAxis
			local right = fwd:Cross(Vector3.yAxis)
			local d = (k == Enum.KeyCode.Up and fwd) or (k == Enum.KeyCode.Down and -fwd) or (k == Enum.KeyCode.Right and right) or -right
			nudge += d * step
		end
	end)

	-- track what we carry (attribute changes replicate from the server)
	local pollAcc = 0
	RunService.RenderStepped:Connect(function(dt)
		pollAcc += dt
		if pollAcc > 0.2 then
			pollAcc = 0
			local m = findCarried()
			if m ~= State.carrying then
				State.carrying = m
				State.fire("CarryChanged", m)
				local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if hum then
					local def = m and Registry.get(m:GetAttribute("ItemId"))
					local canClimb = not def or Config.WeightClasses[def.weightClass].climb
					hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, canClimb)
				end
			end
		end
		update(dt)
	end)
end

return Placement
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000024">
<Properties>
<string name="Name">Settings</string>
<ProtectedString name="Source"><![CDATA[-- Applies player settings (graphics, audio, controls) locally and builds the
-- settings panel used by both the main menu and the pause menu.

local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)

local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Audio = require(script.Parent.Audio)
local Net = require(script.Parent.Net)

local C = Config.Colors
local Settings = {}

function Settings.apply()
	local s = State.settings
	local preset = Config.Graphics.Presets[s.graphics] or Config.Graphics.Presets.Balanced
	local post = s.post and preset.post
	for _, name in ipairs({ "SR_Bloom", "SR_SunRays", "SR_Grade" }) do
		local e = Lighting:FindFirstChild(name)
		if e then
			e.Enabled = post
		end
	end
	local dof = Lighting:FindFirstChild("SR_DOF")
	if dof then
		dof.Enabled = post and (s.graphics == "High" or s.graphics == "Ultra")
	end
	Lighting.GlobalShadows = s.shadows and preset.shadows
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if atm then
		local base = State.siteDef and State.siteDef.lighting and State.siteDef.lighting.density or 0.32
		atm.Density = base * (preset.atmosphere / 0.32)
	end
	State.particleScale = s.particles and preset.particles or 0
	State.detailDistance = preset.detailDistance
	if workspace.CurrentCamera then
		workspace.CurrentCamera.FieldOfView = s.fov
	end
	UserInputService.MouseDeltaSensitivity = s.mouseSensitivity
	Audio.setVolumes(s.volumes)
end

local saveQueued = false
function Settings.save()
	if saveQueued then
		return
	end
	saveQueued = true
	task.delay(1.5, function()
		saveQueued = false
		Net.call("Save", true, "Settings", State.settings)
	end)
end

local function changed()
	Settings.apply()
	Settings.save()
end

local function section(parent, title, order)
	local l = UIKit.label(parent, title, 13, UIKit.Font.Bold, C.Safety, { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 26) })
	return l
end

-- Builds the settings controls into a scrolling frame.
function Settings.buildPanel(parent)
	local scroll = UIKit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Steel,
		Parent = parent,
	})
	UIKit.padding(scroll, 4, 4, 14, 4)
	UIKit.list(scroll, nil, 8)
	local s = State.settings
	local order = 0
	local function nxt()
		order += 1
		return order
	end
	section(scroll, "GRAPHICS", nxt())
	local seg = UIKit.segmented(scroll, "Quality preset", Config.Graphics.Order, s.graphics, function(v)
		s.graphics = v
		changed()
	end)
	seg.LayoutOrder = nxt()
	UIKit.toggle(scroll, "Shadows", s.shadows, function(v)
		s.shadows = v
		changed()
	end).LayoutOrder = nxt()
	UIKit.toggle(scroll, "Post-processing (bloom, sun rays, grading, depth of field)", s.post, function(v)
		s.post = v
		changed()
	end).LayoutOrder = nxt()
	UIKit.toggle(scroll, "Particles (welding sparks, dust)", s.particles, function(v)
		s.particles = v
		changed()
	end).LayoutOrder = nxt()
	local fov = UIKit.slider(scroll, "Field of view", s.fov, 60, 95, 1, function(v)
		s.fov = v
		changed()
	end, function(v)
		return v .. "°"
	end)
	fov.LayoutOrder = nxt()

	section(scroll, "CONTROLS", nxt())
	local sens = UIKit.slider(scroll, "Mouse sensitivity", s.mouseSensitivity, 0.2, 2.5, 0.05, function(v)
		s.mouseSensitivity = v
		changed()
	end, function(v)
		return string.format("%.2f", v)
	end)
	sens.LayoutOrder = nxt()
	UIKit.toggle(scroll, "Start in third-person view", s.thirdPerson, function(v)
		s.thirdPerson = v
		changed()
		State.fire("ViewPreference", v)
	end).LayoutOrder = nxt()
	UIKit.toggle(scroll, "Crane alignment assist on by default", s.assist, function(v)
		s.assist = v
		State.crane.assist = v
		changed()
	end).LayoutOrder = nxt()

	section(scroll, "AUDIO", nxt())
	for _, g in ipairs(Config.AudioGroups) do
		local row = UIKit.slider(scroll, g == "Master" and "Master volume" or g, s.volumes[g] or 0.8, 0, 1, 0.05, function(v)
			s.volumes[g] = v
			changed()
		end, function(v)
			return math.floor(v * 100 + 0.5) .. "%"
		end)
		row.LayoutOrder = nxt()
	end
	return scroll
end

Lighting.ChildAdded:Connect(function()
	task.defer(Settings.apply)
end)

return Settings
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000025">
<Properties>
<string name="Name">State</string>
<ProtectedString name="Source"><![CDATA[-- Client-side shared state and a tiny event bus between controllers.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local State = {
	mode = "Loading", -- Loading | Menu | Play
	settings = Util.deepCopy(Config.DefaultSettings),
	favorites = {},
	menuInfo = nil,
	site = nil, -- workspace.SteelriseSite
	siteDef = nil,
	world = nil, -- BuildRules world
	tool = "TL-HANDS",
	carrying = nil,
	firstPerson = true,
	uiBlocking = false, -- catalog / pause menu open
	crane = { operating = false, id = nil, mode = nil, view = "Cab", assist = true },
	tutorialActive = false,
	lastStartMode = nil,
}

local handlers = {}

function State.on(name, fn)
	handlers[name] = handlers[name] or {}
	table.insert(handlers[name], fn)
end

function State.fire(name, ...)
	for _, fn in ipairs(handlers[name] or {}) do
		task.spawn(fn, ...)
	end
end

return State
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000026">
<Properties>
<string name="Name">TrailerAnim</string>
<ProtectedString name="Source"><![CDATA[-- Drive-in / drive-out animation for delivery trucks. The server places a
-- truck at its bay immediately; every client animates it (and its strapped
-- cargo) rolling in from the road and back out, and plays engine audio.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)

local State = require(script.Parent.State)
local Audio = require(script.Parent.Audio)

local TrailerAnim = {}
local D = Config.Delivery
local DIST = 70 * Config.S

local anims = {} -- trailer model -> { final, cargo = {model -> finalCf}, phase, engine }

local function now()
	return workspace:GetServerTimeNow()
end

local function easeOut(t)
	return 1 - (1 - t) ^ 3
end

local function easeIn(t)
	return t * t * t
end

local function cargoOf(site, id)
	local out = {}
	local comps = site:FindFirstChild("Components")
	if comps then
		for _, m in ipairs(comps:GetChildren()) do
			if m:GetAttribute("TrailerId") == id then
				table.insert(out, m)
			end
		end
	end
	return out
end

local function moveAll(a, offset)
	local cf = a.final * CFrame.new(offset, 0, 0)
	a.model:PivotTo(cf)
	local rel = cf * a.final:Inverse()
	for m, finalCf in pairs(a.cargo) do
		if m.Parent and (m:GetAttribute("State") == "Restrained" or m:GetAttribute("State") == "Loose") then
			m:PivotTo(rel * finalCf)
		end
	end
end

function TrailerAnim.init()
	RunService.RenderStepped:Connect(function(dt)
		local site = State.site
		local folder = site and site:FindFirstChild("Trailers")
		if not folder then
			return
		end
		local t = now()
		for _, model in ipairs(folder:GetChildren()) do
			local a = anims[model]
			if not a then
				a = { model = model, final = model:GetPivot(), cargo = {}, phase = "idle" }
				local engine = model:FindFirstChild("Engine")
				a.engine = Audio.loop("TruckIdle", engine)
				anims[model] = a
				model.AncestryChanged:Connect(function()
					if not model.Parent then
						if a.engine then
							a.engine:destroy()
						end
						anims[model] = nil
					end
				end)
			end
			local arriveAt = model:GetAttribute("ArriveAt") or 0
			local departAt = model:GetAttribute("DepartAt") or 0
			local engineLevel = 0.45
			if departAt > 0 then
				if a.phase ~= "depart" then
					a.phase = "depart"
					a.cargo = {}
					Audio.play("TruckAirBrake", model.PrimaryPart, 0.6)
				end
				local p = math.clamp((t - departAt) / D.DepartSeconds, 0, 1)
				moveAll(a, -easeIn(p) * DIST)
				engineLevel = 1
			elseif arriveAt > 0 and t < arriveAt + D.ArriveSeconds then
				if a.phase ~= "arrive" then
					a.phase = "arrive"
					a.cargo = {}
					for _, m in ipairs(cargoOf(site, model:GetAttribute("TrailerId"))) do
						a.cargo[m] = m:GetPivot()
					end
				end
				local p = math.clamp((t - arriveAt) / D.ArriveSeconds, 0, 1)
				moveAll(a, (1 - easeOut(p)) * DIST)
				engineLevel = 1 - p * 0.5
			elseif a.phase == "arrive" then
				moveAll(a, 0)
				a.phase = "idle"
				a.cargo = {}
				Audio.play("TruckAirBrake", model.PrimaryPart)
			end
			if a.engine then
				a.engine:set(engineLevel, 0.9 + engineLevel * 0.3)
				a.engine:step(dt)
			end
		end
	end)
end

function TrailerAnim.reset()
	for _, a in pairs(anims) do
		if a.engine then
			a.engine:destroy()
		end
	end
	anims = {}
end

return TrailerAnim
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000027">
<Properties>
<string name="Name">Tutorial</string>
<ProtectedString name="Source"><![CDATA[-- Short playable tutorial on the Empty Land site: unload, rig, lift, land,
-- bolt, unhook, carry scaffold, save. Each step advances on real gameplay
-- events from the server, never on a timer.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")

local State = require(script.Parent.State)
local HUD = require(script.Parent.HUD)
local Net = require(script.Parent.Net)
local Settings = require(script.Parent.Settings)
local View = require(script.Parent.View)

local Tutorial = {}
local player = Players.LocalPlayer
local index = 0
local steps

local function itemIs(data, prefix)
	return data and type(data.item) == "string" and string.sub(data.item, 1, #prefix) == prefix
end

steps = {
	{
		text = "Welcome to STEELRISE. Walk to the flatbed truck parked in unloading bay 1.",
		check = function()
			local site = State.site
			local trailers = site and site:FindFirstChild("Trailers")
			local root = View.rootPosition()
			if not trailers or not root then
				return false
			end
			for _, t in ipairs(trailers:GetChildren()) do
				if (t:GetPivot().Position - root).Magnitude < 40 then
					return true
				end
			end
			return false
		end,
	},
	{ text = "Every stack is strapped down. Aim at an orange ratchet strap and press E to release it.", event = "StrapReleased" },
	{ text = "Take the crane: equip the radio remote (5) to work from the ground, or press E at the yellow access gate at the base of the mast to sit in the cab.", event = "CraneEntered" },
	{
		text = "Fly the hook over a precast footing — A/D slew, W/S trolley, R/F hoist, Shift for fine control. When the crane panel says “G — hook”, press G.",
		event = "Rigged",
		match = function(d)
			return itemIs(d, "FT-")
		end,
	},
	{
		text = "Lift it clear (R), swing it to the yellow blueprint outline and lower it (F). Assist (H) shows a target ghost and directions. Press ENTER when it reads ALIGNED.",
		event = "Landed",
		match = function(d)
			return itemIs(d, "FT-")
		end,
	},
	{ text = "Footings are grouted, not bolted — press G to unhook.", event = "Unhooked" },
	{
		text = "Next, a column. It is lifted by its top lug so it hangs plumb. Hook one, land it on the footing (ENTER).",
		event = "Landed",
		match = function(d)
			return itemIs(d, "COL-")
		end,
	},
	{
		text = "The crane holds it while you bolt it down. Leave the controls (X), equip the impact wrench (2) and hold the left mouse button on each yellow anchor nut.",
		event = "Installed",
		match = function(d)
			return itemIs(d, "COL-")
		end,
	},
	{ text = "Column is fastened. Take the controls again (5 or the cab) and unhook it with G.", event = "Unhooked" },
	{
		text = "Scaffold time. In the laydown yard, pick up a base jack (E) and place it on the ground next to the frame (left click).",
		event = "Placed",
		match = function(d)
			return itemIs(d, "SC-BASEJACK")
		end,
	},
	{ text = "Good. Keep building: uprights on jacks, ledgers between rosettes (hammer them tight with 3), then a platform deck. Press P and save to a slot to finish the tutorial.", local_event = "Saved" },
}

local function show()
	local s = steps[index]
	if not s then
		return
	end
	HUD.setTutorial(s.text, index, #steps, Tutorial.skip)
end

local function finish(skipped)
	index = 0
	State.tutorialActive = false
	HUD.setTutorial(nil)
	State.settings.tutorialDone = true
	Settings.save()
	State.notify(skipped and "Tutorial skipped — F1 shows every control." or "Tutorial complete. The site is yours.", "success")
end

local function advance()
	index += 1
	if index > #steps then
		finish(false)
	else
		show()
	end
end

function Tutorial.skip()
	finish(true)
end

function Tutorial.start()
	State.tutorialActive = true
	index = 0
	task.spawn(function()
		Net.call("Site", true, "Blueprint", "StarterFrame")
	end)
	advance()
end

function Tutorial.init()
	State.on("Progress", function(kind, data)
		if not State.tutorialActive then
			return
		end
		local s = steps[index]
		if s and s.event == kind and (not s.match or s.match(data)) then
			advance()
		end
	end)
	State.on("Saved", function()
		local s = steps[index]
		if State.tutorialActive and s and s.local_event == "Saved" then
			advance()
		end
	end)
	RunService.Heartbeat:Connect(function()
		local s = steps[index]
		if State.tutorialActive and s and s.check and s.check() then
			advance()
		end
	end)
end

return Tutorial
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000028">
<Properties>
<string name="Name">UIKit</string>
<ProtectedString name="Source"><![CDATA[-- Interface building blocks in the STEELRISE style: charcoal panels, steel
-- gray dividers, off-white text and safety-yellow accents.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)

local C = Config.Colors
local UIKit = {}
UIKit.C = C

UIKit.Font = {
	Display = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Medium = Enum.Font.GothamMedium,
	Body = Enum.Font.Gotham,
	Mono = Enum.Font.RobotoMono,
}

local clickSound = nil
function UIKit.setClickSound(fn)
	clickSound = fn
end

function UIKit.new(className, props, children)
	local inst = Instance.new(className)
	for k, v in pairs(props or {}) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if props and props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

function UIKit.corner(inst, r)
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = inst })
end

function UIKit.stroke(inst, color, thickness, transparency)
	return UIKit.new("UIStroke", {
		Color = color or C.SteelDark,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		Parent = inst,
	})
end

function UIKit.padding(inst, l, t, r, b)
	return UIKit.new("UIPadding", {
		PaddingLeft = UDim.new(0, l or 8),
		PaddingTop = UDim.new(0, t or l or 8),
		PaddingRight = UDim.new(0, r or l or 8),
		PaddingBottom = UDim.new(0, b or t or l or 8),
		Parent = inst,
	})
end

function UIKit.list(inst, dir, pad, halign, valign)
	return UIKit.new("UIListLayout", {
		FillDirection = dir or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, pad or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
		Parent = inst,
	})
end

function UIKit.tween(inst, t, props, style, dir)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- Root ScreenGui with automatic scale for 720p..1440p.
function UIKit.screen(name, order)
	local gui = UIKit.new("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order or 0,
		Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	local scale = UIKit.new("UIScale", { Parent = gui })
	local function update()
		local cam = workspace.CurrentCamera
		local h = cam and cam.ViewportSize.Y or 1080
		scale.Scale = math.clamp(h / 1000, 0.7, 1.35)
	end
	update()
	if workspace.CurrentCamera then
		workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
	end
	return gui
end

function UIKit.panel(parent, props)
	local f = UIKit.new("Frame", {
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Parent = parent,
	})
	for k, v in pairs(props or {}) do
		f[k] = v
	end
	UIKit.corner(f, 6)
	UIKit.stroke(f, C.SteelDark, 1, 0.3)
	return f
end

function UIKit.label(parent, text, size, font, color, props)
	local l = UIKit.new("TextLabel", {
		BackgroundTransparency = 1,
		Text = text or "",
		TextSize = size or 16,
		Font = font or UIKit.Font.Body,
		TextColor3 = color or C.OffWhite,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		Size = UDim2.new(1, 0, 0, (size or 16) + 6),
		TextWrapped = true,
		Parent = parent,
	})
	for k, v in pairs(props or {}) do
		l[k] = v
	end
	return l
end

-- Primary / secondary / ghost buttons.
function UIKit.button(parent, text, opts)
	opts = opts or {}
	local style = opts.style or "secondary"
	local bg = style == "primary" and C.Safety or (style == "danger" and C.Invalid or C.CharcoalLight)
	local fg = style == "primary" and C.Charcoal or C.OffWhite
	local b = UIKit.new("TextButton", {
		AutoButtonColor = false,
		BackgroundColor3 = bg,
		BackgroundTransparency = style == "ghost" and 1 or 0,
		BorderSizePixel = 0,
		Text = text,
		TextSize = opts.textSize or 17,
		Font = opts.font or UIKit.Font.Bold,
		TextColor3 = fg,
		Size = opts.size or UDim2.new(1, 0, 0, 42),
		TextXAlignment = opts.align or Enum.TextXAlignment.Center,
		Parent = parent,
	})
	if opts.align == Enum.TextXAlignment.Left then
		UIKit.padding(b, 16, 0, 8, 0)
	end
	UIKit.corner(b, 5)
	local stroke = UIKit.stroke(b, style == "primary" and C.SafetyDark or C.SteelDark, 1, style == "ghost" and 1 or 0.2)
	local base = bg
	b.MouseEnter:Connect(function()
		if b:GetAttribute("Disabled") then
			return
		end
		UIKit.tween(b, 0.12, { BackgroundColor3 = style == "primary" and Color3.fromRGB(255, 210, 70) or C.SteelDark, BackgroundTransparency = 0 })
		stroke.Color = C.Safety
	end)
	b.MouseLeave:Connect(function()
		UIKit.tween(b, 0.18, { BackgroundColor3 = base, BackgroundTransparency = style == "ghost" and 1 or 0 })
		stroke.Color = style == "primary" and C.SafetyDark or C.SteelDark
	end)
	b.MouseButton1Down:Connect(function()
		if clickSound and not b:GetAttribute("Disabled") then
			clickSound()
		end
	end)
	return b
end

function UIKit.setDisabled(button, disabled)
	button:SetAttribute("Disabled", disabled)
	button.TextTransparency = disabled and 0.6 or 0
	button.Active = not disabled
	button.AutoButtonColor = false
end

function UIKit.divider(parent)
	return UIKit.new("Frame", {
		BackgroundColor3 = C.SteelDark,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 1),
		BackgroundTransparency = 0.3,
		Parent = parent,
	})
end

function UIKit.chip(parent, text, color)
	local f = UIKit.new("TextLabel", {
		BackgroundColor3 = color or C.SteelDark,
		Text = text,
		TextSize = 13,
		Font = UIKit.Font.Bold,
		TextColor3 = color == C.Safety and C.Charcoal or C.OffWhite,
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.new(0, 0, 0, 22),
		Parent = parent,
	})
	UIKit.padding(f, 8, 0, 8, 0)
	UIKit.corner(f, 11)
	return f
end

-- Horizontal slider. onChange(value) fires while dragging.
function UIKit.slider(parent, labelText, value, min, max, step, onChange, fmt)
	local row = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), Parent = parent })
	local label = UIKit.label(row, labelText, 15, UIKit.Font.Medium, C.OffWhite, { Size = UDim2.new(0.5, 0, 0, 20) })
	local valueLabel = UIKit.label(row, "", 14, UIKit.Font.Mono, C.Muted, {
		Size = UDim2.new(0.5, 0, 0, 20),
		Position = UDim2.new(0.5, 0, 0, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
	})
	local track = UIKit.new("Frame", {
		BackgroundColor3 = C.SteelDark,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 0, 30),
		Parent = row,
	})
	UIKit.corner(track, 3)
	local fill = UIKit.new("Frame", { BackgroundColor3 = C.Safety, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = track })
	UIKit.corner(fill, 3)
	local knob = UIKit.new("Frame", {
		BackgroundColor3 = C.OffWhite,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 16, 0, 16),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Parent = track,
	})
	UIKit.corner(knob, 8)
	local current = value
	local function render()
		local a = (current - min) / (max - min)
		fill.Size = UDim2.new(a, 0, 1, 0)
		knob.Position = UDim2.new(a, 0, 0.5, 0)
		valueLabel.Text = fmt and fmt(current) or tostring(current)
	end
	local function setFromX(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + a * (max - min)
		v = math.floor(v / step + 0.5) * step
		v = math.clamp(v, min, max)
		if v ~= current then
			current = v
			render()
			onChange(v)
		end
	end
	local dragging = false
	local hit = UIKit.new("TextButton", {
		BackgroundTransparency = 1,
		Text = "",
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 0, 22),
		Parent = row,
	})
	hit.MouseButton1Down:Connect(function(x)
		dragging = true
		setFromX(x)
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
	render()
	return row, function(v)
		current = v
		render()
	end
end

function UIKit.toggle(parent, labelText, value, onChange)
	local row = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 32), Parent = parent })
	UIKit.label(row, labelText, 15, UIKit.Font.Medium, C.OffWhite, { Size = UDim2.new(1, -60, 1, 0) })
	local sw = UIKit.new("TextButton", {
		AutoButtonColor = false,
		Text = "",
		Size = UDim2.new(0, 46, 0, 24),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		BorderSizePixel = 0,
		Parent = row,
	})
	UIKit.corner(sw, 12)
	local dot = UIKit.new("Frame", { Size = UDim2.new(0, 18, 0, 18), AnchorPoint = Vector2.new(0, 0.5), BorderSizePixel = 0, BackgroundColor3 = C.OffWhite, Parent = sw })
	UIKit.corner(dot, 9)
	local on = value
	local function render()
		sw.BackgroundColor3 = on and C.Safety or C.SteelDark
		UIKit.tween(dot, 0.12, { Position = on and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) })
	end
	sw.MouseButton1Click:Connect(function()
		on = not on
		render()
		if clickSound then
			clickSound()
		end
		onChange(on)
	end)
	render()
	return row
end

function UIKit.segmented(parent, labelText, options, value, onChange)
	local row = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 58), Parent = parent })
	UIKit.label(row, labelText, 15, UIKit.Font.Medium, C.OffWhite, { Size = UDim2.new(1, 0, 0, 20) })
	local bar = UIKit.new("Frame", { BackgroundColor3 = C.Charcoal, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 32), Position = UDim2.new(0, 0, 0, 24), Parent = row })
	UIKit.corner(bar, 5)
	UIKit.list(bar, Enum.FillDirection.Horizontal, 0)
	local buttons = {}
	local current = value
	local function render()
		for opt, b in pairs(buttons) do
			b.BackgroundColor3 = opt == current and C.Safety or C.Charcoal
			b.TextColor3 = opt == current and C.Charcoal or C.OffWhite
		end
	end
	for i, opt in ipairs(options) do
		local b = UIKit.new("TextButton", {
			AutoButtonColor = false,
			Text = opt,
			Font = UIKit.Font.Bold,
			TextSize = 14,
			BorderSizePixel = 0,
			Size = UDim2.new(1 / #options, 0, 1, 0),
			LayoutOrder = i,
			Parent = bar,
		})
		UIKit.corner(b, 5)
		buttons[opt] = b
		b.MouseButton1Click:Connect(function()
			current = opt
			render()
			if clickSound then
				clickSound()
			end
			onChange(opt)
		end)
	end
	render()
	return row
end

-- Frames a model inside a ViewportFrame camera.
function UIKit.frameModel(viewport, model, yawDeg, pitchDeg, distScale)
	local cam = viewport.CurrentCamera
	if not cam then
		cam = Instance.new("Camera")
		cam.FieldOfView = 30
		cam.Parent = viewport
		viewport.CurrentCamera = cam
	end
	local cf, size = model:GetAttribute("BBCf"), model:GetAttribute("BBSize")
	if not cf then
		cf, size = model:GetBoundingBox()
		model:SetAttribute("BBCf", cf)
		model:SetAttribute("BBSize", size)
	end
	local radius = size.Magnitude / 2
	local dist = radius / math.tan(math.rad(cam.FieldOfView / 2)) * (distScale or 1.05)
	local rot = CFrame.Angles(0, math.rad(yawDeg or 35), 0) * CFrame.Angles(math.rad(-(pitchDeg or 22)), 0, 0)
	cam.CFrame = CFrame.new(cf.Position) * rot * CFrame.new(0, 0, dist)
	return cam
end

return UIKit
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000029">
<Properties>
<string name="Name">View</string>
<ProtectedString name="Source"><![CDATA[-- First/third-person view switching and the shared aim ray.

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local State = require(script.Parent.State)

local View = {}
local player = Players.LocalPlayer

function View.setFirstPerson(first)
	State.firstPerson = first
	if first then
		player.CameraMode = Enum.CameraMode.LockFirstPerson
	else
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 12
		player.CameraMaxZoomDistance = 40
		task.delay(0.1, function()
			if not State.firstPerson then
				player.CameraMinZoomDistance = 4
			end
		end)
	end
end

function View.toggle()
	View.setFirstPerson(not State.firstPerson)
end

-- Ray from the crosshair (first person / locked mouse) or the mouse cursor.
function View.ray()
	local cam = workspace.CurrentCamera
	local pos
	if State.firstPerson or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
		pos = cam.ViewportSize / 2
	else
		pos = UserInputService:GetMouseLocation()
	end
	local r = cam:ViewportPointToRay(pos.X, pos.Y)
	return r.Origin, r.Direction
end

local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude

function View.cast(maxDist, extraExclude)
	local origin, dir = View.ray()
	local exclude = { workspace.CurrentCamera }
	if player.Character then
		table.insert(exclude, player.Character)
	end
	for _, e in ipairs(extraExclude or {}) do
		table.insert(exclude, e)
	end
	params.FilterDescendantsInstances = exclude
	return workspace:Raycast(origin, dir * (maxDist or 60), params)
end

function View.rootPosition()
	local c = player.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart")
	return hrp and hrp.Position
end

return View
]]></ProtectedString>
</Properties>
</Item>
</Item>
