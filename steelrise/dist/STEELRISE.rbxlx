	description = "Drives ring-lock wedges tight. Hold the mouse on a ledger wedge.",
	build = function(b)
		b:box("Handle", V(0.035, 0.32, 0.03), CF(0, 0, 0), Color3.fromRGB(200, 60, 30), M.SmoothPlastic)
		b:box("Head", V(0.04, 0.04, 0.14), CF(0, 0.17, -0.02), C.SteelDark, M.Metal)
	end,
})

add({
	id = "TL-WELDER",
	name = "Stick Welder Stinger",
	category = "Tools",
	class = "Tool",
	kind = "Tool",
	hotkey = 4,
	fastens = "Weld",
	weightKg = 1.5,
	sizeM = V(0.06, 0.08, 0.4),
	description = "Electrode holder on welding leads. Hold the mouse on a puddle-weld spot; wear the hood — sparks are kept restrained.",
	build = function(b)
		b:box("Holder", V(0.045, 0.045, 0.22), CF(0, 0, 0.05), Color3.fromRGB(30, 30, 32), M.SmoothPlastic)
		b:box("Jaw", V(0.03, 0.03, 0.06), CF(0, 0, -0.09), Color3.fromRGB(180, 140, 60), M.Metal)
		b:cylX("Rod", 0.18, 0.006, CF(0, -0.03, -0.17) * CFrame.Angles(0, math.pi / 2, math.rad(35)), Color3.fromRGB(120, 110, 100), M.Metal)
	end,
})

add({
	id = "TL-REMOTE",
	name = "Crane Radio Remote",
	category = "Tools",
	class = "Tool",
	kind = "Tool",
	hotkey = 5,
	weightKg = 1.8,
	sizeM = V(0.22, 0.12, 0.16),
	description = "Belly-box radio remote for the tower crane. Equip it to operate the crane from the ground or the steel while you stay at the connection.",
	build = function(b)
		b:box("Box", V(0.22, 0.08, 0.15), CF(), C.Safety, M.SmoothPlastic)
		b:box("Panel", V(0.18, 0.01, 0.11), CF(0, 0.045, 0), C.Charcoal, M.SmoothPlastic)
		b:cylY("StickL", 0.06, 0.015, V(-0.05, 0.07, 0), C.Charcoal, M.SmoothPlastic)
		b:cylY("StickR", 0.06, 0.015, V(0.05, 0.07, 0), C.Charcoal, M.SmoothPlastic)
		b:box("EStop", V(0.03, 0.02, 0.03), CF(0.08, 0.055, -0.05), Color3.fromRGB(210, 30, 30), M.SmoothPlastic)
	end,
})

---------------------------------------------------------------------------
-- Queries
---------------------------------------------------------------------------

function Registry.get(id)
	return Registry.items[id]
end

function Registry.count()
	local counts = { total = 0 }
	for _, def in ipairs(Registry.list) do
		counts.total += 1
		counts[def.class] = (counts[def.class] or 0) + 1
	end
	return counts
end

Registry.TargetCount = 500

function Registry.search(query, category, favorites, favoritesOnly)
	query = string.lower(query or "")
	local out = {}
	for _, def in ipairs(Registry.list) do
		local okCat = (not category or category == "All" or def.category == category)
		local okFav = (not favoritesOnly) or (favorites and favorites[def.id])
		local okQuery = query == ""
			or string.find(string.lower(def.name), query, 1, true)
			or string.find(string.lower(def.category), query, 1, true)
			or string.find(string.lower(def.id), query, 1, true)
		if okCat and okFav and okQuery then
			table.insert(out, def)
		end
	end
	return out
end

-- Human-readable dimension string (L × W × H in metres).
function Registry.dimensionsText(def)
	local s = def.sizeM
	return string.format("%.2f × %.2f × %.2f m", s.X, s.Z, s.Y)
end

-- Find the beam/brace/panel that fits a given bay and storey; used by
-- blueprints and site layouts.
function Registry.find(kind, a, b, c)
	if kind == "column" then
		return "COL-" .. a:gsub("×", "x") .. "-" .. idLen(b)
	elseif kind == "beam" then
		return "BM-" .. a:gsub("×", "x") .. "-" .. idLen(b)
	elseif kind == "brace" then
		return "BR-HSS4-" .. idLen(a) .. "-" .. idLen(b)
	elseif kind == "deck" then
		return "DK-15B-" .. idLen(a)
	elseif kind == "wall" then
		return "WP-IMP-" .. idLen(a) .. "-" .. idLen(b)
	elseif kind == "curtain" then
		return "CW-UNIT-" .. idLen(a) .. "-" .. idLen(b)
	elseif kind == "footing" then
		return "FT-PRECAST-" .. idLen(a)
	end
	return nil
end

return Registry
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000008">
<Properties>
<string name="Name">ModelFactory</string>
<ProtectedString name="Source"><![CDATA[-- Procedural geometry for every catalog item.
--
-- Every component is a Model whose PrimaryPart is an invisible "Root" part at
-- the item's local origin. All parts are anchored; components are moved with
-- Model:PivotTo (installed steel never simulates). Hand carrying temporarily
-- welds the parts to the character on the server.
--
-- Builders work in metres in item-local space; the factory converts to studs.

local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)

local S = Config.S
local C = Config.Colors
local M = Enum.Material

local Factory = {}

local Builder = {}
Builder.__index = Builder

-- b:box(name, sizeMeters, cframeMeters, color, material, flags)
-- flags: nc = no collision, ns = no shadow, tr = transparency, refl = reflectance,
--        shape = Enum.PartType, nq = not queryable
local function applyFlags(p, flags)
	if flags then
		if flags.nc then
			p.CanCollide = false
		end
		if flags.ns then
			p.CastShadow = false
		end
		if flags.tr then
			p.Transparency = flags.tr
		end
		if flags.refl then
			p.Reflectance = flags.refl
		end
		if flags.nq then
			p.CanQuery = false
		end
	end
end

-- CFrame.lookAt with a safe up vector for (near) vertical directions.
local function lookAlong(pos, dir)
	local up = Vector3.yAxis
	if dir.Magnitude > 0 and math.abs(dir.Unit.Y) > 0.98 then
		up = Vector3.xAxis
	end
	return CFrame.lookAt(pos, pos + dir, up)
end
Factory.lookAlong = lookAlong

local function toStuds(cf)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(x * S, y * S, z * S, r00, r01, r02, r10, r11, r12, r20, r21, r22)
end

function Builder.new(model, tint)
	local self = setmetatable({}, Builder)
	self.model = model
	self.tint = tint or 0
	return self
end

function Builder:_tint(color)
	if self.tint == 0 or not color then
		return color
	end
	local h, s, v = color:ToHSV()
	return Color3.fromHSV(h, s, Util.clamp(v * (1 + self.tint), 0, 1))
end

function Builder:box(name, size, cf, color, material, flags)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = Vector3.new(math.max(size.X * S, 0.02), math.max(size.Y * S, 0.02), math.max(size.Z * S, 0.02))
	p.CFrame = toStuds(cf)
	p.Color = self:_tint(color or C.MillSteel)
	p.Material = material or M.Metal
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanTouch = false
	applyFlags(p, flags)
	if flags and flags.shape then
		p.Shape = flags.shape
	end
	p.Parent = self.model
	return p
end

-- Cylinder along local X of `cf` (Roblox cylinders run along X).
function Builder:cylX(name, length, diameter, cf, color, material, flags)
	local f = flags and Util.shallowCopy(flags) or {}
	f.shape = Enum.PartType.Cylinder
	return self:box(name, Vector3.new(length, diameter, diameter), cf, color, material, f)
end

-- Vertical cylinder centred at `pos` (metres).
function Builder:cylY(name, length, diameter, pos, color, material, flags)
	return self:cylX(name, length, diameter, CFrame.new(pos) * CFrame.Angles(0, 0, math.pi / 2), color, material, flags)
end

-- Cylinder (tube) between two points.
function Builder:tube(name, a, b, diameter, color, material, flags)
	local mid = (a + b) / 2
	local dir = b - a
	local len = dir.Magnitude
	local cf = lookAlong(mid, dir) * CFrame.Angles(0, math.pi / 2, 0)
	return self:cylX(name, len, diameter, cf, color, material, flags)
end

-- Rectangular bar between two points.
function Builder:bar(name, a, b, w, h, color, material, flags)
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	local cf = lookAlong(mid, b - a)
	return self:box(name, Vector3.new(w, h, len), cf, color, material, flags)
end

function Builder:wedge(name, size, cf, color, material, flags)
	local p = Instance.new("WedgePart")
	p.Name = name
	p.Anchored = true
	p.Size = Vector3.new(size.X * S, size.Y * S, size.Z * S)
	p.CFrame = toStuds(cf)
	p.Color = self:_tint(color or C.MillSteel)
	p.Material = material or M.Metal
	p.CanTouch = false
	applyFlags(p, flags)
	p.Parent = self.model
	return p
end

function Builder:sphere(name, diameter, pos, color, material, flags)
	local f = flags and Util.shallowCopy(flags) or {}
	f.shape = Enum.PartType.Ball
	return self:box(name, Vector3.new(diameter, diameter, diameter), CFrame.new(pos), color, material, f)
end

-- Wide-flange (W) shape. axis "X": length along X (beams). axis "Y": columns,
-- flanges face +/-X.
function Builder:wShape(prefix, length, p, cf, color, material)
	local d, bf, tf, tw = p.d, p.bf, p.tf, p.tw
	if p.axis == "Y" then
		self:box(prefix .. "FlangeA", Vector3.new(tf, length, bf), cf * CFrame.new(d / 2 - tf / 2, 0, 0), color, material)
		self:box(prefix .. "FlangeB", Vector3.new(tf, length, bf), cf * CFrame.new(-d / 2 + tf / 2, 0, 0), color, material)
		self:box(prefix .. "Web", Vector3.new(d - 2 * tf, length, tw), cf, color, material)
	else
		self:box(prefix .. "TopFlange", Vector3.new(length, tf, bf), cf * CFrame.new(0, d / 2 - tf / 2, 0), color, material)
		self:box(prefix .. "BottomFlange", Vector3.new(length, tf, bf), cf * CFrame.new(0, -d / 2 + tf / 2, 0), color, material)
		self:box(prefix .. "Web", Vector3.new(length, d - 2 * tf, tw), cf, color, material)
	end
end

-- Hollow structural section (square tube) along X.
function Builder:hss(prefix, length, w, t, cf, color, material)
	self:box(prefix .. "T", Vector3.new(length, t, w), cf * CFrame.new(0, w / 2 - t / 2, 0), color, material)
	self:box(prefix .. "B", Vector3.new(length, t, w), cf * CFrame.new(0, -w / 2 + t / 2, 0), color, material)
	self:box(prefix .. "L", Vector3.new(length, w - 2 * t, t), cf * CFrame.new(0, 0, w / 2 - t / 2), color, material)
	self:box(prefix .. "R", Vector3.new(length, w - 2 * t, t), cf * CFrame.new(0, 0, -w / 2 + t / 2), color, material)
end

-- Small painted stencil mark (piece mark) - a thin off-white plate.
function Builder:stencil(cf, w, h)
	return self:box("Stencil", Vector3.new(w, h, 0.002), cf, C.OffWhite, M.SmoothPlastic, { nc = true, ns = true })
end

Factory.Builder = Builder

---------------------------------------------------------------------------
-- Model assembly
---------------------------------------------------------------------------

local function makeRoot(model)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CastShadow = false
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root
	return root
end

-- Builds the model for a registry definition at the origin, then pivots it.
-- opts: { tint = number, installed = bool, ghost = bool, preview = bool }
function Factory.build(def, cf, opts)
	opts = opts or {}
	local model = Instance.new("Model")
	model.Name = def.id
	makeRoot(model)
	local b = Builder.new(model, opts.tint or 0)
	b.opts = opts
	local ok, err = pcall(def.build, b, def, opts)
	if not ok then
		warn("[STEELRISE] builder failed for", def.id, err)
		b:box("Fallback", def.sizeM, CFrame.new(0, def.originBottom and def.sizeM.Y / 2 or 0, 0), C.Invalid, M.SmoothPlastic)
	end
	if opts.ghost then
		Factory.makeGhost(model)
	end
	if cf then
		model:PivotTo(cf)
	end
	return model
end

function Factory.makeGhost(model)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Anchored = true
			if p.Name ~= "Root" and not p:IsA("TrussPart") then
				p.Transparency = math.max(p.Transparency, 0.45)
				p.Material = M.SmoothPlastic
			end
			if p:IsA("TrussPart") then
				p.Transparency = 1
			end
		elseif p:IsA("SurfaceGui") or p:IsA("Light") or p:IsA("ParticleEmitter") or p:IsA("Sound") then
			p:Destroy()
		end
	end
end

-- Fastener visuals. Created when a component is placed; a fastener becomes
-- visible once it has been tightened/welded. Index order matches def.fasteners.
function Factory.addFasteners(model, def, mask)
	local folder = model:FindFirstChild("Fasteners")
	if folder then
		folder:Destroy()
	end
	if not def.fasteners or #def.fasteners == 0 then
		return
	end
	folder = Instance.new("Folder")
	folder.Name = "Fasteners"
	folder.Parent = model
	local rootCf = model:GetPivot()
	for i, f in ipairs(def.fasteners) do
		local done = mask and string.sub(mask, i, i) == "1"
		local p = Instance.new("Part")
		p.Name = "F" .. i
		p.Anchored = true
		p.CanCollide = false
		p.CanTouch = false
		p.CastShadow = false
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		local pos = f.pos * S
		local normal = f.normal or Vector3.new(0, 0, 1)
		local local_cf = lookAlong(pos, normal)
		if f.type == "Weld" then
			p.Size = Vector3.new(0.16, 0.16, 0.06)
			p.Color = Color3.fromRGB(58, 56, 54)
			p.Material = M.Metal
		elseif f.type == "Wedge" then
			p.Size = Vector3.new(0.06, 0.22, 0.12)
			p.Color = C.SteelDark
			p.Material = M.Metal
		else
			-- Hex nut + washer read as a short cylinder (axis along the normal)
			p.Shape = Enum.PartType.Cylinder
			p.Size = Vector3.new(0.12, 0.17, 0.17)
			local_cf = local_cf * CFrame.Angles(0, math.pi / 2, 0)
			p.Color = Color3.fromRGB(62, 64, 66)
			p.Material = M.Metal
		end
		p.CFrame = rootCf * local_cf
		p.Transparency = done and 0 or 1
		p:SetAttribute("Index", i)
		p:SetAttribute("Type", f.type)
		p.Parent = folder
	end
end

function Factory.setFastenerVisible(model, index, visible)
	local folder = model:FindFirstChild("Fasteners")
	local p = folder and folder:FindFirstChild("F" .. index)
	if p then
		p.Transparency = visible and 0 or 1
	end
end

-- Simplified box stand-in used by menu previews and blueprint ghosts.
function Factory.proxy(def, cf, color, transparency)
	local p = Instance.new("Part")
	p.Name = def.id
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Material = M.SmoothPlastic
	p.Color = color or def.proxyColor or C.Steel
	p.Transparency = transparency or 0
	local size = def.sizeM * S
	p.Size = size
	p.CFrame = cf * CFrame.new(def.boundsOffsetM * S)
	return p
end

return Factory
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000009">
<Properties>
<string name="Name">Remotes</string>
<ProtectedString name="Source"><![CDATA[-- Single place that defines every network endpoint.
-- The server creates them at boot; clients wait for them.
--
-- Functions (client -> server, returns ok, message, data):
--   Menu      : ("Info") | ("Slots")                     menu data, save summaries
--   Site      : ("Start", siteId, mode, slot)            mode = "new" | "continue" | "join"
--   Delivery  : ("Request", itemId, qty) | ("Dismiss", trailerId)
--   Handle    : ("PickUp", id) | ("Drop") | ("Place", id, cframe, freeMode) | ("Release", strapId)
--   Build     : ("Fasten", id, index) | ("Dismantle", id) | ("Equip", toolId)
--   Crane     : ("Enter", craneId) | ("Remote", craneId) | ("Exit") | ("Attach", componentId)
--               | ("Release") | ("Land", cframe) | ("Recover")
--   Save      : ("Save", slot) | ("Settings", table) | ("Favorite", itemId, on)
-- Events:
--   CraneStream (unreliable, client -> server) : operator state stream
--   Notify      (server -> client)             : (text, kind)
--   FX          (server -> clients)            : (kind, position, extra)
--   Progress    (server -> clients)            : (eventName, data) used by tutorial/task panel

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local FUNCTIONS = { "Menu", "Site", "Delivery", "Handle", "Build", "Crane", "Save" }
local EVENTS = { "Notify", "FX", "Progress" }
local UNRELIABLE = { "CraneStream" }

local folder

local function getFolder()
	if folder then
		return folder
	end
	if RunService:IsServer() then
		folder = ReplicatedStorage:FindFirstChild("SteelriseRemotes")
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "SteelriseRemotes"
			for _, name in ipairs(FUNCTIONS) do
				local f = Instance.new("RemoteFunction")
				f.Name = name
				f.Parent = folder
			end
			for _, name in ipairs(EVENTS) do
				local e = Instance.new("RemoteEvent")
				e.Name = name
				e.Parent = folder
			end
			for _, name in ipairs(UNRELIABLE) do
				local e = Instance.new("UnreliableRemoteEvent")
				e.Name = name
				e.Parent = folder
			end
			folder.Parent = ReplicatedStorage
		end
	else
		folder = ReplicatedStorage:WaitForChild("SteelriseRemotes", 30)
		if not folder then
			error("[STEELRISE] Remotes folder never replicated - is the server script running?")
		end
	end
	return folder
end

function Remotes.get(name)
	local f = getFolder()
	if RunService:IsServer() then
		return f:FindFirstChild(name)
	end
	return f:WaitForChild(name, 30)
end

function Remotes.init()
	getFolder()
end

return Remotes
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000000A">
<Properties>
<string name="Name">Sites</string>
<ProtectedString name="Source"><![CDATA[-- Site definitions and the deterministic building layout generator.
--
-- A site's building is described by a column grid. layout(site) expands the
-- grid into a full blueprint (every footing, column, beam, gusset, brace, deck
-- sheet and facade unit with its exact CFrame). The starting stage is a
-- subset of that blueprint installed at load; the rest is what still has to be
-- built. Menu previews are generated from the same data, so a preview always
-- shows the playable starting state.

local Config = require(script.Parent.Config)
local Registry = require(script.Parent.ItemRegistry)
local Factory = require(script.Parent.ModelFactory)
local BuildRules = require(script.Parent.BuildRules)
local Util = require(script.Parent.Util)

local S = Config.S
local G = Config.Geo
local V = Vector3.new

local Sites = {}

local function m(x)
	return x * S
end

-- Trailer bay: CFrame at the road surface under the middle of the bed,
-- bed length along local X, cab toward -X.
local function bay(x, z, yawDeg)
	return CFrame.new(m(x), 0, m(z)) * CFrame.Angles(0, math.rad(yawDeg or 0), 0)
end

Sites.Order = { "EmptyLand", "Office1", "Office2", "Office3", "Office4", "Office5", "Apartment", "HighRise" }

Sites.Defs = {
	EmptyLand = {
		id = "EmptyLand",
		name = "Empty Land",
		subtitle = "Open graded lot",
		description = "A large graded lot with nothing on it. Set out footings anywhere, erect your own frame and scaffold it — or follow the Starter Frame blueprint.",
		stageText = "Bare ground — start from foundations",
		difficulty = "Beginner",
		equipment = { "Tower crane — 50 m jib, 8 t", "Flatbed deliveries (3 bays)", "Scaffold kit in laydown" },
		style = "Rural",
		lotM = V(120, 0, 90),
		lighting = { clock = 9.6, latitude = 38, haze = 0.9, density = 0.3, tint = Color3.fromRGB(255, 248, 238) },
		crane = { posM = V(-6, 0, 3), heightM = 30, jibM = 50, counterM = 14, maxKg = 8000, fullRadiusM = 18, slewDeg = 200 },
		bays = { bay(14, -33), bay(14, -24.5), bay(14, -16) },
		entryM = V(70, 0, -52),
		spawnM = V(22, 0, -40),
		laydownM = { center = V(-24, 0, -30), size = V(22, 0, 14) },
		blueprints = {
			{
				id = "StarterFrame",
				name = "Starter Frame — 2 × 1 bays",
				grid = { originM = V(-36, 0, 14), nx = 2, nz = 1, bayX = 6.0, bayZ = 6.0, floorH = 4.2, floors = 1, column = "W12×65", beam = "W16×31", deck = true, braces = { { "x", 0, 0 } }, facade = nil },
			},
			{
				id = "Workshop",
				name = "Two-Storey Workshop — 3 × 2 bays",
				grid = { originM = V(-48, 0, 14), nx = 3, nz = 2, bayX = 7.5, bayZ = 6.0, floorH = 4.5, floors = 2, column = "W14×90", beam = "W18×35", deck = true, braces = { { "x", 0, 0 }, { "x", 2, 2 } }, facade = "wall" },
			},
		},
		starter = {
			trailer = { { "FT-PRECAST-1500", 6 }, { "COL-W12x65-4200", 6 }, { "BM-W16x31-6000", 7 } },
			laydown = {
				{ "DK-15B-6000", 8 },
				{ "CON-GUSSET-350", 2 },
				{ "SC-BASEJACK", 4 },
				{ "SC-STD-2000", 4 },
				{ "SC-LEDGER-2570", 4 },
				{ "SC-LEDGER-1090", 4 },
				{ "SC-DECK-2570", 1 },
				{ "SC-LADDER-27", 1 },
			},
		},
	},

	Office1 = {
		id = "Office1",
		name = "Office 1 — Suburban Business Park",
		subtitle = "Low-rise office",
		description = "A three-storey office in a landscaped business park. Footings are cast and a few starter columns are standing; the rest of the frame is yours.",
		stageText = "Foundations complete, 4 starter columns",
		difficulty = "Beginner",
		equipment = { "Tower crane — 55 m jib, 8 t", "Flatbed deliveries (3 bays)", "Scaffold kit" },
		style = "Suburban",
		lotM = V(150, 0, 110),
		lighting = { clock = 12.2, latitude = 34, haze = 0.6, density = 0.27, tint = Color3.fromRGB(255, 252, 245) },
