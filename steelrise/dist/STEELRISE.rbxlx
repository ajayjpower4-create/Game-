<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
<Item class="ReplicatedFirst" referent="RBX00000002">
<Properties>
<string name="Name">ReplicatedFirst</string>
</Properties>
<Item class="LocalScript" referent="RBX00000001">
<Properties>
<string name="Name">LoadingScreen</string>
<ProtectedString name="Source"><![CDATA[-- STEELRISE loading screen. Runs from ReplicatedFirst before anything else.
--
-- Progress is tied to real work: engine load, server handshake, asset
-- preloading (with per-asset callbacks), site streaming around the menu
-- camera, catalog preparation and the menu reporting ready. Every stage has a
-- timeout so a missing asset or slow server never leaves the player stuck.

local ReplicatedFirst = game:GetService("ReplicatedFirst")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContentProvider = game:GetService("ContentProvider")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer
pcall(function()
	ReplicatedFirst:RemoveDefaultLoadingScreen()
end)

local CHARCOAL = Color3.fromRGB(24, 26, 29)
local STEEL = Color3.fromRGB(122, 128, 134)
local STEEL_DARK = Color3.fromRGB(58, 62, 67)
local OFFWHITE = Color3.fromRGB(236, 233, 226)
local SAFETY = Color3.fromRGB(255, 194, 14)
local SILHOUETTE = Color3.fromRGB(19, 21, 25)

local function new(class, props)
	local inst = Instance.new(class)
	for k, v in pairs(props) do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local gui = new("ScreenGui", {
	Name = "SR_Loading",
	IgnoreGuiInset = true,
	ResetOnSpawn = false,
	DisplayOrder = 100,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})
local root = new("CanvasGroup", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = CHARCOAL,
	BorderSizePixel = 0,
	Parent = gui,
})

---------------------------------------------------------------------------
-- Cinematic background (procedural silhouettes, no image assets required)
---------------------------------------------------------------------------

local sky = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, Parent = root })
new("UIGradient", {
	Rotation = 90,
	Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(17, 19, 23)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(40, 44, 52)),
		ColorSequenceKeypoint.new(0.74, Color3.fromRGB(104, 90, 74)),
		ColorSequenceKeypoint.new(0.8, Color3.fromRGB(70, 62, 56)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(20, 21, 24)),
	}),
	Parent = sky,
})
-- low sun glow
for i, s in ipairs({ 0.55, 0.36, 0.2 }) do
	local glow = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.3, 0.74),
		Size = UDim2.fromScale(s, s * 1.6),
		BackgroundColor3 = Color3.fromRGB(255, 196, 120),
		BackgroundTransparency = 0.93 - i * 0.02,
		BorderSizePixel = 0,
		Parent = root,
	})
	new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = glow })
end

local scene = new("Frame", { Size = UDim2.new(1.08, 0, 1, 0), Position = UDim2.fromScale(-0.04, 0), BackgroundTransparency = 1, Parent = root })
local rng = Random.new(1987)
-- distant skyline
for i = 0, 28 do
	local w = rng:NextNumber(0.025, 0.055)
	local h = rng:NextNumber(0.06, 0.24)
	new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(i * 0.036, 0.8),
		Size = UDim2.fromScale(w, h),
		BackgroundColor3 = Color3.fromRGB(30, 32, 37),
		BorderSizePixel = 0,
		Parent = scene,
	})
end
new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.21), BackgroundColor3 = SILHOUETTE, BorderSizePixel = 0, Parent = scene })

-- steel frame under construction
local frameX, frameW, frameBase = 0.56, 0.3, 0.79
local levels = 5
for c = 0, 4 do
	local h = (c == 4) and 3 or levels
	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(frameX + c * frameW / 4, frameBase),
		Size = UDim2.new(0, 4, h * 0.075, 0),
		BackgroundColor3 = SILHOUETTE,
		BorderSizePixel = 0,
		Parent = scene,
	})
end
for l = 1, levels do
	for c = 0, 3 do
		local missing = (l == levels and c >= 2) or (l == levels - 1 and c == 3) or (l >= 4 and c == 3)
		if not missing then
			new("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.fromScale(frameX + c * frameW / 4, frameBase - l * 0.075),
				Size = UDim2.new(frameW / 4, 0, 0, 3),
				BackgroundColor3 = SILHOUETTE,
				BorderSizePixel = 0,
				Parent = scene,
			})
		end
	end
end

-- tower crane
local mastX = 0.47
new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(mastX, frameBase), Size = UDim2.new(0, 12, 0.62, 0), BackgroundColor3 = SILHOUETTE, BorderSizePixel = 0, Parent = scene })
for k = 0, 22 do
	new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(mastX, frameBase - 0.012 - k * 0.026),
		Size = UDim2.new(0, 16, 0, 2),
		Rotation = (k % 2 == 0) and 35 or -35,
		BackgroundColor3 = Color3.fromRGB(46, 48, 54),
		BorderSizePixel = 0,
		Parent = scene,
	})
end
local jibY = frameBase - 0.62
new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(mastX - 0.12, jibY), Size = UDim2.new(0.5, 0, 0, 7), BackgroundColor3 = SILHOUETTE, BorderSizePixel = 0, Parent = scene })
new("Frame", { AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromScale(mastX - 0.115, jibY + 0.006), Size = UDim2.fromScale(0.035, 0.05), BackgroundColor3 = SILHOUETTE, BorderSizePixel = 0, Parent = scene })
new("Frame", { AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromScale(mastX + 0.005, jibY + 0.006), Size = UDim2.new(0, 22, 0, 18), BackgroundColor3 = Color3.fromRGB(60, 52, 30), BorderSizePixel = 0, Parent = scene })
local beacon = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(mastX + 0.38, jibY - 0.008), Size = UDim2.new(0, 5, 0, 5), BackgroundColor3 = Color3.fromRGB(255, 60, 40), BorderSizePixel = 0, Parent = scene })
new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = beacon })
local trolleyX = mastX + 0.27
new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(trolleyX, jibY + 0.004), Size = UDim2.new(0, 14, 0, 6), BackgroundColor3 = SILHOUETTE, BorderSizePixel = 0, Parent = scene })
-- GUI rotation pivots on the frame centre, so the pendulum frame is centred
-- on the trolley and everything hangs in its lower half.
local pendulum = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(trolleyX, jibY + 0.01),
	Size = UDim2.fromScale(0.06, 0.6),
	BackgroundTransparency = 1,
	Parent = scene,
})
new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 1, 0.41, 0), BackgroundColor3 = Color3.fromRGB(34, 36, 40), BorderSizePixel = 0, Parent = pendulum })
new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.9), Size = UDim2.new(0, 10, 0, 14), BackgroundColor3 = Color3.fromRGB(70, 58, 26), BorderSizePixel = 0, Parent = pendulum })
new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.9, 18), Size = UDim2.new(0, 120, 0, 6), BackgroundColor3 = SILHOUETTE, BorderSizePixel = 0, Parent = pendulum })

-- vignette
for _, v in ipairs({ { 0, 0, 1, 0.25, 90, false }, { 0, 0.75, 1, 0.25, 90, true }, { 0, 0, 0.2, 1, 0, false }, { 0.8, 0, 0.2, 1, 0, true } }) do
	local f = new("Frame", { Position = UDim2.fromScale(v[1], v[2]), Size = UDim2.fromScale(v[3], v[4]), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = root })
	new("UIGradient", {
		Rotation = v[5],
		Transparency = v[6] and NumberSequence.new(1, 0.35) or NumberSequence.new(0.35, 1),
		Parent = f,
	})
end

---------------------------------------------------------------------------
-- Logo, progress and tips
---------------------------------------------------------------------------

local logo = new("Frame", { Position = UDim2.new(0, 72, 0.3, 0), Size = UDim2.new(0, 640, 0, 160), BackgroundTransparency = 1, Parent = root })
local mark = new("Frame", { Size = UDim2.new(0, 46, 0, 64), Position = UDim2.new(0, 0, 0, 8), BackgroundTransparency = 1, Parent = logo })
new("Frame", { Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = SAFETY, BorderSizePixel = 0, Parent = mark })
new("Frame", { Size = UDim2.new(1, 0, 0, 10), Position = UDim2.new(0, 0, 1, -10), BackgroundColor3 = SAFETY, BorderSizePixel = 0, Parent = mark })
new("Frame", { Size = UDim2.new(0, 10, 1, 0), Position = UDim2.new(0.5, -5, 0, 0), BackgroundColor3 = SAFETY, BorderSizePixel = 0, Parent = mark })
new("TextLabel", {
	Text = "STEELRISE",
	Font = Enum.Font.GothamBlack,
	TextSize = 76,
	TextColor3 = OFFWHITE,
	TextXAlignment = Enum.TextXAlignment.Left,
	BackgroundTransparency = 1,
	Position = UDim2.new(0, 64, 0, 0),
	Size = UDim2.new(1, -64, 0, 80),
	Parent = logo,
})
new("Frame", { Position = UDim2.new(0, 66, 0, 90), Size = UDim2.new(0, 120, 0, 3), BackgroundColor3 = SAFETY, BorderSizePixel = 0, Parent = logo })
new("TextLabel", {
	Text = "C O N S T R U C T I O N   S I M U L A T O R",
	Font = Enum.Font.GothamMedium,
	TextSize = 17,
	TextColor3 = STEEL,
	TextXAlignment = Enum.TextXAlignment.Left,
	BackgroundTransparency = 1,
	Position = UDim2.new(0, 66, 0, 102),
	Size = UDim2.new(1, -66, 0, 24),
	Parent = logo,
})

local bottom = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 72, 1, -56), Size = UDim2.new(1, -144, 0, 96), BackgroundTransparency = 1, Parent = root })
local stageLabel = new("TextLabel", {
	Text = "PREPARING",
	Font = Enum.Font.GothamBold,
	TextSize = 15,
	TextColor3 = OFFWHITE,
	TextXAlignment = Enum.TextXAlignment.Left,
	BackgroundTransparency = 1,
	Size = UDim2.new(0.7, 0, 0, 20),
	Parent = bottom,
})
local percentLabel = new("TextLabel", {
	Text = "0%",
	Font = Enum.Font.RobotoMono,
	TextSize = 15,
	TextColor3 = SAFETY,
	TextXAlignment = Enum.TextXAlignment.Right,
	BackgroundTransparency = 1,
	Position = UDim2.new(0.7, 0, 0, 0),
	Size = UDim2.new(0.3, 0, 0, 20),
	Parent = bottom,
})
local track = new("Frame", { Position = UDim2.new(0, 0, 0, 28), Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = STEEL_DARK, BorderSizePixel = 0, Parent = bottom })
local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = SAFETY, BorderSizePixel = 0, Parent = track })
local detailLabel = new("TextLabel", {
	Text = "",
	Font = Enum.Font.RobotoMono,
	TextSize = 13,
	TextColor3 = STEEL,
	TextXAlignment = Enum.TextXAlignment.Left,
	BackgroundTransparency = 1,
	Position = UDim2.new(0, 0, 0, 40),
	Size = UDim2.new(1, 0, 0, 18),
	Parent = bottom,
})
local tipLabel = new("TextLabel", {
	Text = "",
	Font = Enum.Font.Gotham,
	TextSize = 14,
	TextColor3 = Color3.fromRGB(170, 172, 174),
	TextXAlignment = Enum.TextXAlignment.Left,
	BackgroundTransparency = 1,
	Position = UDim2.new(0, 0, 0, 66),
	Size = UDim2.new(1, 0, 0, 20),
	TextTransparency = 0,
	Parent = bottom,
})
new("TextLabel", {
	Text = "PHASE 1 BUILD",
	Font = Enum.Font.RobotoMono,
	TextSize = 12,
	TextColor3 = STEEL_DARK,
	TextXAlignment = Enum.TextXAlignment.Right,
	BackgroundTransparency = 1,
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -24, 0, 18),
	Size = UDim2.new(0, 300, 0, 16),
	Parent = root,
})

local TIPS = {
	"Heavy steel goes up by crane. Light and medium pieces can be carried by hand.",
	"Release a stack's ratchet straps before you try to lift anything off the truck.",
	"Columns need their four anchor nuts tightened before the crane can let go.",
	"Beams need two seats exactly one bay apart — the preview tells you what's wrong.",
	"Build scaffold as the frame rises: base jacks, uprights, ledgers, then a platform.",
	"Turn on alignment assist (H) in the crane for a target ghost and guidance arrows.",
	"Shift slows every crane motion for fine positioning.",
}

---------------------------------------------------------------------------
-- Animation
---------------------------------------------------------------------------

local t0 = os.clock()
local animConn = RunService.RenderStepped:Connect(function()
	local t = os.clock() - t0
	pendulum.Rotation = math.sin(t * 0.9) * 3.5
	scene.Position = UDim2.new(-0.04 + math.sin(t * 0.05) * 0.02, 0, 0, 0)
	beacon.BackgroundTransparency = (math.floor(t * 1.2) % 2 == 0) and 0 or 0.85
end)

local tipIndex = 0
task.spawn(function()
	while gui.Parent do
		tipIndex = tipIndex % #TIPS + 1
		TweenService:Create(tipLabel, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
		task.wait(0.4)
		tipLabel.Text = "TIP  ·  " .. TIPS[tipIndex]
		TweenService:Create(tipLabel, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
		task.wait(5.5)
	end
end)

---------------------------------------------------------------------------
-- Real loading stages
---------------------------------------------------------------------------

local STAGES = {
	{ key = "engine", label = "Initialising engine", weight = 0.1 },
	{ key = "server", label = "Connecting to the site server", weight = 0.12 },
	{ key = "assets", label = "Loading interface and audio", weight = 0.18 },
	{ key = "site", label = "Streaming construction site", weight = 0.38 },
	{ key = "catalog", label = "Preparing component catalog", weight = 0.1 },
	{ key = "menu", label = "Starting interface", weight = 0.12 },
}
local completed = 0
local shown = 0
local target = 0

local function setStage(i, sub, detail)
	local before = 0
	for k = 1, i - 1 do
		before += STAGES[k].weight
	end
	target = math.max(target, before + STAGES[i].weight * math.clamp(sub or 0, 0, 1))
	stageLabel.Text = string.format("%d / %d  ·  %s", i, #STAGES, string.upper(STAGES[i].label))
	if detail then
		detailLabel.Text = detail
	end
end

local barConn = RunService.RenderStepped:Connect(function(dt)
	shown += (target - shown) * math.min(dt * 5, 1)
	fill.Size = UDim2.new(shown, 0, 1, 0)
	percentLabel.Text = string.format("%d%%", math.floor(shown * 100 + 0.5))
end)

local function waitFor(predicate, timeout, onTick)
	local start = os.clock()
	while not predicate() do
		local elapsed = os.clock() - start
		if onTick then
			onTick(elapsed / timeout)
		end
		if elapsed > timeout then
			return false
		end
		task.wait(0.1)
	end
	return true
end

local warnings = {}

-- 1. Engine
setStage(1, 0, "Waiting for game data…")
waitFor(function()
	return game:IsLoaded()
end, 25, function(a)
	setStage(1, a)
end)
setStage(1, 1)
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- 2. Server handshake
setStage(2, 0, "Waiting for shared modules and remotes…")
local shared = ReplicatedStorage:WaitForChild("Steelrise", 20)
setStage(2, 0.5)
local remotes = ReplicatedStorage:WaitForChild("SteelriseRemotes", 20)
if not shared or not remotes then
	table.insert(warnings, "server handshake timed out")
end
setStage(2, 1)

-- 3. Assets (fonts + configured audio)
local preload = {}
local probe = Instance.new("TextLabel")
for _, font in ipairs({ Enum.Font.GothamBlack, Enum.Font.GothamBold, Enum.Font.GothamMedium, Enum.Font.Gotham, Enum.Font.RobotoMono }) do
	local l = probe:Clone()
	l.Font = font
	table.insert(preload, l)
end
local audioCount = 0
if shared then
	local okReg, AudioRegistry = pcall(require, shared:WaitForChild("AudioRegistry", 5))
	if okReg and type(AudioRegistry) == "table" then
		for key, e in pairs(AudioRegistry) do
			for _, id in ipairs(e.ids or {}) do
				local s = Instance.new("Sound")
				s.Name = key
				s.SoundId = id
				table.insert(preload, s)
				audioCount += 1
			end
		end
	end
end
-- optional loading ambience (only if an id has been supplied)
local ambience = nil
if shared then
	local okReg, AudioRegistry = pcall(require, shared:WaitForChild("AudioRegistry", 5))
	local entry = okReg and type(AudioRegistry) == "table" and AudioRegistry.LoadingAmbience
	if entry and entry.ids and #entry.ids > 0 then
		ambience = Instance.new("Sound")
		ambience.SoundId = entry.ids[1]
		ambience.Looped = true
		ambience.Volume = 0
		ambience.Parent = game:GetService("SoundService")
		ambience:Play()
		TweenService:Create(ambience, TweenInfo.new(2), { Volume = entry.volume or 0.35 }):Play()
	end
end

local loaded, failed = 0, 0
local total = #preload
setStage(3, 0, string.format("Assets 0/%d", total))
local preloadDone = false
task.spawn(function()
	local ok = pcall(function()
		ContentProvider:PreloadAsync(preload, function(contentId, status)
			loaded += 1
			if status ~= Enum.AssetFetchStatus.Success then
				failed += 1
				warn("[STEELRISE] asset failed to load:", contentId, status)
			end
			setStage(3, loaded / math.max(total, 1), string.format("Assets %d/%d  ·  audio files configured: %d  ·  unavailable: %d", loaded, total, audioCount, failed))
		end)
	end)
	if not ok then
		table.insert(warnings, "asset preload error")
	end
	preloadDone = true
end)
waitFor(function()
	return preloadDone
end, 20)
if failed > 0 then
	table.insert(warnings, failed .. " asset(s) unavailable")
end
if audioCount == 0 then
	detailLabel.Text = "No custom audio configured yet (see docs/AUDIO.md) — continuing."
end
setStage(3, 1)

-- 4. Site streaming
setStage(4, 0, "Waiting for the site to be built…")
local site = nil
waitFor(function()
	site = workspace:FindFirstChild("SteelriseSite")
	return site ~= nil and site:GetAttribute("Ready") == true
end, 30, function(a)
	setStage(4, a * 0.5)
end)
if site then
	local focus = site:FindFirstChild("Focus")
	local pos = focus and focus.Position or Vector3.new(0, 20, 0)
	setStage(4, 0.55, "Streaming geometry around the crane…")
	local done = false
	task.spawn(function()
		pcall(function()
			player:RequestStreamAroundAsync(pos, 15)
		end)
		done = true
	end)
	waitFor(function()
		return done
	end, 16, function(a)
		setStage(4, 0.55 + a * 0.4)
	end)
	local comps = site:FindFirstChild("Components")
	detailLabel.Text = string.format("Site ready  ·  %d components streamed", comps and #comps:GetChildren() or 0)
else
	table.insert(warnings, "site not ready (continuing)")
end
setStage(4, 1)

-- 5. Catalog
setStage(5, 0, "Indexing item registry…")
if shared then
	local okReg, Registry = pcall(require, shared:WaitForChild("ItemRegistry", 5))
	if okReg and type(Registry) == "table" and Registry.count then
		local counts = Registry.count()
		detailLabel.Text = string.format("Catalog: %d items implemented (target %d)", counts.total, Registry.TargetCount or 500)
	else
		table.insert(warnings, "catalog unavailable")
	end
end
setStage(5, 1)

-- 6. Menu
setStage(6, 0, "Waiting for the menu…")
waitFor(function()
	return player:GetAttribute("SR_MenuReady") == true
end, 20, function(a)
	setStage(6, a)
end)
setStage(6, 1)
if #warnings > 0 then
	detailLabel.Text = "Continuing with warnings: " .. table.concat(warnings, "; ")
	task.wait(1.2)
end

task.wait(0.35)
player:SetAttribute("SR_LoaderDone", true)
local fade = TweenService:Create(root, TweenInfo.new(0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { GroupTransparency = 1 })
fade:Play()
if ambience then
	TweenService:Create(ambience, TweenInfo.new(1.2), { Volume = 0 }):Play()
	task.delay(1.3, function()
		ambience:Destroy()
	end)
end
fade.Completed:Wait()
animConn:Disconnect()
barConn:Disconnect()
gui:Destroy()
]]></ProtectedString>
</Properties>
</Item>
</Item>
<Item class="ReplicatedStorage" referent="RBX0000000D">
<Properties>
<string name="Name">ReplicatedStorage</string>
</Properties>
<Item class="Folder" referent="RBX0000000C">
<Properties>
<string name="Name">Steelrise</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000003">
<Properties>
<string name="Name">AudioRegistry</string>
<ProtectedString name="Source"><![CDATA[-- Every sound the game can play, with its mix group and playback behaviour.
--
-- IMPORTANT: no Roblox asset IDs are invented here. Entries with an empty
-- `ids` list are silent until you supply audio you have rights to use (your
-- own uploads, or Creator Store audio your experience is permitted to play).
-- Paste "rbxassetid://<id>" strings into `ids`; several ids = random
-- variations. See docs/AUDIO.md for the full list of required files.
-- Until then the default Roblox character sounds remain the only audio.

local AudioRegistry = {
	-- Crane
	CraneSlewMotor = { group = "Machinery", ids = {}, loop = true, volume = 0.55, min = 12, max = 260 },
	CraneTrolleyMotor = { group = "Machinery", ids = {}, loop = true, volume = 0.45, min = 10, max = 220 },
	CraneHoistWinch = { group = "Machinery", ids = {}, loop = true, volume = 0.6, min = 12, max = 260 },
	CraneBrake = { group = "Machinery", ids = {}, volume = 0.5, min = 10, max = 200, pitchVar = 0.08 },
	CraneWarningHorn = { group = "Machinery", ids = {}, volume = 0.6, min = 30, max = 500 },
	CableCreak = { group = "Machinery", ids = {}, volume = 0.35, min = 8, max = 120, pitchVar = 0.15 },

	-- Steel handling & impacts
	MetalContactHeavy = { group = "Impacts", ids = {}, volume = 0.8, min = 10, max = 300, pitchVar = 0.12 },
	MetalContactLight = { group = "Impacts", ids = {}, volume = 0.6, min = 6, max = 150, pitchVar = 0.15 },
	SteelSet = { group = "Impacts", ids = {}, volume = 0.7, min = 8, max = 220, pitchVar = 0.08 },
	ConcreteSet = { group = "Impacts", ids = {}, volume = 0.7, min = 8, max = 200, pitchVar = 0.08 },
	SlingRattle = { group = "Impacts", ids = {}, volume = 0.45, min = 6, max = 100, pitchVar = 0.15 },
	StrapRelease = { group = "Impacts", ids = {}, volume = 0.6, min = 6, max = 90, pitchVar = 0.1 },
	ScaffoldClank = { group = "Impacts", ids = {}, volume = 0.55, min = 6, max = 120, pitchVar = 0.18 },
	PickUp = { group = "Impacts", ids = {}, volume = 0.4, min = 4, max = 60, pitchVar = 0.1 },

	-- Tools
	ImpactWrench = { group = "Tools", ids = {}, volume = 0.75, min = 6, max = 160, pitchVar = 0.06 },
	HammerWedge = { group = "Tools", ids = {}, volume = 0.7, min = 6, max = 160, pitchVar = 0.12 },
	WeldArc = { group = "Tools", ids = {}, volume = 0.55, min = 6, max = 120, pitchVar = 0.05 },

	-- Vehicles & machines
	TruckIdle = { group = "Machinery", ids = {}, loop = true, volume = 0.5, min = 12, max = 220 },
	TruckAirBrake = { group = "Machinery", ids = {}, volume = 0.7, min = 15, max = 300, pitchVar = 0.05 },
	TruckReverseBeeper = { group = "Machinery", ids = {}, loop = true, volume = 0.45, min = 15, max = 260 },
	GeneratorLoop = { group = "Machinery", ids = {}, loop = true, volume = 0.5, min = 8, max = 160 },

	-- Footsteps by surface
	StepSteel = { group = "Footsteps", ids = {}, volume = 0.45, min = 3, max = 50, pitchVar = 0.1 },
	StepConcrete = { group = "Footsteps", ids = {}, volume = 0.4, min = 3, max = 45, pitchVar = 0.1 },
	StepGravel = { group = "Footsteps", ids = {}, volume = 0.45, min = 3, max = 45, pitchVar = 0.12 },
	StepDirt = { group = "Footsteps", ids = {}, volume = 0.4, min = 3, max = 40, pitchVar = 0.12 },
	StepWood = { group = "Footsteps", ids = {}, volume = 0.4, min = 3, max = 45, pitchVar = 0.1 },
	StepGrating = { group = "Footsteps", ids = {}, volume = 0.5, min = 3, max = 50, pitchVar = 0.12 },

	-- Ambience (2D loops)
	WindLoop = { group = "Ambience", ids = {}, loop = true, volume = 0.35, twoD = true },
	WindHighLoop = { group = "Ambience", ids = {}, loop = true, volume = 0.5, twoD = true },
	DistantConstruction = { group = "Ambience", ids = {}, loop = true, volume = 0.3, twoD = true },
	CityTraffic = { group = "Ambience", ids = {}, loop = true, volume = 0.25, twoD = true },
	Harbour = { group = "Ambience", ids = {}, loop = true, volume = 0.25, twoD = true },
	LoadingAmbience = { group = "Ambience", ids = {}, loop = true, volume = 0.35, twoD = true },

	-- Interface
	UIClick = { group = "UI", ids = {}, volume = 0.4, twoD = true },
	UINotify = { group = "UI", ids = {}, volume = 0.35, twoD = true },
	UIError = { group = "UI", ids = {}, volume = 0.35, twoD = true },
	UIConfirm = { group = "UI", ids = {}, volume = 0.4, twoD = true },
}

return AudioRegistry
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000004">
<Properties>
<string name="Name">BuildRules</string>
<ProtectedString name="Source"><![CDATA[-- Shared construction rules: socket index, snapping solver and placement
-- validation. The client uses solve() to drive the placement preview; the
-- server re-runs validate() on every placement/landing before accepting it,
-- so both sides explain failures with the same words.

local Config = require(script.Parent.Config)
local Registry = require(script.Parent.ItemRegistry)
local Util = require(script.Parent.Util)

local S = Config.S
local TOL = Config.Geo.SnapTolerance
local CELL = 6
local UP = Vector3.yAxis

local BuildRules = {}

BuildRules.SocketNames = {
	FootingTop = "a footing top",
	ColumnTop = "the top of a column",
	BeamSeat = "a beam seat on a column face",
	GussetMount = "a gusset mount on a column face",
	BraceSeat = "a gusset plate seat",
	CladSeat = "the outside face line of two columns",
	ScafNode = "a scaffold base jack",
	ScafStdTop = "the top of a scaffold upright",
	ScafRosette = "a rosette on a scaffold upright",
}

BuildRules.SupportStates = { Placed = true, Installed = true }
BuildRules.SolidStates = { Placed = true, Installed = true, Loose = true, Restrained = true }

local function friendlyAccepts(acceptSet)
	local names = {}
	for t in pairs(acceptSet or {}) do
		table.insert(names, BuildRules.SocketNames[t] or t)
	end
	table.sort(names)
	return table.concat(names, " or ")
end

---------------------------------------------------------------------------
-- World access (works on server and client)
---------------------------------------------------------------------------

local World = {}
World.__index = World

function BuildRules.newWorld(siteFolder)
	local self = setmetatable({}, World)
	self.site = siteFolder
	self.components = siteFolder:WaitForChild("Components", 10)
	self.environment = siteFolder:WaitForChild("Environment", 10)
	self.dirty = true
	self._index = nil
	self.overlap = OverlapParams.new()
	self.overlap.FilterType = Enum.RaycastFilterType.Include
	self.overlap.FilterDescendantsInstances = { self.components, self.environment }
	self.overlap.RespectCanCollide = true
	self.ray = RaycastParams.new()
	self.ray.FilterType = Enum.RaycastFilterType.Include
	self.ray.FilterDescendantsInstances = { self.components, self.environment, workspace.Terrain }
	self.ray.IgnoreWater = false
	return self
end

function World:markDirty()
	self.dirty = true
end

function World:bounds()
	local mn = self.site:GetAttribute("BoundsMin")
	local mx = self.site:GetAttribute("BoundsMax")
	return mn, mx
end

-- Component record from a model (or any descendant part).
function World:record(inst)
	local model = inst
	while model and model.Parent ~= self.components do
		model = model.Parent
	end
	if not model or not model:IsA("Model") then
		return nil
	end
	local def = Registry.get(model:GetAttribute("ItemId") or "")
	if not def or not model.PrimaryPart then
		return nil
	end
	return {
		id = model:GetAttribute("ComponentId"),
		def = def,
		cf = model:GetPivot(),
		state = model:GetAttribute("State"),
		model = model,
	}
end

function World:records()
	local out = {}
	for _, model in ipairs(self.components:GetChildren()) do
		local r = self:record(model)
		if r and r.id then
			table.insert(out, r)
		end
	end
	return out
end

local function cellKey(x, y, z)
	return math.floor(x / CELL) .. "," .. math.floor(y / CELL) .. "," .. math.floor(z / CELL)
end

function World:index()
	if not self.dirty and self._index then
		return self._index
	end
	local idx = { cells = {}, list = {} }
	local recs = self:records()
	for _, r in ipairs(recs) do
		if BuildRules.SupportStates[r.state] then
			for _, s in ipairs(r.def.sockets) do
				local wcf = r.cf * s.cfS
				local p = wcf.Position
				local sock = {
					type = s.type,
					cf = wcf,
					pos = p,
					owner = r.id,
					ownerName = r.def.name,
					multi = s.multi,
					provisional = r.state ~= "Installed",
				}
				local k = cellKey(p.X, p.Y, p.Z)
				idx.cells[k] = idx.cells[k] or {}
				table.insert(idx.cells[k], sock)
				table.insert(idx.list, sock)
			end
		end
	end
	self._index = idx
	self.dirty = false
	-- occupancy from plugs of placed/installed components
	for _, r in ipairs(recs) do
		if BuildRules.SupportStates[r.state] then
			for _, plug in ipairs(r.def.plugs) do
				local wp = (r.cf * plug.cfS).Position
				for _, s in ipairs(self:query(wp, TOL * 2)) do
					if not s.multi and plug.acceptSet[s.type] and s.owner ~= r.id then
						s.occupiedBy = r.id
					end
				end
			end
		end
	end
	return idx
end

function World:query(pos, radius)
	local idx = self._index or self:index()
	local out = {}
	local r = math.ceil(radius / CELL)
	local cx, cy, cz = math.floor(pos.X / CELL), math.floor(pos.Y / CELL), math.floor(pos.Z / CELL)
	for x = cx - r, cx + r do
		for y = cy - r, cy + r do
			for z = cz - r, cz + r do
				local list = idx.cells[x .. "," .. y .. "," .. z]
				if list then
					for _, s in ipairs(list) do
						if (s.pos - pos).Magnitude <= radius then
							table.insert(out, s)
						end
					end
				end
			end
		end
	end
	return out
end

function World:raycast(origin, dir, exclude)
	local params = self.ray
	if exclude and #exclude > 0 then
		params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Include
		params.FilterDescendantsInstances = { self.components, self.environment, workspace.Terrain }
		params.IgnoreWater = false
		-- Include lists cannot subtract; filter results instead.
		local result = workspace:Raycast(origin, dir, params)
		local guard = 0
		while result and guard < 8 do
			local skip = false
			for _, m in ipairs(exclude) do
				if result.Instance:IsDescendantOf(m) then
					skip = true
					break
				end
			end
			if not skip then
				return result
			end
			guard += 1
			local travelled = (result.Position - origin).Magnitude + 0.01
			local remaining = dir.Magnitude - travelled
			if remaining <= 0 then
				return nil
			end
			origin = result.Position + dir.Unit * 0.01
			dir = dir.Unit * remaining
			result = workspace:Raycast(origin, dir, params)
		end
		return result
	end
	return workspace:Raycast(origin, dir, params)
end

---------------------------------------------------------------------------
-- Orientation helpers
---------------------------------------------------------------------------

local function frameFrom(dir)
	local f1 = dir.Unit
	local f3 = f1:Cross(UP)
	if f3.Magnitude < 1e-4 then
		f3 = Vector3.zAxis
	end
	f3 = f3.Unit
	local f2 = f3:Cross(f1)
	return CFrame.fromMatrix(Vector3.zero, f1, f2, f3)
end

-- CFrame placing local plug points pA,pB onto world points a,b.
local function spanCf(pA, pB, a, b)
	local R = frameFrom(b - a) * frameFrom(pB - pA):Inverse()
	return CFrame.new(a) * R * CFrame.new(-pA)
end

BuildRules.spanCf = spanCf

-- Candidate CFrame for a Point item rotated `angle` about its socket.
local function s_cf(sock, angle, plug)
	return sock.cf * CFrame.Angles(0, angle, 0) * plug.cfS:Inverse()
end

function BuildRules.angleDiff(def, cfA, cfB)
	local d = Util.angleBetween(cfA, cfB)
	if def.symmetric180 then
		local flipped = cfB * CFrame.Angles(0, math.pi, 0)
		d = math.min(d, Util.angleBetween(cfA, flipped))
	end
	return d
end

---------------------------------------------------------------------------
-- Validation
---------------------------------------------------------------------------

-- Returns ok, reason, info { mates = {ids}, supports = {ids} }
-- opts: { exclude = {ids}, excludeModels = {models}, actorPos = Vector3, reach = studs, ignoreOverlap = bool }
function BuildRules.validate(world, def, cf, opts)
	opts = opts or {}
	local info = { mates = {}, supports = {} }
	local excl = {}
	for _, id in ipairs(opts.exclude or {}) do
		excl[id] = true
	end

	if def.kind == "Tool" then
		return false, "Tools are equipped from the hotbar, not placed.", info
	end

	-- Reach
	if opts.actorPos and opts.reach then
		local dist = (cf.Position - opts.actorPos).Magnitude
		if dist > opts.reach then
			return false, string.format("Out of reach (%.1f m) — move closer.", Config.toMeters(dist)), info
		end
	end

	-- Site boundary
	local mn, mx = world:bounds()
	if mn and mx then
		local p = cf.Position
		if p.X < mn.X or p.Z < mn.Z or p.X > mx.X or p.Z > mx.Z then
			return false, "Outside the site boundary.", info
		end
	end

	world:index()

	local function matchSocket(plug, wcf)
		local wp = wcf.Position
		local near = world:query(wp, 2.5)
		local best, bestD, wrong = nil, math.huge, nil
		for _, s in ipairs(near) do
			local d = (s.pos - wp).Magnitude
			if plug.acceptSet[s.type] then
				if d <= TOL and d < bestD then
					best, bestD = s, d
				end
			elseif d <= 1.0 and not excl[s.owner] then
				wrong = s
			end
		end
		if not best then
			if wrong then
				return nil, string.format("Wrong connection type: this needs %s, not %s.", friendlyAccepts(plug.acceptSet), BuildRules.SocketNames[wrong.type] or wrong.type)
			end
			return nil, string.format("Missing support: needs %s here.", friendlyAccepts(plug.acceptSet))
		end
		if best.occupiedBy and not excl[best.occupiedBy] then
			return nil, "That connection is already used by another component."
		end
		if best.provisional then
			return nil, string.format("Supporting %s isn't fastened yet — finish its connections first.", best.ownerName)
		end
		return best
	end

	if def.kind == "Point" then
		local plug = def.plugs[1]
		local wcf = cf * plug.cfS
		local s, why = matchSocket(plug, wcf)
		if not s then
			return false, why, info
		end
		if wcf.UpVector:Dot(s.cf.UpVector) < 0.995 then
			return false, "Not plumb with its connection — rotate it upright.", info
		end
		if def.rotStep >= 360 and wcf.LookVector:Dot(s.cf.LookVector) < 0.99 then
			return false, "Not aligned with its connection face.", info
		end
		table.insert(info.mates, s.owner)
	elseif def.kind == "Span" then
		local used = {}
		local matched = {}
		for i, plug in ipairs(def.plugs) do
			local wcf = cf * plug.cfS
			local s, why = matchSocket(plug, wcf)
			if not s then
				return false, (i == 1 and "First end: " or "Second end: ") .. why, info
			end
			if used[s] then
				return false, "Both ends land on the same connection.", info
			end
			used[s] = true
			matched[i] = s
			if def.faceNormal then
				local front = cf:VectorToWorldSpace(Vector3.zAxis)
				if front:Dot(s.cf.LookVector) < 0.95 then
					return false, "Panel faces the wrong way — it must hang on the outside face of the columns.", info
				end
			end
			table.insert(info.mates, s.owner)
		end
		local expected = spanCf(def.plugs[1].cfS.Position, def.plugs[2].cfS.Position, matched[1].pos, matched[2].pos)
		if Util.angleBetween(expected, cf) > 0.05 then
			return false, "Twisted out of line with its connections.", info
		end
		for _, req in ipairs(def.requireSockets or {}) do
			local wp = (cf * req.cfS).Position
			local found = false
			for _, s in ipairs(world:query(wp, TOL * 2)) do
				if s.type == req.type then
					found = true
					table.insert(info.mates, s.owner)
					break
				end
			end
			if not found then
				return false, "Missing support: needs an upright with a rosette at every corner of the bay.", info
			end
		end
	elseif def.kind == "Surface" then
		if cf.UpVector.Y < 0.999 then
			return false, "Floor sheets must lie level.", info
		end
		local half = def.size.X / 2 - 0.09
		local exclude = opts.excludeModels
		for i, sx in ipairs({ -1, 1 }) do
			local origin = cf * Vector3.new(sx * half, 0.6, 0)
			local hit = world:raycast(origin, Vector3.new(0, -1.6, 0), exclude)
			local rec = hit and world:record(hit.Instance)
			local okTag = false
			if rec then
				for tag in pairs(def.surface.supportTags) do
					if rec.def.tags[tag] then
						okTag = true
					end
				end
			end
			local endName = i == 1 and "one end" or "the other end"
			if not rec or not okTag then
				return false, string.format("Missing support at %s: it must bear on a beam %.1f m from the first.", endName, def.sizeM.X), info
			end
			if math.abs(hit.Position.Y - cf.Position.Y) > 0.12 then
				return false, "Not bearing on the beam flange — lower it onto the steel.", info
			end
			if rec.state ~= "Installed" then
				return false, string.format("Supporting %s isn't fastened yet.", rec.def.name), info
			end
			table.insert(info.supports, rec.id)
		end
	elseif def.kind == "Rest" then
		if cf.UpVector.Y < 0.999 then
			return false, "It has to stand upright.", info
		end
		local center = cf.Position
		local hit = world:raycast(center + Vector3.new(0, 0.6, 0), Vector3.new(0, -1.4, 0), opts.excludeModels)
		if not hit then
			return false, "Missing support: nothing solid underneath.", info
		end
		if math.abs(hit.Position.Y - center.Y) > 0.15 then
			return false, "Not resting on the surface.", info
		end
		if hit.Normal.Y < 0.94 then
			return false, "Ground is too steep here.", info
		end
		local rec = world:record(hit.Instance)
		if def.rest and def.rest.terrainOnly and hit.Instance ~= workspace.Terrain then
			return false, "Footings must be set on prepared ground, not on other materials.", info
		end
		if rec then
			if rec.state ~= "Installed" then
				return false, "Can only be set down on installed structure or the ground.", info
			end
			table.insert(info.supports, rec.id)
		end
		-- corner support (no hanging off a deck edge)
		local hx, hz = def.size.X / 2 * 0.85, def.size.Z / 2 * 0.85
		local misses = 0
		for _, c in ipairs({ { hx, hz }, { -hx, hz }, { hx, -hz }, { -hx, -hz } }) do
			local o = cf * Vector3.new(c[1], 0.6, c[2])
			local h = world:raycast(o, Vector3.new(0, -1.4, 0), opts.excludeModels)
			if not h or math.abs(h.Position.Y - center.Y) > 0.4 then
				misses += 1
			end
		end
		if misses >= 2 then
			return false, "Missing support: it would overhang an edge.", info
		end
	end

	-- Overlap
	if not opts.ignoreOverlap then
		for _, id in ipairs(info.mates) do
			excl[id] = true
		end
		for _, id in ipairs(info.supports) do
			excl[id] = true
		end
		local shrink = Vector3.new(0.14, 0.14, 0.14)
		local size = def.size - shrink
		size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
		local boxCf = cf * CFrame.new(def.boundsOffset)
		local parts = workspace:GetPartBoundsInBox(boxCf, size, world.overlap)
		for _, p in ipairs(parts) do
			if p.Parent and p.Parent.Name ~= "Fasteners" then
				local rec = world:record(p)
				if rec then
					local ignore = excl[rec.id] or not BuildRules.SolidStates[rec.state]
					if not ignore then
						for tag in pairs(def.overlapIgnore) do
							if rec.def.tags[tag] then
								ignore = true
							end
						end
					end
					if not ignore then
						return false, "Overlaps " .. rec.def.name .. ".", info
					end
				elseif p:IsDescendantOf(world.environment) then
					return false, "Overlaps site equipment (" .. (p.Parent and p.Parent.Name or p.Name) .. ").", info
				end
			end
		end
	end

	return true, nil, info
end

---------------------------------------------------------------------------
-- Solver: find the snapped CFrame for an item from an aim
---------------------------------------------------------------------------

-- aim: { point = Vector3, hit = Instance?, normal = Vector3? }
-- opts: { rot = int steps, free = bool, nudge = Vector3 (studs), current = CFrame (crane landing),
--         excludeModels = {models} }
-- returns cf or nil, hintReason
function BuildRules.solve(world, def, aim, opts)
	opts = opts or {}
	world:index()
	local kind = def.kind
	if kind == "Point" then
		local plug = def.plugs[1]
		local ref = aim.point
		if opts.current then
			ref = (opts.current * plug.cfS).Position
		end
		local best, bestD, wrong = nil, 3.5, nil
		for _, s in ipairs(world:query(ref, 3.5)) do
			local d = (s.pos - ref).Magnitude
			if plug.acceptSet[s.type] then
				if not s.occupiedBy and d < bestD then
					best, bestD = s, d
				end
			elseif not wrong then
				wrong = s
			end
		end
		if not best then
			if wrong then
				return nil, string.format("Wrong connection type: needs %s.", friendlyAccepts(plug.acceptSet))
			end
			return nil, string.format("Aim at %s.", friendlyAccepts(plug.acceptSet))
		end
		local step = math.rad(def.rotStep >= 360 and 0 or def.rotStep)
		local k = opts.rot or 0
		if opts.current and step > 0 then
			local bestA, bestK = math.huge, 0
			for kk = 0, math.floor(2 * math.pi / step + 0.5) - 1 do
				local cand = s_cf(best, step * kk, plug)
				local a = Util.angleBetween(cand, opts.current)
				if a < bestA then
					bestA, bestK = a, kk
				end
			end
			k = bestK
		end
		return best.cf * CFrame.Angles(0, step * k, 0) * plug.cfS:Inverse()
	elseif kind == "Span" then
		local pA, pB = def.plugs[1].cfS.Position, def.plugs[2].cfS.Position
		local L = (pB - pA).Magnitude
		local ref = aim.point
		if opts.current then
			ref = opts.current * ((pA + pB) / 2)
		end
		local radius = L / 2 + 4
		local cands = {}
		for _, s in ipairs(world:query(ref, radius)) do
			if def.plugs[1].acceptSet[s.type] and (s.multi or not s.occupiedBy) then
				table.insert(cands, s)
			end
		end
		local best, bestScore = nil, math.huge
		local sawPairDist = nil
		for i = 1, #cands do
			for j = 1, #cands do
				if i ~= j then
					local a, b = cands[i], cands[j]
					local w = b.pos - a.pos
					local dist = w.Magnitude
					if dist > 0.5 and math.abs(dist - L) <= TOL * 1.5 then
						local inclination = math.asin(Util.clamp(w.Y / dist, -1, 1))
						local wantPitch = def.pitch or 0
						local okPitch = math.abs(math.abs(inclination) - wantPitch) < math.rad(3)
						if okPitch then
							local cf = spanCf(pA, pB, a.pos, b.pos)
							local ok = true
							if def.faceNormal then
								local front = cf:VectorToWorldSpace(Vector3.zAxis)
								ok = front:Dot(a.cf.LookVector) > 0.95 and front:Dot(b.cf.LookVector) > 0.95
							end
							if ok and def.requireSockets then
								for _, req in ipairs(def.requireSockets) do
									local wp = (cf * req.cfS).Position
									local found = false
									for _, s in ipairs(world:query(wp, TOL * 2)) do
										if s.type == req.type then
											found = true
											break
										end
									end
									if not found then
										ok = false
										break
									end
								end
							end
							if ok then
								local mid = (a.pos + b.pos) / 2
								local score = (mid - ref).Magnitude
								if opts.current then
									score += BuildRules.angleDiff(def, cf, opts.current) * 8
								end
								if score < bestScore then
									best, bestScore = cf, score
								end
							end
						end
					elseif dist > 0.5 and math.abs(w.Y) < 0.2 then
						if not sawPairDist or math.abs(dist - L) < math.abs(sawPairDist - L) then
							sawPairDist = dist
						end
					end
				end
			end
		end
		if not best then
			if #cands == 0 then
				return nil, string.format("Aim between two connections: needs %s at both ends.", friendlyAccepts(def.plugs[1].acceptSet))
			end
			if sawPairDist then
				return nil, string.format("Missing support: needs two seats %.2f m apart (nearest pair is %.2f m).", Config.toMeters(L), Config.toMeters(sawPairDist))
			end
			return nil, string.format("Missing support: no second seat %.2f m away.", Config.toMeters(L))
		end
		return best
	elseif kind == "Surface" then
		local rec, anchorPoint
		if opts.current then
			local half = def.size.X / 2 - 0.09
			for _, sx in ipairs({ -1, 1 }) do
				local o = opts.current * Vector3.new(sx * half, 0.5, 0)
				local hit = world:raycast(o, Vector3.new(0, -8, 0), opts.excludeModels)
				local r = hit and world:record(hit.Instance)
				if r and r.def.tags.Beam then
					rec, anchorPoint = r, o
					break
				end
			end
		else
			rec = aim.hit and world:record(aim.hit)
			anchorPoint = aim.point
		end
		if not rec or not rec.def.tags.Beam then
			return nil, "Aim at the top flange of an installed beam."
		end
		local beamCf = rec.cf
		local ax = beamCf.XVector
		ax = Vector3.new(ax.X, 0, ax.Z)
		if ax.Magnitude < 0.5 then
			return nil, "That beam is not level."
		end
		ax = ax.Unit
		local d = rec.def.sizeM.Y * S
		local top = beamCf.Position + Vector3.new(0, d / 2, 0)
		local s = ax:Cross(UP).Unit
		if (anchorPoint - top):Dot(s) < 0 then
			s = -s
		end
		local seat = Config.Geo.SeatOffset * S
		local fullLen = rec.def.size.X + 2 * seat
		local t0 = top - ax * (fullLen / 2)
		local W = def.surface.tile * S
		local tAim = (anchorPoint - t0):Dot(ax)
		local t = (math.floor(tAim / W) + 0.5) * W
		t = Util.clamp(t, W / 2, fullLen - W / 2)
		local L = def.size.X
		local pos = t0 + ax * t + s * (L / 2)
		pos = Vector3.new(pos.X, top.Y, pos.Z)
		return CFrame.fromMatrix(pos, s, UP, s:Cross(UP))
	elseif kind == "Rest" then
		local p = aim.point
		if opts.current then
			local hit = world:raycast(opts.current.Position + Vector3.new(0, 1, 0), Vector3.new(0, -80, 0), opts.excludeModels)
			if not hit then
				return nil, "No ground below the load."
			end
			p = hit.Position
		end
		local yaw
		if opts.current then
			yaw = Util.yawOf(opts.current)
			if not def.allowFree then
				yaw = Util.round(yaw, math.rad(90))
			end
		else
			local step = opts.free and Config.Grid.FreeRotateStep or 90
			if def.rotStep >= 360 then
				step = 0
			end
			yaw = math.rad(step * (opts.rot or 0))
		end
		local snapped = false
		if def.rest and def.rest.lattice and not opts.free then
			local bestNode, bestD = nil, 30
			for _, s in ipairs(world:query(p, 30)) do
				if s.type == "ScafNode" and math.abs(s.pos.Y - Config.Geo.ScaffoldJack * S - p.Y) < 2 then
					local dd = (Vector3.new(s.pos.X, 0, s.pos.Z) - Vector3.new(p.X, 0, p.Z)).Magnitude
					if dd < bestD then
						bestNode, bestD = s, dd
					end
				end
			end
			if bestNode then
				local A, B = Config.Geo.ScaffoldBayLong * S, Config.Geo.ScaffoldBayShort * S
				local dx, dz = p.X - bestNode.pos.X, p.Z - bestNode.pos.Z
				local function snapAxis(v)
					local options = { Util.round(v, A), Util.round(v, B) }
					return math.abs(options[1] - v) <= math.abs(options[2] - v) and options[1] or options[2]
				end
				p = Vector3.new(bestNode.pos.X + snapAxis(dx), p.Y, bestNode.pos.Z + snapAxis(dz))
				snapped = true
			end
		end
		if not snapped and not opts.free then
			local g = ((def.rest and def.rest.grid) or Config.Grid.Ground) * S
			p = Vector3.new(Util.round(p.X, g), p.Y, Util.round(p.Z, g))
		end
		if opts.nudge then
			p += Vector3.new(opts.nudge.X, 0, opts.nudge.Z)
		end
		-- settle on whatever is under the snapped point
		local hit = world:raycast(p + Vector3.new(0, 3, 0), Vector3.new(0, -8, 0), opts.excludeModels)
		if hit then
			p = Vector3.new(p.X, hit.Position.Y, p.Z)
		end
		return CFrame.new(p) * CFrame.Angles(0, yaw, 0)
	end
	return nil, "This item can't be placed."
end

-- Ids of the components an item at `cf` connects to or bears on (any state).
-- Used to rebuild support links for pre-built site stages.
function BuildRules.supportsOf(world, def, cf, selfId)
	world:index()
	local ids, seen = {}, {}
	local function add(id)
		if id and id ~= selfId and not seen[id] then
			seen[id] = true
			table.insert(ids, id)
		end
	end
	for _, plug in ipairs(def.plugs) do
		local wp = (cf * plug.cfS).Position
		for _, s in ipairs(world:query(wp, TOL * 2)) do
			if plug.acceptSet[s.type] then
				add(s.owner)
				break
			end
		end
	end
	if def.kind == "Surface" then
		local half = def.size.X / 2 - 0.09
		for _, sx in ipairs({ -1, 1 }) do
			local hit = world:raycast(cf * Vector3.new(sx * half, 0.6, 0), Vector3.new(0, -1.6, 0))
			local rec = hit and world:record(hit.Instance)
			if rec then
				add(rec.id)
			end
		end
	elseif def.kind == "Rest" then
		local hit = world:raycast(cf.Position + Vector3.new(0, 0.6, 0), Vector3.new(0, -1.4, 0))
		local rec = hit and world:record(hit.Instance)
		if rec then
			add(rec.id)
		end
	end
	return ids
end

-- Components that rest on / connect to `id` (blocking dismantle).
function BuildRules.dependents(world, id)
	local out = {}
	for _, model in ipairs(world.components:GetChildren()) do
		local sup = model:GetAttribute("SupportedBy")
		if sup and BuildRules.SupportStates[model:GetAttribute("State")] then
			for other in string.gmatch(sup, "[^,]+") do
				if other == id then
					table.insert(out, model)
					break
				end
			end
		end
	end
	return out
end

return BuildRules
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000005">
<Properties>
<string name="Name">Config</string>
<ProtectedString name="Source"><![CDATA[-- STEELRISE shared configuration. Every tunable number lives here so the
-- server, the client and the shared rules agree on the same values.

local Config = {}

Config.Version = "0.1.0-phase1"
Config.GameTitle = "STEELRISE"
Config.Subtitle = "CONSTRUCTION SIMULATOR"

-- World scale: 3 studs per metre (a default 5.2-stud avatar reads as ~1.73 m).
Config.S = 3

function Config.m(meters)
	return meters * Config.S
end

function Config.toMeters(studs)
	return studs / Config.S
end

Config.Colors = {
	Charcoal = Color3.fromRGB(24, 26, 29),
	CharcoalLight = Color3.fromRGB(36, 39, 43),
	Panel = Color3.fromRGB(30, 33, 37),
	Steel = Color3.fromRGB(122, 128, 134),
	SteelDark = Color3.fromRGB(70, 74, 79),
	OffWhite = Color3.fromRGB(236, 233, 226),
	Muted = Color3.fromRGB(150, 154, 158),
	Safety = Color3.fromRGB(255, 194, 14),
	SafetyDark = Color3.fromRGB(196, 146, 0),
	Valid = Color3.fromRGB(88, 214, 141),
	Invalid = Color3.fromRGB(235, 87, 72),
	Info = Color3.fromRGB(110, 170, 235),

	-- Material colours used by the model factory
	MillSteel = Color3.fromRGB(86, 90, 95),
	PrimerGray = Color3.fromRGB(118, 121, 124),
	PrimerRed = Color3.fromRGB(122, 58, 46),
	Galvanized = Color3.fromRGB(164, 169, 172),
	Concrete = Color3.fromRGB(168, 165, 158),
	ConcreteDark = Color3.fromRGB(128, 126, 120),
	CraneYellow = Color3.fromRGB(240, 178, 18),
	Rubber = Color3.fromRGB(28, 28, 30),
	Timber = Color3.fromRGB(150, 112, 72),
	StrapOrange = Color3.fromRGB(232, 110, 28),
	Glass = Color3.fromRGB(140, 170, 185),
	HiVis = Color3.fromRGB(208, 255, 40),
}

-- Weight classes decide how an item can be handled.
--   Light   : one person, normal walking, can climb ladders while carrying
--   Medium  : one person, slow walking, no ladders
--   Heavy   : crane (or later: telehandler) only
--   Fixed   : not movable once delivered (site equipment)
Config.WeightClasses = {
	Light = { maxKg = 25, carry = true, walkSpeed = 14, climb = true, label = "Light — carry by hand" },
	Medium = { maxKg = 75, carry = true, walkSpeed = 9, climb = false, label = "Medium — carry slowly, no ladders" },
	Heavy = { maxKg = math.huge, carry = false, walkSpeed = 16, climb = true, label = "Heavy — crane lift required" },
	Fixed = { maxKg = math.huge, carry = false, walkSpeed = 16, climb = true, label = "Fixed equipment" },
}

function Config.weightClassFor(kg)
	if kg <= Config.WeightClasses.Light.maxKg then
		return "Light"
	elseif kg <= Config.WeightClasses.Medium.maxKg then
		return "Medium"
	end
	return "Heavy"
end

Config.WalkSpeed = 16

Config.Reach = {
	Interact = 13, -- studs from the character to the thing being used
	Place = 16, -- studs from the character to a hand-placement target
	Fasten = 13,
	CraneCab = 18, -- distance to the crane access ladder to climb in
}

-- Geometry shared by columns, beams, gussets, braces and panels (metres).
Config.Geo = {
	SeatOffset = 0.20, -- beam seat / gusset mount distance from column centre
	CladOffset = 0.24, -- cladding back face distance from column centre
	GussetLow = 0.60, -- gusset mount height above column base
	GussetHighFromTop = 0.90, -- gusset mount depth below column top
	GussetTip = 0.26, -- brace seat distance from gusset back edge
	DeckWidth = 0.75, -- every bay length is a multiple of this
	DeckDepth = 0.075,
	FootingTop = 0.80, -- top of a precast footing above grade
	ScaffoldBayLong = 2.57,
	ScaffoldBayShort = 1.09,
	ScaffoldLift = 2.0,
	ScaffoldJack = 0.30, -- base-jack node height above the ground
	SnapTolerance = 0.08, -- studs
}

Config.Bays = { 4.5, 6.0, 7.5, 9.0 }
Config.FloorHeights = { 3.6, 4.2, 4.5 }

Config.Grid = {
	Ground = 0.5, -- metres, default ground grid
	Fine = 0.1, -- metres, fine adjustment nudge
	RotateStep = 90,
	FreeRotateStep = 15,
}

Config.Crane = {
	SlewMaxSpeed = math.rad(7), -- rad/s
	SlewAccel = math.rad(4),
	SlewBrake = math.rad(7),
	TrolleyMaxSpeed = 7, -- studs/s
	TrolleyAccel = 4,
	TrolleyBrake = 7,
	HoistMaxSpeed = 10, -- studs/s, unloaded
	HoistLoadedSpeed = 5,
	HoistAccel = 8,
	HoistBrake = 14,
	LoadRotateSpeed = math.rad(18),
	PrecisionFactor = 0.25,
	PendulumGravity = 9.81 * 3, -- studs/s² (real g at world scale)
	SwingDamping = 0.10,
	SwingDampingAssist = 0.45,
	SlingDrop = 4.0, -- studs from hook to the rigging point
	AttachRange = 4.0, -- hook to lift point
	LandPosTolerance = 1.6, -- studs between hanging load and its target to land
	LandAngleTolerance = math.rad(14),
	RiggingKg = 60,
	StreamRate = 15, -- Hz, operator -> server
	AttributeRate = 12, -- Hz, server -> everyone
	RemoteRange = 600, -- studs from the mast for the radio remote
}

-- Capacity chart: full capacity inside FullRadius, then falls off with the
-- load moment. Both values in metres/kg so the HUD reads like a real chart.
function Config.craneCapacityKg(craneDef, radiusStuds)
	local r = math.max(Config.toMeters(radiusStuds), 0.1)
	local full = craneDef.maxKg or 8000
	local fullRadius = craneDef.fullRadiusM or 18
	if r <= fullRadius then
		return full
	end
	return math.floor(full * fullRadius / r)
end

Config.Delivery = {
	MaxTrailers = 3,
	TrailerMaxKg = 22000,
	BedLength = 16.0, -- metres
	BedWidth = 2.5,
	BedHeight = 1.45, -- deck height above the road
	MaxStackHeight = 2.4,
	ArriveSeconds = 7,
	DepartSeconds = 7,
	MaxLooseComponents = 400,
}

Config.Save = {
	StoreName = "SteelriseSaves_v1",
	ManualSlots = 3,
	AutosaveSlot = 0,
	AutosaveInterval = 180,
	MinSaveGap = 8, -- seconds between saves per player (DataStore budget)
}

Config.Graphics = {
	Default = "Balanced",
	Presets = {
		Low = { shadows = false, post = false, atmosphere = 0.25, particles = 0.3, detailDistance = 250 },
		Balanced = { shadows = true, post = true, atmosphere = 0.32, particles = 0.7, detailDistance = 450 },
		High = { shadows = true, post = true, atmosphere = 0.36, particles = 1.0, detailDistance = 800 },
		Ultra = { shadows = true, post = true, atmosphere = 0.38, particles = 1.0, detailDistance = 1600 },
	},
	Order = { "Low", "Balanced", "High", "Ultra" },
}

Config.AudioGroups = { "Master", "Machinery", "Tools", "Impacts", "Ambience", "Footsteps", "UI" }

Config.DefaultSettings = {
	graphics = "Balanced",
	shadows = true,
	post = true,
	particles = true,
	fov = 70,
	thirdPerson = false,
	mouseSensitivity = 1.0,
	assist = true,
	tutorialDone = false,
	volumes = { Master = 0.8, Machinery = 0.8, Tools = 0.8, Impacts = 0.8, Ambience = 0.6, Footsteps = 0.7, UI = 0.6 },
}

return Config
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000006">
<Properties>
<string name="Name">CraneMath</string>
<ProtectedString name="Source"><![CDATA[-- Tower crane kinematics shared by the server (validation, landing checks)
-- and every client (rendering, operator prediction).
--
-- State (all studs / radians):
--   slew     : jib heading about the mast
--   trolley  : trolley radius from the mast centre along the jib
--   hoist    : rope length from the trolley sheaves to the hook point
--   swingX/Z : pendulum offset of the hook point in the jib frame
--   loadYaw  : load rotation about the hook (taglines/rotator)

local Config = require(script.Parent.Config)
local Util = require(script.Parent.Util)

local S = Config.S

local CraneMath = {}

-- Geometry offsets relative to the slewing pivot (top of mast), studs.
CraneMath.TrolleyY = 0.5 -- sheave point under the jib
CraneMath.JibBottomY = 2.0
CraneMath.JibHeight = 4.5
CraneMath.JibWidth = 3.6
CraneMath.MastWidth = 4.8
CraneMath.CabOffset = Vector3.new(1.2, -1.4, 4.4) -- cab centre, beside the jib root
CraneMath.CabEye = Vector3.new(1.8, -0.4, 4.4) -- operator eye point inside the cab
CraneMath.HookBlockHeight = 3.0 -- hook point to the top of the block

function CraneMath.config(craneDef)
	local cfg = {}
	cfg.base = craneDef.posM * S
	cfg.height = craneDef.heightM * S
	cfg.pivot = cfg.base + Vector3.new(0, cfg.height, 0)
	cfg.jib = craneDef.jibM * S
	cfg.counter = craneDef.counterM * S
	cfg.minR = 4 * S
	cfg.maxR = cfg.jib - 1.5 * S
	cfg.minRope = 4
	cfg.maxRope = cfg.height + CraneMath.TrolleyY - 1
	cfg.maxKg = craneDef.maxKg
	cfg.fullRadiusM = craneDef.fullRadiusM
	cfg.def = craneDef
	return cfg
end

function CraneMath.defaultState(craneDef)
	return {
		slew = math.rad(craneDef.slewDeg or 0),
		trolley = craneDef.jibM * S * 0.45,
		hoist = 20,
		swingX = 0,
		swingZ = 0,
		loadYaw = 0,
	}
end

function CraneMath.slewCf(cfg, slew)
	return CFrame.new(cfg.pivot) * CFrame.Angles(0, slew, 0)
end

function CraneMath.trolleyCf(cfg, st)
	return CraneMath.slewCf(cfg, st.slew) * CFrame.new(st.trolley, CraneMath.TrolleyY, 0)
end

function CraneMath.hookPos(cfg, st)
	local slewCf = CraneMath.slewCf(cfg, st.slew)
	local trolley = (slewCf * CFrame.new(st.trolley, CraneMath.TrolleyY, 0)).Position
	local swing = slewCf:VectorToWorldSpace(Vector3.new(st.swingX or 0, 0, st.swingZ or 0))
	-- keep rope length constant as the pendulum swings out
	local rope = st.hoist
	local horiz = swing.Magnitude
	local drop = math.sqrt(math.max(rope * rope - horiz * horiz, 0.01))
	return trolley + swing - Vector3.new(0, drop, 0)
end

-- Hook point CFrame (yaw follows the jib).
function CraneMath.hookCf(cfg, st)
	return CFrame.new(CraneMath.hookPos(cfg, st)) * CFrame.Angles(0, st.slew, 0)
end

-- Hook block visual CFrame, tilted along the rope.
function CraneMath.blockCf(cfg, st)
	local hook = CraneMath.hookPos(cfg, st)
	local trolley = CraneMath.trolleyCf(cfg, st).Position
	local up = (trolley - hook)
	if up.Magnitude < 0.01 then
		up = Vector3.yAxis
	end
	up = up.Unit
	local fwd = CFrame.Angles(0, st.slew, 0).LookVector
	local right = fwd:Cross(up)
	if right.Magnitude < 0.01 then
		right = Vector3.xAxis
	end
	right = right.Unit
	fwd = up:Cross(right)
	return CFrame.fromMatrix(hook, right, up, -fwd)
end

function CraneMath.loadCf(cfg, st, rigOffset)
	return CraneMath.hookCf(cfg, st) * CFrame.Angles(0, st.loadYaw or 0, 0) * rigOffset
end

-- Average of an item's lift points (local studs).
function CraneMath.liftCentre(def)
	local sum = Vector3.zero
	for _, p in ipairs(def.liftPointsS) do
		sum += p
	end
	return sum / math.max(#def.liftPointsS, 1)
end

-- Load pose relative to the hook frame, chosen by the item's rigging mode.
function CraneMath.rigOffset(def, loadCf, hookCf)
	local rel
	if def.rigging == "Upright" then
		rel = CFrame.new()
	elseif def.rigging == "Pitch" then
		rel = CFrame.Angles(0, 0, def.pitch or 0)
	else
		rel = hookCf.Rotation:Inverse() * loadCf.Rotation
	end
	local lift = CraneMath.liftCentre(def)
	local t = Vector3.new(0, -Config.Crane.SlingDrop, 0) - rel:VectorToWorldSpace(lift)
	return CFrame.new(t) * rel
end

function CraneMath.capacityKg(cfg, radius)
	return Config.craneCapacityKg(cfg, radius)
end

-- Largest trolley radius that can carry `kg`.
function CraneMath.maxRadiusFor(cfg, kg)
	if kg <= 0 then
		return cfg.maxR
	end
	local full = cfg.maxKg
	local fr = cfg.fullRadiusM
	if kg > full then
		return 0
	end
	local rM = full * fr / kg
	return Util.clamp(rM * S, cfg.minR, cfg.maxR)
end

-- Encode/decode state into model attributes.
CraneMath.Keys = { "slew", "trolley", "hoist", "swingX", "swingZ", "loadYaw" }

function CraneMath.writeAttributes(model, st)
	for _, k in ipairs(CraneMath.Keys) do
		model:SetAttribute("S_" .. k, st[k])
	end
end

function CraneMath.readAttributes(model, fallback)
	local st = {}
	for _, k in ipairs(CraneMath.Keys) do
		st[k] = model:GetAttribute("S_" .. k) or (fallback and fallback[k]) or 0
	end
	return st
end

function CraneMath.sanitize(cfg, st)
	st.trolley = Util.clamp(st.trolley, cfg.minR, cfg.maxR)
	st.hoist = Util.clamp(st.hoist, cfg.minRope, cfg.maxRope)
	local maxSwing = st.hoist * 0.35
	st.swingX = Util.clamp(st.swingX or 0, -maxSwing, maxSwing)
	st.swingZ = Util.clamp(st.swingZ or 0, -maxSwing, maxSwing)
	st.slew = (st.slew + math.pi) % (2 * math.pi) - math.pi
	st.loadYaw = (st.loadYaw + math.pi) % (2 * math.pi) - math.pi
	return st
end

return CraneMath
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000007">
<Properties>
<string name="Name">ItemRegistry</string>
<ProtectedString name="Source"><![CDATA[-- The reusable item registry behind the catalog, deliveries, placement rules,
-- crane rigging and saves. Every entry here has a working model builder and a
-- defined behaviour; nothing is listed that cannot be delivered and used.
--
-- Units inside definitions are METRES; derived stud values are added by add().
--
-- Kinds:
--   Point   : one plug that seats on a compatible socket (column on footing)
--   Span    : two plugs that seat on two sockets a fixed distance apart (beam)
--   Surface : rests across supports with tagged parts below both ends (deck)
--   Rest    : stands on terrain or any upward surface (footing, props)
--   Tool    : hotbar equipment, never delivered

local Config = require(script.Parent.Config)
local Factory = require(script.Parent.ModelFactory)

local C = Config.Colors
local M = Enum.Material
local G = Config.Geo
local S = Config.S
local V = Vector3.new
local CF = CFrame.new

local Registry = {}
Registry.items = {}
Registry.list = {}

Registry.Categories = {
	"Structural Steel",
	"Concrete & Foundations",
	"Walls & Roofing",
	"Windows & Doors",
	"Scaffolding",
	"Connections & Rigging",
	"Tools",
	"Machinery",
	"Electrical, Plumbing & HVAC",
	"Site Safety",
	"Site Furnishings",
}

Registry.Classes = {
	Installable = "Installable component",
	Equipment = "Functional equipment",
	Decorative = "Decorative prop",
	Tool = "Hand tool",
}

local DIRS = {
	{ name = "+X", v = V(1, 0, 0) },
	{ name = "-X", v = V(-1, 0, 0) },
	{ name = "+Z", v = V(0, 0, 1) },
	{ name = "-Z", v = V(0, 0, -1) },
}

local function look(pos, dir)
	return Factory.lookAlong(pos, dir)
end

local function mToStudsCf(cf)
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = cf:GetComponents()
	return CFrame.new(x * S, y * S, z * S, r00, r01, r02, r10, r11, r12, r20, r21, r22)
end

local function set(list)
	local t = {}
	for _, v in ipairs(list or {}) do
		t[v] = true
	end
	return t
end

local function add(def)
	assert(def.id and not Registry.items[def.id], "duplicate or missing id " .. tostring(def.id))
	def.class = def.class or "Installable"
	def.tags = set(def.tags)
	def.overlapIgnore = set(def.overlapIgnore)
	def.boundsOffsetM = def.boundsOffsetM or V(0, def.originBottom and def.sizeM.Y / 2 or 0, 0)
	def.size = def.sizeM * S
	def.boundsOffset = def.boundsOffsetM * S
	def.weightClass = def.weightClass or Config.weightClassFor(def.weightKg or 0)
	def.handling = Config.WeightClasses[def.weightClass].label
	def.deliverable = def.class ~= "Tool" and def.deliverable ~= false
	def.fasteners = def.fasteners or {}
	def.minFastenRelease = def.minFastenRelease or math.min(2, #def.fasteners)
	def.rigging = def.rigging or "Bridle"
	def.transport = def.transport or CFrame.new()
	def.rotStep = def.rotStep or 90
	for _, list in ipairs({ def.plugs or {}, def.sockets or {}, def.requireSockets or {} }) do
		for _, s in ipairs(list) do
			s.cfS = mToStudsCf(s.cf)
			if s.accepts then
				s.acceptSet = set(s.accepts)
			end
		end
	end
	def.plugs = def.plugs or {}
	def.sockets = def.sockets or {}
	def.liftPoints = def.liftPoints or { V(0, def.sizeM.Y / 2 + (def.originBottom and def.sizeM.Y / 2 or 0), 0) }
	def.liftPointsS = {}
	for i, p in ipairs(def.liftPoints) do
		def.liftPointsS[i] = p * S
	end
	if def.kind == "Span" and #def.plugs == 2 then
		local a, b = def.plugs[1].cfS.Position, def.plugs[2].cfS.Position
		def.spanVector = b - a
		def.spanLength = (b - a).Magnitude
	end
	Registry.items[def.id] = def
	table.insert(Registry.list, def)
	return def
end

---------------------------------------------------------------------------
-- Steel profiles (metres, kg/m) — AISC W-shapes and HSS
---------------------------------------------------------------------------

local BEAMS = {
	{ name = "W10×26", d = 0.262, bf = 0.147, tf = 0.0112, tw = 0.0066, kgm = 38.7 },
	{ name = "W12×26", d = 0.310, bf = 0.165, tf = 0.0097, tw = 0.0058, kgm = 38.7 },
	{ name = "W16×31", d = 0.403, bf = 0.140, tf = 0.0112, tw = 0.0070, kgm = 46.1 },
	{ name = "W18×35", d = 0.450, bf = 0.152, tf = 0.0108, tw = 0.0076, kgm = 52.1 },
	{ name = "W21×44", d = 0.526, bf = 0.165, tf = 0.0114, tw = 0.0089, kgm = 65.5 },
	{ name = "W24×55", d = 0.599, bf = 0.178, tf = 0.0128, tw = 0.0100, kgm = 81.8 },
}

local COLUMNS = {
	{ name = "W10×49", d = 0.253, bf = 0.254, tf = 0.0142, tw = 0.0086, kgm = 72.9 },
	{ name = "W12×65", d = 0.308, bf = 0.305, tf = 0.0154, tw = 0.0099, kgm = 96.7 },
	{ name = "W14×90", d = 0.356, bf = 0.369, tf = 0.0180, tw = 0.0112, kgm = 134.0 },
}

Registry.BeamProfiles = BEAMS
Registry.ColumnProfiles = COLUMNS

local function fmtLen(m)
	return string.format("%.1f m", m)
end

local function idLen(m)
	return tostring(math.floor(m * 1000 + 0.5))
end

---------------------------------------------------------------------------
-- Columns
---------------------------------------------------------------------------

local function buildColumn(b, def, opts)
	local p, L = def.profile, def.lengthM
	local col = C.PrimerGray
	local bp = def.basePlateM
	local shaftLen = L - 0.025 - 0.012
	b:wShape("Shaft", shaftLen, { d = p.d, bf = p.bf, tf = p.tf, tw = p.tw, axis = "Y" }, CF(0, -L / 2 + 0.025 + shaftLen / 2, 0), col)
	b:box("BasePlate", V(bp, 0.025, bp), CF(0, -L / 2 + 0.0125, 0), C.MillSteel)
	b:box("CapPlate", V(p.d + 0.02, 0.012, p.bf + 0.02), CF(0, L / 2 - 0.006, 0), col)
	local r = G.SeatOffset
	local tabH = 0.24
	local tabY = L / 2 - 0.08 - tabH / 2
	for _, sx in ipairs({ 1, -1 }) do
		local x0, x1 = p.d / 2, r + 0.07
		b:box("ShearTab", V(x1 - x0, tabH, 0.01), CF(sx * (x0 + x1) / 2, tabY, 0.009), col, nil, { nc = true })
	end
	for _, sz in ipairs({ 1, -1 }) do
		local z0, z1 = p.tw / 2, r + 0.07
		b:box("ShearTab", V(0.01, tabH, z1 - z0), CF(0.009, tabY, sz * (z0 + z1) / 2), col, nil, { nc = true })
	end
	if not opts.installed then
		b:box("LiftLug", V(0.02, 0.12, 0.14), CF(0, L / 2 + 0.06, 0), C.MillSteel, nil, { nc = true })
	end
	b:stencil(CF(p.d / 2 + 0.001, -L / 2 + 0.9, 0) * CFrame.Angles(0, math.pi / 2, 0), 0.16, 0.05)
end

local function columnSockets(L)
	local sockets = {
		{ type = "ColumnTop", cf = CF(0, L / 2, 0) },
	}
	for _, d in ipairs(DIRS) do
		table.insert(sockets, { type = "BeamSeat", cf = look(V(0, L / 2, 0) + d.v * G.SeatOffset, d.v) })
		table.insert(sockets, { type = "GussetMount", cf = look(V(0, -L / 2 + G.GussetLow, 0) + d.v * G.SeatOffset, d.v) })
		table.insert(sockets, { type = "GussetMount", cf = look(V(0, L / 2 - G.GussetHighFromTop, 0) + d.v * G.SeatOffset, d.v) })
		table.insert(sockets, { type = "CladSeat", multi = true, cf = look(V(0, -L / 2, 0) + d.v * G.CladOffset, d.v) })
	end
	return sockets
end

for _, prof in ipairs(COLUMNS) do
	for _, L in ipairs(Config.FloorHeights) do
		local bp = math.max(prof.d, prof.bf) + 0.15
		local a = bp / 2 - 0.06
		add({
			id = "COL-" .. prof.name:gsub("×", "x") .. "-" .. idLen(L),
			name = "Steel Column " .. prof.name .. " — " .. fmtLen(L),
			category = "Structural Steel",
			kind = "Point",
			tags = { "Column", "Steel", "Structural" },
			profile = prof,
			lengthM = L,
			basePlateM = bp,
			weightKg = prof.kgm * L + 25,
			sizeM = V(bp, L, bp),
			description = string.format(
				"Wide-flange column for a %.1f m storey. Seats on a footing or splices onto the column below; shop-welded shear tabs take beams on all four faces. Lifted by its top lug so it hangs plumb.",
				L
			),
			build = buildColumn,
			plugs = { { type = "ColumnBottom", accepts = { "FootingTop", "ColumnTop" }, cf = CF(0, -L / 2, 0) } },
			sockets = columnSockets(L),
			fasteners = {
				{ type = "Bolt", pos = V(a, -L / 2 + 0.04, a), normal = V(0, 1, 0) },
				{ type = "Bolt", pos = V(-a, -L / 2 + 0.04, a), normal = V(0, 1, 0) },
				{ type = "Bolt", pos = V(a, -L / 2 + 0.04, -a), normal = V(0, 1, 0) },
				{ type = "Bolt", pos = V(-a, -L / 2 + 0.04, -a), normal = V(0, 1, 0) },
			},
			minFastenRelease = 4,
			liftPoints = { V(0, L / 2 + 0.1, 0) },
			rigging = "Upright",
			transport = CFrame.Angles(0, 0, math.pi / 2),
			proxyColor = C.PrimerGray,
		})
	end
end

---------------------------------------------------------------------------
-- Beams
---------------------------------------------------------------------------

local function buildBeam(b, def)
	local p, len = def.profile, def.lengthM
	b:wShape("Beam", len, { d = p.d, bf = p.bf, tf = p.tf, tw = p.tw }, CF(), C.PrimerGray)
	b:stencil(CF(len / 2 - 0.6, 0, -p.tw / 2 - 0.001), 0.18, 0.05)
end

for _, prof in ipairs(BEAMS) do
	for _, bay in ipairs(Config.Bays) do
		local len = bay - 2 * G.SeatOffset
		local n = prof.d > 0.45 and 4 or 3
		local fasteners = {}
		for _, sx in ipairs({ -1, 1 }) do
			for k = 0, n - 1 do
				table.insert(fasteners, {
					type = "Bolt",
					pos = V(sx * (len / 2 - 0.045), (k - (n - 1) / 2) * 0.075, -(prof.tw / 2 + 0.012)),
					normal = V(0, 0, -1),
				})
			end
		end
		add({
			id = "BM-" .. prof.name:gsub("×", "x") .. "-" .. idLen(bay),
			name = "Steel Beam " .. prof.name .. " — " .. fmtLen(bay) .. " bay",
			category = "Structural Steel",
			kind = "Span",
			tags = { "Beam", "Steel", "Structural" },
			profile = prof,
			lengthM = len,
			bayM = bay,
			weightKg = prof.kgm * len,
			sizeM = V(len, prof.d, prof.bf),
			description = string.format(
				"%s floor beam for a %.1f m column-to-column bay (%.2f m cut length). Bolts to the column shear tabs at both ends; deck spans between parallel beams.",
				prof.name,
				bay,
				len
			),
			build = buildBeam,
			plugs = {
				{ type = "BeamEnd", accepts = { "BeamSeat" }, cf = CF(-len / 2, prof.d / 2, 0) },
				{ type = "BeamEnd", accepts = { "BeamSeat" }, cf = CF(len / 2, prof.d / 2, 0) },
			},
			fasteners = fasteners,
			minFastenRelease = 2,
			liftPoints = { V(-len / 4, prof.d / 2, 0), V(len / 4, prof.d / 2, 0) },
			rigging = "Bridle",
			symmetric180 = true,
			proxyColor = C.PrimerGray,
		})
	end
end

