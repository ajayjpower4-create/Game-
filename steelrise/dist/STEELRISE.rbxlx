<Item class="StarterPlayer" referent="RBX0000002C">
<Properties>
<string name="Name">StarterPlayer</string>
</Properties>
<Item class="StarterPlayerScripts" referent="RBX0000002B">
<Properties>
<string name="Name">StarterPlayerScripts</string>
</Properties>
<Item class="Folder" referent="RBX0000002A">
<Properties>
<string name="Name">Steelrise</string>
</Properties>
<Item class="ModuleScript" referent="RBX00000018">
<Properties>
<string name="Name">Audio</string>
<ProtectedString name="Source"><![CDATA[-- Client audio: mix groups with separate volumes, varied one-shots and
-- smooth machinery loops whose pitch/volume follow what the machine is doing.
-- Entries without supplied ids are silent (see AudioRegistry).

local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local AudioRegistry = require(Shared.AudioRegistry)

local Audio = {}
local groups = {}
local rng = Random.new()

function Audio.init(volumes)
	local master = SoundService:FindFirstChild("SR_Master") or Instance.new("SoundGroup")
	master.Name = "SR_Master"
	master.Parent = SoundService
	groups.Master = master
	for _, name in ipairs(Config.AudioGroups) do
		if name ~= "Master" then
			local g = master:FindFirstChild("SR_" .. name) or Instance.new("SoundGroup")
			g.Name = "SR_" .. name
			g.Parent = master
			groups[name] = g
		end
	end
	Audio.setVolumes(volumes or Config.DefaultSettings.volumes)
end

function Audio.setVolumes(volumes)
	for name, g in pairs(groups) do
		local v = volumes[name]
		if v then
			g.Volume = v
		end
	end
end

function Audio.has(key)
	local e = AudioRegistry[key]
	return e ~= nil and #e.ids > 0
end

local function makeSound(key, parent)
	local e = AudioRegistry[key]
	if not e or #e.ids == 0 then
		return nil
	end
	local s = Instance.new("Sound")
	s.Name = "SR_" .. key
	s.SoundId = e.ids[rng:NextInteger(1, #e.ids)]
	s.Volume = e.volume or 0.5
	s.Looped = e.loop == true
	s.SoundGroup = groups[e.group] or groups.Master
	if not e.twoD then
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = e.min or 8
		s.RollOffMaxDistance = e.max or 150
	end
	if e.pitchVar then
		s.PlaybackSpeed = 1 + rng:NextNumber(-e.pitchVar, e.pitchVar)
	end
	s.Parent = parent
	return s
end

-- One-shot. `where` = BasePart/Attachment (positional), Vector3, or nil (2D).
function Audio.play(key, where, volumeScale)
	local e = AudioRegistry[key]
	if not e or #e.ids == 0 then
		return nil
	end
	local parent = SoundService
	local temp = nil
	if typeof(where) == "Vector3" then
		temp = Instance.new("Attachment")
		temp.WorldPosition = where
		temp.Parent = workspace.Terrain
		parent = temp
	elseif typeof(where) == "Instance" then
		parent = where
	end
	local s = makeSound(key, parent)
	if not s then
		if temp then
			temp:Destroy()
		end
		return nil
	end
	s.Volume = s.Volume * (volumeScale or 1)
	s.Ended:Connect(function()
		s:Destroy()
		if temp then
			temp:Destroy()
		end
	end)
	s:Play()
	task.delay(12, function()
		if s.Parent then
			s:Destroy()
		end
		if temp and temp.Parent then
			temp:Destroy()
		end
	end)
	return s
end

-- Machinery loop handle with smoothed level control.
function Audio.loop(key, parent)
	local s = makeSound(key, parent or SoundService)
	local e = AudioRegistry[key]
	local handle = { level = 0, target = 0 }
	if not s then
		function handle:set() end
		function handle:step() end
		function handle:destroy() end
		return handle
	end
	local baseVol = e.volume or 0.5
	s.Volume = 0
	s:Play()
	function handle:set(level, pitch)
		self.target = math.clamp(level, 0, 1.2)
		self.pitch = pitch
	end
	function handle:step(dt)
		self.level += (self.target - self.level) * math.min(dt * 6, 1)
		s.Volume = baseVol * self.level
		if self.pitch then
			s.PlaybackSpeed = s.PlaybackSpeed + (self.pitch - s.PlaybackSpeed) * math.min(dt * 4, 1)
		end
	end
	function handle:destroy()
		s:Destroy()
	end
	return handle
end

-- All sound ids that should be preloaded by the loading screen.
function Audio.preloadList()
	local list = {}
	for key, e in pairs(AudioRegistry) do
		for _, id in ipairs(e.ids) do
			local s = Instance.new("Sound")
			s.Name = key
			s.SoundId = id
			table.insert(list, s)
		end
	end
	return list
end

return Audio
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000019">
<Properties>
<string name="Name">Blueprint</string>
<ProtectedString name="Source"><![CDATA[-- Blueprint ghosts: translucent outlines of what still has to be built on
-- the current working level, with the next member highlighted. Installed
-- members disappear from the ghost set, so the building itself shows
-- progress. Purely local (never replicated).

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local Sites = require(Shared.Sites)
local Factory = require(Shared.ModelFactory)

local State = require(script.Parent.State)
local View = require(script.Parent.View)

local Blueprint = {}
local folder
local entries = nil
local entriesFor = nil
local dirty = true
local visible = true
local MAX_GHOSTS = 450

local function posKey(itemId, p)
	return itemId .. "@" .. math.floor(p.X * 2 + 0.5) .. "," .. math.floor(p.Y * 2 + 0.5) .. "," .. math.floor(p.Z * 2 + 0.5)
end

function Blueprint.markDirty()
	dirty = true
end

function Blueprint.toggle()
	visible = not visible
	dirty = true
	State.notify(visible and "Blueprint ghosts on" or "Blueprint ghosts off", "info")
end

local function rebuild()
	dirty = false
	folder:ClearAllChildren()
	local site = State.site
	if not visible or not site or not State.siteDef or State.mode ~= "Play" then
		return
	end
	local bp = site:GetAttribute("Blueprint") or ""
	if bp == "" then
		entries = nil
		return
	end
	if entriesFor ~= State.siteDef.id .. ":" .. bp then
		local grid = Sites.blueprintGrid(State.siteDef, bp)
		entries = grid and Sites.sortEntries(Sites.layout(grid)) or nil
		entriesFor = State.siteDef.id .. ":" .. bp
	end
	if not entries then
		return
	end
	local built = {}
	local comps = site:FindFirstChild("Components")
	for _, m in ipairs(comps and comps:GetChildren() or {}) do
		local st = m:GetAttribute("State")
		if st == "Installed" or st == "Placed" then
			built[posKey(m:GetAttribute("ItemId"), m:GetPivot().Position)] = st
		end
	end
	-- working level = level of the first unbuilt entry
	local first = nil
	for _, e in ipairs(entries) do
		if built[posKey(e.item, e.cf.Position)] ~= "Installed" then
			first = e
			break
		end
	end
	if not first then
		return
	end
	local lvl = first.level
	local root = View.rootPosition()
	local range = State.detailDistance or 450
	local count = 0
	for _, e in ipairs(entries) do
		local show = (e.level == lvl) or (lvl == 0 and e.level == 1 and e.phase == "column") or (e.level == lvl + 1 and e.phase == "column")
		if show and not built[posKey(e.item, e.cf.Position)] then
			if not root or (e.cf.Position - root).Magnitude < range then
				local def = Registry.get(e.item)
				if def then
					local isNext = e == first
					local p = Factory.proxy(def, e.cf, isNext and Config.Colors.Safety or Config.Colors.Info, isNext and 0.45 or 0.78)
					p.Parent = folder
					count += 1
					if count >= MAX_GHOSTS then
						break
					end
				end
			end
		end
	end
end

function Blueprint.init()
	folder = Instance.new("Folder")
	folder.Name = "SR_Blueprint"
	folder.Parent = workspace.CurrentCamera
	State.on("Progress", function()
		dirty = true
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc > 1.0 and dirty then
			acc = 0
			rebuild()
		elseif acc > 6 then
			acc = 0
			rebuild()
		end
	end)
end

return Blueprint
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001A">
<Properties>
<string name="Name">Catalog</string>
<ProtectedString name="Source"><![CDATA[-- Searchable catalog over the item registry: categories, favourites, lazy
-- 3D thumbnails (only cards scrolled into view get a model, and the oldest
-- are released once the cache is full) and physical delivery requests.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local Factory = require(Shared.ModelFactory)
local Util = require(Shared.Util)

local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Net = require(script.Parent.Net)

local C = Config.Colors
local F = UIKit.Font

local Catalog = {}
local gui, root, grid, search, detail, countLabel
local category = "All"
local favoritesOnly = false
local selected = nil
local qty = 1
local cards = {} -- id -> { frame, vp, model, lastSeen }
local built = 0
local MAX_THUMBS = 48

local CLASS_COLOR = {
	Installable = C.Safety,
	Equipment = C.Info,
	Decorative = C.Steel,
	Tool = C.Valid,
}

local function thumbModel(def)
	local ok, model = pcall(Factory.build, def, CFrame.new(), { preview = true })
	if ok then
		return model
	end
	return nil
end

local function releaseThumb(c)
	if c.model then
		c.model:Destroy()
		c.model = nil
		built -= 1
	end
end

local function updateThumbs()
	if not root.Visible then
		return
	end
	local winPos, winSize = grid.AbsolutePosition, grid.AbsoluteSize
	local now = os.clock()
	for _, c in pairs(cards) do
		local p, s = c.frame.AbsolutePosition, c.frame.AbsoluteSize
		local visible = c.frame.Visible and p.Y + s.Y > winPos.Y - 100 and p.Y < winPos.Y + winSize.Y + 100
		if visible then
			c.lastSeen = now
			if not c.model and built < MAX_THUMBS + 12 then
				c.model = thumbModel(c.def)
				if c.model then
					built += 1
					c.model.Parent = c.vp
					UIKit.frameModel(c.vp, c.model, 35, 24, 0.95)
				end
			end
		end
	end
	if built > MAX_THUMBS then
		local list = {}
		for _, c in pairs(cards) do
			if c.model then
				table.insert(list, c)
			end
		end
		table.sort(list, function(a, b)
			return (a.lastSeen or 0) < (b.lastSeen or 0)
		end)
		for i = 1, built - MAX_THUMBS do
			if list[i] and now - (list[i].lastSeen or 0) > 0.5 then
				releaseThumb(list[i])
			end
		end
	end
end

local function setDetail(def)
	selected = def
	qty = 1
	for _, c in ipairs(detail.vp:GetChildren()) do
		if c:IsA("Model") then
			c:Destroy()
		end
	end
	if not def then
		detail.body.Visible = false
		return
	end
	detail.body.Visible = true
	local m = thumbModel(def)
	if m then
		m.Parent = detail.vp
		detail.model = m
		UIKit.frameModel(detail.vp, m, 35, 24, 0.9)
	end
	detail.name.Text = def.name
	detail.cat.Text = string.upper(def.category)
	detail.class.Text = string.upper(Registry.Classes[def.class] or def.class)
	detail.class.BackgroundColor3 = CLASS_COLOR[def.class] or C.Steel
	detail.class.TextColor3 = def.class == "Installable" and C.Charcoal or C.OffWhite
	detail.dims.Text = Registry.dimensionsText(def)
	detail.weight.Text = def.weightKg > 0 and (Util.fmtKg(def.weightKg) .. "  ·  " .. def.handling) or def.handling
	local behaviour = ({
		Point = "Seats on one connection point.",
		Span = "Spans between two connection points.",
		Surface = "Bears on two parallel beams.",
		Rest = "Stands on the ground or an installed deck.",
		Tool = "Equip from the hotbar.",
	})[def.kind] or ""
	if #def.fasteners > 0 then
		local kinds = {}
		for _, f in ipairs(def.fasteners) do
			kinds[f.type] = (kinds[f.type] or 0) + 1
		end
		local parts = {}
		for k, n in pairs(kinds) do
			table.insert(parts, n .. " " .. string.lower(k) .. (n > 1 and "s" or ""))
		end
		behaviour ..= "  Fastening: " .. table.concat(parts, ", ") .. "."
	end
	if def.allowFree then
		behaviour ..= "  Free placement available (T)."
	end
	detail.behaviour.Text = behaviour
	detail.desc.Text = def.description or ""
	detail.fav.Text = State.favorites[def.id] and "★ FAVOURITE" or "☆ ADD TO FAVOURITES"
	detail.qtyRow.Visible = def.deliverable
	detail.order.Visible = def.deliverable
	detail.equip.Visible = def.kind == "Tool"
	detail.qty.Text = tostring(qty)
end

local function rebuild()
	local favs = State.favorites
	local list = Registry.search(search.Text, category ~= "Favourites" and category or nil, favs, category == "Favourites")
	local keep = {}
	for i, def in ipairs(list) do
		keep[def.id] = i
	end
	for id, c in pairs(cards) do
		c.frame.Visible = keep[id] ~= nil
		c.frame.LayoutOrder = keep[id] or 0
	end
	countLabel.Text = string.format("%d shown  ·  %d items implemented  ·  target %d", #list, Registry.count().total, Registry.TargetCount)
	task.defer(updateThumbs)
end

local function makeCard(def, order)
	local frame = UIKit.new("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.CharcoalLight, BorderSizePixel = 0, LayoutOrder = order, Parent = grid })
	UIKit.corner(frame, 5)
	local stroke = UIKit.stroke(frame, C.SteelDark, 1, 0)
	local vp = UIKit.new("ViewportFrame", {
		BackgroundColor3 = Color3.fromRGB(44, 48, 54),
		BorderSizePixel = 0,
		Size = UDim2.new(1, -8, 0, 86),
		Position = UDim2.new(0, 4, 0, 4),
		Ambient = Color3.fromRGB(130, 132, 138),
		LightColor = Color3.fromRGB(255, 246, 232),
		LightDirection = Vector3.new(-0.5, -1, -0.6),
		Parent = frame,
	})
	UIKit.corner(vp, 4)
	local bar = UIKit.new("Frame", { BackgroundColor3 = CLASS_COLOR[def.class] or C.Steel, BorderSizePixel = 0, Size = UDim2.new(0, 3, 0, 86), Position = UDim2.new(0, 4, 0, 4), Parent = frame })
	bar.ZIndex = 2
	UIKit.label(frame, def.name, 12, F.Medium, C.OffWhite, { Position = UDim2.new(0, 6, 0, 92), Size = UDim2.new(1, -12, 0, 30), TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top })
	local fav = UIKit.label(frame, "★", 14, F.Bold, C.Safety, { Position = UDim2.new(1, -20, 0, 6), Size = UDim2.new(0, 16, 0, 16), Visible = State.favorites[def.id] == true })
	fav.ZIndex = 3
	frame.MouseButton1Click:Connect(function()
		setDetail(def)
	end)
	frame.MouseEnter:Connect(function()
		stroke.Color = C.Safety
	end)
	frame.MouseLeave:Connect(function()
		stroke.Color = C.SteelDark
	end)
	cards[def.id] = { frame = frame, vp = vp, def = def, fav = fav }
end

function Catalog.build()
	gui = UIKit.screen("SR_Catalog", 8)
	root = UIKit.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, Parent = gui })
	root.Active = true
	UIKit.new("TextButton", { Modal = true, BackgroundTransparency = 1, Text = "", Size = UDim2.new(0, 1, 0, 1), Parent = root })
	local panel = UIKit.panel(root, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.86, 0, 0.84, 0) })
	UIKit.padding(panel, 18)
	UIKit.label(panel, "CATALOG & DELIVERIES", 22, F.Display, C.OffWhite, { Size = UDim2.new(0.5, 0, 0, 28) })
	countLabel = UIKit.label(panel, "", 12, F.Mono, C.Muted, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -44, 0, 6), Size = UDim2.new(0.5, 0, 0, 16), TextXAlignment = Enum.TextXAlignment.Right })
	local close = UIKit.button(panel, "✕", { style = "ghost", size = UDim2.new(0, 34, 0, 34), textSize = 18 })
	close.AnchorPoint = Vector2.new(1, 0)
	close.Position = UDim2.new(1, 0, 0, -4)
	close.MouseButton1Click:Connect(function()
		Catalog.toggle(false)
	end)

	-- categories
	local cats = UIKit.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 44), Size = UDim2.new(0, 220, 1, -44), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, Parent = panel })
	UIKit.list(cats, nil, 3)
	local catButtons = {}
	local function selectCat(name)
		category = name
		for n, b in pairs(catButtons) do
			b.TextColor3 = n == name and C.Safety or C.OffWhite
		end
		rebuild()
	end
	local allCats = { "All", "Favourites" }
	for _, c in ipairs(Registry.Categories) do
		table.insert(allCats, c)
	end
	for i, name in ipairs(allCats) do
		local n = 0
		for _, def in ipairs(Registry.list) do
			if name == "All" or def.category == name then
				n += 1
			end
		end
		local label = name == "Favourites" and "★ Favourites" or (name .. "  (" .. n .. ")")
		local b = UIKit.button(cats, label, { style = "ghost", align = Enum.TextXAlignment.Left, size = UDim2.new(1, -6, 0, 32), textSize = 14, font = F.Medium })
		b.LayoutOrder = i
		b.MouseButton1Click:Connect(function()
			selectCat(name)
		end)
		catButtons[name] = b
	end

	-- search + grid
	local mid = UIKit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 232, 0, 44), Size = UDim2.new(1, -232 - 360, 1, -44), Parent = panel })
	search = UIKit.new("TextBox", {
		PlaceholderText = "Search components, sizes, categories…",
		Text = "",
		ClearTextOnFocus = false,
		Font = F.Medium,
		TextSize = 15,
		TextColor3 = C.OffWhite,
		PlaceholderColor3 = C.Muted,
		BackgroundColor3 = C.Charcoal,
		BorderSizePixel = 0,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 0, 36),
		Parent = mid,
	})
	UIKit.corner(search, 5)
	UIKit.padding(search, 12, 0, 12, 0)
	UIKit.stroke(search, C.SteelDark, 1, 0)
	search:GetPropertyChangedSignal("Text"):Connect(rebuild)
	grid = UIKit.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 46), Size = UDim2.new(1, 0, 1, -46), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 4, ScrollBarImageColor3 = C.Steel, Parent = mid })
	UIKit.new("UIGridLayout", { CellSize = UDim2.new(0, 150, 0, 126), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	grid:GetPropertyChangedSignal("CanvasPosition"):Connect(updateThumbs)
	for i, def in ipairs(Registry.list) do
		makeCard(def, i)
	end

	-- detail
	local dp = UIKit.panel(panel, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 44), Size = UDim2.new(0, 348, 1, -44) })
	UIKit.padding(dp, 12)
	detail = {}
	detail.vp = UIKit.new("ViewportFrame", { BackgroundColor3 = Color3.fromRGB(44, 48, 54), BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 170), Ambient = Color3.fromRGB(130, 132, 138), LightColor = Color3.fromRGB(255, 246, 232), LightDirection = Vector3.new(-0.5, -1, -0.6), Parent = dp })
	UIKit.corner(detail.vp, 4)
	detail.body = UIKit.new("ScrollingFrame", { BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.new(0, 0, 0, 178), Size = UDim2.new(1, 0, 1, -178), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 3, Visible = false, Parent = dp })
	UIKit.list(detail.body, nil, 6)
	detail.name = UIKit.label(detail.body, "", 17, F.Bold, C.OffWhite, { LayoutOrder = 1, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	local chips = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 22), LayoutOrder = 2, Parent = detail.body })
	UIKit.list(chips, Enum.FillDirection.Horizontal, 6)
	detail.class = UIKit.chip(chips, "")
	detail.cat = UIKit.label(detail.body, "", 11, F.Bold, C.Muted, { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 14) })
	detail.dims = UIKit.label(detail.body, "", 13, F.Mono, C.OffWhite, { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 16) })
	detail.weight = UIKit.label(detail.body, "", 13, F.Medium, C.Safety, { LayoutOrder = 5, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	detail.desc = UIKit.label(detail.body, "", 13, F.Body, C.OffWhite, { LayoutOrder = 6, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	detail.behaviour = UIKit.label(detail.body, "", 12, F.Body, C.Muted, { LayoutOrder = 7, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	detail.fav = UIKit.button(detail.body, "", { style = "ghost", size = UDim2.new(1, -6, 0, 30), textSize = 13 })
	detail.fav.LayoutOrder = 8
	detail.fav.MouseButton1Click:Connect(function()
		if not selected then
			return
		end
		local on = not State.favorites[selected.id]
		State.favorites[selected.id] = on or nil
		cards[selected.id].fav.Visible = on
		detail.fav.Text = on and "★ FAVOURITE" or "☆ ADD TO FAVOURITES"
		Net.call("Save", true, "Favorite", selected.id, on)
		if category == "Favourites" then
			rebuild()
		end
	end)
	detail.qtyRow = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -6, 0, 34), LayoutOrder = 9, Parent = detail.body })
	UIKit.label(detail.qtyRow, "QUANTITY", 12, F.Bold, C.Muted, { Size = UDim2.new(0, 100, 1, 0) })
	local minus = UIKit.button(detail.qtyRow, "−", { size = UDim2.new(0, 34, 1, 0), textSize = 18 })
	minus.Position = UDim2.new(0, 110, 0, 0)
	detail.qty = UIKit.label(detail.qtyRow, "1", 16, F.Mono, C.OffWhite, { Position = UDim2.new(0, 148, 0, 0), Size = UDim2.new(0, 50, 1, 0), TextXAlignment = Enum.TextXAlignment.Center })
	local plus = UIKit.button(detail.qtyRow, "+", { size = UDim2.new(0, 34, 1, 0), textSize = 18 })
	plus.Position = UDim2.new(0, 202, 0, 0)
	minus.MouseButton1Click:Connect(function()
		qty = math.max(1, qty - 1)
		detail.qty.Text = tostring(qty)
	end)
	plus.MouseButton1Click:Connect(function()
		qty = math.min(40, qty + 1)
		detail.qty.Text = tostring(qty)
	end)
	detail.order = UIKit.button(detail.body, "REQUEST DELIVERY", { style = "primary", size = UDim2.new(1, -6, 0, 42) })
	detail.order.LayoutOrder = 10
	detail.order.MouseButton1Click:Connect(function()
		if not selected then
			return
		end
		local ok = Net.call("Delivery", false, "Request", selected.id, qty)
		if ok then
			State.fire("DeliveryRequested", selected.id, qty)
			Catalog.toggle(false)
		end
	end)
	detail.equip = UIKit.button(detail.body, "EQUIP", { size = UDim2.new(1, -6, 0, 38) })
	detail.equip.LayoutOrder = 11
	detail.equip.MouseButton1Click:Connect(function()
		if selected then
			State.fire("SelectTool", selected.id)
			Catalog.toggle(false)
		end
	end)
	UIKit.label(detail.body, "Deliveries are free in this build: no money grind. Trucks park in the unloading bays with every piece strapped on the deck.", 11, F.Body, C.SteelDark, { LayoutOrder = 12, Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })

	selectCat("All")
	RunService.Heartbeat:Connect(function(dt)
		if root.Visible and detail.model and detail.vp.CurrentCamera then
			detail.spin = (detail.spin or 0) + dt * 20
			UIKit.frameModel(detail.vp, detail.model, 35 + detail.spin, 24, 0.9)
		end
	end)
	return gui
end

function Catalog.toggle(open)
	if open == nil then
		open = not root.Visible
	end
	root.Visible = open
	State.catalogOpen = open
	State.uiBlocking = open
	State.fire("UIBlocking", open)
	if open then
		rebuild()
		task.delay(0.05, updateThumbs)
	else
		search:ReleaseFocus()
	end
end

function Catalog.isOpen()
	return root and root.Visible
end

return Catalog
]]></ProtectedString>
</Properties>
</Item>
<Item class="LocalScript" referent="RBX0000001B">
<Properties>
<string name="Name">ClientMain</string>
<ProtectedString name="Source"><![CDATA[-- STEELRISE client bootstrap: builds the interface, binds the current site,
-- switches between menu and play, routes global keys and tool selection.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Sites = require(Shared.Sites)
local BuildRules = require(Shared.BuildRules)
local Registry = require(Shared.ItemRegistry)
local Remotes = require(Shared.Remotes)
local Util = require(Shared.Util)

local here = script.Parent
local State = require(here.State)
local UIKit = require(here.UIKit)
local Audio = require(here.Audio)
local Net = require(here.Net)
local Settings = require(here.Settings)
local HUD = require(here.HUD)
local MainMenu = require(here.MainMenu)
local Catalog = require(here.Catalog)
local View = require(here.View)
local Interaction = require(here.Interaction)
local Placement = require(here.Placement)
local CraneClient = require(here.CraneClient)
local TrailerAnim = require(here.TrailerAnim)
local Blueprint = require(here.Blueprint)
local FX = require(here.FX)
local Footsteps = require(here.Footsteps)
local Tutorial = require(here.Tutorial)

local player = Players.LocalPlayer

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false)
end)

-- Settings and favourites first, so every panel is built with the player's values.
do
	local ok, _, info = Net.call("Menu", true, "Info")
	if ok and info then
		local merged = Util.withDefaults(info.settings, Config.DefaultSettings)
		for k, v in pairs(merged) do
			State.settings[k] = v
		end
		State.favorites = info.favorites or {}
		State.crane.assist = State.settings.assist
		State.menuInfo = info
	end
end

Audio.init(State.settings.volumes)
UIKit.setClickSound(function()
	Audio.play("UIClick")
end)

HUD.build()
MainMenu.build()
Catalog.build()
Interaction.init()
Placement.init()
CraneClient.init()
TrailerAnim.init()
Blueprint.init()
FX.init()
Footsteps.init()
Tutorial.init()

Remotes.get("Notify").OnClientEvent:Connect(function(text, kind)
	HUD.notify(text, kind)
end)
Remotes.get("Progress").OnClientEvent:Connect(function(kind, data)
	State.fire("Progress", kind, data)
end)

---------------------------------------------------------------------------
-- Site binding
---------------------------------------------------------------------------

local siteConns = {}

local function bindSite(folder)
	for _, c in ipairs(siteConns) do
		c:Disconnect()
	end
	siteConns = {}
	State.site = folder
	State.siteDef = Sites.get(folder:GetAttribute("SiteId"))
	State.world = BuildRules.newWorld(folder)
	CraneClient.reset()
	TrailerAnim.reset()
	local comps = folder:WaitForChild("Components", 10)
	local function watch(m)
		table.insert(siteConns, m:GetAttributeChangedSignal("State"):Connect(function()
			State.world:markDirty()
			Blueprint.markDirty()
		end))
	end
	if comps then
		for _, m in ipairs(comps:GetChildren()) do
			watch(m)
		end
		table.insert(siteConns, comps.ChildAdded:Connect(function(m)
			watch(m)
			State.world:markDirty()
			Blueprint.markDirty()
		end))
		table.insert(siteConns, comps.ChildRemoved:Connect(function()
			State.world:markDirty()
			Blueprint.markDirty()
		end))
	end
	table.insert(siteConns, folder:GetAttributeChangedSignal("Blueprint"):Connect(function()
		Blueprint.markDirty()
		HUD.refreshBlueprintButtons()
	end))
	Settings.apply()
	Blueprint.markDirty()
	HUD.refreshBlueprintButtons()
	State.fire("SiteChanged", State.siteDef)
end

local function tryBind(folder)
	if folder.Name ~= "SteelriseSite" then
		return
	end
	task.spawn(function()
		local t = os.clock()
		while folder.Parent and folder:GetAttribute("Ready") ~= true and os.clock() - t < 30 do
			task.wait(0.1)
		end
		if folder.Parent then
			bindSite(folder)
		end
	end)
end

workspace.ChildAdded:Connect(tryBind)
local existing = workspace:FindFirstChild("SteelriseSite")
if existing then
	tryBind(existing)
end

---------------------------------------------------------------------------
-- Menu camera (slow cinematic orbit over the live site)
---------------------------------------------------------------------------

local orbit = 0
RunService:BindToRenderStep("SR_MenuCam", Enum.RenderPriority.Camera.Value + 2, function(dt)
	if State.mode ~= "Menu" and State.mode ~= "Loading" then
		return
	end
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Scriptable
	local def = State.siteDef
	local focus = Vector3.new(0, 20, 0)
	local radius = 260
	if def then
		local c = def.crane.posM * Config.S
		focus = Vector3.new(c.X, def.crane.heightM * Config.S * 0.35, c.Z)
		radius = math.max(def.lotM.X, def.lotM.Z) * Config.S * 0.75 + 60
	end
	orbit += dt * 0.025
	local pos = focus + Vector3.new(math.cos(orbit) * radius, radius * 0.38, math.sin(orbit) * radius)
	cam.CFrame = CFrame.lookAt(pos, focus)
	cam.FieldOfView = 50
end)

---------------------------------------------------------------------------
-- Modes
---------------------------------------------------------------------------

local function selectTool(id)
	if State.mode ~= "Play" then
		return
	end
	if State.crane.operating then
		if State.crane.mode == "Remote" and id ~= "TL-REMOTE" then
			CraneClient.exit()
		elseif State.crane.mode == "Remote" and id == "TL-REMOTE" then
			CraneClient.exit()
			return
		else
			return
		end
	end
	if State.carrying and id ~= "TL-HANDS" then
		State.notify("Put down what you're carrying first.", "info")
		return
	end
	State.tool = id
	HUD.setTool(id)
	task.spawn(function()
		Net.call("Build", true, "Equip", id)
		if id == "TL-REMOTE" then
			local ok, msg, data = Net.call("Crane", true, "Remote", nil)
			if ok then
				CraneClient.start(data and data.craneId, "Remote")
			elseif msg then
				State.notify(msg, "warn")
			end
		end
	end)
end
State.on("SelectTool", selectTool)

local function enterMenu()
	State.mode = "Menu"
	CraneClient.stop()
	Interaction.clear()
	if Catalog.isOpen() then
		Catalog.toggle(false)
	end
	HUD.openPause(false)
	HUD.show(false)
	HUD.setTutorial(nil)
	State.tutorialActive = false
	player.CameraMode = Enum.CameraMode.Classic
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	UserInputService.MouseIconEnabled = true
	MainMenu.show()
end

local function enterPlay(data)
	State.mode = "Play"
	MainMenu.hide()
	HUD.show(true)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = State.settings.fov
	local function onChar(char)
		local hum = char:WaitForChild("Humanoid", 10)
		if hum then
			cam.CameraSubject = hum
		end
		View.setFirstPerson(not State.settings.thirdPerson)
		HUD.setCrosshair(State.firstPerson)
		State.tool = "TL-HANDS"
		HUD.setTool("TL-HANDS")
	end
	if player.Character then
		task.spawn(onChar, player.Character)
	end
	Settings.apply()
	HUD.setTool("TL-HANDS")
	local siteId = data and data.siteId
	if siteId == "EmptyLand" and State.lastStartMode == "new" and not State.settings.tutorialDone then
		task.delay(1.5, Tutorial.start)
	else
		local def = Sites.get(siteId or "")
		if def then
			State.notify(def.name .. " — " .. def.stageText, "info")
		end
	end
end

player.CharacterAdded:Connect(function(char)
	if State.mode == "Play" then
		local hum = char:WaitForChild("Humanoid", 10)
		workspace.CurrentCamera.CameraSubject = hum
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
		View.setFirstPerson(State.firstPerson)
		State.tool = "TL-HANDS"
		HUD.setTool("TL-HANDS")
	end
end)

State.on("EnteredSite", enterPlay)
State.on("ReturnToMenu", function()
	task.spawn(function()
		Net.call("Site", true, "Menu")
	end)
	enterMenu()
end)
State.on("ViewPreference", function(third)
	if State.mode == "Play" then
		View.setFirstPerson(not third)
		HUD.setCrosshair(State.firstPerson)
	end
end)
State.on("CraneOperating", function(on)
	HUD.setCrosshair(not on and State.firstPerson)
end)

---------------------------------------------------------------------------
-- Global keys
---------------------------------------------------------------------------

local TOOL_KEYS = {
	[Enum.KeyCode.One] = 1,
	[Enum.KeyCode.Two] = 2,
	[Enum.KeyCode.Three] = 3,
	[Enum.KeyCode.Four] = 4,
	[Enum.KeyCode.Five] = 5,
}

UserInputService.InputBegan:Connect(function(input, gp)
	if gp or State.mode ~= "Play" then
		return
	end
	local k = input.KeyCode
	if k == Enum.KeyCode.Tab then
		if not State.crane.operating or State.crane.mode == "Remote" then
			HUD.openPause(false)
			Catalog.toggle()
		end
	elseif k == Enum.KeyCode.P then
		if Catalog.isOpen() then
			Catalog.toggle(false)
		end
		HUD.openPause()
	elseif k == Enum.KeyCode.F1 then
		HUD.toggleHelp()
	elseif State.uiBlocking then
		return
	elseif k == Enum.KeyCode.J then
		HUD.toggleTasks()
	elseif k == Enum.KeyCode.B then
		Blueprint.toggle()
	elseif k == Enum.KeyCode.V and not State.crane.operating then
		View.toggle()
		HUD.setCrosshair(State.firstPerson)
	elseif TOOL_KEYS[k] then
		local id = Registry.ToolOrder[TOOL_KEYS[k]]
		if id then
			selectTool(id)
		end
	end
end)

-- Overlays (catalog, site menu, help) contain a Modal button, which frees the
-- mouse even in first person; nothing else to do here.

---------------------------------------------------------------------------
-- Start
---------------------------------------------------------------------------

task.spawn(function()
	if State.menuInfo then
		MainMenu.refresh(State.menuInfo)
	end
	State.mode = "Menu"
	player:SetAttribute("SR_MenuReady", true)
	while not player:GetAttribute("SR_LoaderDone") do
		task.wait(0.1)
	end
	enterMenu()
end)
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001C">
<Properties>
<string name="Name">CraneClient</string>
<ProtectedString name="Source"><![CDATA[-- Tower crane on the client.
--
-- Renderer (everyone): poses the slewing assembly, trolley, hook block, hoist
-- falls, slings and the rigged load from the crane's state each frame,
-- smoothing the server's ~12 Hz attribute updates.
--
-- Operator (the player at the controls): simulates the crane at frame rate
-- with acceleration/braking, a damped pendulum for load sway, load-chart and
-- travel limits, ground and collision stops, then streams the state to the
-- server which clamps and republishes it. Also runs the alignment assist,
-- landing, hooking/unhooking and the cab / hook / exterior cameras.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local Factory = require(Shared.ModelFactory)
local BuildRules = require(Shared.BuildRules)
local CraneMath = require(Shared.CraneMath)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local HUD = require(script.Parent.HUD)
local Net = require(script.Parent.Net)
local Audio = require(script.Parent.Audio)

local CraneClient = {}
local player = Players.LocalPlayer
local K = Config.Crane
local S = Config.S

local recs = {} -- crane model -> render record
local op = nil -- operator session
local slingFolder

local function now()
	return workspace:GetServerTimeNow()
end

local function wrap(a)
	return (a + math.pi) % (2 * math.pi) - math.pi
end

---------------------------------------------------------------------------
-- Render records
---------------------------------------------------------------------------

local function getRec(model)
	local rec = recs[model]
	if rec then
		return rec
	end
	if not State.siteDef then
		return nil
	end
	local slew, trolley, hook = model:FindFirstChild("Slew"), model:FindFirstChild("Trolley"), model:FindFirstChild("Hook")
	if not (slew and trolley and hook and slew.PrimaryPart and trolley.PrimaryPart and hook.PrimaryPart) then
		return nil
	end
	local cfg = CraneMath.config(State.siteDef.crane)
	rec = {
		model = model,
		cfg = cfg,
		st = CraneMath.readAttributes(model, CraneMath.defaultState(cfg.def)),
		prev = nil,
		slew = slew,
		trolley = trolley,
		hook = hook,
		cables = model:FindFirstChild("Cables"),
		slings = {},
	}
	local drum = slew:FindFirstChild("WinchDrum")
	rec.sndSlew = Audio.loop("CraneSlewMotor", slew.PrimaryPart)
	rec.sndTrolley = Audio.loop("CraneTrolleyMotor", trolley.PrimaryPart)
	rec.sndHoist = Audio.loop("CraneHoistWinch", drum or slew.PrimaryPart)
	recs[model] = rec
	return rec
end

local function placeCylinder(part, a, b)
	local len = (b - a).Magnitude
	if len < 0.01 then
		part.Transparency = 1
		return
	end
	part.Transparency = 0
	part.Size = Vector3.new(len, part.Size.Y, part.Size.Z)
	part.CFrame = Factory.lookAlong((a + b) / 2, b - a) * CFrame.Angles(0, math.pi / 2, 0)
end

local function loadModelOf(rec)
	local id = rec.model:GetAttribute("LoadId")
	if not id or id == "" or not State.site then
		return nil
	end
	local comps = State.site:FindFirstChild("Components")
	if not comps then
		return nil
	end
	for _, m in ipairs(comps:GetChildren()) do
		if m:GetAttribute("ComponentId") == id then
			return m
		end
	end
	return nil
end

local function rigBlend(rec)
	local t = rec.model:GetAttribute("RigTime") or 0
	return math.clamp((now() - t) / 1.5, 0, 1)
end

-- Current pose of the rigged load (including the pick-up blend).
local function riggedLoadCf(rec, st)
	local offset = rec.model:GetAttribute("RigOffset")
	if typeof(offset) ~= "CFrame" then
		return nil
	end
	local target = CraneMath.loadCf(rec.cfg, st, offset)
	local start = rec.model:GetAttribute("RigStart")
	local a = rigBlend(rec)
	if typeof(start) == "CFrame" and a < 1 then
		local e = a * a * (3 - 2 * a)
		return start:Lerp(target, e), true
	end
	return target, false
end

local function setSling(rec, i, a, b)
	local p = rec.slings[i]
	if not p then
		p = Instance.new("Part")
		p.Name = "Sling"
		p.Shape = Enum.PartType.Cylinder
		p.Size = Vector3.new(1, 0.12, 0.12)
		p.Color = Color3.fromRGB(230, 120, 30)
		p.Material = Enum.Material.Fabric
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Parent = slingFolder
		rec.slings[i] = p
	end
	if a then
		placeCylinder(p, a, b)
	else
		p.Transparency = 1
	end
end

local function render(rec, st, dt)
	local cfg = rec.cfg
	rec.slew:PivotTo(CraneMath.slewCf(cfg, st.slew))
	local tcf = CraneMath.trolleyCf(cfg, st)
	rec.trolley:PivotTo(tcf)
	local bcf = CraneMath.blockCf(cfg, st)
	rec.hook:PivotTo(bcf)
	if rec.cables then
		local f1, f2 = rec.cables:FindFirstChild("Fall1"), rec.cables:FindFirstChild("Fall2")
		if f1 and f2 then
			placeCylinder(f1, (tcf * CFrame.new(-0.45, 0.2, 0)).Position, (bcf * CFrame.new(-0.45, 2.9, 0)).Position)
			placeCylinder(f2, (tcf * CFrame.new(0.45, 0.2, 0)).Position, (bcf * CFrame.new(0.45, 2.9, 0)).Position)
		end
	end
	-- load and slings
	local load = loadModelOf(rec)
	local hookPoint = bcf.Position
	if load then
		local def = Registry.get(load:GetAttribute("ItemId"))
		if load:GetAttribute("State") == "Rigged" then
			local cf = riggedLoadCf(rec, st)
			if cf then
				load:PivotTo(cf)
			end
		end
		local pivot = load:GetPivot()
		for i = 1, 2 do
			local lp = def and def.liftPointsS[i]
			if lp then
				setSling(rec, i, hookPoint, pivot * lp)
			else
				setSling(rec, i, nil)
			end
		end
	else
		setSling(rec, 1, nil)
		setSling(rec, 2, nil)
	end
	-- motor sounds follow the motion
	if rec.prev and dt > 0 then
		local vs = math.abs(wrap(st.slew - rec.prev.slew)) / dt
		local vt = math.abs(st.trolley - rec.prev.trolley) / dt
		local vh = math.abs(st.hoist - rec.prev.hoist) / dt
		rec.sndSlew:set(vs / K.SlewMaxSpeed, 0.8 + 0.3 * vs / K.SlewMaxSpeed)
		rec.sndTrolley:set(vt / K.TrolleyMaxSpeed, 0.85 + 0.25 * vt / K.TrolleyMaxSpeed)
		rec.sndHoist:set(vh / K.HoistMaxSpeed, 0.8 + 0.35 * vh / K.HoistMaxSpeed)
		rec.sndSlew:step(dt)
		rec.sndTrolley:step(dt)
		rec.sndHoist:step(dt)
	end
	rec.prev = { slew = st.slew, trolley = st.trolley, hoist = st.hoist }
end

---------------------------------------------------------------------------
-- Operator session
---------------------------------------------------------------------------

local function sinkMovement(on)
	if on then
		ContextActionService:BindActionAtPriority("SR_CraneSink", function()
			return Enum.ContextActionResult.Sink
		end, false, Enum.ContextActionPriority.High.Value + 100, Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Space, Enum.KeyCode.Up, Enum.KeyCode.Down, Enum.KeyCode.Left, Enum.KeyCode.Right)
	else
		ContextActionService:UnbindAction("SR_CraneSink")
	end
end

local VIEWS = { Cab = { "Cab", "Hook", "Exterior" }, Remote = { "Player", "Hook", "Exterior" } }

local function setView(view)
	op.view = view
	State.crane.view = view
	local cam = workspace.CurrentCamera
	if view == "Player" then
		cam.CameraType = Enum.CameraType.Custom
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	else
		cam.CameraType = Enum.CameraType.Scriptable
		UserInputService.MouseBehavior = view == "Cab" and Enum.MouseBehavior.LockCenter or Enum.MouseBehavior.Default
	end
end

function CraneClient.start(craneId, mode)
	local site = State.site
	local folder = site and site:FindFirstChild("Cranes")
	local model = nil
	for _, m in ipairs(folder and folder:GetChildren() or {}) do
		if m:GetAttribute("CraneId") == craneId or not craneId then
			model = m
		end
	end
	if not model then
		return
	end
	local rec = getRec(model)
	if not rec then
		return
	end
	op = {
		rec = rec,
		mode = mode,
		st = CraneMath.readAttributes(model, rec.st),
		v = { slew = 0, trolley = 0, hoist = 0, rot = 0 },
		sv = { x = 0, z = 0 },
		seq = model:GetAttribute("ResetSeq") or 0,
		sendAcc = 0,
		camYaw = 0,
		camPitch = -0.38,
		orbitYaw = math.rad(30),
		orbitPitch = math.rad(-25),
		orbitDist = 60,
		assist = State.settings.assist,
		lastSolve = 0,
		contactCooldown = 0,
		recoverHold = nil,
		startedAt = os.clock(),
	}
	State.crane.operating = true
	State.crane.id = craneId
	State.crane.mode = mode
	State.crane.assist = op.assist
	sinkMovement(true)
	setView(VIEWS[mode][1])
	HUD.setCrosshair(false)
	HUD.setPrompt(nil)
	State.fire("CraneOperating", true)
end

local function clearGhost()
	if op and op.ghost then
		op.ghost:Destroy()
		op.ghost = nil
		op.ghostDef = nil
	end
end

function CraneClient.stop()
	if not op then
		return
	end
	clearGhost()
	op = nil
	State.crane.operating = false
	State.crane.id = nil
	sinkMovement(false)
	local cam = workspace.CurrentCamera
	cam.CameraType = Enum.CameraType.Custom
	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	if player.Character then
		for _, p in ipairs(player.Character:GetDescendants()) do
			if p:IsA("BasePart") then
				p.LocalTransparencyModifier = 0
			end
		end
	end
	HUD.setCrane(nil)
	HUD.setCrosshair(State.firstPerson)
	State.fire("CraneOperating", false)
end

function CraneClient.exit()
	if not op then
		return
	end
	task.spawn(function()
		Net.call("Crane", true, "Exit")
	end)
	CraneClient.stop()
end

-- Collision probe around the hook block and the hanging load.
local overlap = OverlapParams.new()
overlap.FilterType = Enum.RaycastFilterType.Include
overlap.RespectCanCollide = true

local function blocked(rec, st, load, loadDef, skipLoad)
	local site = State.site
	overlap.FilterDescendantsInstances = { site.Components, site.Environment, site.Trailers, rec.model.Static }
	local function hits(cf, size, ignore)
		for _, p in ipairs(workspace:GetPartBoundsInBox(cf, size, overlap)) do
			if not (ignore and p:IsDescendantOf(ignore)) and p.Name ~= "StrapHit" then
				local comp = p
				while comp and comp.Parent ~= site.Components do
					comp = comp.Parent
				end
				local stt = comp and comp:GetAttribute("State")
				if not comp or stt ~= "Carried" then
					return true
				end
			end
		end
		return false
	end
	local hookCf = CraneMath.blockCf(rec.cfg, st)
	if hits(hookCf * CFrame.new(0, 1.2, 0), Vector3.new(1.2, 3.4, 1.6), load) then
		return true
	end
	if load and loadDef and not skipLoad then
		local cf = riggedLoadCf(rec, st)
		if cf then
			local size = loadDef.size - Vector3.new(0.5, 0.5, 0.5)
			size = Vector3.new(math.max(size.X, 0.1), math.max(size.Y, 0.1), math.max(size.Z, 0.1))
			if hits(cf * CFrame.new(loadDef.boundsOffset), size, load) then
				return true
			end
		end
	end
	return false
end

-- Lowest point of the hook or load below which nothing may go, and the
-- surface underneath it.
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundClearance(rec, st, load, loadDef)
	local exclude = { rec.model, workspace.CurrentCamera }
	if load then
		table.insert(exclude, load)
	end
	if player.Character then
		table.insert(exclude, player.Character)
	end
	rayParams.FilterDescendantsInstances = exclude
	local bottom, origin
	if load and loadDef then
		local cf = riggedLoadCf(rec, st)
		local box = cf * CFrame.new(loadDef.boundsOffset)
		local h = loadDef.size / 2
		bottom = math.huge
		for _, sx in ipairs({ -1, 1 }) do
			for _, sy in ipairs({ -1, 1 }) do
				for _, sz in ipairs({ -1, 1 }) do
					bottom = math.min(bottom, (box * Vector3.new(sx * h.X, sy * h.Y, sz * h.Z)).Y)
				end
			end
		end
		origin = box.Position
	else
		local hp = CraneMath.hookPos(rec.cfg, st)
		bottom = hp.Y - 0.6
		origin = hp
	end
	local hit = workspace:Raycast(origin + Vector3.new(0, 2, 0), Vector3.new(0, -400, 0), rayParams)
	local surface = hit and hit.Position.Y or -50
	return bottom - surface
end

local contactSoundAt = 0

local function simulate(dt)
	local rec = op.rec
	local model = rec.model
	local cfg = rec.cfg
	-- server-side reset (recovery)
	local seq = model:GetAttribute("ResetSeq") or 0
	if seq ~= op.seq then
		op.seq = seq
		op.st = CraneMath.readAttributes(model, op.st)
		op.v = { slew = 0, trolley = 0, hoist = 0, rot = 0 }
		op.sv = { x = 0, z = 0 }
	end
	local locked = model:GetAttribute("Locked") == true
	local load = loadModelOf(rec)
	local loadDef = load and Registry.get(load:GetAttribute("ItemId"))
	local hanging = load and load:GetAttribute("State") == "Rigged"
	local blending = hanging and rigBlend(rec) < 1
	local blockedInput = State.uiBlocking
	local function key(k)
		return not blockedInput and UserInputService:IsKeyDown(k)
	end
	local prec = key(Enum.KeyCode.LeftShift) and K.PrecisionFactor or 1
	local slewIn = (key(Enum.KeyCode.A) and 1 or 0) - (key(Enum.KeyCode.D) and 1 or 0)
	local trolleyIn = (key(Enum.KeyCode.W) and 1 or 0) - (key(Enum.KeyCode.S) and 1 or 0)
	local hoistIn = (key(Enum.KeyCode.F) and 1 or 0) - (key(Enum.KeyCode.R) and 1 or 0)
	local rotIn = (key(Enum.KeyCode.Z) and 1 or 0) - (key(Enum.KeyCode.C) and 1 or 0)
	if locked then
		slewIn, trolleyIn, rotIn = 0, 0, 0
		hoistIn = 0
	end
	local hoistMax = hanging and K.HoistLoadedSpeed or K.HoistMaxSpeed
	local v = op.v
	local oldV = { slew = v.slew, trolley = v.trolley }
	v.slew = Util.rampVelocity(v.slew, slewIn * K.SlewMaxSpeed * prec, K.SlewAccel, K.SlewBrake, dt)
	v.trolley = Util.rampVelocity(v.trolley, trolleyIn * K.TrolleyMaxSpeed * prec, K.TrolleyAccel, K.TrolleyBrake, dt)
	v.hoist = Util.rampVelocity(v.hoist, hoistIn * hoistMax * prec, K.HoistAccel, K.HoistBrake, dt)
	v.rot = Util.rampVelocity(v.rot, rotIn * K.LoadRotateSpeed * prec, K.LoadRotateSpeed * 2, K.LoadRotateSpeed * 3, dt)

	-- brake clunk when a fast motion is released
	local fast = math.abs(oldV.slew) > K.SlewMaxSpeed * 0.5 or math.abs(oldV.trolley) > K.TrolleyMaxSpeed * 0.5
	if fast and slewIn == 0 and trolleyIn == 0 and not op.braked then
		op.braked = true
		Audio.play("CraneBrake", rec.slew.PrimaryPart)
	elseif slewIn ~= 0 or trolleyIn ~= 0 then
		op.braked = false
	end

	local st = op.st
	local prev = { slew = st.slew, trolley = st.trolley, hoist = st.hoist, swingX = st.swingX, swingZ = st.swingZ, loadYaw = st.loadYaw }
	st.slew = wrap(st.slew + v.slew * dt)
	st.trolley += v.trolley * dt
	st.hoist += v.hoist * dt
	st.loadYaw = wrap(st.loadYaw + v.rot * dt)

	-- travel limits and load chart
	local maxR = cfg.maxR
	local kg = 0
	if hanging and loadDef then
		kg = loadDef.weightKg + K.RiggingKg
		maxR = math.min(maxR, CraneMath.maxRadiusFor(cfg, kg))
	end
	if st.trolley > maxR then
		if v.trolley > 0 and kg > 0 then
			HUD.flash("LOAD MOMENT LIMIT")
		end
		st.trolley = math.max(maxR, math.min(prev.trolley, maxR))
		v.trolley = math.min(v.trolley, 0)
	elseif st.trolley < cfg.minR then
		st.trolley = cfg.minR
		v.trolley = math.max(v.trolley, 0)
	end
	if st.hoist < cfg.minRope then
		st.hoist = cfg.minRope
		v.hoist = math.max(v.hoist, 0)
	elseif st.hoist > cfg.maxRope then
		st.hoist = cfg.maxRope
		v.hoist = math.min(v.hoist, 0)
	end

	-- pendulum sway in the jib frame (small-angle model, real g at world scale)
	if locked then
		st.swingX, st.swingZ = 0, 0
		op.sv.x, op.sv.z = 0, 0
	else
		local L = math.max(st.hoist + (hanging and K.SlingDrop or 0), 2)
		local g = K.PendulumGravity
		local damping = op.assist and K.SwingDampingAssist or K.SwingDamping
		local aRad = (v.trolley - oldV.trolley) / dt - (v.slew * v.slew) * st.trolley
		local aTan = -((v.slew - oldV.slew) / dt) * st.trolley
		local steps = 4
		local h = dt / steps
		for _ = 1, steps do
			local ax = -(g / L) * st.swingX - aRad - damping * op.sv.x
			local az = -(g / L) * st.swingZ - aTan - damping * op.sv.z
			op.sv.x += ax * h
			op.sv.z += az * h
			st.swingX += op.sv.x * h
			st.swingZ += op.sv.z * h
		end
	end
	CraneMath.sanitize(cfg, st)

	-- ground / deck stop while lowering
	if v.hoist > 0 then
		local clearance = groundClearance(rec, st, hanging and load or nil, loadDef)
		if clearance < 0.15 then
			st.hoist = math.max(cfg.minRope, st.hoist - (0.15 - clearance))
			v.hoist = 0
		end
	end

	-- collision stop
	op.contactCooldown -= dt
	if not blending and blocked(rec, st, hanging and load or nil, loadDef, false) then
		local wasBlocked = blocked(rec, prev, hanging and load or nil, loadDef, false)
		if not wasBlocked then
			st.slew, st.trolley, st.hoist, st.loadYaw = prev.slew, prev.trolley, prev.hoist, prev.loadYaw
			st.swingX, st.swingZ = prev.swingX, prev.swingZ
			op.sv.x, op.sv.z = -op.sv.x * 0.3, -op.sv.z * 0.3
			v.slew, v.trolley, v.hoist, v.rot = 0, 0, 0, 0
			if op.contactCooldown <= 0 then
				op.contactCooldown = 0.6
				HUD.flash("CONTACT")
				local where = hanging and load and load:GetPivot().Position or CraneMath.hookPos(cfg, st)
				if os.clock() - contactSoundAt > 0.5 then
					contactSoundAt = os.clock()
					Audio.play(hanging and "MetalContactHeavy" or "MetalContactLight", where)
				end
			end
		end
	end

	-- stream to the server
	op.sendAcc += dt
	if op.sendAcc >= 1 / K.StreamRate then
		op.sendAcc = 0
		Remotes.get("CraneStream"):FireServer(model:GetAttribute("CraneId"), {
			slew = st.slew,
			trolley = st.trolley,
			hoist = st.hoist,
			swingX = st.swingX,
			swingZ = st.swingZ,
			loadYaw = st.loadYaw,
			seq = op.seq,
		})
	end
	return st, load, loadDef, hanging, locked, prec < 1
end

---------------------------------------------------------------------------
-- Assist, attach candidates, camera
---------------------------------------------------------------------------

local function attachCandidate(rec, st)
	local site = State.site
	local comps = site and site:FindFirstChild("Components")
	if not comps then
		return nil
	end
	local hook = CraneMath.hookPos(rec.cfg, st)
	local best, bestD = nil, math.huge
	for _, m in ipairs(comps:GetChildren()) do
		local stt = m:GetAttribute("State")
		if stt == "Loose" or stt == "Restrained" then
			local def = Registry.get(m:GetAttribute("ItemId"))
			if def then
				local lift = m:GetPivot() * CraneMath.liftCentre(def) + Vector3.new(0, K.SlingDrop, 0)
				local d = (lift - hook).Magnitude
				if d < bestD then
					best, bestD = { model = m, def = def, state = stt }, d
				end
			end
		end
	end
	if best and bestD <= K.AttachRange + 1.5 then
		return best, bestD
	end
	return nil, bestD
end

local function guidance(rec, st, loadCf, target, def)
	local slewCf = CraneMath.slewCf(rec.cfg, st.slew)
	local delta = target.Position - loadCf.Position
	local lv = slewCf:VectorToObjectSpace(delta)
	local lines = {}
	local function m(x)
		return Config.toMeters(math.abs(x))
	end
	if math.abs(lv.X) > 0.15 then
		table.insert(lines, string.format("TROLLEY %s  %.2f m   (%s)", lv.X > 0 and "OUT" or "IN", m(lv.X), lv.X > 0 and "W" or "S"))
	end
	if math.abs(lv.Z) > 0.15 then
		table.insert(lines, string.format("SLEW %s  %.2f m   (%s)", lv.Z > 0 and "RIGHT" or "LEFT", m(lv.Z), lv.Z > 0 and "D" or "A"))
	end
	if math.abs(delta.Y) > 0.15 then
		table.insert(lines, string.format("%s  %.2f m   (%s)", delta.Y < 0 and "LOWER" or "RAISE", m(delta.Y), delta.Y < 0 and "F" or "R"))
	end
	local yawErr = wrap(Util.yawOf(target) - Util.yawOf(loadCf))
	if def.symmetric180 and math.abs(yawErr) > math.pi / 2 then
		yawErr = wrap(yawErr + math.pi)
	end
	if math.abs(yawErr) > math.rad(2) then
		table.insert(lines, string.format("ROTATE %s  %d°   (%s)", yawErr > 0 and "LEFT" or "RIGHT", math.floor(math.deg(math.abs(yawErr)) + 0.5), yawErr > 0 and "Z" or "C"))
	end
	local ang = BuildRules.angleDiff(def, target, loadCf)
	local ready = delta.Magnitude <= K.LandPosTolerance and ang <= K.LandAngleTolerance
	if ready then
		table.insert(lines, 1, "ALIGNED — press ENTER to land and secure")
	end
	return table.concat(lines, "\n"), ready
end

local function updateCamera(dt, st, load)
	local rec = op.rec
	local cam = workspace.CurrentCamera
	local slewCf = CraneMath.slewCf(rec.cfg, st.slew)
	if op.view == "Cab" then
		if not State.uiBlocking then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		end
		local d = UserInputService:GetMouseDelta()
		if not State.uiBlocking then
			op.camYaw = math.clamp(op.camYaw - d.X * 0.0035, -2.4, 2.4)
			op.camPitch = math.clamp(op.camPitch - d.Y * 0.0035, -1.35, 0.6)
		end
		local eye = slewCf * CraneMath.CabEye
		cam.CFrame = CFrame.new(eye) * slewCf.Rotation * CFrame.Angles(0, -math.pi / 2 + op.camYaw, 0) * CFrame.Angles(op.camPitch, 0, 0)
		if player.Character then
			for _, p in ipairs(player.Character:GetDescendants()) do
				if p:IsA("BasePart") then
					p.LocalTransparencyModifier = 1
				end
			end
		end
	elseif op.view == "Hook" then
		local trolley = CraneMath.trolleyCf(rec.cfg, st)
		local hookPos = CraneMath.hookPos(rec.cfg, st)
		local eye = (trolley * CFrame.new(0, -1.8, 2.2)).Position
		local focus = load and load:GetPivot().Position or hookPos
		cam.CFrame = CFrame.lookAt(eye, focus - Vector3.new(0, 6, 0), slewCf.RightVector)
	elseif op.view == "Exterior" then
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			local d = UserInputService:GetMouseDelta()
			op.orbitYaw -= d.X * 0.005
			op.orbitPitch = math.clamp(op.orbitPitch - d.Y * 0.005, -1.4, 0.3)
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
		local focus = load and load:GetPivot().Position or CraneMath.hookPos(rec.cfg, st)
		local rot = CFrame.Angles(0, op.orbitYaw, 0) * CFrame.Angles(op.orbitPitch, 0, 0)
		local want = CFrame.new(focus) * rot * CFrame.new(0, 0, op.orbitDist)
		cam.CFrame = cam.CFrame:Lerp(want, math.min(dt * 8, 1))
	end
end

local function landNow()
	local rec = op.rec
	local load = loadModelOf(rec)
	if not load or load:GetAttribute("State") ~= "Rigged" then
		State.notify("Nothing hanging to land.", "info")
		return
	end
	local def = Registry.get(load:GetAttribute("ItemId"))
	local loadCf = riggedLoadCf(rec, op.st)
	local target, why = BuildRules.solve(State.world, def, { point = loadCf.Position }, { current = loadCf, excludeModels = { load, rec.model } })
	if not target then
		State.notify(why or "No connection near the load.", "warn")
		return
	end
	task.spawn(function()
		local ok = Net.call("Crane", false, "Land", target)
		if ok then
			op.v = { slew = 0, trolley = 0, hoist = 0, rot = 0 }
			op.sv = { x = 0, z = 0 }
		end
	end)
end

local function hookOrRelease()
	local rec = op.rec
	local load = loadModelOf(rec)
	if load then
		task.spawn(function()
			Net.call("Crane", false, "Release")
		end)
		return
	end
	local cand = attachCandidate(rec, op.st)
	if not cand then
		State.notify("Bring the hook down over a load's rigging points first.", "info")
		return
	end
	task.spawn(function()
		local ok = Net.call("Crane", false, "Attach", cand.model:GetAttribute("ComponentId"))
		if ok then
			op.st.loadYaw = 0
			Audio.play("SlingRattle", cand.model.PrimaryPart)
		end
	end)
end

local RIG_NAMES = { Bridle = "two-leg bridle", Upright = "top lug — hangs plumb", Pitch = "choker — hangs at brace angle" }

local function updateOperatorHud(st, load, loadDef, hanging, locked, precision)
	local rec = op.rec
	local cfg = rec.cfg
	local hookPos = CraneMath.hookPos(cfg, st)
	local kg = loadDef and (loadDef.weightKg + K.RiggingKg) or 0
	local cap = CraneMath.capacityKg(cfg, st.trolley)
	local data = {
		mode = op.mode,
		view = op.view,
		assist = op.assist,
		radiusM = Config.toMeters(st.trolley),
		heightM = Config.toMeters(hookPos.Y),
		slewDeg = math.deg(st.slew),
		loadName = loadDef and loadDef.name or nil,
		loadKg = kg,
		capKg = cap,
		lmi = kg / math.max(cap, 1),
		precision = precision,
	}
	local hints = {}
	if locked and load then
		local mask = load:GetAttribute("Fastened") or ""
		local done = select(2, string.gsub(mask, "1", ""))
		local need = loadDef.minFastenRelease
		if load:GetAttribute("State") == "Installed" or done >= need then
			data.guide = "Connections made. G — unhook."
			data.guideReady = true
		else
			data.guide = string.format("Crane is holding the piece in place.\nFasten %d connection%s (%d/%d done), then unhook with G.\nTip: use the radio remote from the steel or scaffold.", need, need > 1 and "s" or "", done, need)
		end
	elseif hanging then
		data.guide = "Rigging: " .. (RIG_NAMES[loadDef.rigging] or loadDef.rigging)
		if op.assist and op.target then
			local text, ready = guidance(rec, st, riggedLoadCf(rec, st), op.target, loadDef)
			data.guide = (op.targetValid and "" or ("✕ " .. (op.targetReason or "") .. "\n")) .. text
			data.guideReady = ready and op.targetValid
		elseif op.assist and op.targetReason then
			data.guide = op.targetReason
		end
		table.insert(hints, "ENTER land · G set down on ground")
	else
		local cand, d = attachCandidate(rec, st)
		if cand then
			if cand.state == "Restrained" then
				data.guide = cand.def.name .. " — release its cargo straps first."
			else
				data.guide = "G — hook " .. cand.def.name .. "\n(" .. (RIG_NAMES[cand.def.rigging] or cand.def.rigging) .. ", " .. Util.fmtKg(cand.def.weightKg) .. ")"
				data.guideReady = true
			end
		else
			data.guide = d and d < 40 and string.format("Nearest load %.1f m from the hook", Config.toMeters(d)) or "Hook free"
		end
	end
	table.insert(hints, "WASD slew/trolley · R/F hoist · Z/C rotate · Shift fine")
	table.insert(hints, "H assist · V camera · X exit · hold Y recover")
	data.hint = table.concat(hints, "\n")
	HUD.setCrane(data)
end

local function updateAssist(st, load, loadDef, hanging, locked)
	local rec = op.rec
	if not (op.assist and hanging and not locked and loadDef) then
		clearGhost()
		op.target = nil
		op.targetReason = nil
		return
	end
	if os.clock() - op.lastSolve < 0.12 then
		return
	end
	op.lastSolve = os.clock()
	local loadCf = riggedLoadCf(rec, st)
	local target, why = BuildRules.solve(State.world, loadDef, { point = loadCf.Position }, { current = loadCf, excludeModels = { load, rec.model } })
	op.target = target
	op.targetReason = why
	op.targetValid = false
	if target then
		local ok, reason = BuildRules.validate(State.world, loadDef, target, { exclude = { load:GetAttribute("ComponentId") }, excludeModels = { load } })
		op.targetValid = ok
		op.targetReason = reason
		if op.ghostDef ~= loadDef then
			clearGhost()
			op.ghost = Factory.build(loadDef, target, { ghost = true, preview = true })
			op.ghostDef = loadDef
			local h = Instance.new("Highlight")
			h.Name = "H"
			h.FillTransparency = 0.6
			h.OutlineTransparency = 0.1
			h.Parent = op.ghost
			op.ghost.Parent = workspace.CurrentCamera
		end
		op.ghost:PivotTo(target)
		local h = op.ghost:FindFirstChild("H")
		if h then
			h.FillColor = ok and Config.Colors.Valid or Config.Colors.Invalid
			h.OutlineColor = h.FillColor
		end
	else
		clearGhost()
	end
end

---------------------------------------------------------------------------
-- Loop & input
---------------------------------------------------------------------------

function CraneClient.init()
	slingFolder = Instance.new("Folder")
	slingFolder.Name = "SR_Slings"
	slingFolder.Parent = workspace.CurrentCamera

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp or not op then
			return
		end
		local k = input.KeyCode
		if State.uiBlocking then
			return
		end
		if k == Enum.KeyCode.X then
			CraneClient.exit()
		elseif k == Enum.KeyCode.G then
			hookOrRelease()
		elseif k == Enum.KeyCode.Return or k == Enum.KeyCode.KeypadEnter then
			landNow()
		elseif k == Enum.KeyCode.H then
			op.assist = not op.assist
			State.crane.assist = op.assist
		elseif k == Enum.KeyCode.V then
			local views = VIEWS[op.mode]
			local idx = table.find(views, op.view) or 1
			setView(views[idx % #views + 1])
		elseif k == Enum.KeyCode.Y then
			op.recoverHold = os.clock()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if op and input.KeyCode == Enum.KeyCode.Y then
			op.recoverHold = nil
			HUD.setHold(nil)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if op and op.view == "Exterior" and input.UserInputType == Enum.UserInputType.MouseWheel then
			op.orbitDist = math.clamp(op.orbitDist - input.Position.Z * 6, 15, 260)
		end
	end)
	State.on("CraneRecover", function()
		task.spawn(function()
			Net.call("Crane", false, "Recover")
		end)
	end)
	State.on("CraneExit", CraneClient.exit)
	State.on("CraneStart", function(id, mode)
		CraneClient.start(id, mode)
	end)

	RunService:BindToRenderStep("SR_Crane", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local site = State.site
		local folder = site and site:FindFirstChild("Cranes")
		if not folder then
			return
		end
		dt = math.min(dt, 1 / 20)
		for _, model in ipairs(folder:GetChildren()) do
			local rec = getRec(model)
			if rec then
				local st
				if op and op.rec == rec then
					local load, loadDef, hanging, locked, precision
					st, load, loadDef, hanging, locked, precision = simulate(dt)
					render(rec, st, dt)
					updateAssist(st, load, loadDef, hanging, locked)
					updateCamera(dt, st, load)
					updateOperatorHud(st, load, loadDef, hanging, locked, precision)
					if op.recoverHold then
						local a = (os.clock() - op.recoverHold) / 1.2
						HUD.setHold(a)
						if a >= 1 then
							op.recoverHold = nil
							HUD.setHold(nil)
							State.fire("CraneRecover")
						end
					end
				else
					local target = CraneMath.readAttributes(model, rec.st)
					local a = math.min(dt * 10, 1)
					rec.st.slew = wrap(rec.st.slew + wrap(target.slew - rec.st.slew) * a)
					rec.st.loadYaw = wrap(rec.st.loadYaw + wrap(target.loadYaw - rec.st.loadYaw) * a)
					for _, key in ipairs({ "trolley", "hoist", "swingX", "swingZ" }) do
						rec.st[key] += (target[key] - rec.st[key]) * a
					end
					render(rec, rec.st, dt)
				end
				-- operator gone (server cleared it)
				if op and op.rec == rec and os.clock() - op.startedAt > 1.5 and model:GetAttribute("Operator") ~= player.UserId then
					CraneClient.stop()
				end
			end
		end
	end)
end

function CraneClient.reset()
	CraneClient.stop()
	for _, rec in pairs(recs) do
		for _, s in ipairs(rec.slings) do
			s:Destroy()
		end
		for _, snd in ipairs({ rec.sndSlew, rec.sndTrolley, rec.sndHoist }) do
			snd:destroy()
		end
	end
	recs = {}
end

function CraneClient.isOperating()
	return op ~= nil
end

return CraneClient
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001D">
<Properties>
<string name="Name">FX</string>
<ProtectedString name="Source"><![CDATA[-- Effects and positional audio for server-announced events (bolting,
-- welding, setting steel, straps, trucks), the local welding arc while the
-- player holds the stinger, machine loops for running equipment and the
-- site ambience beds.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Registry = require(Shared.ItemRegistry)
local Remotes = require(Shared.Remotes)

local State = require(script.Parent.State)
local Audio = require(script.Parent.Audio)

local FX = {}
local player = Players.LocalPlayer

local function anchorAt(pos)
	local a = Instance.new("Attachment")
	a.WorldPosition = pos
	a.Parent = workspace.Terrain
	Debris:AddItem(a, 3)
	return a
end

local function sparks(pos, amount, color)
	local scale = State.particleScale or 0.7
	if scale <= 0 then
		return
	end
	local a = anchorAt(pos)
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.25, 0.6)
	e.Speed = NumberRange.new(6, 16)
	e.SpreadAngle = Vector2.new(70, 70)
	e.Acceleration = Vector3.new(0, -60, 0)
	e.Drag = 2
	e.LightEmission = 1
	e.LightInfluence = 0
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.12), NumberSequenceKeypoint.new(1, 0) })
	e.Color = ColorSequence.new(color or Color3.fromRGB(255, 214, 140), Color3.fromRGB(255, 140, 40))
	e.Squash = NumberSequence.new(1.5)
	e.Parent = a
	e:Emit(math.max(1, math.floor(amount * scale)))
	local light = Instance.new("PointLight")
	light.Range = 10
	light.Brightness = 3
	light.Color = Color3.fromRGB(190, 210, 255)
	light.Parent = a
	task.delay(0.12, function()
		light.Enabled = false
	end)
end

local function dust(pos)
	local scale = State.particleScale or 0.7
	if scale <= 0 then
		return
	end
	local a = anchorAt(pos)
	local e = Instance.new("ParticleEmitter")
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(1, 3)
	e.SpreadAngle = Vector2.new(80, 20)
	e.Color = ColorSequence.new(Color3.fromRGB(150, 140, 126))
	e.Transparency = NumberSequence.new(0.5, 1)
	e.Size = NumberSequence.new(0.6, 2)
	e.LightInfluence = 1
	e.Parent = a
	e:Emit(math.floor(10 * scale))
end

local HANDLERS = {
	Bolt = function(pos)
		Audio.play("ImpactWrench", pos)
	end,
	Wedge = function(pos)
		Audio.play("HammerWedge", pos)
		sparks(pos, 3, Color3.fromRGB(255, 240, 200))
	end,
	Weld = function(pos)
		Audio.play("WeldArc", pos)
		sparks(pos, 18)
	end,
	Set = function(pos, itemId)
		local def = Registry.get(itemId or "")
		if def and def.tags.Concrete then
			Audio.play("ConcreteSet", pos)
			dust(pos)
		elseif def and def.tags.Scaffold then
			Audio.play("ScaffoldClank", pos)
		else
			Audio.play("SteelSet", pos)
		end
	end,
	Strap = function(pos)
		Audio.play("StrapRelease", pos)
	end,
	Rig = function(pos)
		Audio.play("SlingRattle", pos)
	end,
	Unhook = function(pos)
		Audio.play("SlingRattle", pos, 0.7)
	end,
	Drop = function(pos, itemId)
		local def = Registry.get(itemId or "")
		Audio.play(def and def.weightKg > 200 and "MetalContactHeavy" or "MetalContactLight", pos)
		if def and def.weightKg > 500 then
			dust(pos)
		end
	end,
	Pickup = function(pos)
		Audio.play("PickUp", pos)
	end,
	Dismantle = function(pos)
		Audio.play("ImpactWrench", pos, 0.8)
	end,
	TruckDepart = function(pos)
		Audio.play("TruckAirBrake", pos)
	end,
	TruckArrive = function() end,
	Toggle = function(pos)
		Audio.play("UIClick", pos)
	end,
}

---------------------------------------------------------------------------
-- Machine loops for running equipment
---------------------------------------------------------------------------

local machineLoops = {}

local function updateMachines(dt)
	local site = State.site
	local comps = site and site:FindFirstChild("Components")
	local seen = {}
	if comps then
		for _, m in ipairs(comps:GetChildren()) do
			local def = Registry.get(m:GetAttribute("ItemId") or "")
			if def and def.functional == "Engine" then
				seen[m] = true
				local loop = machineLoops[m]
				if not loop then
					loop = Audio.loop("GeneratorLoop", m.PrimaryPart)
					machineLoops[m] = loop
				end
				loop:set(m:GetAttribute("On") and 1 or 0, 1)
				loop:step(dt)
			end
		end
	end
	for m, loop in pairs(machineLoops) do
		if not seen[m] then
			loop:destroy()
			machineLoops[m] = nil
		end
	end
end

---------------------------------------------------------------------------
-- Ambience
---------------------------------------------------------------------------

local ambience = {}

local function ambienceFor(style)
	for _, h in pairs(ambience) do
		h:destroy()
	end
	ambience = {}
	ambience.wind = Audio.loop("WindLoop")
	ambience.windHigh = Audio.loop("WindHighLoop")
	ambience.site = Audio.loop("DistantConstruction")
	if style == "Downtown" or style == "CityCenter" or style == "HighRise" then
		ambience.city = Audio.loop("CityTraffic")
	elseif style == "Waterfront" then
		ambience.city = Audio.loop("Harbour")
	end
end

local function updateAmbience(dt)
	if not ambience.wind then
		return
	end
	local playing = State.mode == "Play"
	local cam = workspace.CurrentCamera
	local height = cam and cam.CFrame.Position.Y or 0
	local high = math.clamp((height - 30) / 120, 0, 1)
	ambience.wind:set(playing and (0.6 + 0.4 * (1 - high)) or 0.3)
	ambience.windHigh:set(playing and high or 0)
	ambience.site:set(playing and 0.8 or 0.4)
	if ambience.city then
		ambience.city:set(playing and 0.8 or 0.4)
	end
	for _, h in pairs(ambience) do
		h:step(dt)
	end
end

---------------------------------------------------------------------------
-- Local welding arc while holding the stinger on a weld spot
---------------------------------------------------------------------------

local weldPart = nil
local weldAcc = 0

function FX.init()
	Remotes.get("FX").OnClientEvent:Connect(function(kind, pos, extra)
		local h = HANDLERS[kind]
		if h and typeof(pos) == "Vector3" then
			h(pos, extra)
		end
	end)
	State.on("LocalWeldStart", function(part)
		weldPart = part
	end)
	State.on("LocalWeldStop", function()
		weldPart = nil
	end)
	State.on("SiteChanged", function(def)
		ambienceFor(def and def.style)
	end)
	RunService.Heartbeat:Connect(function(dt)
		updateMachines(dt)
		updateAmbience(dt)
		if weldPart and weldPart.Parent then
			weldAcc += dt
			if weldAcc > 0.08 then
				weldAcc = 0
				sparks(weldPart.Position, 4)
			end
		end
	end)
end

return FX
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001E">
<Properties>
<string name="Name">Footsteps</string>
<ProtectedString name="Source"><![CDATA[-- Surface-aware footsteps for the local character. Silent until step sounds
-- are supplied in AudioRegistry; once they are, the default running sound is
-- muted so the two don't double up.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local State = require(script.Parent.State)
local Audio = require(script.Parent.Audio)

local Footsteps = {}
local player = Players.LocalPlayer

local SURFACE = {
	[Enum.Material.Metal] = "StepSteel",
	[Enum.Material.DiamondPlate] = "StepGrating",
	[Enum.Material.CorrodedMetal] = "StepSteel",
	[Enum.Material.Concrete] = "StepConcrete",
	[Enum.Material.Pavement] = "StepConcrete",
	[Enum.Material.Asphalt] = "StepConcrete",
	[Enum.Material.Slate] = "StepGravel",
	[Enum.Material.Pebble] = "StepGravel",
	[Enum.Material.Ground] = "StepDirt",
	[Enum.Material.Mud] = "StepDirt",
	[Enum.Material.Grass] = "StepDirt",
	[Enum.Material.LeafyGrass] = "StepDirt",
	[Enum.Material.Wood] = "StepWood",
	[Enum.Material.WoodPlanks] = "StepWood",
}

function Footsteps.init()
	local anyConfigured = false
	for _, key in pairs(SURFACE) do
		if Audio.has(key) then
			anyConfigured = true
		end
	end
	if not anyConfigured then
		return
	end
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		local c = player.Character
		local hum = c and c:FindFirstChildOfClass("Humanoid")
		local hrp = c and c:FindFirstChild("HumanoidRootPart")
		if not hum or not hrp or State.mode ~= "Play" then
			return
		end
		local running = hrp:FindFirstChild("Running")
		if running and running:IsA("Sound") then
			running.Volume = 0
		end
		local speed = Vector3.new(hrp.AssemblyLinearVelocity.X, 0, hrp.AssemblyLinearVelocity.Z).Magnitude
		if hum.FloorMaterial == Enum.Material.Air or speed < 2 then
			acc = 0.3
			return
		end
		acc += dt
		local interval = math.clamp(5.5 / speed, 0.28, 0.6)
		if acc >= interval then
			acc = 0
			local key = SURFACE[hum.FloorMaterial] or "StepConcrete"
			Audio.play(key, hrp.Position - Vector3.new(0, 2.8, 0), math.clamp(speed / 16, 0.5, 1))
		end
	end)
end

return Footsteps
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX0000001F">
<Properties>
<string name="Name">HUD</string>
<ProtectedString name="Source"><![CDATA[-- In-game interface: crosshair, contextual prompts, hold progress, placement
-- status, tool hotbar, task panel with deliveries, toasts, crane panel,
-- help overlay, pause/site menu and the tutorial card.

local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local Sites = require(Shared.Sites)
local Util = require(Shared.Util)

local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Net = require(script.Parent.Net)
local Settings = require(script.Parent.Settings)
local Audio = require(script.Parent.Audio)

local C = Config.Colors
local F = UIKit.Font

local HUD = {}
local gui
local ui = {}

---------------------------------------------------------------------------
-- Toasts
---------------------------------------------------------------------------

local TOAST_COLORS = {
	info = C.Info,
	success = C.Valid,
	warn = C.Safety,
	error = C.Invalid,
	save = C.Steel,
}

function HUD.notify(text, kind)
	if not gui or not text or text == "" then
		return
	end
	kind = kind or "info"
	local t = UIKit.new("Frame", {
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = -math.floor(os.clock() * 100),
		Parent = ui.toasts,
	})
	UIKit.corner(t, 5)
	UIKit.new("Frame", { BackgroundColor3 = TOAST_COLORS[kind] or C.Info, BorderSizePixel = 0, Size = UDim2.new(0, 4, 1, 0), Parent = t })
	local l = UIKit.label(t, text, 15, F.Medium, C.OffWhite, { Size = UDim2.new(1, -24, 0, 0), Position = UDim2.new(0, 16, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	UIKit.padding(l, 0, 9, 0, 9)
	if kind == "error" or kind == "warn" then
		Audio.play("UIError")
	else
		Audio.play("UINotify")
	end
	task.delay(kind == "warn" and 5 or 4, function()
		if t.Parent then
			UIKit.tween(t, 0.4, { BackgroundTransparency = 1 })
			UIKit.tween(l, 0.4, { TextTransparency = 1 })
			task.wait(0.45)
			t:Destroy()
		end
	end)
	local items = {}
	for _, c in ipairs(ui.toasts:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	if #items > 5 then
		table.sort(items, function(a, b)
			return a.LayoutOrder > b.LayoutOrder
		end)
		items[1]:Destroy()
	end
end

---------------------------------------------------------------------------
-- Prompts, hold ring, placement status
---------------------------------------------------------------------------

local lastPromptKey = nil

function HUD.setPrompt(list)
	-- rebuild only when the content changes (called every frame)
	local key = ""
	for _, p in ipairs(list or {}) do
		key ..= (p.key or "") .. "|" .. (p.text or "") .. "|" .. (p.sub or "") .. "|" .. tostring(p.disabled) .. ";"
	end
	if key == lastPromptKey then
		return
	end
	lastPromptKey = key
	for _, c in ipairs(ui.prompt:GetChildren()) do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	if not list or #list == 0 then
		ui.prompt.Visible = false
		return
	end
	ui.prompt.Visible = true
	for i, p in ipairs(list) do
		local row = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, p.sub and 40 or 26), LayoutOrder = i, Parent = ui.prompt })
		if p.key then
			local k = UIKit.new("TextLabel", {
				Text = p.key,
				Font = F.Bold,
				TextSize = 14,
				TextColor3 = C.Charcoal,
				BackgroundColor3 = p.disabled and C.Steel or C.Safety,
				Size = UDim2.new(0, math.max(26, #p.key * 9 + 12), 0, 24),
				Parent = row,
			})
			UIKit.corner(k, 4)
		end
		local x = p.key and math.max(26, #p.key * 9 + 12) + 10 or 0
		UIKit.label(row, p.text, 16, F.Bold, p.disabled and C.Muted or C.OffWhite, { Position = UDim2.new(0, x, 0, 0), Size = UDim2.new(1, -x, 0, 24) })
		if p.sub then
			UIKit.label(row, p.sub, 13, F.Body, p.subColor or C.Muted, { Position = UDim2.new(0, x, 0, 22), Size = UDim2.new(1, -x, 0, 16) })
		end
	end
end

function HUD.setHold(fraction)
	ui.hold.Visible = fraction ~= nil
	if fraction then
		ui.holdFill.Size = UDim2.new(math.clamp(fraction, 0, 1), 0, 1, 0)
	end
end

function HUD.setPlacement(info)
	ui.place.Visible = info ~= nil
	if not info then
		return
	end
	ui.placeTitle.Text = info.title or ""
	ui.placeStatus.Text = info.valid and ("✓  " .. (info.okText or "Valid placement — click to set")) or ("✕  " .. (info.reason or "Can't place here"))
	ui.placeStatus.TextColor3 = info.valid and C.Valid or C.Invalid
	ui.placeBar.BackgroundColor3 = info.valid and C.Valid or C.Invalid
	ui.placeHints.Text = info.hints or ""
end

function HUD.setCrosshair(visible)
	ui.cross.Visible = visible
end

---------------------------------------------------------------------------
-- Hotbar
---------------------------------------------------------------------------

function HUD.setTool(id)
	for toolId, slot in pairs(ui.slots) do
		local on = toolId == id
		slot.BackgroundColor3 = on and C.SteelDark or C.Panel
		slot:FindFirstChildOfClass("UIStroke").Color = on and C.Safety or C.SteelDark
		slot:FindFirstChildOfClass("UIStroke").Thickness = on and 2 or 1
	end
	local def = Registry.get(id)
	ui.toolName.Text = def and string.upper(def.name) or ""
end

---------------------------------------------------------------------------
-- Task panel
---------------------------------------------------------------------------

local function refreshTasks()
	local site = State.site
	if not site then
		return
	end
	local def = State.siteDef
	ui.siteName.Text = def and string.upper(def.name) or ""
	local done, total = site:GetAttribute("BPInstalled") or 0, site:GetAttribute("BPTotal") or 0
	local bp = site:GetAttribute("Blueprint") or ""
	if total > 0 then
		ui.progressText.Text = string.format("%s  ·  %d / %d installed", bp == "Site" and "Building" or ("Blueprint: " .. bp), done, total)
		ui.progressFill.Size = UDim2.new(done / total, 0, 1, 0)
		ui.progressBar.Visible = true
	else
		ui.progressText.Text = "Free build"
		ui.progressBar.Visible = false
	end
	ui.nextTask.Text = site:GetAttribute("NextTask") or ""
	-- deliveries
	local lines = {}
	local trailers = site:FindFirstChild("Trailers")
	if trailers then
		for _, t in ipairs(trailers:GetChildren()) do
			local manifest = t:GetAttribute("Manifest")
			local ok, list = pcall(function()
				return HttpService:JSONDecode(manifest or "[]")
			end)
			local bay = t:GetAttribute("Bay") or 0
			if ok and #list > 0 then
				local parts = {}
				for i, e in ipairs(list) do
					if i <= 3 then
						table.insert(parts, e.qty .. "× " .. (Registry.get(e.id) and Registry.get(e.id).name:gsub(" —.*", "") or e.id))
					end
				end
				if #list > 3 then
					table.insert(parts, "+" .. (#list - 3) .. " more")
				end
				table.insert(lines, string.format("Bay %d  ·  %s", bay, table.concat(parts, ", ")))
			elseif t:GetAttribute("DepartAt") == 0 then
				table.insert(lines, string.format("Bay %d  ·  empty — E at the cab to release the truck", bay))
			end
		end
	end
	ui.deliveries.Text = #lines > 0 and table.concat(lines, "\n") or "No trucks on site — order materials with Tab."
	local carrying = State.carrying
	if carrying and carrying.Parent then
		local d = Registry.get(carrying:GetAttribute("ItemId"))
		ui.carry.Text = d and ("Carrying: " .. d.name .. "  (" .. Util.fmtKg(d.weightKg) .. ")") or ""
	else
		ui.carry.Text = ""
	end
end

function HUD.toggleTasks()
	ui.tasks.Visible = not ui.tasks.Visible
end

---------------------------------------------------------------------------
-- Crane panel
---------------------------------------------------------------------------

function HUD.setCrane(d)
	ui.crane.Visible = d ~= nil
	if not d then
		return
	end
	ui.craneMode.Text = string.format("%s  ·  %s VIEW  ·  ASSIST %s", d.mode == "Remote" and "RADIO REMOTE" or "CAB", string.upper(d.view or ""), d.assist and "ON" or "OFF")
	ui.craneRows.Radius.Text = string.format("%.1f m", d.radiusM)
	ui.craneRows.Height.Text = string.format("%.1f m", d.heightM)
	ui.craneRows.Slew.Text = string.format("%03d°", math.floor(d.slewDeg % 360))
	ui.craneRows.Load.Text = d.loadName and (d.loadName .. "  " .. Util.fmtKg(d.loadKg)) or "— hook free —"
	ui.craneRows.Capacity.Text = Util.fmtKg(d.capKg) .. " at radius"
	local lmi = math.clamp(d.lmi or 0, 0, 1.2)
	ui.lmiFill.Size = UDim2.new(math.min(lmi, 1), 0, 1, 0)
	ui.lmiFill.BackgroundColor3 = lmi < 0.8 and C.Valid or (lmi < 0.95 and C.Safety or C.Invalid)
	ui.lmiText.Text = string.format("LOAD MOMENT %d%%", math.floor(lmi * 100 + 0.5))
	ui.craneGuide.Text = d.guide or ""
	ui.craneGuide.TextColor3 = d.guideReady and C.Valid or C.OffWhite
	ui.craneHint.Text = d.hint or ""
	ui.craneSpeed.Text = d.precision and "PRECISION" or ""
end

function HUD.flash(text)
	ui.flash.Text = text
	ui.flash.Visible = true
	ui.flash.TextTransparency = 0
	task.delay(0.9, function()
		UIKit.tween(ui.flash, 0.4, { TextTransparency = 1 })
	end)
end

---------------------------------------------------------------------------
-- Tutorial card
---------------------------------------------------------------------------

function HUD.setTutorial(text, step, total, onSkip)
	ui.tutorial.Visible = text ~= nil
	if not text then
		return
	end
	ui.tutText.Text = text
	ui.tutStep.Text = string.format("TUTORIAL  ·  STEP %d / %d", step, total)
	ui.tutSkipHandler = onSkip
end

---------------------------------------------------------------------------
-- Help overlay & pause menu
---------------------------------------------------------------------------

function HUD.toggleHelp()
	ui.help.Visible = not ui.help.Visible
end

local function refreshSlots()
	local info = State.menuInfo or {}
	for slot, row in pairs(ui.slotRows) do
		local s = info.slots and info.slots[tostring(slot)]
		if s then
			local site = Sites.get(s.site)
			row.info.Text = string.format("%s  ·  %s  ·  %d/%d installed", site and site.name or s.site, os.date("%b %d %H:%M", s.savedAt or 0), s.installed or 0, s.total or 0)
		else
			row.info.Text = "Empty"
		end
		UIKit.setDisabled(row.load, s == nil)
	end
end

function HUD.openPause(open)
	if open == nil then
		open = not ui.pause.Visible
	end
	ui.pause.Visible = open
	State.uiBlocking = open or (State.catalogOpen == true)
	State.fire("UIBlocking", State.uiBlocking)
	if open then
		local ok, _, info = Net.call("Menu", true, "Info")
		if ok then
			State.menuInfo = info
		end
		refreshSlots()
		HUD.showPauseTab("Site")
	end
end

function HUD.showPauseTab(name)
	for n, f in pairs(ui.pauseTabs) do
		f.Visible = n == name
	end
end

local function buildPause()
	local overlay = UIKit.new("Frame", { BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 20, Parent = gui })
	overlay.Active = true
	UIKit.new("TextButton", { Modal = true, BackgroundTransparency = 1, Text = "", Size = UDim2.new(0, 1, 0, 1), Parent = overlay })
	ui.pause = overlay
	local panel = UIKit.panel(overlay, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 760, 0, 600) })
	UIKit.padding(panel, 20)
	UIKit.label(panel, "SITE MENU", 24, F.Display, C.OffWhite, { Size = UDim2.new(1, 0, 0, 30) })
	local tabs = UIKit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(1, 0, 0, 36), Parent = panel })
	UIKit.list(tabs, Enum.FillDirection.Horizontal, 6)
	ui.pauseTabs = {}
	local body = UIKit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 88), Size = UDim2.new(1, 0, 1, -88), Parent = panel })
	for i, name in ipairs({ "Site", "Settings", "Controls" }) do
		local b = UIKit.button(tabs, string.upper(name), { size = UDim2.new(0, 140, 1, 0), textSize = 15 })
		b.LayoutOrder = i
		b.MouseButton1Click:Connect(function()
			HUD.showPauseTab(name)
		end)
		ui.pauseTabs[name] = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = body })
	end
	local resume = UIKit.button(tabs, "RESUME  (P)", { style = "primary", size = UDim2.new(0, 160, 1, 0), textSize = 15 })
	resume.LayoutOrder = 9
	resume.MouseButton1Click:Connect(function()
		HUD.openPause(false)
	end)

	-- Site tab: saves, blueprint, exit
	local site = ui.pauseTabs.Site
	UIKit.list(site, nil, 8)
	UIKit.label(site, "SAVE SLOTS", 13, F.Bold, C.Safety, { LayoutOrder = 1 })
	ui.slotRows = {}
	for slot = 0, Config.Save.ManualSlots do
		local row = UIKit.new("Frame", { BackgroundColor3 = C.CharcoalLight, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 2 + slot, Parent = site })
		UIKit.corner(row, 5)
		UIKit.padding(row, 12, 6, 8, 6)
		UIKit.label(row, slot == 0 and "AUTOSAVE" or ("SLOT " .. slot), 14, F.Bold, C.OffWhite, { Size = UDim2.new(0, 110, 1, 0) })
		local info = UIKit.label(row, "", 13, F.Body, C.Muted, { Position = UDim2.new(0, 110, 0, 0), Size = UDim2.new(1, -340, 1, 0) })
		local load = UIKit.button(row, "LOAD", { size = UDim2.new(0, 100, 1, 0), textSize = 14 })
		load.AnchorPoint = Vector2.new(1, 0)
		load.Position = UDim2.new(1, slot == 0 and 0 or -108, 0, 0)
		load.MouseButton1Click:Connect(function()
			if load:GetAttribute("Disabled") then
				return
			end
			HUD.openPause(false)
			HUD.notify("Loading saved site…", "save")
			local ok, msg, data = Net.call("Site", true, "Start", nil, "continue", slot)
			if ok then
				State.fire("EnteredSite", data)
			else
				HUD.notify(msg or "Load failed.", "error")
			end
		end)
		if slot > 0 then
			local save = UIKit.button(row, "SAVE", { style = "primary", size = UDim2.new(0, 100, 1, 0), textSize = 14 })
			save.AnchorPoint = Vector2.new(1, 0)
			save.Position = UDim2.new(1, 0, 0, 0)
			save.MouseButton1Click:Connect(function()
				HUD.notify("Saving…", "save")
				local ok = Net.call("Save", false, "Save", slot)
				if ok then
					State.fire("Saved", slot)
					local okInfo, _, info2 = Net.call("Menu", true, "Info")
					if okInfo then
						State.menuInfo = info2
						refreshSlots()
					end
				end
			end)
		end
		ui.slotRows[slot] = { info = info, load = load }
	end
	UIKit.label(site, "BLUEPRINT GUIDE", 13, F.Bold, C.Safety, { LayoutOrder = 10 })
	ui.bpRow = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 38), LayoutOrder = 11, Parent = site })
	UIKit.list(ui.bpRow, Enum.FillDirection.Horizontal, 6)
	local bottom = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 20, Parent = site })
	local menuBtn = UIKit.button(bottom, "RETURN TO MAIN MENU", { style = "danger", size = UDim2.new(0, 260, 1, 0) })
	menuBtn.MouseButton1Click:Connect(function()
		HUD.openPause(false)
		State.fire("ReturnToMenu")
	end)

	Settings.buildPanel(ui.pauseTabs.Settings)
end

function HUD.refreshBlueprintButtons()
	for _, c in ipairs(ui.bpRow:GetChildren()) do
		if c:IsA("TextButton") then
			c:Destroy()
		end
	end
	local def = State.siteDef
	if not def then
		return
	end
	local options = {}
	if def.grid then
		table.insert(options, { id = "Site", name = "Site building" })
	end
	for _, bp in ipairs(def.blueprints or {}) do
		table.insert(options, { id = bp.id, name = bp.name })
	end
	table.insert(options, { id = "", name = "None (free build)" })
	local current = State.site and State.site:GetAttribute("Blueprint") or ""
	for i, o in ipairs(options) do
		local b = UIKit.button(ui.bpRow, o.name, { style = o.id == current and "primary" or "secondary", size = UDim2.new(0, 0, 1, 0), textSize = 13 })
		b.AutomaticSize = Enum.AutomaticSize.X
		UIKit.padding(b, 12, 0, 12, 0)
		b.LayoutOrder = i
		b.MouseButton1Click:Connect(function()
			local ok = Net.call("Site", false, "Blueprint", o.id)
			if ok then
				task.wait(0.2)
				HUD.refreshBlueprintButtons()
			end
		end)
	end
end

---------------------------------------------------------------------------
-- Construction
---------------------------------------------------------------------------

function HUD.build()
	gui = UIKit.screen("SR_HUD", 5)
	gui.Enabled = false
	State.notify = HUD.notify

	-- crosshair
	ui.cross = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 6, 0, 6), BackgroundColor3 = C.OffWhite, BorderSizePixel = 0, Parent = gui })
	UIKit.corner(ui.cross, 3)
	UIKit.stroke(ui.cross, C.Charcoal, 1, 0.3)

	-- prompt
	ui.prompt = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 30, 0.5, 26), Size = UDim2.new(0, 380, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false, Parent = gui })
	UIKit.list(ui.prompt, nil, 4)

	-- hold progress
	ui.hold = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.5, 14), Size = UDim2.new(0, 60, 0, 4), BackgroundColor3 = C.SteelDark, BorderSizePixel = 0, Visible = false, Parent = gui })
	ui.holdFill = UIKit.new("Frame", { BackgroundColor3 = C.Safety, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = ui.hold })

	-- placement status
	ui.place = UIKit.panel(gui, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -112), Size = UDim2.new(0, 560, 0, 78), Visible = false })
	ui.placeBar = UIKit.new("Frame", { BackgroundColor3 = C.Valid, BorderSizePixel = 0, Size = UDim2.new(0, 4, 1, 0), Parent = ui.place })
	ui.placeTitle = UIKit.label(ui.place, "", 14, F.Bold, C.OffWhite, { Position = UDim2.new(0, 16, 0, 6), Size = UDim2.new(1, -24, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
	ui.placeStatus = UIKit.label(ui.place, "", 14, F.Medium, C.Valid, { Position = UDim2.new(0, 16, 0, 26), Size = UDim2.new(1, -24, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
	ui.placeHints = UIKit.label(ui.place, "", 12, F.Mono, C.Muted, { Position = UDim2.new(0, 16, 0, 50), Size = UDim2.new(1, -24, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })

	-- hotbar
	local bar = UIKit.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -24), Size = UDim2.new(0, 5 * 76, 0, 66), BackgroundTransparency = 1, Parent = gui })
	UIKit.list(bar, Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Center)
	ui.slots = {}
	local shortNames = { ["TL-HANDS"] = "HANDS", ["TL-IMPACT"] = "WRENCH", ["TL-HAMMER"] = "HAMMER", ["TL-WELDER"] = "WELDER", ["TL-REMOTE"] = "REMOTE" }
	for i, id in ipairs(Registry.ToolOrder) do
		local slot = UIKit.new("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.Panel, BackgroundTransparency = 0.1, BorderSizePixel = 0, Size = UDim2.new(0, 68, 0, 66), LayoutOrder = i, Parent = bar })
		UIKit.corner(slot, 6)
		UIKit.stroke(slot, C.SteelDark, 1, 0)
		UIKit.label(slot, tostring(i), 12, F.Mono, C.Safety, { Position = UDim2.new(0, 6, 0, 2), Size = UDim2.new(0, 20, 0, 14) })
		local vp = UIKit.new("ViewportFrame", { BackgroundTransparency = 1, Size = UDim2.new(1, -12, 0, 36), Position = UDim2.new(0, 6, 0, 10), Ambient = Color3.fromRGB(150, 150, 150), LightDirection = Vector3.new(-1, -1, -1), Parent = slot })
		task.spawn(function()
			local def = Registry.get(id)
			local m = require(Shared.ModelFactory).build(def, CFrame.new(), { preview = true })
			m.Parent = vp
			UIKit.frameModel(vp, m, 40, 20, 0.9)
		end)
		UIKit.label(slot, shortNames[id] or id, 11, F.Bold, C.OffWhite, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -3), Size = UDim2.new(1, 0, 0, 14), TextXAlignment = Enum.TextXAlignment.Center })
		slot.MouseButton1Click:Connect(function()
			State.fire("SelectTool", id)
		end)
		ui.slots[id] = slot
	end
	ui.toolName = UIKit.label(gui, "", 12, F.Bold, C.Muted, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -94), Size = UDim2.new(0, 400, 0, 16), TextXAlignment = Enum.TextXAlignment.Center })

	-- task panel
	ui.tasks = UIKit.panel(gui, { Position = UDim2.new(0, 20, 0, 20), Size = UDim2.new(0, 360, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	UIKit.padding(ui.tasks, 14, 12, 14, 12)
	UIKit.list(ui.tasks, nil, 5)
	ui.siteName = UIKit.label(ui.tasks, "", 14, F.Display, C.OffWhite, { LayoutOrder = 1 })
	ui.progressText = UIKit.label(ui.tasks, "", 12, F.Medium, C.Muted, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 16) })
	ui.progressBar = UIKit.new("Frame", { BackgroundColor3 = C.SteelDark, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 4), LayoutOrder = 3, Parent = ui.tasks })
	ui.progressFill = UIKit.new("Frame", { BackgroundColor3 = C.Safety, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = ui.progressBar })
	UIKit.label(ui.tasks, "NEXT", 11, F.Bold, C.Safety, { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 14) })
	ui.nextTask = UIKit.label(ui.tasks, "", 13, F.Medium, C.OffWhite, { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	UIKit.label(ui.tasks, "DELIVERIES", 11, F.Bold, C.Safety, { LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 14) })
	ui.deliveries = UIKit.label(ui.tasks, "", 12, F.Body, C.OffWhite, { LayoutOrder = 7, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	ui.carry = UIKit.label(ui.tasks, "", 12, F.Bold, C.Info, { LayoutOrder = 8, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	UIKit.label(ui.tasks, "Tab catalog · P site menu · F1 help · J hide", 11, F.Mono, C.SteelDark, { LayoutOrder = 9, Size = UDim2.new(1, 0, 0, 14) })

	-- toasts
	ui.toasts = UIKit.new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -20, 0, 20), Size = UDim2.new(0, 380, 0, 400), BackgroundTransparency = 1, Parent = gui })
	UIKit.list(ui.toasts, nil, 6)

	-- crane panel
	ui.crane = UIKit.panel(gui, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -20, 0.55, 0), Size = UDim2.new(0, 330, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false })
	UIKit.padding(ui.crane, 14, 12, 14, 12)
	UIKit.list(ui.crane, nil, 4)
	UIKit.label(ui.crane, "TOWER CRANE", 15, F.Display, C.Safety, { LayoutOrder = 1 })
	ui.craneMode = UIKit.label(ui.crane, "", 11, F.Mono, C.Muted, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 14) })
	ui.craneRows = {}
	for i, row in ipairs({ "Radius", "Height", "Slew", "Load", "Capacity" }) do
		local r = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 2 + i, Parent = ui.crane })
		UIKit.label(r, string.upper(row), 12, F.Bold, C.Muted, { Size = UDim2.new(0, 90, 1, 0) })
		ui.craneRows[row] = UIKit.label(r, "", 14, F.Mono, C.OffWhite, { Position = UDim2.new(0, 90, 0, 0), Size = UDim2.new(1, -90, 1, 0), TextTruncate = Enum.TextTruncate.AtEnd })
	end
	ui.lmiText = UIKit.label(ui.crane, "", 11, F.Bold, C.Muted, { LayoutOrder = 10, Size = UDim2.new(1, 0, 0, 14) })
	local lmi = UIKit.new("Frame", { BackgroundColor3 = C.SteelDark, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, 8), LayoutOrder = 11, Parent = ui.crane })
	ui.lmiFill = UIKit.new("Frame", { BackgroundColor3 = C.Valid, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = lmi })
	ui.craneSpeed = UIKit.label(ui.crane, "", 11, F.Bold, C.Safety, { LayoutOrder = 12, Size = UDim2.new(1, 0, 0, 14) })
	ui.craneGuide = UIKit.label(ui.crane, "", 14, F.Medium, C.OffWhite, { LayoutOrder = 13, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	ui.craneHint = UIKit.label(ui.crane, "", 12, F.Mono, C.Muted, { LayoutOrder = 14, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	local btnRow = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), LayoutOrder = 15, Parent = ui.crane })
	UIKit.list(btnRow, Enum.FillDirection.Horizontal, 6)
	local recover = UIKit.button(btnRow, "RECOVER LOAD", { size = UDim2.new(0.5, -3, 1, 0), textSize = 13 })
	recover.MouseButton1Click:Connect(function()
		State.fire("CraneRecover")
	end)
	local exit = UIKit.button(btnRow, "EXIT  (X)", { style = "danger", size = UDim2.new(0.5, -3, 1, 0), textSize = 13 })
	exit.MouseButton1Click:Connect(function()
		State.fire("CraneExit")
	end)

	ui.flash = UIKit.label(gui, "", 22, F.Display, C.Invalid, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.new(0, 500, 0, 30), TextXAlignment = Enum.TextXAlignment.Center, Visible = false })

	-- tutorial card
	ui.tutorial = UIKit.panel(gui, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 20), Size = UDim2.new(0, 560, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false })
	UIKit.padding(ui.tutorial, 16, 12, 16, 12)
	UIKit.list(ui.tutorial, nil, 4)
	ui.tutStep = UIKit.label(ui.tutorial, "", 11, F.Bold, C.Safety, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 14) })
	ui.tutText = UIKit.label(ui.tutorial, "", 15, F.Medium, C.OffWhite, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	local skip = UIKit.button(ui.tutorial, "SKIP TUTORIAL", { style = "ghost", size = UDim2.new(0, 140, 0, 26), textSize = 12 })
	skip.LayoutOrder = 3
	skip.MouseButton1Click:Connect(function()
		if ui.tutSkipHandler then
			ui.tutSkipHandler()
		end
	end)

	-- help overlay
	ui.help = UIKit.new("Frame", { BackgroundColor3 = C.Charcoal, BackgroundTransparency = 0.12, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 15, Parent = gui })
	UIKit.new("TextButton", { Modal = true, BackgroundTransparency = 1, Text = "", Size = UDim2.new(0, 1, 0, 1), Parent = ui.help })
	local helpPanel = UIKit.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0, 760, 0.86, 0), Parent = ui.help })
	UIKit.label(helpPanel, "CONTROLS  ·  F1 TO CLOSE", 20, F.Display, C.Safety, { Size = UDim2.new(1, 0, 0, 30) })
	local helpBody = UIKit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 40), Size = UDim2.new(1, 0, 1, -40), Parent = helpPanel })
	require(script.Parent.MainMenu).buildControlsList(helpBody)

	buildPause()
	require(script.Parent.MainMenu).buildControlsList(ui.pauseTabs.Controls)

	task.spawn(function()
		while true do
			task.wait(0.5)
			if gui.Enabled then
				pcall(refreshTasks)
			end
		end
	end)
	return gui
end

function HUD.show(on)
	gui.Enabled = on
	if on then
		HUD.refreshBlueprintButtons()
	end
end

return HUD
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000020">
<Properties>
<string name="Name">Interaction</string>
<ProtectedString name="Source"><![CDATA[-- On-foot interaction: what the crosshair is on, contextual prompts, picking
-- up, releasing straps, entering the crane, releasing trucks, switching
-- equipment, and hold-to-fasten / hold-to-dismantle with the equipped tool.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Registry = require(Shared.ItemRegistry)
local Util = require(Shared.Util)

local State = require(script.Parent.State)
local HUD = require(script.Parent.HUD)
local Net = require(script.Parent.Net)
local View = require(script.Parent.View)
local Audio = require(script.Parent.Audio)

local Interaction = {}
local player = Players.LocalPlayer

local target = nil -- resolved aim target
local hold = nil -- { kind, id, index, start, duration }
local busy = false
local markers = {}
local markerFolder

local HOLD_TIME = { Bolt = 0.55, Wedge = 0.35, Weld = 0.9, Dismantle = 1.2 }
local TOOL_NAME = { Bolt = "impact wrench (2)", Wedge = "scaffold hammer (3)", Weld = "welder (4)" }

local function active()
	return State.mode == "Play" and not State.uiBlocking and not State.crane.operating
end

local function within(pos, extra)
	local root = View.rootPosition()
	return root and (root - pos).Magnitude <= Config.Reach.Interact + (extra or 0)
end

local function resolve(result)
	if not result then
		return nil
	end
	local inst = result.Instance
	if inst:GetAttribute("StrapHit") then
		return { kind = "Strap", strap = inst.Parent, pos = result.Position, dist = result.Distance }
	end
	local craneKind = inst:GetAttribute("CraneInteract")
	if craneKind then
		local model = inst.Parent
		while model and model ~= workspace and not model:GetAttribute("CraneId") do
			model = model.Parent
		end
		return { kind = "Crane", crane = model, pos = result.Position, dist = result.Distance }
	end
	if inst:GetAttribute("TrailerInteract") then
		local m = inst:FindFirstAncestorWhichIsA("Model")
		return { kind = "Truck", trailer = m, pos = result.Position, dist = result.Distance }
	end
	if State.world then
		local rec = State.world:record(inst)
		if rec then
			return { kind = "Component", rec = rec, part = inst, pos = result.Position, dist = result.Distance }
		end
	end
	return nil
end

-- Nearest unfastened fastener of `ftype` on a placed component near `point`.
local function nearestFastener(rec, point, ftype)
	local folder = rec.model:FindFirstChild("Fasteners")
	if not folder then
		return nil
	end
	local best, bestD = nil, 2.2
	for _, f in ipairs(folder:GetChildren()) do
		if f.Transparency > 0.5 and (not ftype or f:GetAttribute("Type") == ftype) then
			local d = (f.Position - point).Magnitude
			if d < bestD then
				best, bestD = f, d
			end
		end
	end
	return best
end

local function toolFastens()
	local def = Registry.get(State.tool)
	return def and def.fastens
end

local function buildPrompt()
	if not target then
		return nil
	end
	local list = {}
	local carrying = State.carrying ~= nil
	if target.kind == "Strap" then
		if within(target.pos, 3) then
			table.insert(list, { key = "E", text = "Release ratchet strap", sub = "Frees every piece in this stack" })
		else
			table.insert(list, { text = "Ratchet strap", sub = "Move closer to release", disabled = true })
		end
	elseif target.kind == "Crane" then
		table.insert(list, { key = "E", text = "Climb into the crane cab", sub = "Or operate from the ground with the radio remote (5)" })
	elseif target.kind == "Truck" then
		local t = target.trailer
		if t and t:GetAttribute("Empty") then
			table.insert(list, { key = "E", text = "Release the empty truck", sub = "Frees the unloading bay" })
		elseif t then
			table.insert(list, { text = "Delivery truck — bay " .. tostring(t:GetAttribute("Bay")), sub = tostring(t:GetAttribute("Remaining") or 0) .. " pieces still on the deck", disabled = true })
		end
	elseif target.kind == "Component" then
		local rec = target.rec
		local def = rec.def
		local sub = string.format("%s  ·  %s", Util.fmtKg(def.weightKg), def.handling)
		if rec.state == "Restrained" then
			table.insert(list, { text = def.name, sub = "Secured by cargo straps — release the strap first", disabled = true })
		elseif rec.state == "Loose" then
			local wc = Config.WeightClasses[def.weightClass]
			if wc.carry and not carrying then
				table.insert(list, { key = "E", text = "Pick up " .. def.name, sub = sub })
			elseif not wc.carry then
				table.insert(list, { text = def.name, sub = "Heavy — rig it with the crane (" .. Util.fmtKg(def.weightKg) .. ")", disabled = true })
			end
		elseif rec.state == "Placed" then
			local need = def.fasteners[1] and def.fasteners[1].type
			local ft = toolFastens()
			local done = 0
			local mask = rec.model:GetAttribute("Fastened") or ""
			for i = 1, #mask do
				if string.sub(mask, i, i) == "1" then
					done += 1
				end
			end
			local progress = string.format("%d / %d connections made", done, #def.fasteners)
			if ft and ft == need then
				local f = nearestFastener(rec, target.pos, ft)
				if f then
					table.insert(list, { key = "Hold LMB", text = (ft == "Weld" and "Weld" or (ft == "Wedge" and "Drive wedge" or "Tighten bolt")), sub = def.name .. "  ·  " .. progress })
				else
					table.insert(list, { text = "Aim at a yellow connection marker", sub = def.name .. "  ·  " .. progress, disabled = true })
				end
			else
				table.insert(list, { text = def.name .. " — not fastened", sub = "Equip the " .. (TOOL_NAME[need] or "right tool") .. "  ·  " .. progress, disabled = true, subColor = Config.Colors.Safety })
			end
		elseif rec.state == "Installed" then
			table.insert(list, { text = def.name, sub = "Installed" })
			if not carrying then
				table.insert(list, { key = "Hold X", text = "Dismantle", sub = #def.fasteners > 0 and ("Needs the " .. (TOOL_NAME[def.fasteners[1].type] or "tool")) or nil })
			end
		elseif rec.state == "Rigged" then
			table.insert(list, { text = def.name, sub = "On the crane hook", disabled = true })
		end
		if def.functional and (rec.state == "Installed" or rec.state == "Loose") then
			table.insert(list, { key = "F", text = rec.model:GetAttribute("On") and "Switch off" or "Switch on" })
		end
	end
	return list
end

---------------------------------------------------------------------------
-- Fastener markers
---------------------------------------------------------------------------

local function refreshMarkers()
	if not State.site or State.mode ~= "Play" then
		for _, a in pairs(markers) do
			a:Destroy()
		end
		markers = {}
		return
	end
	local root = View.rootPosition()
	local seen = {}
	local comps = State.site:FindFirstChild("Components")
	if root and comps then
		for _, m in ipairs(comps:GetChildren()) do
			if m:GetAttribute("State") == "Placed" then
				local folder = m:FindFirstChild("Fasteners")
				if folder and (m:GetPivot().Position - root).Magnitude < 70 then
					for _, f in ipairs(folder:GetChildren()) do
						if f.Transparency > 0.5 then
							seen[f] = true
							if not markers[f] then
								local a = Instance.new("SphereHandleAdornment")
								a.Adornee = f
								a.Radius = 0.2
								a.Color3 = Config.Colors.Safety
								a.Transparency = 0.15
								a.AlwaysOnTop = true
								a.ZIndex = 2
								a.Parent = markerFolder
								markers[f] = a
							end
						end
					end
				end
			end
		end
	end
	for f, a in pairs(markers) do
		if not seen[f] then
			a:Destroy()
			markers[f] = nil
		end
	end
end

---------------------------------------------------------------------------
-- Actions
---------------------------------------------------------------------------

local function doAsync(fn)
	if busy then
		return
	end
	busy = true
	task.spawn(function()
		local ok, err = pcall(fn)
		if not ok then
			warn(err)
		end
		busy = false
	end)
end

local function onE()
	if not target then
		return
	end
	if target.kind == "Strap" then
		doAsync(function()
			Net.call("Handle", false, "Release", target.strap:GetAttribute("StrapId"))
		end)
	elseif target.kind == "Crane" then
		local craneId = target.crane and target.crane:GetAttribute("CraneId")
		doAsync(function()
			local ok, _, data = Net.call("Crane", false, "Enter", craneId)
			if ok then
				State.fire("CraneStart", data and data.craneId or craneId, "Cab")
			end
		end)
	elseif target.kind == "Truck" then
		local t = target.trailer
		if t and t:GetAttribute("Empty") then
			doAsync(function()
				Net.call("Delivery", false, "Dismiss", t:GetAttribute("TrailerId"))
			end)
		end
	elseif target.kind == "Component" then
		local rec = target.rec
		if rec.state == "Loose" and not State.carrying and Config.WeightClasses[rec.def.weightClass].carry then
			doAsync(function()
				local ok = Net.call("Handle", false, "PickUp", rec.id)
				if ok then
					Audio.play("PickUp", rec.model.PrimaryPart)
				end
			end)
		end
	end
end

local function onF()
	if target and target.kind == "Component" and target.rec.def.functional then
		local id = target.rec.id
		doAsync(function()
			Net.call("Handle", false, "Toggle", id)
		end)
	end
end

local function startHold(kind)
	if not target or target.kind ~= "Component" then
		return
	end
	local rec = target.rec
	if kind == "Fasten" then
		local ft = toolFastens()
		if not ft or rec.state ~= "Placed" then
			return
		end
		local f = nearestFastener(rec, target.pos, ft)
		if not f then
			return
		end
		hold = { kind = "Fasten", id = rec.id, index = f:GetAttribute("Index"), part = f, start = os.clock(), duration = HOLD_TIME[ft] or 0.6, ftype = ft }
		if ft == "Weld" then
			State.fire("LocalWeldStart", f)
		end
	elseif kind == "Dismantle" then
		if rec.state ~= "Installed" and rec.state ~= "Placed" then
			return
		end
		hold = { kind = "Dismantle", id = rec.id, start = os.clock(), duration = HOLD_TIME.Dismantle }
	end
end

local function cancelHold()
	if hold and hold.ftype == "Weld" then
		State.fire("LocalWeldStop")
	end
	hold = nil
	HUD.setHold(nil)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.CameraOffset = Vector3.zero
	end
end

local function finishHold()
	local h = hold
	cancelHold()
	if h.kind == "Fasten" then
		task.spawn(function()
			Net.call("Build", true, "Fasten", h.id, h.index)
			-- keep going on the next marker while the button stays down
			if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) and active() then
				task.wait(0.1)
				startHold("Fasten")
			end
		end)
	else
		task.spawn(function()
			Net.call("Build", false, "Dismantle", h.id)
		end)
	end
end

---------------------------------------------------------------------------
-- Loop
---------------------------------------------------------------------------

function Interaction.init()
	markerFolder = Instance.new("Folder")
	markerFolder.Name = "SR_Markers"
	markerFolder.Parent = player:WaitForChild("PlayerGui")

	UserInputService.InputBegan:Connect(function(input, gp)
		if gp or not active() then
			return
		end
		if input.KeyCode == Enum.KeyCode.E then
			onE()
		elseif input.KeyCode == Enum.KeyCode.F then
			onF()
		elseif input.KeyCode == Enum.KeyCode.X and not State.carrying then
			startHold("Dismantle")
		elseif input.UserInputType == Enum.UserInputType.MouseButton1 and not State.carrying then
			startHold("Fasten")
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if not hold then
			return
		end
		if (hold.kind == "Fasten" and input.UserInputType == Enum.UserInputType.MouseButton1) or (hold.kind == "Dismantle" and input.KeyCode == Enum.KeyCode.X) then
			cancelHold()
		end
	end)

	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc += dt
		if acc > 0.25 then
			acc = 0
			refreshMarkers()
		end
		if not active() then
			if target then
				target = nil
				HUD.setPrompt(nil)
			end
			if hold then
				cancelHold()
			end
			return
		end
		local exclude = {}
		if State.carrying then
			table.insert(exclude, State.carrying)
		end
		target = resolve(View.cast(40, exclude))
		if target and target.dist > Config.Reach.Interact + 12 then
			target = nil
		end
		HUD.setPrompt(buildPrompt())
		-- hovered marker
		for f, a in pairs(markers) do
			a.Radius = 0.2
			a.Color3 = Config.Colors.Safety
		end
		if target and target.kind == "Component" and target.rec.state == "Placed" then
			local f = nearestFastener(target.rec, target.pos, toolFastens())
			if f and markers[f] then
				markers[f].Radius = 0.3
				markers[f].Color3 = Config.Colors.OffWhite
			end
		end
		if hold then
			-- the aim must stay on the same piece
			if not target or target.kind ~= "Component" or target.rec.id ~= hold.id then
				cancelHold()
				return
			end
			if hold.kind == "Fasten" then
				local f = nearestFastener(target.rec, target.pos, hold.ftype)
				if f ~= hold.part then
					cancelHold()
					return
				end
			end
			local a = (os.clock() - hold.start) / hold.duration
			HUD.setHold(a)
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum and hold.kind == "Fasten" and hold.ftype == "Bolt" then
				hum.CameraOffset = Vector3.new(math.random() - 0.5, math.random() - 0.5, 0) * 0.06
			end
			if a >= 1 then
				finishHold()
			end
		end
	end)
end

function Interaction.clear()
	cancelHold()
	target = nil
	HUD.setPrompt(nil)
end

return Interaction
]]></ProtectedString>
</Properties>
</Item>
<Item class="ModuleScript" referent="RBX00000021">
<Properties>
<string name="Name">MainMenu</string>
<ProtectedString name="Source"><![CDATA[-- Main menu: Play, Continue Construction, Site Selection, Settings, Controls,
-- Credits. Site cards render live 3D previews generated from the same layout
-- data the server uses to build each site's starting stage.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Steelrise")
local Config = require(Shared.Config)
local Sites = require(Shared.Sites)

local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local Net = require(script.Parent.Net)
local Settings = require(script.Parent.Settings)

local C = Config.Colors
local F = UIKit.Font

local MainMenu = {}
local gui, nav, content, footer, busyOverlay
local panels = {}
local navButtons = {}
local selectedSite = "EmptyLand"
local detail = {}
local previewsBuilt = false
local spin = 0

local DIFF_COLOR = {
	Beginner = Color3.fromRGB(70, 150, 96),
	Standard = Color3.fromRGB(70, 120, 180),
	Advanced = Color3.fromRGB(196, 120, 40),
	Expert = Color3.fromRGB(180, 56, 50),
}

local function timeAgo(t)
	if not t then
		return ""
	end
	local d = os.time() - t
	if d < 90 then
		return "just now"
	elseif d < 3600 then
		return math.floor(d / 60) .. " min ago"
	elseif d < 86400 then
		return math.floor(d / 3600) .. " h ago"
	end
	return math.floor(d / 86400) .. " days ago"
end

local function showPanel(name)
	for n, p in pairs(panels) do
		p.Visible = n == name
	end
	content.Visible = name ~= nil
	for n, b in pairs(navButtons) do
		local bar = b:FindFirstChild("Indicator")
		if bar then
			bar.Visible = n == name
		end
	end
	if name == "Sites" then
		MainMenu.buildPreviews()
	end
end

local function setBusy(text)
	busyOverlay.Visible = text ~= nil
	busyOverlay.Label.Text = text or ""
end

local function start(siteId, mode, slot)
	setBusy(mode == "continue" and "Restoring your construction site…" or (mode == "join" and "Joining site…" or "Preparing " .. (Sites.get(siteId or "") and Sites.get(siteId).name or "site") .. "…"))
	local ok, msg, data = Net.call("Site", true, "Start", siteId, mode, slot)
	setBusy(nil)
	if not ok then
		State.notify(msg or "Couldn't start the site.", "error")
		return
	end
	State.lastStartMode = mode
	State.fire("EnteredSite", data)
end

---------------------------------------------------------------------------
-- Building blocks
---------------------------------------------------------------------------

local function navButton(text, key, order, onClick)
	local b = UIKit.button(nav, text, { style = "ghost", align = Enum.TextXAlignment.Left, size = UDim2.new(1, 0, 0, 46), textSize = 18 })
	b.LayoutOrder = order
	local bar = UIKit.new("Frame", {
		Name = "Indicator",
		BackgroundColor3 = C.Safety,
		BorderSizePixel = 0,
		Size = UDim2.new(0, 4, 0.6, 0),
		Position = UDim2.new(0, 0, 0.2, 0),
		Visible = false,
		Parent = b,
	})
	bar.ZIndex = 2
	b.MouseButton1Click:Connect(function()
		if not b:GetAttribute("Disabled") then
			onClick()
		end
	end)
	navButtons[key] = b
	return b
end

local function panelFrame(name, title)
	local p = UIKit.new("Frame", { Name = name, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false, Parent = content })
	UIKit.label(p, title, 26, F.Display, C.OffWhite, { Size = UDim2.new(1, 0, 0, 34) })
	UIKit.new("Frame", { BackgroundColor3 = C.Safety, BorderSizePixel = 0, Size = UDim2.new(0, 60, 0, 3), Position = UDim2.new(0, 0, 0, 38), Parent = p })
	local body = UIKit.new("Frame", { Name = "Body", BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 56), Size = UDim2.new(1, 0, 1, -56), Parent = p })
	panels[name] = p
	return body
end

local function makeViewport(parent, props)
	local vp = UIKit.new("ViewportFrame", {
		BackgroundColor3 = Color3.fromRGB(42, 46, 52),
		BorderSizePixel = 0,
		Ambient = Color3.fromRGB(120, 124, 132),
		LightColor = Color3.fromRGB(255, 244, 228),
		LightDirection = Vector3.new(-0.6, -1, -0.4),
		Parent = parent,
	})
	for k, v in pairs(props or {}) do
		vp[k] = v
	end
	local grad = UIKit.new("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(150, 160, 172), Color3.fromRGB(90, 90, 92)),
		Parent = vp,
	})
	grad.Enabled = true
	return vp
end

---------------------------------------------------------------------------
-- Site selection
---------------------------------------------------------------------------

local cardViewports = {}

local function updateDetail()
	local site = Sites.get(selectedSite)
	detail.title.Text = string.upper(site.name)
	detail.subtitle.Text = site.subtitle
	detail.desc.Text = site.description
	detail.stage.Text = site.stageText
	for _, ch in ipairs(detail.chips:GetChildren()) do
		if ch:IsA("TextLabel") then
			ch:Destroy()
		end
	end
	UIKit.chip(detail.chips, string.upper(site.difficulty), DIFF_COLOR[site.difficulty])
	if site.grid then
		UIKit.chip(detail.chips, site.grid.floors .. " STOREYS")
		UIKit.chip(detail.chips, string.format("%d × %d BAYS", site.grid.nx, site.grid.nz))
	else
		UIKit.chip(detail.chips, "FREE BUILD")
	end
	UIKit.chip(detail.chips, string.format("LOT %d × %d m", site.lotM.X, site.lotM.Z))
	detail.equipment.Text = "•  " .. table.concat(site.equipment, "\n•  ")
	-- slot for this site?
	local info = State.menuInfo or {}
	local slotFor = nil
	for k, s in pairs(info.slots or {}) do
		if s.site == selectedSite and (not slotFor or (s.savedAt or 0) > (info.slots[slotFor].savedAt or 0)) then
			slotFor = k
		end
	end
	detail.slot = slotFor
	detail.continueBtn.Visible = slotFor ~= nil
	if slotFor then
		local s = info.slots[slotFor]
		detail.continueBtn.Text = string.format("CONTINUE  ·  %s %s · %s", slotFor == "0" and "AUTOSAVE" or ("SLOT " .. slotFor), "", timeAgo(s.savedAt))
	end
	local hostOther = info.currentSite and info.host ~= 0 and info.host ~= game:GetService("Players").LocalPlayer.UserId
	detail.joinBtn.Visible = hostOther == true
	if hostOther then
		detail.joinBtn.Text = "JOIN " .. string.upper(info.hostName or "HOST") .. "'S SITE"
	end
	UIKit.setDisabled(detail.startBtn, hostOther == true)
	-- big preview
	local vp = detail.viewport
	for _, ch in ipairs(vp:GetChildren()) do
		if ch:IsA("Model") then
			ch:Destroy()
		end
	end
	local model = Sites.buildPreview(selectedSite)
	model.Parent = vp
	detail.model = model
	UIKit.frameModel(vp, model, 35, 26, 0.72)
	for id, card in pairs(cardViewports) do
		local stroke = card.Parent:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Color = id == selectedSite and C.Safety or C.SteelDark
			stroke.Thickness = id == selectedSite and 2 or 1
		end
	end
	navButtons.Play.Text = "PLAY  —  " .. string.upper(site.name)
end

function MainMenu.buildPreviews()
	if previewsBuilt then
		return
	end
	previewsBuilt = true
	for id, vp in pairs(cardViewports) do
		task.spawn(function()
			local model = Sites.buildPreview(id)
			model.Parent = vp
			UIKit.frameModel(vp, model, 40, 28, 0.7)
		end)
		task.wait()
	end
end

local function buildSitesPanel()
	local body = panelFrame("Sites", "SITE SELECTION")
	local list = UIKit.new("ScrollingFrame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.new(0.46, -10, 1, 0),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Steel,
		Parent = body,
	})
	UIKit.new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -8, 0, 150),
		CellPadding = UDim2.new(0, 8, 0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = list,
	})
	for i, id in ipairs(Sites.Order) do
		local site = Sites.get(id)
		local card = UIKit.new("TextButton", { AutoButtonColor = false, Text = "", BackgroundColor3 = C.CharcoalLight, BorderSizePixel = 0, LayoutOrder = i, Parent = list })
		UIKit.corner(card, 6)
		UIKit.stroke(card, C.SteelDark, 1, 0)
		local vp = makeViewport(card, { Size = UDim2.new(1, -8, 1, -44), Position = UDim2.new(0, 4, 0, 4) })
		UIKit.corner(vp, 4)
		cardViewports[id] = vp
		UIKit.label(card, site.name, 14, F.Bold, C.OffWhite, { Position = UDim2.new(0, 8, 1, -40), Size = UDim2.new(1, -16, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd })
		UIKit.label(card, site.stageText, 12, F.Body, C.Muted, { Position = UDim2.new(0, 8, 1, -21), Size = UDim2.new(1, -16, 0, 16), TextTruncate = Enum.TextTruncate.AtEnd })
		local dot = UIKit.new("Frame", { BackgroundColor3 = DIFF_COLOR[site.difficulty], BorderSizePixel = 0, Size = UDim2.new(0, 8, 0, 8), Position = UDim2.new(1, -16, 0, 10), Parent = card })
		UIKit.corner(dot, 4)
		card.MouseButton1Click:Connect(function()
			selectedSite = id
			updateDetail()
		end)
	end

	local pane = UIKit.panel(body, { Size = UDim2.new(0.54, -6, 1, 0), Position = UDim2.new(0.46, 6, 0, 0) })
	UIKit.padding(pane, 14)
	detail.viewport = makeViewport(pane, { Size = UDim2.new(1, 0, 0.42, 0) })
	UIKit.corner(detail.viewport, 4)
	local info = UIKit.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0.42, 10), Size = UDim2.new(1, 0, 0.58, -10), Parent = pane })
	UIKit.list(info, nil, 6)
	detail.title = UIKit.label(info, "", 22, F.Display, C.OffWhite, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 26) })
	detail.subtitle = UIKit.label(info, "", 14, F.Medium, C.Safety, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 18) })
	detail.chips = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), LayoutOrder = 3, Parent = info })
	UIKit.list(detail.chips, Enum.FillDirection.Horizontal, 6)
	detail.desc = UIKit.label(info, "", 14, F.Body, C.OffWhite, { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 54), TextYAlignment = Enum.TextYAlignment.Top })
	local stageRow = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 5, Parent = info })
	UIKit.label(stageRow, "STARTING STAGE", 12, F.Bold, C.Muted, { Size = UDim2.new(0, 130, 1, 0) })
	detail.stage = UIKit.label(stageRow, "", 14, F.Medium, C.OffWhite, { Position = UDim2.new(0, 130, 0, 0), Size = UDim2.new(1, -130, 1, 0) })
	UIKit.label(info, "AVAILABLE EQUIPMENT", 12, F.Bold, C.Muted, { LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 16) })
	detail.equipment = UIKit.label(info, "", 13, F.Body, C.OffWhite, { LayoutOrder = 7, Size = UDim2.new(1, 0, 0, 52), TextYAlignment = Enum.TextYAlignment.Top })
	local buttons = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 92), LayoutOrder = 8, Parent = info })
	UIKit.list(buttons, nil, 6)
	detail.startBtn = UIKit.button(buttons, "START NEW CONSTRUCTION", { style = "primary" })
	detail.startBtn.LayoutOrder = 1
	detail.startBtn.MouseButton1Click:Connect(function()
		if not detail.startBtn:GetAttribute("Disabled") then
			start(selectedSite, "new")
		end
	end)
	detail.continueBtn = UIKit.button(buttons, "CONTINUE", {})
	detail.continueBtn.LayoutOrder = 2
	detail.continueBtn.MouseButton1Click:Connect(function()
		if detail.slot then
			start(nil, "continue", tonumber(detail.slot))
		end
	end)
	detail.joinBtn = UIKit.button(buttons, "JOIN", {})
	detail.joinBtn.LayoutOrder = 3
	detail.joinBtn.MouseButton1Click:Connect(function()
		start(nil, "join")
	end)
end

---------------------------------------------------------------------------
-- Controls & credits
---------------------------------------------------------------------------

MainMenu.ControlRows = {
	{ "ON FOOT", nil },
	{ "WASD / Space", "Walk / jump" },
	{ "Mouse", "Look and aim (first person) · aim with cursor (third person)" },
	{ "V", "First / third-person view" },
	{ "E", "Interact: pick up, release strap, enter crane, release truck" },
	{ "LMB", "Place carried item · hold to fasten with the equipped tool" },
	{ "R  ·  Z / C", "Rotate 90°  ·  fine rotate" },
	{ "T", "Free placement (props and equipment)" },
	{ "Arrow keys", "Nudge in free placement (Shift = coarse)" },
	{ "G", "Drop carried item" },
	{ "Hold X", "Dismantle the aimed component (with its tool)" },
	{ "F", "Switch equipment on / off" },
	{ "1 – 5", "Hands · impact wrench · hammer · welder · crane remote" },
	{ "Tab", "Catalog & deliveries" },
	{ "B", "Blueprint ghosts on / off" },
	{ "J", "Task panel" },
	{ "P", "Site menu: save, load, settings" },
	{ "F1", "Help overlay" },
	{ "CRANE", nil },
	{ "A / D", "Slew left / right" },
	{ "W / S", "Trolley out / in" },
	{ "R / F", "Hoist up / down" },
	{ "Z / C", "Rotate load" },
	{ "Shift", "Precision (slow) mode" },
	{ "G", "Hook nearby load · unhook" },
